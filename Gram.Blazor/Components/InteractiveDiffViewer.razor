@namespace Gram.Blazor.Components
@using Gram.Blazor.Shared
@inject IJSRuntime JSRuntime

@if (Diff != null && Diff.Lines.Count > 0)
{
    var displayLines = isExpandedAll || Diff.Lines.Count <= MaxPreviewLines
        ? Diff.Lines
        : Diff.Lines.Take(MaxPreviewLines).ToList();

    <div class="interactive-diff-box @(isReverted ? "is-reverted" : "")">
        <!-- Diff Toolbar Header -->
        <div class="diff-toolbar">
            <div class="diff-toolbar-left">
                @if (!string.IsNullOrWhiteSpace(Diff.FilePath))
                {
                    <span class="diff-file-path" title="@Diff.FilePath">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                        </svg>
                        <span>@Diff.FilePath</span>
                    </span>
                }
                <div class="diff-stats-badges">
                    @if (Diff.AdditionsCount > 0)
                    {
                        <span class="diff-badge added">+@Diff.AdditionsCount</span>
                    }
                    @if (Diff.DeletionsCount > 0)
                    {
                        <span class="diff-badge deleted">-@Diff.DeletionsCount</span>
                    }
                </div>
            </div>

            <div class="diff-toolbar-right">
                @if (isReverted)
                {
                    <span class="diff-reverted-badge" title="Changes reverted to pre-write snapshot">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>Reverted</span>
                    </span>
                }
                else if (!string.IsNullOrWhiteSpace(CheckpointId))
                {
                    <button type="button" class="diff-btn-action revert" @onclick="HandleRollbackAsync" disabled="@isReverting" title="Revert this change to pre-write snapshot">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
                        <span>@(isReverting ? "Reverting..." : "Undo Change")</span>
                    </button>
                }

                <button type="button" class="diff-btn-action" @onclick="CopyDiffText" title="Copy unified diff">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                    </svg>
                    <span>@(isCopied ? "Copied" : "Copy Diff")</span>
                </button>
            </div>
        </div>

        <!-- Diff Code Table -->
        <div class="diff-table-container">
            <table class="diff-table">
                <tbody>
                    @foreach (var line in displayLines)
                    {
                        if (line.Type == "header")
                        {
                            var matchingHunk = Diff.Hunks.FirstOrDefault(h => h.Header == line.Content);
                            <tr class="diff-row diff-hunk-header-row">
                                <td colspan="4" class="diff-hunk-header-cell" style="padding: 0;">
                                    <div class="diff-hunk-bar">
                                        <span class="diff-hunk-text">@line.Content</span>
                                        @if (matchingHunk != null)
                                        {
                                            <div class="diff-hunk-actions">
                                                @if (matchingHunk.IsAccepted)
                                                {
                                                    <span class="diff-hunk-status accepted">Accepted</span>
                                                }
                                                else if (matchingHunk.IsRejected)
                                                {
                                                    <span class="diff-hunk-status rejected">Rejected</span>
                                                }
                                                else
                                                {
                                                    <button type="button" class="diff-hunk-btn accept" @onclick="() => HandleAcceptHunkAsync(matchingHunk)" title="Accept this hunk">Accept</button>
                                                    <button type="button" class="diff-hunk-btn reject" @onclick="() => HandleRejectHunkAsync(matchingHunk)" title="Reject this hunk">Reject</button>
                                                }
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr class="diff-row @GetRowClass(line.Type)">
                                <td class="diff-ln old-ln">@(line.OldLineNumber?.ToString() ?? "")</td>
                                <td class="diff-ln new-ln">@(line.NewLineNumber?.ToString() ?? "")</td>
                                <td class="diff-sign">@GetSign(line.Type)</td>
                                <td class="diff-code"><code>@line.Content</code></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Diff.Lines.Count > MaxPreviewLines)
        {
            <div class="diff-expand-footer" @onclick="ToggleExpandAll">
                <span>@(isExpandedAll ? "Show less ▲" : $"Show all {Diff.Lines.Count} lines ({Diff.Lines.Count - MaxPreviewLines} more) ▼")</span>
            </div>
        }
    </div>
}

@code {
    [Parameter] public DiffFileItem? Diff { get; set; }
    [Parameter] public int MaxPreviewLines { get; set; } = 25;
    [Parameter] public string? CheckpointId { get; set; }
    [Parameter] public string? WorkspaceRoot { get; set; }
    [Parameter] public EventCallback<string> OnRollback { get; set; }
    [Parameter] public EventCallback<DiffHunk> OnHunkRejected { get; set; }
    [Parameter] public EventCallback<DiffHunk> OnHunkAccepted { get; set; }

    private bool isExpandedAll = false;
    private bool isCopied = false;
    private bool isReverting = false;
    private bool isReverted = false;

    private async Task HandleRejectHunkAsync(DiffHunk hunk)
    {
        hunk.IsRejected = true;
        hunk.IsAccepted = false;

        // If WorkspaceRoot and FilePath are available, attempt local disk reverse patching
        if (!string.IsNullOrWhiteSpace(WorkspaceRoot) && !string.IsNullOrWhiteSpace(Diff?.FilePath))
        {
            try
            {
                var fullPath = Path.IsPathRooted(Diff.FilePath) ? Diff.FilePath : Path.Combine(WorkspaceRoot, Diff.FilePath);
                if (File.Exists(fullPath))
                {
                    var text = await File.ReadAllTextAsync(fullPath);
                    var (ok, updated) = DiffEngine.ApplyReverseHunk(text, hunk);
                    if (ok)
                    {
                        await File.WriteAllTextAsync(fullPath, updated);
                    }
                }
            }
            catch {}
        }

        if (OnHunkRejected.HasDelegate)
        {
            await OnHunkRejected.InvokeAsync(hunk);
        }

        StateHasChanged();
    }

    private async Task HandleAcceptHunkAsync(DiffHunk hunk)
    {
        hunk.IsAccepted = true;
        hunk.IsRejected = false;

        if (OnHunkAccepted.HasDelegate)
        {
            await OnHunkAccepted.InvokeAsync(hunk);
        }

        StateHasChanged();
    }

    private async Task HandleRollbackAsync()
    {
        if (string.IsNullOrWhiteSpace(CheckpointId) || isReverting || isReverted) return;
        isReverting = true;
        try
        {
            if (OnRollback.HasDelegate)
            {
                await OnRollback.InvokeAsync(CheckpointId);
            }
            isReverted = true;
        }
        catch
        {
            // Error handling
        }
        finally
        {
            isReverting = false;
            StateHasChanged();
        }
    }

    private void ToggleExpandAll() => isExpandedAll = !isExpandedAll;

    private static string GetRowClass(string type) => type?.ToLowerInvariant() switch
    {
        "add" => "diff-added",
        "delete" => "diff-deleted",
        "header" => "diff-hunk",
        _ => "diff-unchanged"
    };

    private static string GetSign(string type) => type?.ToLowerInvariant() switch
    {
        "add" => "+",
        "delete" => "-",
        "header" => "@",
        _ => " "
    };

    private async Task CopyDiffText()
    {
        if (Diff == null || Diff.Lines.Count == 0) return;

        var sb = new System.Text.StringBuilder();
        foreach (var l in Diff.Lines)
        {
            var sign = GetSign(l.Type);
            sb.AppendLine($"{sign} {l.Content}");
        }

        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
        isCopied = true;
        StateHasChanged();
        _ = Task.Delay(1500).ContinueWith(_ =>
        {
            isCopied = false;
            InvokeAsync(StateHasChanged);
        });
    }
}
