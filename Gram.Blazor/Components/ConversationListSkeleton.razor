@namespace Gram.Blazor.Components
@using Gram.Blazor.Components.ShadCn

<div class="conversation-skeleton-list" aria-busy="true" aria-label="Loading conversations">
    @for (int i = 0; i < Count; i++)
    {
        var widthRatio = (i % 3) switch
        {
            0 => "82%",
            1 => "65%",
            _ => "74%"
        };
        <div class="conversation-skeleton-item">
            <div class="conv-skeleton-icon">
                <Skeleton Variant="circle" Width="18px" Height="18px" />
            </div>
            <div class="conv-skeleton-content">
                <Skeleton Width="@widthRatio" Height="14px" BorderRadius="4px" />
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Count { get; set; } = 4;
}
