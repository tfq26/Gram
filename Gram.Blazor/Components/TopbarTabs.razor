@namespace Gram.Blazor.Components
@using Gram.Blazor.Shared
@using Gram.Blazor.Components.ShadCn
@inject WorkspaceTabService TabService
@inject ToolboxManagerService ToolboxService
@inject ChatStateService ChatStateService
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="topbar-tabs-container">
    <div class="topbar-divider"></div>

    <div class="topbar-tabs-list">
        @foreach (var tab in TabService.OpenTabs)
        {
            var isTabActive = TabService.ActiveTabId == tab.Id;

            <div class="topbar-tab @(isTabActive ? "active" : "")"
                 data-tabid="@tab.Id"
                 @onpointerdown="e => OnPointerDown(e, tab)"
                 @onclick="() => HandleTabClick(tab)"
                 title="@tab.Title">
                <span class="topbar-tab-title">@tab.Title</span>
                @if (TabService.OpenTabs.Count > 1 && !tab.IsPinned)
                {
                    <button class="topbar-tab-close" @onclick:stopPropagation="true" @onclick="() => TabService.CloseTab(tab.Id)" title="Close tab">
                        ✕
                    </button>
                }
            </div>
        }

        @if (isDragActive && TabService.OpenTabs.Count > 1 && !TabService.IsSplitView)
        {
            <div class="topbar-tab-split-dock visible" title="Drop here to split screen">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="12" y1="3" x2="12" y2="21"></line>
                </svg>
                <span>Drop to Split</span>
            </div>
        }

        <button class="btn-new-tab" @onclick="CreateNewChatTab" title="Open new chat tab">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
        </button>
    </div>
</div>

@code {
    private DotNetObjectReference<TopbarTabs>? dotNetHelper;
    private bool isDragActive = false;

    protected override void OnInitialized()
    {
        TabService.OnTabsChanged += OnTabsChanged;
        ToolboxService.OnChange += OnToolboxChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetHelper = DotNetObjectReference.Create(this);
            try
            {
                await JSRuntime.InvokeVoidAsync("gramTabDrag.init", dotNetHelper);
            }
            catch {}
        }
    }

    private void OnTabsChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnToolboxChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task OnPointerDown(PointerEventArgs e, WorkspaceTab tab)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("gramTabDrag.startDrag", e, tab.Id, tab.Title);
        }
        catch {}
    }

    [JSInvokable]
    public void OnDragStarted(string tabId)
    {
        isDragActive = true;
        TabService.SetDraggingTab(tabId);
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnDragEnded()
    {
        isDragActive = false;
        TabService.SetDraggingTab(null);
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnTabSnapped(string tabId, string side)
    {
        isDragActive = false;
        TabService.SetDraggingTab(null);
        if (!string.IsNullOrWhiteSpace(tabId))
        {
            TabService.ToggleSplitView(tabId);
        }
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnTabReordered(string sourceTabId, string targetTabId)
    {
        isDragActive = false;
        TabService.SetDraggingTab(null);
        TabService.ReorderTab(sourceTabId, targetTabId);
        InvokeAsync(StateHasChanged);
    }

    private void HandleTabClick(WorkspaceTab tab)
    {
        TabService.SelectTab(tab.Id);
        if (tab.Type == WorkspaceTabType.Chat)
        {
            if (!NavManager.Uri.EndsWith("/"))
            {
                NavManager.NavigateTo("/");
            }
        }
        else if (tab.Type == WorkspaceTabType.ToolboxOverview || tab.Type == WorkspaceTabType.ToolConfig)
        {
            if (!NavManager.Uri.Contains("/toolbox"))
            {
                NavManager.NavigateTo("/toolbox");
            }
        }
    }

    private void CreateNewChatTab()
    {
        ChatStateService.RequestNewChat();
        if (!NavManager.Uri.EndsWith("/") && !NavManager.Uri.EndsWith("/#"))
        {
            NavManager.NavigateTo("/");
        }
    }

    private void OpenToolboxHub()
    {
        TabService.OpenToolboxTab();
        if (!NavManager.Uri.Contains("/toolbox"))
        {
            NavManager.NavigateTo("/toolbox");
        }
    }

    private bool IsToolboxActive()
    {
        return TabService.ActiveTab?.Type == WorkspaceTabType.ToolboxOverview || TabService.ActiveTab?.Type == WorkspaceTabType.ToolConfig;
    }

    public void Dispose()
    {
        TabService.OnTabsChanged -= OnTabsChanged;
        ToolboxService.OnChange -= OnToolboxChanged;
        dotNetHelper?.Dispose();
    }
}
