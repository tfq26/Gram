@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string ConversationId { get; set; } = string.Empty;
    [Parameter] public string FileName { get; set; } = string.Empty;

    private ParsedDocumentResult? parsedDoc;
    private bool isLoading = false;
    private string activeTab = "preview";
    private string csvSearchQuery = "";
    private int activeSheetIdx = 0;
    private bool isCopied = false;

    private string AttachmentApiUrl => $"/api/attachments/{Uri.EscapeDataString(ConversationId)}/{Uri.EscapeDataString(FileName)}";

    private DocumentSheetItem? ActiveSheet =>
        parsedDoc?.Sheets != null && activeSheetIdx >= 0 && activeSheetIdx < parsedDoc.Sheets.Count
            ? parsedDoc.Sheets[activeSheetIdx]
            : null;

    private List<List<string>> FilteredCsvRows
    {
        get
        {
            if (parsedDoc?.CsvRows == null) return [];
            if (string.IsNullOrWhiteSpace(csvSearchQuery)) return parsedDoc.CsvRows;

            return parsedDoc.CsvRows.Where(row =>
                row.Any(cell => cell.Contains(csvSearchQuery, StringComparison.OrdinalIgnoreCase))).ToList();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !string.IsNullOrWhiteSpace(ConversationId) && !string.IsNullOrWhiteSpace(FileName))
        {
            activeSheetIdx = 0;
            await LoadDocumentDataAsync();
        }
    }

    private async Task LoadDocumentDataAsync()
    {
        isLoading = true;
        isCopied = false;
        parsedDoc = null;
        StateHasChanged();

        try
        {
            var path = SessionStorage.GetAttachmentPath(ConversationId, FileName);
            parsedDoc = await DocumentParser.ParseDocumentAsync(path, FileName);
        }
        catch (Exception ex)
        {
            parsedDoc = new ParsedDocumentResult
            {
                FileName = FileName,
                IsSuccess = false,
                ErrorMessage = ex.Message
            };
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task CopyExtractedText()
    {
        if (parsedDoc == null) return;
        var textToCopy = activeTab == "grounding" 
            ? parsedDoc.FormattedContextText 
            : parsedDoc.RawExtractedText;

        if (string.IsNullOrWhiteSpace(textToCopy)) return;

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", textToCopy);
            isCopied = true;
            SonnerService.Success("Copied", "Extracted text copied to clipboard.");
            StateHasChanged();
            await Task.Delay(2000);
            isCopied = false;
            StateHasChanged();
        }
        catch (Exception) {}
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024):F1} MB";
    }
}
