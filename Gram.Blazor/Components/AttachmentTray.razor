@using Gram.Blazor.Shared

@if (FileNames.Count > 0)
{
    <div class="attachment-tray" aria-label="Attached files">
        @foreach (var fileName in FileNames)
        {
            var attachment = Attachments.FirstOrDefault(a => a.FileName == fileName);
            var isImage = attachment?.IsImage ?? fileName.EndsWith(".png", StringComparison.OrdinalIgnoreCase) || fileName.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || fileName.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) || fileName.EndsWith(".webp", StringComparison.OrdinalIgnoreCase) || fileName.EndsWith(".svg", StringComparison.OrdinalIgnoreCase);
            <div class="attachment-pill">
                <span class="attachment-icon" aria-hidden="true">@(isImage ? "▧" : "▤")</span>
                <span class="attachment-name">@fileName</span>
                <button type="button" class="btn-remove-attachment" @onclick="() => Remove.InvokeAsync(fileName)" title="Remove @fileName" aria-label="Remove @fileName">✕</button>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> FileNames { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<AttachmentInfo> Attachments { get; set; } = [];
    [Parameter] public EventCallback<string> Remove { get; set; }
}
