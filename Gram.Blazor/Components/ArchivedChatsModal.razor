@namespace Gram.Blazor.Components
@using Gram.Blazor.Shared
@using Gram.Blazor.Components.ShadCn
@inject ISonnerService SonnerService

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-dialog archived-modal-dialog" style="max-width: 580px; border-radius: var(--radius-lg);" @onclick:stopPropagation="true">
            <div class="modal-header" style="padding: 16px 20px; border-bottom: 1px solid var(--border-color);">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <div style="width: 28px; height: 28px; border-radius: var(--radius-sm); background: var(--bg-hover); color: var(--text-primary); display: flex; align-items: center; justify-content: center; font-size: 14px;">
                        📦
                    </div>
                    <div>
                        <span class="modal-title" style="font-size: 15px; font-weight: 600;">
                            Archived Chats (@ArchivedConversations.Count)
                        </span>
                    </div>
                </div>
                <button class="btn-close-modal" @onclick="Close" title="Close">✕</button>
            </div>

            <!-- Search input -->
            <div style="padding: 12px 20px 0 20px;">
                <input class="setting-input"
                       @bind="searchQuery"
                       @bind:event="oninput"
                       placeholder="Search archived chats by title..."
                       style="font-size: 12.5px; padding: 7px 12px;" />
            </div>

            <div class="modal-body" style="padding: 12px 20px; max-height: 420px; overflow-y: auto; display: flex; flex-direction: column; gap: 6px;">
                @{
                    var filtered = string.IsNullOrWhiteSpace(searchQuery)
                        ? ArchivedConversations
                        : ArchivedConversations.Where(c => c.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();
                }

                @if (filtered.Count > 0)
                {
                    @foreach (var chat in filtered)
                    {
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 10px 12px; background: var(--bg-panel-subtle); border: 1px solid var(--border-color); border-radius: var(--radius-sm); gap: 12px;">
                            <div style="display: flex; flex-direction: column; min-width: 0; flex: 1;">
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span style="font-size: 13px; font-weight: 600; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                        @chat.Title
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(chat.ContextSummary))
                                    {
                                        <span style="font-size: 10px; color: var(--accent); background: var(--bg-hover); padding: 1px 5px; border-radius: 6px; font-weight: 500;">
                                            Compacted
                                        </span>
                                    }
                                </div>
                                <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
                                    <span>@chat.Messages.Count messages</span>
                                    <span style="margin: 0 4px;">·</span>
                                    <span>Updated @chat.Updated.ToLocalTime().ToString("MMM d, yyyy")</span>
                                </div>
                            </div>

                            <div style="display: flex; align-items: center; gap: 6px;">
                                <button type="button"
                                        class="btn-secondary"
                                        style="margin: 0; padding: 4px 10px; font-size: 11.5px;"
                                        @onclick="() => HandleSelect(chat.Id)"
                                        title="Open chat">
                                    Open
                                </button>
                                <button type="button"
                                        class="btn-secondary"
                                        style="margin: 0; padding: 4px 10px; font-size: 11.5px;"
                                        @onclick="() => HandleUnarchive(chat)"
                                        title="Unarchive and restore to sidebar">
                                    Unarchive
                                </button>
                                <button type="button"
                                        class="btn-subtle"
                                        style="padding: 4px 6px; color: var(--text-danger, #ef4444); border: none; background: transparent; cursor: pointer; font-size: 12px;"
                                        @onclick="() => HandleDelete(chat.Id)"
                                        title="Delete permanently">
                                    🗑️
                                </button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="text-align: center; padding: 32px 12px; border: 1px dashed var(--border-color); border-radius: var(--radius-md); background: var(--bg-panel-subtle); margin-top: 6px;">
                        <div style="font-size: 24px; margin-bottom: 6px;">📦</div>
                        <div style="font-size: 13px; font-weight: 600; color: var(--text-primary);">No archived chats</div>
                        <div style="font-size: 11.5px; color: var(--text-muted); margin-top: 2px;">
                            @(string.IsNullOrWhiteSpace(searchQuery) ? "Archived conversations will appear here." : "No archived chats match your search.")
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer" style="padding: 12px 20px; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end;">
                <button type="button" class="btn-secondary" style="margin: 0; padding: 6px 16px; font-size: 12.5px;" @onclick="Close">
                    Close
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public IReadOnlyList<Conversation> ArchivedConversations { get; set; } = [];
    [Parameter] public EventCallback<Conversation> OnUnarchiveChat { get; set; }
    [Parameter] public EventCallback<string> OnSelectChat { get; set; }
    [Parameter] public EventCallback<string> OnDeleteChat { get; set; }

    private string searchQuery = "";

    private async Task Close()
    {
        IsOpen = false;
        searchQuery = "";
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleSelect(string id)
    {
        await OnSelectChat.InvokeAsync(id);
        await Close();
    }

    private async Task HandleUnarchive(Conversation chat)
    {
        await OnUnarchiveChat.InvokeAsync(chat);
        SonnerService.Success("Chat unarchived", $"Restored '{chat.Title}' to sidebar.");
    }

    private async Task HandleDelete(string id)
    {
        await OnDeleteChat.InvokeAsync(id);
        SonnerService.Info("Chat deleted", "Archived conversation removed permanently.");
    }
}
