@using Gram.Blazor.Shared

@if (Run is not null && IsGenerating)
{
    <section class="run-status-panel" aria-live="polite">
        <button type="button" class="agent-run-status" @onclick="ToggleDetails" aria-expanded="@ShowDetails">
            <span class="agent-run-dot"></span>
            <span>@Run.StatusText</span>
            @if (Run.ToolCalls > 0)
            {
                <span class="agent-run-detail">@Run.ToolCalls tool@(Run.ToolCalls == 1 ? "" : "s")</span>
            }
            <span class="agent-run-chevron">@(ShowDetails ? "⌃" : "⌄")</span>
        </button>

        @if (ShowDetails)
        {
            <div class="agent-run-inspector">
                <div class="agent-run-inspector-head"><span>Run details</span><span class="agent-run-id">@Run.Id</span></div>
                <div class="agent-run-metrics">
                    <span><b>Model</b> @Run.ModelId</span>
                    <span><b>Iteration</b> @Run.Iteration</span>
                    <span><b>Tools</b> @Run.ToolCalls</span>
                </div>
                <div class="agent-run-events">
                    @foreach (var runEvent in Tracker.GetEvents(Run.Id, 5).AsEnumerable().Reverse())
                    {
                        <div><span>@runEvent.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span> @runEvent.Message</div>
                    }
                </div>
            </div>
        }
    </section>
}

@code {
    [Parameter] public AgentRunSnapshot? Run { get; set; }
    [Parameter] public bool IsGenerating { get; set; }
    [Parameter] public bool ShowDetails { get; set; }
    [Parameter, EditorRequired] public IAgentRunTracker Tracker { get; set; } = default!;
    [Parameter] public EventCallback<bool> ShowDetailsChanged { get; set; }

    private Task ToggleDetails() => ShowDetailsChanged.InvokeAsync(!ShowDetails);
}
