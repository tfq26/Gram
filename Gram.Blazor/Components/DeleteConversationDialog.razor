@namespace Gram.Blazor.Components
@using Gram.Blazor.Shared

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="HandleCancel" @onkeydown="HandleKeyDown" tabindex="0">
        <div class="modal-dialog-confirm delete-chat-dialog" @onclick:stopPropagation="true">
            <div class="delete-dialog-header">
                <div class="delete-dialog-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        <line x1="10" y1="11" x2="10" y2="17"></line>
                        <line x1="14" y1="11" x2="14" y2="17"></line>
                    </svg>
                </div>
                <div class="delete-dialog-titles">
                    <h3 class="delete-dialog-title">
                        @(TargetConversations.Count <= 1 ? "Delete conversation?" : $"Delete {TargetConversations.Count} conversations?")
                    </h3>
                    <p class="delete-dialog-description">
                        @if (TargetConversations.Count <= 1)
                        {
                            var title = TargetConversations.Count == 1 ? TargetConversations[0].Title : "this conversation";
                            <span>Are you sure you want to delete <strong>@title</strong>? This action cannot be undone.</span>
                        }
                        else
                        {
                            <span>Are you sure you want to delete these <strong>@TargetConversations.Count conversations</strong> and all their message histories? This action cannot be undone.</span>
                        }
                    </p>
                </div>
            </div>

            @if (TargetConversations.Count > 1)
            {
                <div class="delete-chat-preview-list">
                    @foreach (var chat in TargetConversations.Take(4))
                    {
                        <div class="delete-chat-preview-item">
                            <span class="delete-preview-dot">•</span>
                            <span class="delete-preview-title">@chat.Title</span>
                        </div>
                    }
                    @if (TargetConversations.Count > 4)
                    {
                        <div class="delete-chat-preview-more">+@(TargetConversations.Count - 4) more</div>
                    }
                </div>
            }

            <div class="delete-dialog-actions">
                <button type="button" class="btn-dialog-cancel" @onclick="HandleCancel">Cancel</button>
                <button type="button" class="btn-dialog-delete" @onclick="HandleConfirm">
                    @(TargetConversations.Count <= 1 ? "Delete" : $"Delete ({TargetConversations.Count})")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public IReadOnlyList<Conversation> TargetConversations { get; set; } = [];
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private Task HandleCancel() => OnCancel.InvokeAsync();
    private Task HandleConfirm() => OnConfirm.InvokeAsync();

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await HandleCancel();
        }
        else if (e.Key == "Enter")
        {
            await HandleConfirm();
        }
    }
}
