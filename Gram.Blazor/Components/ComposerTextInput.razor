<textarea @ref="_element"
          id="composerTextarea"
          class="composer-textarea"
          value="@Draft"
          @oninput="InputChanged"
          @onkeydown="KeyDown"
          @onkeydown:preventDefault="PreventEnter"
          placeholder="@Placeholder"
          rows="1"
          aria-label="Message Gram"></textarea>

@code {
    private ElementReference _element;

    [Parameter] public string Draft { get; set; } = "";
    [Parameter] public EventCallback<ChangeEventArgs> InputChanged { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> KeyDown { get; set; }
    [Parameter] public bool PreventEnter { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Message Gram";
    [Parameter] public EventCallback<ElementReference> ReferenceChanged { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && ReferenceChanged.HasDelegate)
            await ReferenceChanged.InvokeAsync(_element);
    }
}
