@namespace Gram.Blazor.Components
@using Gram.Blazor.Shared
@using Gram.Blazor.Components.ShadCn
@inject IGramBoxService GramBox
@inject ISubagentEngine SubagentEngine
@inject ISonnerService SonnerService
@implements IDisposable

<div class="grambox-panel" style="display: flex; flex-direction: column; gap: 14px;">
    <!-- Engine Header Card -->
    <div style="background: var(--bg-panel); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 14px; display: flex; flex-direction: column; gap: 8px;">
        <div style="display: flex; align-items: center; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-weight: 600; font-size: 13px; color: var(--text-primary);">Subagents & Sandboxes</span>
                <Badge Variant="default" Style="font-size: 10px;">Zero-RAM Worktrees</Badge>
            </div>
            <span style="font-size: 11px; color: #22c55e; font-weight: 500;">Active</span>
        </div>

        <div style="font-size: 11.5px; color: var(--text-muted); line-height: 1.4;">
            Autonomous background workers running in isolated worktrees without host resource lag.
        </div>

        <div style="display: flex; gap: 6px; margin-top: 4px;">
            <Button Variant="outline" Size="sm" OnClick="() => showNewSandboxDialog = true">
                + New Sandbox
            </Button>
        </div>
    </div>

    <!-- Active Subagents List -->
    @{
        var subagentTasks = SubagentEngine.GetTasksForConversation("default-session");
    }
    <div style="display: flex; flex-direction: column; gap: 10px;">
        <div style="display: flex; align-items: center; justify-content: space-between;">
            <span style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted);">
                Subagent Tasks (@subagentTasks.Count)
            </span>
        </div>

        @if (subagentTasks.Count == 0)
        {
            <div style="padding: 16px; text-align: center; border: 1px dashed var(--border-color); border-radius: var(--radius-md); color: var(--text-muted); font-size: 12px;">
                No subagent tasks currently running.<br />Lead agents spawn subagents dynamically during tasks.
            </div>
        }
        else
        {
            @foreach (var task in subagentTasks)
            {
                <div style="background: var(--bg-panel); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 12px; display: flex; flex-direction: column; gap: 6px;">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <span style="font-weight: 600; font-size: 12.5px; color: var(--text-primary);">@task.Role</span>
                            <Badge Variant="outline" Style="font-size: 9.5px;">@task.SubagentName</Badge>
                        </div>
                        <Badge Variant="@(task.Status == SubagentTaskStatus.Running ? "default" : task.Status == SubagentTaskStatus.Completed ? "secondary" : "destructive")" Style="font-size: 9.5px;">
                            @task.Status
                        </Badge>
                    </div>

                    <div style="font-size: 11.5px; color: var(--text-muted); line-height: 1.35;">
                        @task.Prompt
                    </div>

                    @if (!string.IsNullOrWhiteSpace(task.SandboxPath))
                    {
                        <div style="font-size: 10.5px; color: var(--text-muted);">
                            Sandbox: @task.SandboxPath
                        </div>
                    }

                    @if (task.Status == SubagentTaskStatus.Running)
                    {
                        <div style="display: flex; justify-content: flex-end; margin-top: 4px;">
                            <Button Variant="destructive" Size="sm" OnClick="() => CancelSubagentTask(task.Id)">Cancel</Button>
                        </div>
                    }
                </div>
            }
        }
    </div>

    <!-- Active Sandboxes List -->
    <div style="display: flex; flex-direction: column; gap: 10px;">
        <div style="display: flex; align-items: center; justify-content: space-between;">
            <span style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted);">
                Active Sandboxes (@GramBox.ActiveSessions.Count)
            </span>
            <a href="/sandboxes" style="font-size: 11px; color: var(--accent); text-decoration: none; font-weight: 500;">
                Open Dashboard ↗
            </a>
        </div>

        @if (GramBox.ActiveSessions.Count == 0)
        {
            <div style="padding: 24px; text-align: center; border: 1px dashed var(--border-color); border-radius: var(--radius-md); color: var(--text-muted); font-size: 12px;">
                No active worktree sandboxes.<br />Agents will automatically create worktrees or you can create one above.
            </div>
        }
        else
        {
            @foreach (var session in GramBox.ActiveSessions)
            {
                var isSelected = GramBox.ActiveSession?.Id == session.Id;
                <div class="sandbox-card @(isSelected ? "selected" : "")" 
                     style="background: var(--bg-panel); border: 1px solid @(isSelected ? "var(--accent-color, #6366f1)" : "var(--border-color)"); border-radius: var(--radius-md); padding: 12px; display: flex; flex-direction: column; gap: 8px;">
                    
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <span style="font-weight: 600; font-size: 13px; color: var(--text-primary);">@session.Name</span>
                            <Badge Variant="outline" Style="font-size: 10px;">@session.BranchName</Badge>
                        </div>
                        <Badge Variant="@(session.MajorState == SandboxMajorState.RunningCommand ? "default" : session.MajorState == SandboxMajorState.Ready ? "secondary" : "outline")" Style="font-size: 10px;">
                            @session.MajorState
                        </Badge>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(session.TaskDescription))
                    {
                        <div style="font-size: 11.5px; color: var(--text-secondary); line-height: 1.35;">
                            @session.TaskDescription
                        </div>
                    }

                    <div style="display: flex; align-items: center; justify-content: space-between; font-size: 10.5px; color: var(--text-muted);">
                        <span>📁 @session.ModifiedFiles.Count files modified</span>
                        <span>RAM: @(session.PeakWorkingSetBytes > 0 ? $"{session.PeakWorkingSetBytes / (1024 * 1024)}MB" : "0MB")</span>
                    </div>

                    @if (!string.IsNullOrEmpty(session.CurrentCommand))
                    {
                        <div style="background: var(--bg-code, #111); padding: 6px 8px; border-radius: 4px; font-size: 11px; color: #38bdf8; font-family: monospace;">
                            $ @session.CurrentCommand
                        </div>
                    }

                    <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--border-color); padding-top: 8px; margin-top: 2px;">
                        <div style="display: flex; gap: 6px;">
                            <Button Variant="outline" Size="sm" OnClick="() => ViewDiff(session)">
                                Diff
                            </Button>
                            <Button Variant="outline" Size="sm" OnClick="() => PromptExec(session)">
                                Exec
                            </Button>
                        </div>

                        <div style="display: flex; gap: 6px;">
                            <Button Variant="destructive" Size="sm" OnClick="() => CloseSandbox(session.Id)">
                                Prune
                            </Button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- New Sandbox Modal / Inline Dialog -->
    @if (showNewSandboxDialog)
    {
        <div style="background: var(--bg-panel-subtle, #1e1b2e); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 14px; display: flex; flex-direction: column; gap: 10px;">
            <span style="font-weight: 600; font-size: 13px;">Create New Parallel Worktree Sandbox</span>
            <input type="text" class="sheet-input" placeholder="Task Name (e.g. Auth System Refactor)" @bind="newTaskName" />
            <input type="text" class="sheet-input" placeholder="Optional Branch (e.g. feat/auth-v2)" @bind="newBranchName" />
            <div style="display: flex; gap: 6px; justify-content: flex-end;">
                <Button Variant="secondary" Size="sm" OnClick="() => showNewSandboxDialog = false">Cancel</Button>
                <Button Variant="default" Size="sm" OnClick="CreateNewSandbox">Create Worktree</Button>
            </div>
        </div>
    }

    <!-- Diff Viewer Modal -->
    @if (activeDiff != null)
    {
        <div style="background: var(--bg-panel); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 14px; display: flex; flex-direction: column; gap: 10px;">
            <div style="display: flex; align-items: center; justify-content: space-between;">
                <span style="font-weight: 600; font-size: 13px;">Sandbox Diff (@activeDiff.BranchName)</span>
                <Button Variant="ghost" Size="sm" OnClick="() => activeDiff = null">✕</Button>
            </div>
            <div style="font-size: 11.5px; color: var(--text-muted);">
                @activeDiff.FilesChanged files changed (+@activeDiff.Insertions / -@activeDiff.Deletions)
            </div>
            <pre style="background: #0d0b14; padding: 10px; border-radius: 6px; font-size: 11px; overflow-x: auto; max-height: 250px; color: #e2e8f0; font-family: monospace;">@activeDiff.DiffContent</pre>
        </div>
    }
</div>

@code {
    private bool showNewSandboxDialog = false;
    private string newTaskName = "";
    private string newBranchName = "";
    private SandboxDiffSummary? activeDiff = null;

    protected override void OnInitialized()
    {
        GramBox.OnStatusChanged += OnStatusChanged;
        GramBox.OnSandboxStateChanged += OnSandboxStateChanged;
        SubagentEngine.OnTaskUpdated += OnSubagentTaskUpdated;
    }

    private void OnStatusChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnSandboxStateChanged(GramBoxSandboxSession session, SandboxMajorState state) => _ = InvokeAsync(StateHasChanged);
    private void OnSubagentTaskUpdated(SubagentTask task) => _ = InvokeAsync(StateHasChanged);

    private async Task CancelSubagentTask(string taskId)
    {
        var ok = await SubagentEngine.CancelTaskAsync(taskId);
        if (ok)
        {
            SonnerService.Info("Subagent cancelled", $"Task {taskId} stopped.");
        }
    }

    private async Task CreateNewSandbox()
    {
        if (string.IsNullOrWhiteSpace(newTaskName)) return;

        try
        {
            var session = await GramBox.CreateSandboxAsync(Environment.CurrentDirectory, newBranchName, newTaskName);
            SonnerService.Success("Worktree created", $"Sandbox {session.Id} is ready on {session.BranchName}");
            showNewSandboxDialog = false;
            newTaskName = "";
            newBranchName = "";
        }
        catch (Exception ex)
        {
            SonnerService.Error("Failed to create worktree", ex.Message);
        }
    }

    private async Task ViewDiff(GramBoxSandboxSession session)
    {
        try
        {
            activeDiff = await GramBox.GetDiffAsync(session.Id);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            SonnerService.Error("Failed to load diff", ex.Message);
        }
    }

    private async Task PromptExec(GramBoxSandboxSession session)
    {
        // Quick health check execution
        var res = await GramBox.ExecuteAsync("git status --short", session.Id);
        if (res.Success)
        {
            SonnerService.Info($"Status for {session.Id}", string.IsNullOrWhiteSpace(res.Stdout) ? "Clean worktree." : res.Stdout);
        }
        else
        {
            SonnerService.Error("Execution error", res.Stderr);
        }
    }

    private async Task CloseSandbox(string sandboxId)
    {
        var ok = await GramBox.CloseSandboxAsync(sandboxId);
        if (ok)
        {
            SonnerService.Info("Sandbox removed", $"Pruned worktree {sandboxId}");
        }
    }

    public void Dispose()
    {
        GramBox.OnStatusChanged -= OnStatusChanged;
        GramBox.OnSandboxStateChanged -= OnSandboxStateChanged;
        SubagentEngine.OnTaskUpdated -= OnSubagentTaskUpdated;
    }
}
