@using Gram.Blazor.Shared

<div class="audio-device-section">
    <div class="audio-device-section-label"><span>@Title</span></div>
    @if (Devices.Count == 0)
    {
        <div class="audio-device-empty">@EmptyText</div>
    }
    else
    {
        @foreach (var device in Devices)
        {
            <button type="button" class="audio-device-option @(device.DeviceId == SelectedId ? "selected" : "")" @onclick="() => Select.InvokeAsync(device.DeviceId)">
                <span class="audio-device-option-text"><span>@Label(device)</span><small>@Title</small></span>
                @if (device.DeviceId == SelectedId) { <span class="audio-device-check" aria-hidden="true">✓</span> }
            </button>
        }
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "Device";
    [Parameter] public string EmptyText { get; set; } = "No devices detected";
    [Parameter] public IReadOnlyList<AudioDeviceInfo> Devices { get; set; } = [];
    [Parameter] public string SelectedId { get; set; } = "";
    [Parameter] public Func<AudioDeviceInfo, string> Label { get; set; } = device => device.Label;
    [Parameter] public EventCallback<string> Select { get; set; }
}
