@using Gram.Blazor.Shared

@if (IsOpen)
{
    <div class="mention-popup" role="listbox" aria-label="Add context" @onclick:stopPropagation="true">
        <div class="mention-popup-header"><span>Add context</span></div>
        <div class="mention-results">
            @if (Items.Count == 0)
            {
                <div class="mention-empty">No matching context</div>
            }
            else
            {
                @foreach (var group in Items.GroupBy(item => item.Category))
                {
                    <div class="mention-group-label">@group.Key</div>
                    @foreach (var item in group)
                    {
                        var index = Items.ToList().IndexOf(item);
                        <button type="button" id="mention-option-@index" role="option" aria-selected="@(index == SelectedIndex)" class="mention-item @(index == SelectedIndex ? "selected" : "")" @onmousedown:preventDefault="true" @onclick="() => Select.InvokeAsync(item)">
                            <span class="mention-icon">@item.Kind</span>
                            <span class="mention-copy"><span class="mention-title">@item.Title</span><span class="mention-desc">@item.Description</span></span>
                        </button>
                    }
                }
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<MentionPickerItem> Items { get; set; } = [];
    [Parameter] public int SelectedIndex { get; set; }
    [Parameter] public EventCallback<MentionPickerItem> Select { get; set; }
}
