@namespace Gram.Blazor.Components
@inject Gram.Blazor.Shared.ModelService ModelService

@if (ReasoningEffort.SupportsReasoning(ModelId))
{
    var currentEffort = ReasoningEffort.Normalize(ModelService.CurrentReasoningEffort);

    @if (Stacked)
    {
        <div class="effort-stacked-wrap @Class">
            <div class="effort-stacked-header">
                <span class="effort-caption">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                    <span>Reasoning Effort</span>
                </span>
                <span class="effort-active-val">@ReasoningEffort.GetLabel(currentEffort)</span>
            </div>

            <div class="effort-stacked-list" role="radiogroup" aria-label="Reasoning effort level">
                <button type="button"
                        class="effort-stacked-item @(currentEffort == ReasoningEffort.Low ? "active" : "")"
                        @onclick='() => SelectEffort(ReasoningEffort.Low)'
                        role="radio"
                        aria-checked="@(currentEffort == ReasoningEffort.Low)">
                    <div class="effort-stacked-indicator">
                        <span class="effort-stacked-dot"></span>
                    </div>
                    <div class="effort-stacked-main">
                        <div class="effort-stacked-row-head">
                            <span class="effort-stacked-name">Fast</span>
                            <span class="effort-stacked-badge fast">⚡ Low Latency</span>
                        </div>
                        <span class="effort-stacked-desc">Everyday intelligence · Gemini Flash Lite</span>
                    </div>
                </button>

                <button type="button"
                        class="effort-stacked-item @(currentEffort == ReasoningEffort.Medium ? "active" : "")"
                        @onclick='() => SelectEffort(ReasoningEffort.Medium)'
                        role="radio"
                        aria-checked="@(currentEffort == ReasoningEffort.Medium)">
                    <div class="effort-stacked-indicator">
                        <span class="effort-stacked-dot"></span>
                    </div>
                    <div class="effort-stacked-main">
                        <div class="effort-stacked-row-head">
                            <span class="effort-stacked-name">Balanced</span>
                            <span class="effort-stacked-badge balanced">⚖️ Agentic</span>
                        </div>
                        <span class="effort-stacked-desc">Structured tools & coding · Vercel Muse Spark</span>
                    </div>
                </button>

                <button type="button"
                        class="effort-stacked-item @(currentEffort == ReasoningEffort.High ? "active" : "")"
                        @onclick='() => SelectEffort(ReasoningEffort.High)'
                        role="radio"
                        aria-checked="@(currentEffort == ReasoningEffort.High)">
                    <div class="effort-stacked-indicator">
                        <span class="effort-stacked-dot"></span>
                    </div>
                    <div class="effort-stacked-main">
                        <div class="effort-stacked-row-head">
                            <span class="effort-stacked-name">Deep</span>
                            <span class="effort-stacked-badge deep">🧠 High Reasoning</span>
                        </div>
                        <span class="effort-stacked-desc">Extended thinking & complex architecture</span>
                    </div>
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="effort-control-wrap @(Compact ? "compact" : "") @Class" title="@ReasoningEffort.GetDescription(currentEffort)">
            <div class="effort-slider-header">
                <span class="effort-caption">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                    <span>Effort:</span>
                </span>
                <span class="effort-active-val">@ReasoningEffort.GetLabel(currentEffort)</span>
            </div>

            <div class="effort-segmented-track" role="group" aria-label="Reasoning effort level">
                <button type="button" 
                        class="effort-pill @(currentEffort == ReasoningEffort.Low ? "active" : "")" 
                        @onclick='() => SelectEffort(ReasoningEffort.Low)'
                        title="Fast · Everyday intelligence (Low latency)">
                    Fast
                </button>
                <button type="button" 
                        class="effort-pill @(currentEffort == ReasoningEffort.Medium ? "active" : "")" 
                        @onclick='() => SelectEffort(ReasoningEffort.Medium)'
                        title="Balanced · Agentic coding & structured tool output">
                    Balanced
                </button>
                <button type="button" 
                        class="effort-pill @(currentEffort == ReasoningEffort.High ? "active" : "")" 
                        @onclick='() => SelectEffort(ReasoningEffort.High)'
                        title="Deep · Complex architectural reasoning & extended thinking">
                    Deep
                </button>
            </div>
        </div>
    }
}

@code {
    [Parameter] public string? ModelId { get; set; }
    [Parameter] public bool Stacked { get; set; } = true;
    [Parameter] public bool Compact { get; set; } = false;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public EventCallback<string> OnEffortChanged { get; set; }

    private async Task SelectEffort(string effort)
    {
        ModelService.SetReasoningEffort(effort);
        if (OnEffortChanged.HasDelegate)
        {
            await OnEffortChanged.InvokeAsync(effort);
        }
    }
}
