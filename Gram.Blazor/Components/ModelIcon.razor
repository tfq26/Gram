@namespace Gram.Blazor.Components

@code {
    [Parameter] public string? Vendor { get; set; }
    [Parameter] public string? ModelId { get; set; }
    [Parameter] public int Size { get; set; } = 16;
    [Parameter] public string Class { get; set; } = "";

    private string ResolvedLogoSrc
    {
        get
        {
            var modelKey = (ModelId ?? "").Trim().ToLowerInvariant();
            var vendorKey = (Vendor ?? "").Trim().ToLowerInvariant();

            // 1. Gram flagship models (Gram Q, Gram Q+) and any Gram model ALWAYS display the Gram logo
            if (modelKey.StartsWith("gram") || modelKey.Contains("gram-q") || modelKey.Contains("gram-q-plus") ||
                vendorKey.StartsWith("gram") || (string.IsNullOrWhiteSpace(modelKey) && string.IsNullOrWhiteSpace(vendorKey)))
            {
                return "icons/gram-logo.svg";
            }

            // 2. Specific AI Provider / Vendor / Model matchers
            var combinedKey = $"{vendorKey} {modelKey}";

            if (combinedKey.Contains("google") || combinedKey.Contains("gemini"))
            {
                return "logo/gemini.svg";
            }
            if (combinedKey.Contains("groq") || combinedKey.Contains("meta") || combinedKey.Contains("llama"))
            {
                return "logo/meta-12361.svg";
            }
            if (combinedKey.Contains("anthropic") || combinedKey.Contains("claude"))
            {
                return "logo/anthropic.svg";
            }
            if (combinedKey.Contains("openai") || combinedKey.Contains("gpt-") || combinedKey.Contains("o1") || combinedKey.Contains("o3") || combinedKey.Contains("chatgpt"))
            {
                return "logo/openai-light.svg";
            }
            if (combinedKey.Contains("deepseek"))
            {
                return "logo/Deepseek-logo-icon.svg.webp";
            }
            if (combinedKey.Contains("cloudflare"))
            {
                return "logo/Cloudflare.svg";
            }
            if (combinedKey.Contains("x-ai") || combinedKey.Contains("xai") || combinedKey.Contains("grok"))
            {
                return "logo/XAI_Logo.svg.webp";
            }

            // 3. OpenRouter explicit provider
            if (vendorKey.Contains("openrouter") || modelKey.Contains("openrouter"))
            {
                return "logo/openrouter-color.svg";
            }

            // Default fallback is the Gram logo
            return "icons/gram-logo.svg";
        }
    }

    private string ResolvedAlt
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(ModelId))
            {
                var m = ModelId.ToLowerInvariant();
                if (m.StartsWith("gram") || m.Contains("gram-q")) return "Gram";
                return ModelId;
            }
            if (!string.IsNullOrWhiteSpace(Vendor)) return Vendor;
            return "Gram";
        }
    }
}

<span class="model-icon-wrap @Class" style="width: @(Size)px; height: @(Size)px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden;">
    <img src="@ResolvedLogoSrc"
         alt="@ResolvedAlt"
         width="@Size"
         height="@Size"
         style="width: 100%; height: 100%; object-fit: contain; display: block;"
         loading="lazy" />
</span>
