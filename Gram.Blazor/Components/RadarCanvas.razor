@namespace Gram.Blazor.Components
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="gram-radar-wrapper @Class" style="width: @(Size)px; height: @(Size)px; display: inline-flex; align-items: center; justify-content: center; position: relative;">
    <canvas @ref="canvasRef" class="gram-radar-canvas" style="width: 100%; height: 100%; display: block;"></canvas>
</div>

@code {
    [Parameter] public int Size { get; set; } = 32;
    [Parameter] public string SweepColor { get; set; } = "rgba(59, 130, 246, 0.35)";
    [Parameter] public string BlipColor { get; set; } = "#38bdf8";
    [Parameter] public double Speed { get; set; } = 0.045;
    [Parameter] public string Class { get; set; } = "";

    private ElementReference canvasRef;
    private bool isInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isInitialized)
        {
            try
            {
                isInitialized = true;
                await JSRuntime.InvokeVoidAsync("gramVisuals.initRadar", canvasRef, new
                {
                    radius = (Size / 2) - 2,
                    sweepColor = SweepColor,
                    blipColor = BlipColor,
                    speed = Speed
                });
            }
            catch {}
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (isInitialized)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("gramVisuals.destroy", canvasRef);
            }
            catch {}
        }
    }
}
