@namespace Gram.Blazor.Components.ShadCn

<div class="shadcn-avatar @SizeClass @Class" style="@Style">
    @if (!string.IsNullOrWhiteSpace(Src) && !hasImageError)
    {
        <img class="shadcn-avatar-image" 
             src="@Src" 
             alt="@Alt" 
             @onerror="HandleImageError" />
    }
    else
    {
        <span class="shadcn-avatar-fallback">
            @if (!string.IsNullOrWhiteSpace(Fallback))
            {
                @Fallback
            }
            else if (ChildContent != null)
            {
                @ChildContent
            }
            else
            {
                @GetDefaultInitials(Alt)
            }
        </span>
    }
</div>

@code {
    [Parameter] public string? Src { get; set; }
    [Parameter] public string? Alt { get; set; }
    [Parameter] public string? Fallback { get; set; }
    [Parameter] public string Size { get; set; } = "md"; // "sm" (24px), "md" (32px), "lg" (40px), "xl" (48px)
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool hasImageError = false;

    private string SizeClass => Size switch
    {
        "xs" => "shadcn-avatar-xs",
        "sm" => "shadcn-avatar-sm",
        "lg" => "shadcn-avatar-lg",
        "xl" => "shadcn-avatar-xl",
        _ => "shadcn-avatar-md"
    };

    private void HandleImageError()
    {
        hasImageError = true;
        StateHasChanged();
    }

    private static string GetDefaultInitials(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "G";
        var clean = text.Trim().TrimStart('@');
        return clean.Length >= 2 ? clean[..2].ToUpperInvariant() : clean.ToUpperInvariant();
    }
}
