@using Gram.Blazor.Shared

<div class="message-list" aria-live="polite">
    @if (IsLoading && Messages.Count == 0)
    {
        <MessageHistorySkeleton />
    }
    else if (Messages.Count == 0)
    {
        <div class="harness-empty-state">
            <GramCharacter Size="108" State="@(IsGenerating ? "thinking" : "idle")" AutoWaveOnLoad="true" Class="empty-state-character" />
            <h2>How can I help?</h2>
            <p>Type a message or tap the microphone to speak.</p>
        </div>
    }
    else
    {
        @foreach (var message in Messages)
        {
            @if (message.Role.Equals("user", StringComparison.OrdinalIgnoreCase))
            {
                <div class="message-entry user">
                    <div class="user-message-row">
                        <div class="message-body user-body">
                            @if (message.Mentions.Count > 0)
                            {
                                <div class="message-context-list">
                                    @foreach (var mention in message.Mentions)
                                    { <span class="message-context-item">@MentionIcon(mention.Kind)<span>@mention.Label</span></span> }
                                </div>
                            }
                            <div class="user-message-text">@message.Text</div>
                            <button type="button" class="btn-msg-edit" @onclick="() => EditMessage.InvokeAsync(message)" title="Edit prompt" aria-label="Edit prompt">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                var isLastGenerating = IsGenerating && message == Messages.LastOrDefault();
                var messageKey = message.Timestamp.Ticks.ToString();
                <div class="message-entry assistant">
                    <div class="message-header"><ModelIcon ModelId="@ActiveModelId" Size="14" /><span>Gram</span></div>
                    <div class="message-body assistant-body">
                        @if (message.ToolCalls is { Count: > 0 })
                        {
                            <div class="message-tool-calls">
                                @foreach (var tool in message.ToolCalls) { <ToolCallCard ToolCall="@tool" /> }
                            </div>
                        }
                        @if (string.IsNullOrEmpty(message.Text) && isLastGenerating && (message.ToolCalls is null || message.ToolCalls.Count == 0))
                        {
                            <div class="assistant-thinking-indicator"><GramCharacter Size="30" State="thinking" Interactive="false" AutoWaveOnLoad="false" Class="assistant-thinking-character" /><div class="thought-bubble" role="status" aria-label="Gram is formulating a response"><span class="thought-bubble-dot"></span><span class="thought-bubble-dot"></span><span class="thought-bubble-dot"></span></div></div>
                        }
                        else if (!string.IsNullOrEmpty(message.Text))
                        {
                            var stoppedInfo = ParseStoppedMessage(message.Text);
                            @if (!string.IsNullOrWhiteSpace(stoppedInfo.MainText)) { 
                                <MarkdownView Content="@stoppedInfo.MainText" /> 
                                @if (isLastGenerating)
                                {
                                    <span class="streaming-cursor-pulse" aria-hidden="true"></span>
                                }
                            }
                            @if (stoppedInfo.HasStoppedNotice) { <div class="generation-stopped-pill"><span class="stopped-indicator-dot"></span><span class="stopped-indicator-label">Generation stopped</span><span class="stopped-indicator-sep">·</span><span class="stopped-indicator-detail">@stoppedInfo.StoppedDetail</span></div> }
                        }
                        @if (!string.IsNullOrEmpty(message.ErrorDetail))
                        {
                            <div class="message-error-box">
                                <div class="error-header"><span>An error occurred while generating this response.</span></div>
                                <button type="button" class="error-details-toggle" @onclick="() => ToggleError.InvokeAsync(messageKey)">@(ExpandedErrors.Contains(messageKey) ? "Hide full error details ▲" : "View full error details ▼")</button>
                                @if (ExpandedErrors.Contains(messageKey)) { <pre class="error-details-pre">@message.ErrorDetail</pre> }
                            </div>
                        }
                    </div>
                    @if ((!string.IsNullOrEmpty(message.Text) || !string.IsNullOrEmpty(message.ErrorDetail)) && !isLastGenerating)
                    {
                        <div class="message-actions">
                            <button type="button" class="btn-msg-action @(CopiedMessageId == messageKey ? "copied" : "")" @onclick="() => CopyMessage.InvokeAsync(message)" title="Copy response">@(CopiedMessageId == messageKey ? "Copied" : "Copy")</button>
                            <button type="button" class="btn-msg-action @(SpeakingMessageId == messageKey ? "active" : "")" @onclick="() => ReadAloud.InvokeAsync(message)" title="Read aloud">@(SpeakingMessageId == messageKey ? "Stop" : "Read aloud")</button>
                            <button type="button" class="btn-msg-action" @onclick="() => RetryMessage.InvokeAsync(message)" disabled="@IsGenerating" title="Retry response">Retry</button>
                        </div>
                    }
                </div>
            }
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Message> Messages { get; set; } = [];
    [Parameter] public string ActiveModelId { get; set; } = "";
    [Parameter] public bool IsGenerating { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter, EditorRequired] public HashSet<string> ExpandedErrors { get; set; } = [];
    [Parameter] public string? CopiedMessageId { get; set; }
    [Parameter] public string? SpeakingMessageId { get; set; }
    [Parameter] public EventCallback<Message> EditMessage { get; set; }
    [Parameter] public EventCallback<string> ToggleError { get; set; }
    [Parameter] public EventCallback<Message> CopyMessage { get; set; }
    [Parameter] public EventCallback<Message> ReadAloud { get; set; }
    [Parameter] public EventCallback<Message> RetryMessage { get; set; }

    private static MarkupString MentionIcon(MentionKind kind) => new(kind switch
    {
        MentionKind.File => "<span aria-hidden='true'>▧</span>", MentionKind.Folder => "<span aria-hidden='true'>□</span>",
        MentionKind.GitDiff => "<span aria-hidden='true'>±</span>", MentionKind.GitBranch => "<span aria-hidden='true'>⑂</span>",
        MentionKind.Web => "<span aria-hidden='true'>◎</span>", MentionKind.Toolbox => "<span aria-hidden='true'>⚙</span>",
        MentionKind.Docs => "<span aria-hidden='true'>▤</span>", MentionKind.Artifact => "<span aria-hidden='true'>◆</span>",
        MentionKind.Presentation => "<span aria-hidden='true'>▣</span>", _ => "<span aria-hidden='true'>•</span>"
    });

    private static (string MainText, bool HasStoppedNotice, string? StoppedDetail) ParseStoppedMessage(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return ("", false, null);
        const string marker = "[Generation stopped]";
        var index = text.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        return index < 0 ? (text, false, null) : (text[..index].Trim(), true, text[(index + marker.Length)..].Trim(' ', '-', ':'));
    }
}
