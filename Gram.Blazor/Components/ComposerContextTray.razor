@using Gram.Blazor.Shared

@if (Mentions.Count > 0)
{
    <div class="mention-context-tray" aria-label="Selected context">
        @foreach (var mention in Mentions)
        {
            <span class="mention-context-chip">
                <span title="@mention.Target">@mention.Label</span>
                <button type="button" @onclick="() => Remove.InvokeAsync(mention.Id)" title="Remove @mention.Label" aria-label="Remove @mention.Label">✕</button>
            </span>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MentionReference> Mentions { get; set; } = [];
    [Parameter] public EventCallback<string> Remove { get; set; }
}
