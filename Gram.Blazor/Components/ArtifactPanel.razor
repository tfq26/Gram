@using Gram.Blazor.Shared

<section class="artifact-viewer" aria-label="Artifacts">
    @if (SelectedArtifact is not null)
    {
        <div class="artifact-toolbar">
            <div class="artifact-title"><span>@SelectedArtifact.FileName</span><Badge Variant="outline" Style="font-size: 10px;">@SelectedArtifact.Language</Badge></div>
            <div class="artifact-actions">
                @if (IsPlanArtifact(SelectedArtifact))
                {
                    <Button Variant="default" Size="sm" OnClick="() => ExecutePlan.InvokeAsync(SelectedArtifact)">Approve &amp; Execute</Button>
                }
                else if (WebCodingEnabled)
                {
                    <Button Variant="default" Size="sm" OnClick="() => Apply.InvokeAsync(SelectedArtifact)">Apply to Workspace</Button>
                }
                <Button Variant="secondary" Size="sm" OnClick="Back">Back</Button>
            </div>
        </div>
        @if (IsMarkup(SelectedArtifact))
        {
            <div class="artifact-live-preview">@((MarkupString)SelectedArtifact.Content)</div>
        }
        else
        {
            <pre class="artifact-code-pre">@SelectedArtifact.Content</pre>
        }
    }
    else
    {
        <div class="artifact-panel-title">Artifacts &amp; Deliverables (@Artifacts.Count)</div>
        @if (Artifacts.Count == 0)
        {
            <div class="artifact-panel-empty">No artifacts generated yet. Results appear here when Gram creates a report or interactive deliverable.</div>
        }
        else
        {
            <div class="artifact-list">
                @foreach (var artifact in Artifacts)
                {
                    <button type="button" class="artifact-list-item" @onclick="() => View.InvokeAsync(artifact)">
                        <span class="artifact-list-copy"><span>@artifact.FileName</span><small>@artifact.Title</small></span>
                        <span class="mention-badge">@artifact.Language</span>
                    </button>
                }
            </div>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ArtifactInfo> Artifacts { get; set; } = [];
    [Parameter] public ArtifactInfo? SelectedArtifact { get; set; }
    [Parameter] public bool WebCodingEnabled { get; set; }
    [Parameter] public EventCallback<ArtifactInfo> View { get; set; }
    [Parameter] public EventCallback<ArtifactInfo> Apply { get; set; }
    [Parameter] public EventCallback<ArtifactInfo> ExecutePlan { get; set; }
    [Parameter] public EventCallback Back { get; set; }

    private static bool IsMarkup(ArtifactInfo artifact) => artifact.Language?.Equals("html", StringComparison.OrdinalIgnoreCase) == true || artifact.FileName.EndsWith(".html", StringComparison.OrdinalIgnoreCase) || artifact.FileName.EndsWith(".svg", StringComparison.OrdinalIgnoreCase);
    private static bool IsPlanArtifact(ArtifactInfo artifact) => artifact.FileName.EndsWith("plan.md", StringComparison.OrdinalIgnoreCase) || artifact.Title?.Contains("plan", StringComparison.OrdinalIgnoreCase) == true;
}
