@namespace Gram.Blazor.Components
@using Gram.Blazor.Shared

<section class="conversation-rail" aria-label="Conversations" @onkeydown="HandleRailKeyDown" tabindex="0">
    <div class="rail-header-actions" style="display: flex; gap: 6px;">
        <button class="btn-new-chat" type="button" style="flex: 1;" @onclick="HandleNewChat">
            + New chat
        </button>
        <button class="btn-subtle" type="button" title="New Project" aria-label="New Project"
                style="padding: 0 10px; height: 36px; border: 1px solid var(--border-color); border-radius: var(--radius-sm); background: var(--bg-panel-subtle); color: var(--text-primary); cursor: pointer; display: flex; align-items: center; justify-content: center;"
                @onclick="HandleNewProject">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                <line x1="12" y1="11" x2="12" y2="17"></line>
                <line x1="9" y1="14" x2="15" y2="14"></line>
            </svg>
        </button>
    </div>

    @if (IsLoading && Conversations.Count == 0)
    {
        <ConversationListSkeleton Count="5" />
    }
    else
    {
        <div class="conversation-list" role="list">
            <!-- Projects Section -->
            @if (Projects.Count > 0)
            {
                <div class="rail-section-header" style="display: flex; align-items: center; justify-content: space-between; padding: 8px 8px 4px 8px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted);">
                    <span>Projects</span>
                    <button type="button" style="background: transparent; border: none; color: var(--text-muted); cursor: pointer; padding: 2px 4px; font-size: 12px; border-radius: var(--radius-sm);"
                            title="Create Project" @onclick="HandleNewProject">+</button>
                </div>

                @foreach (var proj in Projects)
                {
                    var isExpanded = expandedProjectIds.Contains(proj.Id);
                    var projectChats = Conversations.Where(c => c.ProjectId == proj.Id && !c.IsArchived).ToList();
                    var projColor = !string.IsNullOrWhiteSpace(proj.Color) ? proj.Color : "#8b5cf6";

                    <div class="project-folder-group" style="margin-bottom: 2px;">
                        <div class="project-folder-header"
                             style="display: flex; align-items: center; justify-content: space-between; padding: 6px 8px; border-radius: var(--radius-sm); cursor: pointer; user-select: none; transition: background 0.12s ease; gap: 6px;"
                             @onclick="() => ToggleProjectExpand(proj.Id)">
                            <div style="display: flex; align-items: center; gap: 7px; min-width: 0; flex: 1;">
                                <span style="font-size: 10px; color: var(--text-muted); transition: transform 0.15s ease; transform: @(isExpanded ? "rotate(90deg)" : "rotate(0deg)");">▶</span>
                                <div style="width: 8px; height: 8px; border-radius: 50%; background: @projColor; flex-shrink: 0;"></div>
                                <span style="font-size: 12.5px; font-weight: 600; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@proj.Name</span>
                            </div>

                            <div style="display: flex; align-items: center; gap: 4px;" @onclick:stopPropagation="true">
                                <span style="font-size: 10.5px; color: var(--text-muted); background: var(--bg-hover); padding: 1px 5px; border-radius: 10px;">@projectChats.Count</span>
                                <button type="button" class="btn-subtle" style="border: none; background: transparent; color: var(--text-muted); cursor: pointer; padding: 2px 4px; font-size: 11px;"
                                        title="Project settings & knowledge" @onclick="() => OnEditProject.InvokeAsync(proj)">⚙</button>
                            </div>
                        </div>

                        @if (isExpanded)
                        {
                            <div class="project-chats-list" style="padding-left: 14px; border-left: 1.5px solid var(--border-color); margin-left: 11px; margin-top: 2px; margin-bottom: 4px;">
                                @if (projectChats.Count == 0)
                                {
                                    <div style="padding: 4px 8px; font-size: 11px; color: var(--text-muted); display: flex; align-items: center; justify-content: space-between;">
                                        <span>No chats yet</span>
                                        <button type="button" style="background: transparent; border: none; color: var(--accent); cursor: pointer; font-size: 11px; font-weight: 500;"
                                                @onclick="() => HandleNewChatInProject(proj)">+ Chat</button>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var chat in projectChats)
                                    {
                                        var index = Conversations.ToList().IndexOf(chat);
                                        var isMultiSelected = selectedIds.Contains(chat.Id);
                                        var isActive = chat.Id == ActiveId && selectedIds.Count <= 1;

                                        <div class="conversation-item @(isActive ? "active" : "") @(isMultiSelected ? "is-selected" : "")"
                                             role="listitem"
                                             tabindex="0"
                                             aria-current="@(isActive ? "page" : null)"
                                             @onclick="e => HandleItemClick(e, chat, index)"
                                             @onkeydown="e => HandleConversationKeyDown(e, chat, index)"
                                             @oncontextmenu="e => HandleContextMenu(e, chat)"
                                             @oncontextmenu:preventDefault="true">
                                            
                                            <div class="conv-meta">
                                                <span class="conv-title">@chat.Title</span>
                                                <span class="conv-time">@chat.Updated.ToLocalTime().ToString("MMM d")</span>
                                            </div>

                                            @if (Conversations.Count > 1 && selectedIds.Count <= 1)
                                            {
                                                <button class="conv-delete" type="button" title="Delete" aria-label="Delete @chat.Title"
                                                        @onclick:stopPropagation="true" @onclick="() => HandleSingleDeleteClick(chat.Id)">✕</button>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }

                <div class="rail-section-header" style="padding: 10px 8px 4px 8px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted);">
                    <span>Chats</span>
                </div>
            }

            <!-- General / Unassigned Chats -->
            @{
                var unassignedChats = Conversations.Where(c => string.IsNullOrEmpty(c.ProjectId) && !c.IsArchived).ToList();
            }

            @for (var i = 0; i < unassignedChats.Count; i++)
            {
                var chat = unassignedChats[i];
                var index = Conversations.ToList().IndexOf(chat);
                var isMultiSelected = selectedIds.Contains(chat.Id);
                var isActive = chat.Id == ActiveId && selectedIds.Count <= 1;

                <div class="conversation-item @(isActive ? "active" : "") @(isMultiSelected ? "is-selected" : "")"
                     role="listitem"
                     tabindex="0"
                     aria-current="@(isActive ? "page" : null)"
                     @onclick="e => HandleItemClick(e, chat, index)"
                     @onkeydown="e => HandleConversationKeyDown(e, chat, index)"
                     @oncontextmenu="e => HandleContextMenu(e, chat)"
                     @oncontextmenu:preventDefault="true">
                    
                    <div class="conv-meta">
                        <span class="conv-title">@chat.Title</span>
                        <span class="conv-time">@chat.Updated.ToLocalTime().ToString("MMM d")</span>
                    </div>

                    @if (Conversations.Count > 1 && selectedIds.Count <= 1)
                    {
                        <button class="conv-delete" type="button" title="Delete" aria-label="Delete @chat.Title"
                                @onclick:stopPropagation="true" @onclick="() => HandleSingleDeleteClick(chat.Id)">✕</button>
                    }
                </div>
            }

            @{
                var archivedCount = Conversations.Count(c => c.IsArchived);
            }
            @if (archivedCount > 0)
            {
                <div style="margin-top: 10px; padding: 6px 4px; border-top: 1px solid var(--border-color);">
                    <button type="button" class="btn-subtle" style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 6px 8px; border-radius: var(--radius-sm); border: none; background: transparent; color: var(--text-muted); font-size: 11.5px; cursor: pointer;"
                            @onclick="HandleOpenArchived">
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <span>📦</span>
                            <span>Archived chats</span>
                        </div>
                        <span style="background: var(--bg-hover); padding: 1px 5px; border-radius: 8px; font-size: 10.5px;">@archivedCount</span>
                    </button>
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Conversation> Conversations { get; set; } = [];
    [Parameter] public IReadOnlyList<Project> Projects { get; set; } = [];
    [Parameter] public string ActiveId { get; set; } = "";
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback OnNewConversation { get; set; }
    [Parameter] public EventCallback OnCreateProject { get; set; }
    [Parameter] public EventCallback<Project> OnEditProject { get; set; }
    [Parameter] public EventCallback<Project> OnNewChatInProject { get; set; }
    [Parameter] public EventCallback OnOpenArchivedChats { get; set; }
    [Parameter] public EventCallback<string> OnSelectConversation { get; set; }
    [Parameter] public EventCallback<string> OnDeleteConversation { get; set; }
    [Parameter] public EventCallback<List<string>> OnDeleteMultiple { get; set; }
    [Parameter] public EventCallback<ConversationContextMenu> OnContextMenu { get; set; }

    public sealed record ConversationContextMenu(MouseEventArgs Event, Conversation Conversation, IReadOnlyList<string>? SelectedIds = null);

    private readonly HashSet<string> selectedIds = [];
    private readonly HashSet<string> expandedProjectIds = [];
    private int anchorIndex = -1;

    protected override void OnParametersSet()
    {
        // Auto-expand the project of the currently active chat
        var activeChat = Conversations.FirstOrDefault(c => c.Id == ActiveId);
        if (activeChat != null && !string.IsNullOrWhiteSpace(activeChat.ProjectId))
        {
            expandedProjectIds.Add(activeChat.ProjectId);
        }
    }

    private void ToggleProjectExpand(string projectId)
    {
        if (expandedProjectIds.Contains(projectId))
        {
            expandedProjectIds.Remove(projectId);
        }
        else
        {
            expandedProjectIds.Add(projectId);
        }
    }

    private async Task HandleNewChat()
    {
        selectedIds.Clear();
        anchorIndex = -1;
        await OnNewConversation.InvokeAsync();
    }

    private async Task HandleNewProject()
    {
        await OnCreateProject.InvokeAsync();
    }

    private async Task HandleNewChatInProject(Project project)
    {
        expandedProjectIds.Add(project.Id);
        await OnNewChatInProject.InvokeAsync(project);
    }

    private async Task HandleOpenArchived()
    {
        await OnOpenArchivedChats.InvokeAsync();
    }

    public void ClearSelection()
    {
        selectedIds.Clear();
        anchorIndex = -1;
        StateHasChanged();
    }

    private async Task HandleContextMenu(MouseEventArgs e, Conversation chat)
    {
        if (selectedIds.Contains(chat.Id) && selectedIds.Count > 1)
        {
            await OnContextMenu.InvokeAsync(new ConversationContextMenu(e, chat, selectedIds.ToList()));
        }
        else
        {
            selectedIds.Clear();
            selectedIds.Add(chat.Id);
            anchorIndex = Conversations.ToList().FindIndex(c => c.Id == chat.Id);
            StateHasChanged();
            await OnContextMenu.InvokeAsync(new ConversationContextMenu(e, chat, [chat.Id]));
        }
    }

    private async Task HandleItemClick(MouseEventArgs e, Conversation chat, int index)
    {
        if (e.ShiftKey)
        {
            var start = anchorIndex >= 0 ? anchorIndex : GetActiveIndex();
            var min = Math.Min(start, index);
            var max = Math.Max(start, index);

            selectedIds.Clear();
            for (var i = min; i <= max && i < Conversations.Count; i++)
            {
                selectedIds.Add(Conversations[i].Id);
            }
            StateHasChanged();
            return;
        }

        if (e.CtrlKey || e.MetaKey)
        {
            ToggleItemSelection(chat.Id, index);
            return;
        }

        if (selectedIds.Count > 0)
        {
            selectedIds.Clear();
        }
        anchorIndex = index;
        await OnSelectConversation.InvokeAsync(chat.Id);
    }

    private void ToggleItemSelection(string id, int index)
    {
        if (selectedIds.Contains(id))
        {
            selectedIds.Remove(id);
        }
        else
        {
            selectedIds.Add(id);
            anchorIndex = index;
        }
        StateHasChanged();
    }

    private int GetActiveIndex()
    {
        for (var i = 0; i < Conversations.Count; i++)
        {
            if (Conversations[i].Id == ActiveId) return i;
        }
        return 0;
    }

    private async Task HandleSingleDeleteClick(string id)
    {
        selectedIds.Remove(id);
        await OnDeleteConversation.InvokeAsync(id);
    }

    private async Task HandleBulkDelete()
    {
        if (selectedIds.Count > 0)
        {
            var ids = selectedIds.ToList();
            selectedIds.Clear();
            anchorIndex = -1;
            await OnDeleteMultiple.InvokeAsync(ids);
        }
    }

    private async Task HandleConversationKeyDown(KeyboardEventArgs args, Conversation chat, int index)
    {
        if (args.Key is "Enter" or " ")
        {
            await OnSelectConversation.InvokeAsync(chat.Id);
        }
        else if (args.Key is "Delete" or "Backspace")
        {
            if (selectedIds.Count > 1 && selectedIds.Contains(chat.Id))
            {
                await HandleBulkDelete();
            }
            else
            {
                await OnDeleteConversation.InvokeAsync(chat.Id);
            }
        }
    }

    private void HandleRailKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            ClearSelection();
        }
    }
}
