@namespace Gram.Blazor.Components
@using Gram.Blazor.Shared
@using Gram.Blazor.Components.ShadCn
@inject IJSRuntime JSRuntime

<div class="code-file-viewer @CustomClass">
    <!-- Header Bar -->
    <div class="code-file-header">
        <div class="code-file-meta">
            <span class="code-file-lang-badge">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="code-icon">
                    <polyline points="16 18 22 12 16 6"></polyline>
                    <polyline points="8 6 2 12 8 18"></polyline>
                </svg>
                <span>@DisplayLanguage</span>
            </span>
            @if (!string.IsNullOrWhiteSpace(FileName))
            {
                <span class="code-file-name" title="@FileName">@FileName</span>
            }
            @if (ShowStats && LineCount > 0)
            {
                <span class="code-file-stats">@LineCount lines</span>
            }
        </div>

        <div class="code-file-actions">
            @if (AllowWrapToggle)
            {
                <button type="button" 
                        class="code-action-btn @(isWrapped ? "active" : "")" 
                        @onclick="() => isWrapped = !isWrapped" 
                        title="@(isWrapped ? "Disable line wrap" : "Enable line wrap")">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="17 10 21 14 17 18"></polyline>
                        <path d="M3 6h18"></path>
                        <path d="M3 14h15a3 3 0 0 1 0 6H3"></path>
                    </svg>
                </button>
            }

            <button type="button" 
                    class="code-action-btn copy-btn @(isCopied ? "copied" : "")" 
                    @onclick="CopyContent" 
                    title="Copy code to clipboard">
                @if (isCopied)
                {
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Copied!</span>
                }
                else
                {
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                    </svg>
                    @if (ShowCopyLabel)
                    {
                        <span>Copy</span>
                    }
                }
            </button>
        </div>
    </div>

    <!-- Code Editor / Pre Content -->
    <div class="code-file-body @(isWrapped ? "wrap-lines" : "nowrap-lines")">
        @if (ShowLineNumbers)
        {
            <div class="code-gutter" aria-hidden="true">
                @for (int i = 1; i <= LineCount; i++)
                {
                    <span class="gutter-num">@i</span>
                }
            </div>
        }
        <pre class="code-content-pre"><code class="language-@(Language?.ToLowerInvariant() ?? "plaintext")">@Content</code></pre>
    </div>
</div>

@code {
    [Parameter] public string Content { get; set; } = "";
    [Parameter] public string? FileName { get; set; }
    [Parameter] public string? Language { get; set; }
    [Parameter] public bool ShowLineNumbers { get; set; } = true;
    [Parameter] public bool ShowStats { get; set; } = true;
    [Parameter] public bool ShowCopyLabel { get; set; } = false;
    [Parameter] public bool AllowWrapToggle { get; set; } = true;
    [Parameter] public string CustomClass { get; set; } = "";

    private bool isWrapped = false;
    private bool isCopied = false;

    private int LineCount => string.IsNullOrEmpty(Content) ? 0 : Content.Split('\n').Length;

    private string DisplayLanguage
    {
        get
        {
            var raw = Language;
            if (string.IsNullOrWhiteSpace(raw) && !string.IsNullOrWhiteSpace(FileName))
            {
                var ext = Path.GetExtension(FileName).TrimStart('.').ToLowerInvariant();
                raw = ext;
            }

            return (raw?.ToLowerInvariant()) switch
            {
                "cs" or "csharp" => "C#",
                "cpp" or "c++" => "C++",
                "c" => "C",
                "js" or "javascript" => "JavaScript",
                "ts" or "typescript" => "TypeScript",
                "py" or "python" => "Python",
                "html" => "HTML",
                "css" => "CSS",
                "scss" => "SCSS",
                "json" => "JSON",
                "xml" => "XML",
                "yaml" or "yml" => "YAML",
                "sql" => "SQL",
                "sh" or "bash" or "shell" or "zsh" => "Bash",
                "powershell" or "ps1" => "PowerShell",
                "dockerfile" or "docker" => "Dockerfile",
                "rust" or "rs" => "Rust",
                "go" or "golang" => "Go",
                "razor" => "Razor",
                "md" or "markdown" => "Markdown",
                _ => string.IsNullOrWhiteSpace(raw) ? "Code" : raw
            };
        }
    }

    private async Task CopyContent()
    {
        if (string.IsNullOrEmpty(Content)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("gramAudio.copyMessageText", Content);
            isCopied = true;
            StateHasChanged();
            await Task.Delay(2000);
            isCopied = false;
            StateHasChanged();
        }
        catch {}
    }
}
