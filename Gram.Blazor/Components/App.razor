<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="theme-color" content="#09090b" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="shadcn.css" />
    <link rel="stylesheet" href="app.css?v=20260828n" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
    <link rel="icon" type="image/svg+xml" href="icons/gram-logo.svg" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <div id="components-reconnect-modal" class="components-reconnect-modal" role="status" aria-live="polite">
        <div class="reconnect-hud-banner">
            <div class="reconnect-hud-header">
                <div class="reconnect-state-show">
                    <span class="reconnect-dot"></span>
                    <span class="reconnect-label">Reconnecting</span>
                    <span id="reconnect-countdown-text" class="reconnect-timer">18s</span>
                </div>
                <div class="reconnect-state-failed">
                    <span class="reconnect-dot failed"></span>
                    <span class="reconnect-label failed">Disconnected</span>
                </div>
                <div class="reconnect-actions">
                    <button type="button" id="reconnect-toggle-btn" class="reconnect-btn-subtle" onclick="window.__gramToggleReconnectDetails()">Details</button>
                    <button type="button" class="reconnect-btn-action" onclick="location.reload()">Reload</button>
                </div>
            </div>

            <div id="reconnect-details-drawer" class="reconnect-details-drawer">
                <div class="reconnect-diag-body">
                    <div class="reconnect-diag-meta">
                        <span id="reconnect-diag-subsystem">SignalR Circuit</span>
                        <span class="reconnect-diag-sep">·</span>
                        <span id="reconnect-diag-net">Online</span>
                        <span class="reconnect-diag-sep">·</span>
                        <span id="reconnect-diag-time">--:--</span>
                    </div>
                    <div id="reconnect-diag-detail" class="reconnect-diag-code">Connection to server was interrupted.</div>
                    <div class="reconnect-diag-actions">
                        <button type="button" id="reconnect-copy-btn" class="reconnect-btn-copy" onclick="window.__gramCopyDiagnostics()">Copy</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <Routes @rendermode="InteractiveServer" />
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/mermaid@11.4.0/dist/mermaid.min.js"></script>
    <script src="audio.js?v=20260828c"></script>
    <script src="passkey.js?v=20260828f"></script>
    <script src="tabDrag.js"></script>
    <script src="loginArtwork.js?v=20260828l"></script>
    <script src="gramVisuals.js"></script>
    <script src="gramCharacter.js?v=20260828m"></script>
    <script src="reconnectHandler.js?v=20260828a"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
