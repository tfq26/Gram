<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="theme-color" content="#09090b" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="shadcn.css" />
    <link rel="stylesheet" href="app.css?v=20260828n" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
    <link rel="icon" type="image/svg+xml" href="icons/gram-logo.svg" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <div id="components-reconnect-modal" class="components-reconnect-modal" role="status" aria-live="polite">
        <div class="reconnect-hud-banner">
            <div class="reconnect-hud-header">
                <div class="reconnect-state-show">
                    <span class="reconnect-pulse-dot"></span>
                    <div class="reconnect-title-group">
                        <span class="reconnect-text-alert">Reconnecting to Gram</span>
                        <span id="reconnect-countdown-text" class="reconnect-meta-text">(18s timeout)</span>
                    </div>
                </div>
                <div class="reconnect-state-failed">
                    <svg class="reconnect-alert-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <div class="reconnect-title-group">
                        <span class="reconnect-text-alert">Connection Lost</span>
                        <span class="reconnect-meta-text">Session timed out</span>
                    </div>
                </div>
                <div class="reconnect-actions">
                    <button type="button" id="reconnect-toggle-btn" class="reconnect-btn-toggle" onclick="window.__gramToggleReconnectDetails()">View diagnostics ▼</button>
                    <button type="button" class="reconnect-btn-reload" onclick="location.reload()">Reload</button>
                </div>
            </div>

            <div id="reconnect-details-drawer" class="reconnect-details-drawer">
                <div class="reconnect-diag-grid">
                    <div class="reconnect-diag-row">
                        <span class="reconnect-diag-label">Target Subsystem:</span>
                        <span id="reconnect-diag-subsystem" class="reconnect-diag-value highlight">SignalR Realtime Circuit</span>
                    </div>
                    <div class="reconnect-diag-row">
                        <span class="reconnect-diag-label">Network State:</span>
                        <span id="reconnect-diag-net" class="reconnect-diag-value">Online (Checking connection)</span>
                    </div>
                    <div class="reconnect-diag-row">
                        <span class="reconnect-diag-label">Last Error Timestamp:</span>
                        <span id="reconnect-diag-time" class="reconnect-diag-value">--:--:--</span>
                    </div>
                    <div class="reconnect-diag-row column">
                        <span class="reconnect-diag-label">Diagnostic Exception:</span>
                        <div id="reconnect-diag-detail" class="reconnect-diag-pre">Server connection dropped. Attempting to re-establish WebSocket session...</div>
                    </div>
                </div>
                <div class="reconnect-recovery-steps">
                    <span class="reconnect-steps-title">Recommended Actions:</span>
                    <ol class="reconnect-steps-list">
                        <li>Click <strong>Reload</strong> above to establish a fresh session.</li>
                        <li>Check if your network or VPN disconnected.</li>
                        <li>Verify that the backend server is running and accessible.</li>
                    </ol>
                </div>
                <div class="reconnect-drawer-footer">
                    <button type="button" id="reconnect-copy-btn" class="reconnect-btn-copy" onclick="window.__gramCopyDiagnostics()">Copy Diagnostic Report</button>
                </div>
            </div>
        </div>
    </div>
    <Routes @rendermode="InteractiveServer" />
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/mermaid@11.4.0/dist/mermaid.min.js"></script>
    <script src="audio.js?v=20260828c"></script>
    <script src="passkey.js?v=20260828f"></script>
    <script src="tabDrag.js"></script>
    <script src="loginArtwork.js?v=20260828l"></script>
    <script src="gramVisuals.js"></script>
    <script src="gramCharacter.js?v=20260828m"></script>
    <script src="reconnectHandler.js?v=20260828a"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
