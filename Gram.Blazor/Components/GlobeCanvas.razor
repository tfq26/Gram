@namespace Gram.Blazor.Components
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="gram-globe-wrapper @Class" style="width: @(Size)px; height: @(Size)px; display: inline-flex; align-items: center; justify-content: center; position: relative;">
    <canvas @ref="canvasRef" class="gram-globe-canvas" style="width: 100%; height: 100%; display: block;"></canvas>
</div>

@code {
    [Parameter] public int Size { get; set; } = 48;
    [Parameter] public int PointCount { get; set; } = 180;
    [Parameter] public string AccentColor { get; set; } = "#3b82f6";
    [Parameter] public double RotationSpeed { get; set; } = 0.01;
    [Parameter] public bool Glow { get; set; } = true;
    [Parameter] public bool Interactive { get; set; } = true;
    [Parameter] public string Class { get; set; } = "";

    private ElementReference canvasRef;
    private bool isInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isInitialized)
        {
            try
            {
                isInitialized = true;
                await JSRuntime.InvokeVoidAsync("gramVisuals.initGlobe", canvasRef, new
                {
                    radius = (Size / 2) - 4,
                    pointCount = PointCount,
                    accentColor = AccentColor,
                    rotationSpeed = RotationSpeed,
                    glow = Glow,
                    interactive = Interactive
                });
            }
            catch {}
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (isInitialized)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("gramVisuals.destroy", canvasRef);
            }
            catch {}
        }
    }
}
