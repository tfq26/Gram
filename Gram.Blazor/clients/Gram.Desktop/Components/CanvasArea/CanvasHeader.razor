@namespace Gram.Desktop.Components.CanvasArea
@using Gram.Desktop.Components.Platform
@using Gram.Desktop.Services
@using Gram.Blazor.Shared
@inject IPlatformService Platform
@inject WorkspaceTabService TabService
@inject IJSRuntime JSRuntime
@inject DesktopSession Session

<header class="dt-canvas-header" data-ui-region="canvas-header">
    <!-- Tabs Region -->
    <div class="dt-canvas-tabs-container" data-ui-region="canvas-tabs">
        <div class="dt-tabs-scroll-area" @ref="tabsScrollRef">
            @foreach (var tab in TabService.OpenTabs)
            {
                var isCurrent = TabService.ActiveTabId == tab.Id;
                var isMultiSelected = selectedTabIds.Contains(tab.Id);
                <div class="dt-tab @(isCurrent ? "active" : "") @(isMultiSelected ? "selected" : "")"
                     @onclick="(e) => HandleTabClick(e, tab)"
                     @oncontextmenu="(e) => HandleTabContextMenu(e, tab)"
                     @oncontextmenu:preventDefault="true"
                     title="@tab.Title">
                    @if (tab.IsPinned)
                    {
                        <span class="dt-tab-pin-icon" title="Pinned tab">📌</span>
                    }
                    <span class="dt-tab-title">@tab.Title</span>
                    @if (TabService.OpenTabs.Count > 1 && !tab.IsPinned)
                    {
                        <button type="button"
                                class="dt-tab-close"
                                @onclick:stopPropagation="true"
                                @onclick="() => HandleCloseTab(tab)"
                                title="Close tab">✕</button>
                    }
                </div>
            }

            <button type="button"
                    class="dt-tab-new-btn"
                    @onclick="HandleNewChatTab"
                    title="New chat tab">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
            </button>

            @if (Session.IsLocalAgentConnected && Session.LocalAgentCapabilities.Any(c => c.Name == "terminal.run"))
            {
                <button type="button"
                        class="dt-tab-new-btn"
                        @onclick="HandleOpenTerminalTab"
                        title="Open Terminal (Local Agent)"
                        style="margin-left: 2px;">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="4 17 10 11 4 5"></polyline>
                        <line x1="12" y1="19" x2="20" y2="19"></line>
                    </svg>
                </button>
            }
        </div>
    </div>

    <!-- Chat Title Group & Workspace Badge -->
    <div class="dt-canvas-title-group">
        <button type="button" class="dt-workspace-badge" @onclick="() => OnOpenWorkspacePicker.InvokeAsync()" title="Active Workspace: @Session.WorkspacePath">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
            </svg>
            <span class="dt-workspace-name">@GetWorkspaceFolderName()</span>
        </button>
        <h1 class="dt-canvas-title">
            @(string.IsNullOrWhiteSpace(Conversation?.Title) ? "New Chat" : Conversation.Title)
        </h1>
    </div>
</header>

<!-- Tab Context Menu -->
@if (isContextMenuOpen && contextMenuTab != null)
{
    <div class="dt-context-backdrop" @onclick="CloseContextMenu"></div>
    <div class="dt-context-menu" style="left: @(contextMenuX)px; top: @(contextMenuY)px;" @onclick:stopPropagation="true">
        <div class="dt-context-header">
            <span class="dt-context-title">@contextMenuTab.Title</span>
            @if (selectedTabIds.Count > 1)
            {
                <span class="dt-context-badge">@selectedTabIds.Count selected</span>
            }
        </div>
        <div class="dt-context-separator"></div>

        @if (selectedTabIds.Count > 1)
        {
            <button type="button" class="dt-context-item" @onclick="HandleCloseSelectedTabs">
                <span>Close @selectedTabIds.Count Selected Tabs</span>
            </button>
        }
        else
        {
            <button type="button" class="dt-context-item" @onclick="() => HandleCloseTab(contextMenuTab)">
                <span>Close Tab</span>
            </button>
        }

        <button type="button" class="dt-context-item" @onclick="HandleCloseOthers">
            <span>Close Others</span>
        </button>

        <button type="button" class="dt-context-item" @onclick="HandleCloseToTheRight">
            <span>Close to the Right</span>
        </button>

        <button type="button" class="dt-context-item destructive" @onclick="HandleCloseAllTabs">
            <span>Close All</span>
        </button>

        <div class="dt-context-separator"></div>

        <button type="button" class="dt-context-item" @onclick="HandleTogglePin">
            <span>@(contextMenuTab.IsPinned ? "Unpin Tab" : "Pin Tab")</span>
        </button>

        <button type="button" class="dt-context-item" @onclick="HandleDuplicateTab">
            <span>Duplicate Tab</span>
        </button>

        <div class="dt-context-separator"></div>

        <button type="button" class="dt-context-item" @onclick="HandleCopyAllTabTitles">
            <span>Copy All Tab Titles</span>
        </button>

        <button type="button" class="dt-context-item" @onclick="HandleAddTabToChat">
            <span>Add to Chat</span>
        </button>
    </div>
}

@code {
    [Parameter] public ConversationDetail? Conversation { get; set; }
    [Parameter] public IReadOnlyList<ConversationSummary>? Conversations { get; set; }
    [Parameter] public EventCallback<string> OnSelectConversation { get; set; }
    [Parameter] public EventCallback OnNewConversation { get; set; }
    [Parameter] public EventCallback OnOpenWorkspacePicker { get; set; }
    [Parameter] public EventCallback<ConversationSummary> OnAddReferencedChat { get; set; }

    private ElementReference tabsScrollRef;
    private HashSet<string> selectedTabIds = new();
    private string? lastSelectedTabId = null;
    private bool isContextMenuOpen = false;
    private WorkspaceTab? contextMenuTab;
    private double contextMenuX = 0;
    private double contextMenuY = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("gramDesktop.enableTabsWheel", tabsScrollRef);
            }
            catch {}
        }
    }

    private string GetWorkspaceFolderName()
    {
        try
        {
            var p = Session.WorkspacePath;
            if (string.IsNullOrWhiteSpace(p)) return "Workspace";
            var name = Path.GetFileName(p.TrimEnd('/', '\\'));
            return string.IsNullOrWhiteSpace(name) ? p : name;
        }
        catch
        {
            return "Workspace";
        }
    }

    private void HandleOpenTerminalTab()
    {
        TabService.OpenTerminalTab();
    }

    private async Task HandleNewChatTab()
    {
        await OnNewConversation.InvokeAsync();
    }

    private async Task HandleTabClick(MouseEventArgs e, WorkspaceTab tab)
    {
        CloseContextMenu();

        if (e.CtrlKey || e.MetaKey)
        {
            if (selectedTabIds.Contains(tab.Id))
                selectedTabIds.Remove(tab.Id);
            else
                selectedTabIds.Add(tab.Id);
            lastSelectedTabId = tab.Id;
        }
        else if (e.ShiftKey && lastSelectedTabId != null)
        {
            var allTabs = TabService.OpenTabs;
            var idx1 = allTabs.FindIndex(t => t.Id == lastSelectedTabId);
            var idx2 = allTabs.FindIndex(t => t.Id == tab.Id);
            if (idx1 >= 0 && idx2 >= 0)
            {
                var min = Math.Min(idx1, idx2);
                var max = Math.Max(idx1, idx2);
                for (int i = min; i <= max; i++)
                {
                    selectedTabIds.Add(allTabs[i].Id);
                }
            }
        }
        else
        {
            selectedTabIds.Clear();
            selectedTabIds.Add(tab.Id);
            lastSelectedTabId = tab.Id;
            TabService.SelectTab(tab.Id);
            if (!string.IsNullOrWhiteSpace(tab.ChatId))
            {
                await OnSelectConversation.InvokeAsync(tab.ChatId);
            }
        }
    }

    private void HandleTabContextMenu(MouseEventArgs e, WorkspaceTab tab)
    {
        contextMenuTab = tab;
        if (!selectedTabIds.Contains(tab.Id))
        {
            selectedTabIds.Clear();
            selectedTabIds.Add(tab.Id);
        }
        contextMenuX = Math.Min(e.ClientX, 700);
        contextMenuY = Math.Min(e.ClientY, 500);
        isContextMenuOpen = true;
    }

    private void CloseContextMenu()
    {
        isContextMenuOpen = false;
        contextMenuTab = null;
    }

    private void HandleCloseTab(WorkspaceTab tab)
    {
        TabService.CloseTab(tab.Id);
        selectedTabIds.Remove(tab.Id);
        CloseContextMenu();
    }

    private void HandleCloseSelectedTabs()
    {
        if (selectedTabIds.Count > 0)
        {
            TabService.CloseTabs(selectedTabIds);
            selectedTabIds.Clear();
        }
        CloseContextMenu();
    }

    private void HandleCloseOthers()
    {
        if (contextMenuTab != null)
        {
            TabService.CloseOthers(contextMenuTab.Id);
            selectedTabIds.Clear();
            selectedTabIds.Add(contextMenuTab.Id);
        }
        CloseContextMenu();
    }

    private void HandleCloseToTheRight()
    {
        if (contextMenuTab != null)
        {
            TabService.CloseToTheRight(contextMenuTab.Id);
            selectedTabIds.Clear();
            selectedTabIds.Add(contextMenuTab.Id);
        }
        CloseContextMenu();
    }

    private void HandleCloseAllTabs()
    {
        TabService.CloseAll();
        selectedTabIds.Clear();
        CloseContextMenu();
    }

    private void HandleTogglePin()
    {
        if (contextMenuTab != null)
        {
            TabService.TogglePinTab(contextMenuTab.Id);
        }
        CloseContextMenu();
    }

    private void HandleDuplicateTab()
    {
        if (contextMenuTab != null)
        {
            TabService.DuplicateTab(contextMenuTab.Id);
        }
        CloseContextMenu();
    }

    private async Task HandleCopyAllTabTitles()
    {
        var titles = string.Join("\n", TabService.OpenTabs.Select(t => $"- {t.Title} (ID: {t.ChatId})"));
        await JSRuntime.InvokeVoidAsync("gramDesktop.copyText", titles);
        CloseContextMenu();
    }

    private async Task HandleAddTabToChat()
    {
        if (contextMenuTab != null)
        {
            var targetIds = selectedTabIds.Count > 0 ? selectedTabIds : new HashSet<string> { contextMenuTab.Id };
            foreach (var tId in targetIds)
            {
                var tab = TabService.OpenTabs.FirstOrDefault(t => t.Id == tId);
                if (tab != null && !string.IsNullOrWhiteSpace(tab.ChatId))
                {
                    var matching = Conversations?.FirstOrDefault(c => c.Id == tab.ChatId);
                    if (matching != null)
                    {
                        await OnAddReferencedChat.InvokeAsync(matching);
                    }
                    else
                    {
                        var now = DateTimeOffset.UtcNow;
                        await OnAddReferencedChat.InvokeAsync(new ConversationSummary(tab.ChatId, tab.Title, now, now, null, 0, 0));
                    }
                }
            }
        }
        CloseContextMenu();
    }
}
