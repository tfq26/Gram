    private void HandleEffortChanged(string effort)
    {
        var normalized = ReasoningEffort.Normalize(effort);
        switch (normalized)
        {
            case ReasoningEffort.Low:
                CompanionTasks.TriggerAnimation("caffeine_rush", 2800, "Fast mode engaged! Warp speed intelligence. ⚡");
                break;
            case ReasoningEffort.Medium:
                CompanionTasks.TriggerAnimation("matrix_zen", 2800, "Balanced mode active. Focused & steady. ⚖️");
                break;
            case ReasoningEffort.High:
                CompanionTasks.TriggerAnimation("mind_blown", 3200, "Deep reasoning unlocked! Extended neural thinking. 🧠");
                break;
        }
    }

    private void ToggleReferencePicker()
    {
        isReferencePickerOpen = !isReferencePickerOpen;
        if (isReferencePickerOpen)
        {
            isModelPickerOpen = false;
            isFilePickerOpen = false;
            isSuggestionsOpen = false;
        }
    }

    private void HandleRefSearch(ChangeEventArgs e)
    {
        refSearchQuery = e.Value?.ToString() ?? "";
    }

    private void ToggleReferenceChat(ConversationSummary chat)
    {
        var existing = referencedChats.FirstOrDefault(r => r.Id == chat.Id);
        if (existing != null)
            referencedChats.Remove(existing);
        else
            referencedChats.Add(chat);
    }

    private void ToggleFilePicker()
    {
        isFilePickerOpen = !isFilePickerOpen;
        if (isFilePickerOpen)
        {
            isModelPickerOpen = false;
            isReferencePickerOpen = false;
            isSuggestionsOpen = false;
            filePickerInput = "";
            filePickerError = null;
        }
    }

    private async Task HandleFilePickerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await PickFileFromLocalAgent();
        }
    }

    private async Task PickFileFromLocalAgent()
    {
        if (string.IsNullOrWhiteSpace(filePickerInput) || isPickingFile) return;
        isPickingFile = true;
        filePickerError = null;
        try
        {
            var res = await Session.PickWorkspaceFileAsync(filePickerInput.Trim());
            if (res.Success && !string.IsNullOrEmpty(res.FilePath))
            {
                pickedFiles.Add(res);
                filePickerInput = "";
                isFilePickerOpen = false;
            }
            else
            {
                filePickerError = res.Error ?? "Failed to pick file from workspace.";
            }
        }
        catch (Exception ex)
        {
            filePickerError = ex.Message;
        }
        finally
        {
            isPickingFile = false;
        }
    }

    private void ToggleVoice()
    {
        isVoiceActive = !isVoiceActive;
    }

    private void HandleInput(ChangeEventArgs e)
    {
        inputText = e.Value?.ToString() ?? "";

        // Check slash command trigger
        if (inputText.StartsWith("/"))
        {
            var spaceIdx = inputText.IndexOf(' ');
            if (spaceIdx < 0)
            {
                suggestionMode = SuggestionMode.SlashCommand;
                currentQuery = inputText[1..];
                isSuggestionsOpen = true;
                selectedSuggestionIndex = 0;
                return;
            }
        }

        // Check mention (@) trigger
        var atIdx = inputText.LastIndexOf('@');
        if (atIdx >= 0 && (atIdx == 0 || char.IsWhiteSpace(inputText[atIdx - 1])))
        {
            var queryAfterAt = inputText[(atIdx + 1)..];
            if (!queryAfterAt.Contains(' ') && !queryAfterAt.Contains('\n'))
            {
                suggestionMode = SuggestionMode.Mention;
                currentQuery = queryAfterAt;
                isSuggestionsOpen = true;
                selectedSuggestionIndex = 0;

                if (cachedFiles.Count == 0)
                {
                    _ = PreloadWorkspaceFilesAsync();
                }
                return;
            }
        }

        CloseSuggestions();
    }

    [JSInvokable]
    public async Task OnEnterFromJs(string currentValue)
    {
        if (isSuggestionsOpen && FilteredSuggestions.Count > 0)
        {
            if (selectedSuggestionIndex >= 0 && selectedSuggestionIndex < FilteredSuggestions.Count)
            {
                await SelectSuggestion(FilteredSuggestions[selectedSuggestionIndex]);
            }
            return;
        }

        if (!string.IsNullOrEmpty(currentValue))
        {
            inputText = currentValue;
        }

        await HandleSubmit();
    }

    [JSInvokable]
    public async Task OnSelectSuggestionFromJs()
    {
        if (isSuggestionsOpen && FilteredSuggestions.Count > 0)
        {
            if (selectedSuggestionIndex >= 0 && selectedSuggestionIndex < FilteredSuggestions.Count)
            {
                await SelectSuggestion(FilteredSuggestions[selectedSuggestionIndex]);
            }
        }
    }

    [JSInvokable]
    public void OnArrowKeyFromJs(int direction)
    {
        if (isSuggestionsOpen && FilteredSuggestions.Count > 0)
        {
            selectedSuggestionIndex = (selectedSuggestionIndex + direction + FilteredSuggestions.Count) % FilteredSuggestions.Count;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnEscapeFromJs()
    {
        if (isSuggestionsOpen)
        {
            CloseSuggestions();
            StateHasChanged();
        }
    }

    public async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(inputText) || IsStreaming) return;
        var text = inputText.Trim();
        inputText = "";
        CloseSuggestions();

        if (referencedChats.Count > 0)
        {
            var refs = string.Join("\n", referencedChats.Select(r => $"[Referenced Context: Chat \"{r.Title}\" (ID: {r.Id}) - user referenced this past conversation for context]"));
            text = $"{refs}\n\n{text}";
            referencedChats.Clear();
        }

        if (pickedFiles.Count > 0)
        {
            var files = string.Join("\n\n", pickedFiles.Select(f =>
                $"[Attached Workspace File: {f.FilePath}]\n```\n{(f.Content?.Length > 3000 ? f.Content[..3000] + "\n...[truncated]" : f.Content)}\n```"));
            text = $"{files}\n\n{text}";
            pickedFiles.Clear();
        }

        if (replyingTo != null)
        {
            var preview = replyingTo.Text.Length > 100 ? replyingTo.Text[..100] + "…" : replyingTo.Text;
            var author = replyingTo.Role.Equals("user", StringComparison.OrdinalIgnoreCase) ? "User" : "Gram";
            text = $"> [Replying to {author}: {preview.Replace("\r", "").Replace("\n", " ")}]\n\n{text}";
            replyingTo = null;
        }

        _ = JSRuntime.InvokeVoidAsync("gramDesktop.resetComposerHeight", textareaRef);
        StateHasChanged();

        await OnSendMessage.InvokeAsync(text);
    }

    public async ValueTask DisposeAsync()
    {
        Session.ComposerPromptRequested -= HandleComposerPromptRequested;
        Session.StateChanged -= HandleSessionStateChanged;
        ModelService.OnChange -= HandleModelServiceChanged;
        if (dotNetHelper != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("gramDesktop.disposeComposer", textareaRef);
            }
            catch {}
            dotNetHelper.Dispose();
            dotNetHelper = null;
        }
        await Task.CompletedTask;
    }
}
