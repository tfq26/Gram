    private bool isBrowsingModels = false;

    private void ToggleModelPicker()
    {
        isModelPickerOpen = !isModelPickerOpen;
        if (isModelPickerOpen)
        {
            isBrowsingModels = false;
            isReferencePickerOpen = false;
            isFilePickerOpen = false;
