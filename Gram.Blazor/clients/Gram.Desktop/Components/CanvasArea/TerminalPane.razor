@namespace Gram.Desktop.Components.CanvasArea
@using Gram.Desktop.Services
@using Gram.Blazor.Shared
@inject DesktopSession Session
@inject WorkspaceTabService TabService

<div class="dt-terminal-view">
    <!-- Header: Minimal Zed/Linear bar without status lights or connected text -->
    <div class="dt-terminal-header">
        <div class="dt-terminal-title">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="dt-terminal-icon">
                <polyline points="4 17 10 11 4 5"></polyline>
                <line x1="12" y1="19" x2="20" y2="19"></line>
            </svg>
            <span class="dt-terminal-name">Terminal</span>
            @if (!string.IsNullOrWhiteSpace(Session.WorkspacePath))
            {
                <span class="dt-terminal-sep">·</span>
                <span class="dt-terminal-cwd" title="@Session.WorkspacePath">@GetCleanWorkspaceName()</span>
            }
        </div>

        <div class="dt-terminal-actions">
            @if (isTerminalRunning)
            {
                <div class="dt-terminal-spinner" title="Executing command..."></div>
            }
            @if (terminalHistory.Count > 0)
            {
                <button type="button" class="dt-terminal-action-btn" @onclick="() => terminalHistory.Clear()" title="Clear terminal output">
                    Clear
                </button>
            }
        </div>
    </div>

    <!-- Output Buffer: Continuous monospace terminal buffer, no cards -->
    <div class="dt-terminal-output" @ref="terminalScrollRef">
        @if (terminalHistory.Count == 0)
        {
            <div class="dt-terminal-buffer-info">
                <span>Workspace: @(string.IsNullOrWhiteSpace(Session.WorkspacePath) ? "No folder open" : Session.WorkspacePath)</span>
            </div>
        }
        else
        {
            @foreach (var entry in terminalHistory)
            {
                <div class="dt-terminal-entry">
                    <div class="dt-terminal-cmd-row">
                        <span class="dt-terminal-prompt">❯</span>
                        <span class="dt-terminal-cmd">@entry.Command</span>
                        <span class="dt-terminal-meta">
                            @if (entry.ExitCode != 0)
                            {
                                <span class="dt-terminal-exit error">exit @entry.ExitCode</span>
                            }
                            <span class="dt-terminal-time">@entry.ElapsedMs ms</span>
                        </span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(entry.Stdout))
                    {
                        <pre class="dt-terminal-stdout">@entry.Stdout</pre>
                    }
                    @if (!string.IsNullOrWhiteSpace(entry.Stderr))
                    {
                        <pre class="dt-terminal-stderr">@entry.Stderr</pre>
                    }
                </div>
            }
        }
    </div>

    <!-- Command Input Bar: Clean command line prompt with history navigation -->
    <div class="dt-terminal-input-bar">
        <span class="dt-terminal-prompt">❯</span>
        <input type="text"
               class="dt-terminal-input"
               placeholder="Type a command..."
               @bind="terminalInput"
               @bind:event="oninput"
               @onkeydown="HandleTerminalKeyDown"
               disabled="@isTerminalRunning"
               autofocus />
        @if (isTerminalRunning)
        {
            <span class="dt-terminal-running-label">Running...</span>
        }
    </div>
</div>

@code {
    private sealed record TerminalHistoryEntry(string Command, int ExitCode, string Stdout, string Stderr, long ElapsedMs, DateTimeOffset Timestamp);
    private readonly List<TerminalHistoryEntry> terminalHistory = new();
    private string terminalInput = "";
    private bool isTerminalRunning = false;
    private ElementReference terminalScrollRef;
    private int historyIndex = -1;
    private string temporaryInput = "";

    private string GetCleanWorkspaceName()
    {
        if (string.IsNullOrWhiteSpace(Session.WorkspacePath)) return "";
        var name = Path.GetFileName(Session.WorkspacePath.TrimEnd('/', '\\'));
        return string.IsNullOrWhiteSpace(name) ? Session.WorkspacePath : name;
    }

    private async Task HandleTerminalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await ExecuteTerminalCommand();
        }
        else if (e.Key == "ArrowUp")
        {
            if (terminalHistory.Count > 0)
            {
                if (historyIndex == -1)
                {
                    temporaryInput = terminalInput;
                    historyIndex = terminalHistory.Count - 1;
                }
                else if (historyIndex > 0)
                {
                    historyIndex--;
                }
                terminalInput = terminalHistory[historyIndex].Command;
            }
        }
        else if (e.Key == "ArrowDown")
        {
            if (historyIndex != -1)
            {
                if (historyIndex < terminalHistory.Count - 1)
                {
                    historyIndex++;
                    terminalInput = terminalHistory[historyIndex].Command;
                }
                else
                {
                    historyIndex = -1;
                    terminalInput = temporaryInput;
                }
            }
        }
    }

    private async Task ExecuteTerminalCommand()
    {
        var cmd = terminalInput.Trim();
        if (string.IsNullOrWhiteSpace(cmd) || isTerminalRunning) return;

        isTerminalRunning = true;
        terminalInput = "";
        historyIndex = -1;
        temporaryInput = "";
        try
        {
            var result = await Session.RunTerminalCommandAsync(cmd);
            terminalHistory.Add(new TerminalHistoryEntry(cmd, result.ExitCode, result.Stdout, result.Stderr, result.ElapsedMilliseconds, DateTimeOffset.UtcNow));
        }
        catch (Exception ex)
        {
            terminalHistory.Add(new TerminalHistoryEntry(cmd, -1, "", ex.Message, 0, DateTimeOffset.UtcNow));
        }
        finally
        {
            isTerminalRunning = false;
        }
    }
}
