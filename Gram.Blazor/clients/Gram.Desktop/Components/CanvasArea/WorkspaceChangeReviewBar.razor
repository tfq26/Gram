@namespace Gram.Desktop.Components.CanvasArea
@using Gram.Blazor.Shared
@using System.Text.Json.Nodes
@inject DesktopSession Session

@if (Visible && Items.Count > 0)
{
    <div class="dt-change-review-bar @(isReverted ? "is-reverted" : "")">
        <div class="dt-change-review-info">
            <span class="dt-change-review-title">
                @(isReverted ? "Changes reverted" : $"Modified {Items.Count} file{(Items.Count > 1 ? "s" : "")}")
            </span>
            <div class="dt-change-review-chips">
                @foreach (var file in Items)
                {
                    <span class="dt-change-chip" title="@file.FilePath">
                        <span class="dt-change-chip-name">@GetShortFileName(file.FilePath)</span>
                        @if (file.Additions > 0)
                        {
                            <span class="dt-change-chip-stat add">+@file.Additions</span>
                        }
                        @if (file.Deletions > 0)
                        {
                            <span class="dt-change-chip-stat del">-@file.Deletions</span>
                        }
                    </span>
                }
            </div>
        </div>

        <div class="dt-change-review-actions">
            @if (isReverted)
            {
                <span class="dt-change-reverted-text">Original versions restored</span>
                <button type="button" class="dt-change-btn-dismiss" @onclick="Dismiss" title="Dismiss banner">✕</button>
            }
            else
            {
                <button type="button" class="dt-change-btn revert @(isReverting ? "is-busy" : "")" @onclick="RevertAllAsync" disabled="@isReverting" title="Rollback all changes made in this run" aria-label="Revert Run">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
                    <span class="dt-change-btn-label">@(isReverting ? "Reverting..." : "Revert")</span>
                </button>
                <button type="button" class="dt-change-btn accept" @onclick="AcceptAll" title="Accept all changes and dismiss review" aria-label="Accept All">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span class="dt-change-btn-label">Accept All</span>
                </button>
                <button type="button" class="dt-change-btn commit @(isCommitting ? "is-busy" : "")" @onclick="ToggleCommitModal" title="Generate AI semantic commit message and commit to Git" aria-label="Commit Changes">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <circle cx="12" cy="12" r="4"></circle>
                        <line x1="1.05" y1="12" x2="7" y2="12"></line>
                        <line x1="17.01" y1="12" x2="22.96" y2="12"></line>
                    </svg>
                    <span class="dt-change-btn-label">Commit...</span>
                </button>
            }
        </div>
    </div>

    @if (isCommitModalOpen)
    {
        <div class="dt-commit-popover">
            <div class="dt-commit-popover-header">
                <span>AI Semantic Commit</span>
                <button type="button" class="dt-commit-close" @onclick="() => isCommitModalOpen = false">✕</button>
            </div>
            <div class="dt-commit-popover-body">
                <input type="text" class="dt-commit-input" @bind="commitMessage" placeholder="Conventional commit message..." />
                <button type="button" class="dt-commit-submit-btn" @onclick="ExecuteCommitAsync" disabled="@(isCommitting || string.IsNullOrWhiteSpace(commitMessage))">
                    @(isCommitting ? "Committing..." : "Commit Changes")
                </button>
            </div>
            @if (!string.IsNullOrEmpty(commitStatusMessage))
            {
                <div class="dt-commit-status @(commitFailed ? "error" : "success")">
                    @commitStatusMessage
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public List<ToolCallInfo>? ToolCalls { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }

    public sealed record ModifiedFileItem(string FilePath, string CheckpointId, int Additions, int Deletions);

    private bool isDismissed = false;
    private bool isReverting = false;
    private bool isReverted = false;
    private bool isCommitModalOpen = false;
    private bool isCommitting = false;
    private bool commitFailed = false;
    private string commitMessage = "";
    private string commitStatusMessage = "";
    private string? _lastToolCallsHash;

    private void ToggleCommitModal()
    {
        isCommitModalOpen = !isCommitModalOpen;
        if (isCommitModalOpen && string.IsNullOrWhiteSpace(commitMessage))
        {
            var filePaths = Items.Select(i => i.FilePath).ToList();
            commitMessage = DiffEngine.GenerateConventionalCommitMessage(filePaths);
        }
    }

    private async Task ExecuteCommitAsync()
    {
        if (string.IsNullOrWhiteSpace(commitMessage) || isCommitting) return;
        isCommitting = true;
        commitStatusMessage = "";
        commitFailed = false;

        try
        {
            var ws = Session.WorkspacePath;
            if (string.IsNullOrWhiteSpace(ws) || !Directory.Exists(ws))
            {
                ws = Environment.CurrentDirectory;
            }

            var runner = new NativeProcessRunner();
            var addRes = await runner.ExecuteAsync(new ProcessExecutionOptions
            {
                CommandLine = "git add -A",
                WorkingDirectory = ws,
                WorkspaceRoot = ws,
                TimeoutSeconds = 15
            });

            if (addRes.ExitCode != 0)
            {
                commitFailed = true;
                commitStatusMessage = $"Failed to stage changes: {addRes.StandardError}";
                return;
            }

            var cleanMsg = commitMessage.Replace("\"", "\\\"");
            var commitRes = await runner.ExecuteAsync(new ProcessExecutionOptions
            {
                CommandLine = $"git commit -m \"{cleanMsg}\"",
                WorkingDirectory = ws,
                WorkspaceRoot = ws,
                TimeoutSeconds = 15
            });

            if (commitRes.ExitCode == 0)
            {
                commitStatusMessage = $"Committed: {commitMessage}";
                commitFailed = false;
                await Task.Delay(1200);
                isCommitModalOpen = false;
                isDismissed = true;
                await OnDismiss.InvokeAsync();
            }
            else
            {
                commitFailed = true;
                commitStatusMessage = commitRes.CombinedOutput.Trim();
            }
        }
        catch (Exception ex)
        {
            commitFailed = true;
            commitStatusMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isCommitting = false;
            StateHasChanged();
        }
    }

    private bool Visible => !isDismissed && Items.Count > 0;

    private List<ModifiedFileItem> Items
    {
        get
        {
            if (ToolCalls == null || ToolCalls.Count == 0) return [];
            var list = new List<ModifiedFileItem>();
            foreach (var tc in ToolCalls)
            {
                if (string.IsNullOrWhiteSpace(tc.ToolName) || tc.IsError || string.IsNullOrWhiteSpace(tc.Result)) continue;
                var name = tc.ToolName.ToLowerInvariant();
                var isEditOrWrite = name.Contains("edit") || name.Contains("write") || name.Contains("replace") || name.Contains("patch") || name.Contains("create_file") || name.Contains("modify_file");
                if (!isEditOrWrite) continue;

                var match = System.Text.RegularExpressions.Regex.Match(tc.Result, @"\[Checkpoint:\s*(chk-[a-zA-Z0-9]+)\]");
                var cpId = match.Success ? match.Groups[1].Value : "";

                var filePath = "";
                var target = "";
                var replacement = "";
                try
                {
                    if (!string.IsNullOrWhiteSpace(tc.Arguments))
                    {
                        var node = JsonNode.Parse(tc.Arguments);
                        filePath = node?["filePath"]?.ToString() 
                                ?? node?["path"]?.ToString() 
                                ?? node?["TargetFile"]?.ToString() 
                                ?? node?["target_file"]?.ToString() 
                                ?? node?["file"]?.ToString() 
                                ?? "";
                        target = node?["targetContent"]?.ToString() ?? node?["TargetContent"]?.ToString() ?? "";
                        replacement = node?["replacementContent"]?.ToString() ?? node?["ReplacementContent"]?.ToString() ?? node?["content"]?.ToString() ?? node?["CodeContent"]?.ToString() ?? "";
                    }
                }
                catch {}

                if (string.IsNullOrWhiteSpace(filePath))
                {
                    var pathMatch = System.Text.RegularExpressions.Regex.Match(tc.Result, @"(?:wrote|created|edited|modified)\s+(?:to\s+)?([^\s\[]+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                    if (pathMatch.Success) filePath = pathMatch.Groups[1].Value;
                }

                if (string.IsNullOrWhiteSpace(filePath)) filePath = "modified-file";

                var additions = 0;
                var deletions = 0;
                if (!string.IsNullOrEmpty(target) || !string.IsNullOrEmpty(replacement))
                {
                    var diff = DiffEngine.ComputeDiff(filePath, target, replacement);
                    additions = diff.AdditionsCount;
                    deletions = diff.DeletionsCount;
                }
                else if (tc.Result.Contains("@@") || tc.Result.Contains("[diff_block_start]"))
                {
                    var diff = DiffEngine.ParseUnifiedDiff(tc.Result, filePath);
                    if (diff != null)
                    {
                        additions = diff.AdditionsCount;
                        deletions = diff.DeletionsCount;
                    }
                }

                var existing = list.FirstOrDefault(x => string.Equals(x.FilePath, filePath, StringComparison.OrdinalIgnoreCase));
                if (existing != null)
                {
                    var idx = list.IndexOf(existing);
                    var preservedCpId = !string.IsNullOrEmpty(existing.CheckpointId) ? existing.CheckpointId : cpId;
                    list[idx] = new ModifiedFileItem(filePath, preservedCpId, existing.Additions + additions, existing.Deletions + deletions);
                }
                else
                {
                    list.Add(new ModifiedFileItem(filePath, cpId, additions, deletions));
                }
            }
            return list;
        }
    }

    protected override void OnParametersSet()
    {
        var currentHash = ToolCalls == null ? "" : $"{ToolCalls.Count}_{string.Join(",", ToolCalls.Select(t => t.Id))}";
        if (currentHash != _lastToolCallsHash)
        {
            _lastToolCallsHash = currentHash;
            isDismissed = false;
            isReverted = false;
        }
    }

    private async Task RevertAllAsync()
    {
        if (isReverting || isReverted) return;
        isReverting = true;
        try
        {
            var files = Items;
            for (int i = files.Count - 1; i >= 0; i--)
            {
                if (!string.IsNullOrWhiteSpace(files[i].CheckpointId))
                {
                    await Session.RollbackCheckpointAsync(files[i].CheckpointId);
                }
            }
            isReverted = true;
        }
        catch {}
        finally
        {
            isReverting = false;
            StateHasChanged();
        }
    }

    private void AcceptAll()
    {
        isDismissed = true;
        if (OnDismiss.HasDelegate) OnDismiss.InvokeAsync();
    }

    private void Dismiss()
    {
        isDismissed = true;
        if (OnDismiss.HasDelegate) OnDismiss.InvokeAsync();
    }

    private static string GetShortFileName(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return "";
        var parts = path.Split(new[] { '/', '\\' }, StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 0 ? parts[^1] : path;
    }
}
