@namespace Gram.Desktop.Components.CanvasArea
@using Gram.Desktop.Components
@using Gram.Blazor.Shared
@using System.Text.Json.Nodes

@if (ToolCalls != null && ToolCalls.Count > 0)
{
    @if (ToolCalls.Count == 1)
    {
        <div class="dt-toolcalls-stack">
            <DesktopToolCard ToolCall="@ToolCalls[0]" />
        </div>
    }
    else
    {
        var hasError = ToolCalls.Any(t => t.IsError);
        var isRunning = ToolCalls.Any(t => string.IsNullOrWhiteSpace(t.Result) && !t.IsError);
        var groupSentence = GetGroupSentence(isRunning);
        var subgroups = BuildSubgroups();

        <div class="dt-toolgroup @(hasError ? "has-error" : (isRunning ? "is-running" : "is-complete")) @(isExpanded ? "is-expanded" : "")">
            <div class="dt-toolgroup-header" @onclick="ToggleExpand" role="button" tabindex="0" title="Click to @(isExpanded ? "collapse" : "view") @ToolCalls.Count steps">
                <div class="dt-toolgroup-meta">
                    <span class="dt-toolgroup-title">
                        @groupSentence
                    </span>
                </div>

                <div class="dt-toolgroup-controls">
                    <span class="dt-toolgroup-chevron @(isExpanded ? "expanded" : "")">
                        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </span>
                </div>
            </div>

            @if (isExpanded)
            {
                <div class="dt-toolgroup-items">
                    @foreach (var group in subgroups)
                    {
                        var isSubExpanded = expandedSubgroups.Contains(group.Key);
                        <div class="dt-tool-subgroup @(group.HasError ? "has-error" : "") @(group.IsRunning ? "is-running" : "") @(isSubExpanded ? "is-expanded" : "")">
                            <div class="dt-tool-subgroup-row" @onclick="() => ToggleSubgroup(group.Key)" role="button" tabindex="0">
                                <div class="dt-tool-subgroup-left">
                                    <span class="dt-tool-subgroup-icon @group.Category">
                                        @if (group.Category == "read")
                                        {
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                <polyline points="14 2 14 8 20 8"></polyline>
                                            </svg>
                                        }
                                        else if (group.Category == "edit")
                                        {
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                            </svg>
                                        }
                                        else if (group.Category == "command")
                                        {
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="4 17 10 11 4 5"></polyline>
                                                <line x1="12" y1="19" x2="20" y2="19"></line>
                                            </svg>
                                        }
                                        else if (group.Category == "sandbox")
                                        {
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                                <line x1="12" y1="22.08" x2="12" y2="12"></line>
                                            </svg>
                                        }
                                        else if (group.Category == "web")
                                        {
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <line x1="2" y1="12" x2="22" y2="12"></line>
                                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <line x1="12" y1="16" x2="12" y2="12"></line>
                                                <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                            </svg>
                                        }
                                    </span>
                                    <span class="dt-tool-subgroup-title">@group.Title</span>
                                    @if (!string.IsNullOrWhiteSpace(group.Description))
                                    {
                                        <span class="dt-tool-subgroup-desc" title="@group.Description">@group.Description</span>
                                    }
                                </div>

                                <div class="dt-tool-subgroup-right">
                                    <span class="dt-tool-subgroup-chevron @(isSubExpanded ? "expanded" : "")">
                                        <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                            <polyline points="9 18 15 12 9 6"></polyline>
                                        </svg>
                                    </span>
                                </div>
                            </div>

                            @if (isSubExpanded)
                            {
                                <div class="dt-tool-subgroup-cards">
                                    @foreach (var tool in group.Items)
                                    {
                                        <DesktopToolCard ToolCall="@tool" />
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public List<ToolCallInfo> ToolCalls { get; set; } = [];

    private bool isExpanded = false;
    private bool userToggled = false;
    private readonly HashSet<string> expandedSubgroups = [];

    public sealed class ToolSubgroup
    {
        public string Key { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Badge { get; set; } = "";
        public string Category { get; set; } = "other";
        public bool HasError { get; set; }
        public bool IsRunning { get; set; }
        public List<ToolCallInfo> Items { get; set; } = [];
    }

    protected override void OnParametersSet()
    {
        if (!userToggled)
        {
            var hasError = ToolCalls.Any(t => t.IsError);
            var isRunning = ToolCalls.Any(t => string.IsNullOrWhiteSpace(t.Result) && !t.IsError);
            if (hasError || isRunning)
            {
                isExpanded = true;
            }
        }
    }

    private void ToggleExpand()
    {
        isExpanded = !isExpanded;
        userToggled = true;
    }

    private void ToggleSubgroup(string key)
    {
        if (expandedSubgroups.Contains(key))
        {
            expandedSubgroups.Remove(key);
        }
        else
        {
            expandedSubgroups.Add(key);
        }
    }

    private List<ToolSubgroup> BuildSubgroups()
    {
        var result = new List<ToolSubgroup>();

        // 1. Group tools by high-level category
        var readTools = ToolCalls.Where(t => IsReadTool(t.ToolName)).ToList();
        var editTools = ToolCalls.Where(t => IsEditTool(t.ToolName)).ToList();
        var cmdTools = ToolCalls.Where(t => IsCommandTool(t.ToolName)).ToList();
        var sandboxTools = ToolCalls.Where(t => IsSandboxTool(t.ToolName)).ToList();
        var webTools = ToolCalls.Where(t => IsWebTool(t.ToolName)).ToList();
        var otherTools = ToolCalls.Except(readTools).Except(editTools).Except(cmdTools).Except(sandboxTools).Except(webTools).ToList();

        if (readTools.Count > 0)
        {
            var fileTools = readTools.Where(t => !t.ToolName.Equals("list_directory", StringComparison.OrdinalIgnoreCase)).ToList();
            var dirTools = readTools.Where(t => t.ToolName.Equals("list_directory", StringComparison.OrdinalIgnoreCase)).ToList();
            var files = fileTools.Select(ExtractFileName).Where(f => !string.IsNullOrEmpty(f)).Distinct().ToList();
            var dirs = dirTools.Select(ExtractDirectoryName).Where(d => !string.IsNullOrEmpty(d)).Distinct().ToList();

            string title;
            if (files.Count > 0 && dirs.Count > 0)
                title = $"Read {files.Count} file{(files.Count == 1 ? "" : "s")} & mapped {dirs.Count} director{(dirs.Count == 1 ? "y" : "ies")}";
            else if (files.Count > 0)
                title = $"Read {files.Count} file{(files.Count == 1 ? "" : "s")}";
            else
                title = $"Mapped {dirs.Count} director{(dirs.Count == 1 ? "y" : "ies")}";

            var previewItems = files.Concat(dirs.Select(d => $"{d}/")).ToList();
            var desc = previewItems.Count > 0 ? string.Join(", ", previewItems.Take(4)) + (previewItems.Count > 4 ? $" +{previewItems.Count - 4} more" : "") : "";

            result.Add(new ToolSubgroup
            {
                Key = "read",
                Title = title,
                Description = desc,
                Badge = $"{readTools.Count} operations",
                Category = "read",
                HasError = readTools.Any(t => t.IsError),
                IsRunning = readTools.Any(t => string.IsNullOrWhiteSpace(t.Result) && !t.IsError),
                Items = readTools
            });
        }

        if (editTools.Count > 0)
        {
            var files = editTools.Select(ExtractFileName).Where(f => !string.IsNullOrEmpty(f)).Distinct().ToList();
            var title = $"Modified & created {files.Count} file{(files.Count == 1 ? "" : "s")}";
            var desc = files.Count > 0 ? string.Join(", ", files.Take(4)) + (files.Count > 4 ? $" +{files.Count - 4} more" : "") : "";

            result.Add(new ToolSubgroup
            {
                Key = "edit",
                Title = title,
                Description = desc,
                Badge = $"{editTools.Count} edits",
                Category = "edit",
                HasError = editTools.Any(t => t.IsError),
                IsRunning = editTools.Any(t => string.IsNullOrWhiteSpace(t.Result) && !t.IsError),
                Items = editTools
            });
        }

        if (cmdTools.Count > 0)
        {
            var cmds = cmdTools.Select(ExtractCommandText).Where(c => !string.IsNullOrEmpty(c)).ToList();
            var title = $"Ran {cmdTools.Count} command{(cmdTools.Count == 1 ? "" : "s")}";
            var desc = cmds.Count > 0 ? string.Join(", ", cmds.Select(c => c.Length > 28 ? c[..28] + "…" : c).Take(3)) : "";

            result.Add(new ToolSubgroup
            {
                Key = "command",
                Title = title,
                Description = desc,
                Badge = $"{cmdTools.Count} commands",
                Category = "command",
                HasError = cmdTools.Any(t => t.IsError),
                IsRunning = cmdTools.Any(t => string.IsNullOrWhiteSpace(t.Result) && !t.IsError),
                Items = cmdTools
            });
        }

        if (sandboxTools.Count > 0)
        {
            var sbs = sandboxTools.Select(ExtractSandboxId).Where(s => !string.IsNullOrEmpty(s)).Distinct().ToList();
            var desc = sbs.Count > 0 ? $"Isolated worktree {string.Join(", ", sbs)}" : "Environment diagnostics & workspace isolation";

            result.Add(new ToolSubgroup
            {
                Key = "sandbox",
                Title = "Sandbox verification & isolation",
                Description = desc,
                Badge = $"{sandboxTools.Count} steps",
                Category = "sandbox",
                HasError = sandboxTools.Any(t => t.IsError),
                IsRunning = sandboxTools.Any(t => string.IsNullOrWhiteSpace(t.Result) && !t.IsError),
                Items = sandboxTools
            });
        }

        if (webTools.Count > 0)
        {
            var queries = webTools.Select(ExtractQuery).Where(q => !string.IsNullOrEmpty(q)).ToList();
            var desc = queries.Count > 0 ? string.Join(", ", queries.Take(3)) : "";

            result.Add(new ToolSubgroup
            {
                Key = "web",
                Title = $"Searched web ({webTools.Count} quer{(webTools.Count == 1 ? "y" : "ies")})",
                Description = desc,
                Badge = $"{webTools.Count} queries",
                Category = "web",
                HasError = webTools.Any(t => t.IsError),
                IsRunning = webTools.Any(t => string.IsNullOrWhiteSpace(t.Result) && !t.IsError),
                Items = webTools
            });
        }

        if (otherTools.Count > 0)
        {
            result.Add(new ToolSubgroup
            {
                Key = "other",
                Title = $"{otherTools.Count} tool step{(otherTools.Count == 1 ? "" : "s")}",
                Description = string.Join(", ", otherTools.Select(t => ToolNameHelper.GetDisplayName(t.ToolName)).Distinct().Take(3)),
                Badge = $"{otherTools.Count} steps",
                Category = "other",
                HasError = otherTools.Any(t => t.IsError),
                IsRunning = otherTools.Any(t => string.IsNullOrWhiteSpace(t.Result) && !t.IsError),
                Items = otherTools
            });
        }

        return result;
    }

    private static bool IsReadTool(string name) =>
        name.Contains("read", StringComparison.OrdinalIgnoreCase) ||
        name.Contains("view", StringComparison.OrdinalIgnoreCase) ||
        name.Contains("list", StringComparison.OrdinalIgnoreCase) ||
        name.Contains("find", StringComparison.OrdinalIgnoreCase) ||
        name.Contains("grep", StringComparison.OrdinalIgnoreCase) ||
        name.Contains("symbol", StringComparison.OrdinalIgnoreCase);

    private static bool IsEditTool(string name) =>
        name.Contains("write", StringComparison.OrdinalIgnoreCase) ||
        name.Contains("edit", StringComparison.OrdinalIgnoreCase) ||
        name.Contains("replace", StringComparison.OrdinalIgnoreCase) ||
        name.Contains("patch", StringComparison.OrdinalIgnoreCase);

    private static bool IsCommandTool(string name) =>
        name.Contains("command", StringComparison.OrdinalIgnoreCase) ||
        name.Contains("exec", StringComparison.OrdinalIgnoreCase) ||
        name.Contains("terminal", StringComparison.OrdinalIgnoreCase) ||
        name.Contains("bash", StringComparison.OrdinalIgnoreCase);

    private static bool IsSandboxTool(string name) =>
        name.Contains("sandbox", StringComparison.OrdinalIgnoreCase) ||
        name.Contains("grambox", StringComparison.OrdinalIgnoreCase) ||
        name.Contains("toolbox", StringComparison.OrdinalIgnoreCase);

    private static bool IsWebTool(string name) =>
        name.Contains("search", StringComparison.OrdinalIgnoreCase) ||
        name.Contains("web", StringComparison.OrdinalIgnoreCase) ||
        name.Contains("fetch", StringComparison.OrdinalIgnoreCase) ||
        name.Contains("url", StringComparison.OrdinalIgnoreCase);

    private static string ExtractFileName(ToolCallInfo tool)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(tool.Arguments)) return "";
            var doc = JsonNode.Parse(tool.Arguments);
            var path = doc?["filePath"]?.ToString() ?? doc?["path"]?.ToString() ?? doc?["TargetFile"]?.ToString();
            return !string.IsNullOrWhiteSpace(path) ? Path.GetFileName(path) : "";
        }
        catch
        {
            return "";
        }
    }

    private static string ExtractDirectoryName(ToolCallInfo tool)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(tool.Arguments)) return "";
            var doc = JsonNode.Parse(tool.Arguments);
            var dir = doc?["directoryPath"]?.ToString() ?? doc?["path"]?.ToString() ?? doc?["DirectoryPath"]?.ToString();
            if (string.IsNullOrWhiteSpace(dir) || dir == "." || dir == "./") return "root";
            return Path.GetFileName(dir.TrimEnd('/', '\\'));
        }
        catch
        {
            return "dir";
        }
    }

    private static string ExtractCommandText(ToolCallInfo tool)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(tool.Arguments)) return "";
            var doc = JsonNode.Parse(tool.Arguments);
            var cmd = doc?["command"]?.ToString() ?? doc?["cmd"]?.ToString() ?? doc?["CommandLine"]?.ToString();
            if (string.IsNullOrWhiteSpace(cmd)) return "";
            return cmd.Trim().Split('\n')[0].Trim();
        }
        catch
        {
            return "";
        }
    }

    private static string ExtractSandboxId(ToolCallInfo tool)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(tool.Arguments)) return "";
            var doc = JsonNode.Parse(tool.Arguments);
            return doc?["sandboxId"]?.ToString() ?? doc?["taskName"]?.ToString() ?? "";
        }
        catch
        {
            return "";
        }
    }

    private static string ExtractQuery(ToolCallInfo tool)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(tool.Arguments)) return "";
            var doc = JsonNode.Parse(tool.Arguments);
            return doc?["query"]?.ToString() ?? doc?["url"]?.ToString() ?? "";
        }
        catch
        {
            return "";
        }
    }

    private string GetGroupSentence(bool isRunning)
    {
        var count = ToolCalls.Count;
        var searches = ToolCalls.Count(t => IsWebTool(t.ToolName));
        var edits = ToolCalls.Count(t => IsEditTool(t.ToolName));
        var reads = ToolCalls.Count(t => IsReadTool(t.ToolName));
        var cmds = ToolCalls.Count(t => IsCommandTool(t.ToolName));
        var sandboxes = ToolCalls.Count(t => IsSandboxTool(t.ToolName));

        var actions = new List<string>();
        if (reads > 0) actions.Add(reads == 1 ? "1 file read" : $"{reads} files read");
        if (edits > 0) actions.Add(edits == 1 ? "1 file edit" : $"{edits} file edits");
        if (cmds > 0) actions.Add(cmds == 1 ? "1 command run" : $"{cmds} commands run");
        if (sandboxes > 0) actions.Add(sandboxes == 1 ? "1 sandbox step" : $"{sandboxes} sandbox steps");
        if (searches > 0) actions.Add(searches == 1 ? "1 web search" : $"{searches} web searches");

        var actionSummary = actions.Count > 0 ? string.Join(", ", actions) : $"{count} steps";

        if (isRunning)
        {
            return $"Running {count} steps ({actionSummary})...";
        }
        return $"Completed {count} steps ({actionSummary})";
    }
}
