@namespace Gram.Desktop.Components
@using Gram.Desktop.Components.Platform
@using Gram.Desktop.Services
@using Gram.Blazor.Shared
@inject IPlatformService Platform

<header class="dt-topbar @Platform.PlatformCssClass" data-ui-region="menubar" role="banner">
    <div class="dt-topbar-left">
        <button type="button"
                class="dt-icon-btn @(IsSidebarOpen ? "active" : "")"
                @onclick="OnToggleSidebar"
                title="Toggle Sidebar (⌘B)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="9" y1="3" x2="9" y2="21"></line>
            </svg>
        </button>
    </div>

    <!-- Center: Dynamic Island -->
    <div class="dt-topbar-center">
        <DynamicIsland IsStreaming="@IsStreaming"
                       IsLoading="@IsLoading"
                       ActiveModelName="@(Models?.FirstOrDefault(m => m.Id == SelectedModelId)?.Name)"
                       OnCancel="@OnCancel" />
    </div>

    <!-- Right: Inspector / Settings (Connected status pill removed) -->
    <div class="dt-topbar-right">
        <button type="button"
                class="dt-icon-btn @(IsInfosheetOpen ? "active" : "")"
                @onclick="OnToggleInfosheet"
                title="Chat info">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="15" y1="3" x2="15" y2="21"></line>
            </svg>
        </button>

        <button type="button"
                class="dt-btn-text @(IsSettingsOpen ? "active" : "")"
                @onclick="OnOpenSettings"
                title="Settings (⌘+,)">
            @(IsSettingsOpen ? "Chat" : "Settings")
        </button>
    </div>
</header>

@code {
    [Parameter] public IReadOnlyList<ModelSummary>? Models { get; set; }
    [Parameter] public string? SelectedModelId { get; set; }
    [Parameter] public EventCallback<string> SelectedModelIdChanged { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsStreaming { get; set; }
    [Parameter] public bool IsConnected { get; set; }
    [Parameter] public bool IsSidebarOpen { get; set; }
    [Parameter] public bool IsInfosheetOpen { get; set; }
    [Parameter] public bool IsSettingsOpen { get; set; }
    [Parameter] public string BackendUrl { get; set; } = "http://localhost:7337";
    [Parameter] public EventCallback OnToggleSidebar { get; set; }
    [Parameter] public EventCallback OnToggleInfosheet { get; set; }
    [Parameter] public EventCallback OnOpenSettings { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string ConnectionTooltip => IsConnected
        ? $"Connected to {BackendUrl}"
        : $"Disconnected from {BackendUrl}";

    private async Task HandleModelChange(ChangeEventArgs e)
    {
        var modelId = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(modelId))
        {
            SelectedModelId = modelId;
            await SelectedModelIdChanged.InvokeAsync(modelId);
        }
    }
}
