@namespace Gram.Desktop.Components
@using Gram.Blazor.Shared
@using Gram.Desktop.Components.Platform
@using Gram.Desktop.Services
@inject IPlatformService Platform
@inject SettingsService SettingsService
@inject ModelService ModelService
@inject ToolboxManagerService ToolboxService
@inject GitService GitService
@inject ThemeService ThemeService
@inject StorageService StorageService
@inject DesktopSession Session
@inject GramBackendClient BackendClient
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="dt-settings-view @Platform.PlatformCssClass" role="main" aria-label="Settings">
    <div class="settings-layout">
        <!-- Left Navigation Sidebar -->
        <aside class="settings-sidebar">
            <div class="settings-sidebar-body">
                <!-- Back to Chat Button (clean, no desktop-mac tag) -->
                <div class="settings-back-bar">
                    <button type="button" class="btn-back-to-chat" @onclick="OnClose" title="Back to Chat (Esc)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                        <span>Back to Chat</span>
                    </button>
                </div>

                <!-- Search Input -->
                <div class="settings-search-box">
                    <svg class="search-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input class="settings-search-input"
                           @bind="searchQuery"
                           @bind:event="oninput"
                           placeholder="Search settings..." />
                    @if (!string.IsNullOrWhiteSpace(searchQuery))
                    {
                        <button type="button" class="btn-clear-search" @onclick="() => searchQuery = string.Empty">✕</button>
                    }
                </div>

                <!-- Grouped Navigation List -->
                <nav class="settings-nav-list">
                    <!-- Section: PREFERENCES -->
                    <div class="settings-nav-title">Preferences</div>

                    @if (MatchesSearch("General assistant persona tone voice audio shortcuts"))
                    {
                        <button type="button"
                                class="settings-nav-item @(activeCategory == "General" ? "active" : "")"
                                @onclick='() => SelectCategory("General")'>
                            <span class="nav-label">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="3"></circle>
                                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                                </svg>
                                <span>General</span>
                            </span>
                        </button>
                    }

                    @if (MatchesSearch("Appearance themes colors palette dark light styling"))
                    {
                        <button type="button"
                                class="settings-nav-item @(activeCategory == "Themes" ? "active" : "")"
                                @onclick='() => SelectCategory("Themes")'>
                            <span class="nav-label">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <circle cx="8" cy="10" r="1.5"></circle>
                                    <circle cx="12" cy="7" r="1.5"></circle>
                                    <circle cx="16" cy="10" r="1.5"></circle>
                                    <circle cx="15" cy="15" r="1.5"></circle>
                                </svg>
                                <span>Appearance</span>
                            </span>
                        </button>
                    }

                    @if (MatchesSearch("Prompts system instructions custom rules guidelines"))
                    {
                        <button type="button"
                                class="settings-nav-item @(activeCategory == "Prompts" ? "active" : "")"
                                @onclick='() => SelectCategory("Prompts")'>
                            <span class="nav-label">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="4 17 10 11 4 5"></polyline>
                                    <line x1="12" y1="19" x2="20" y2="19"></line>
                                </svg>
                                <span>Prompts</span>
                            </span>
                        </button>
                    }

                    <!-- Section: INTELLIGENCE & TOOLS -->
                    <div class="settings-nav-title" style="margin-top: 10px;">Intelligence & Tools</div>

                    @if (MatchesSearch("Models providers api keys intelligence context length byok openrouter anthropic openai gemini ollama"))
                    {
                        <button type="button"
                                class="settings-nav-item @(activeCategory == "Models" ? "active" : "")"
                                @onclick='() => SelectCategory("Models")'>
                            <span class="nav-label">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                                    <line x1="8" y1="21" x2="16" y2="21"></line>
                                    <line x1="12" y1="17" x2="12" y2="21"></line>
                                </svg>
                                <span>Models</span>
                            </span>
                        </button>
                    }

                    @if (MatchesSearch("Capabilities execution auto-approve permissions tools autonomous"))
                    {
                        <button type="button"
                                class="settings-nav-item @(activeCategory == "Capabilities" ? "active" : "")"
                                @onclick='() => SelectCategory("Capabilities")'>
                            <span class="nav-label">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="7" height="7"></rect>
                                    <rect x="14" y="3" width="7" height="7"></rect>
                                    <rect x="14" y="14" width="7" height="7"></rect>
                                    <rect x="3" y="14" width="7" height="7"></rect>
                                </svg>
                                <span>Capabilities</span>
                            </span>
                        </button>
                    }

                    @if (MatchesSearch("MCP skills model context protocol servers tools workflows"))
                    {
                        <button type="button"
                                class="settings-nav-item @(activeCategory == "MCP" ? "active" : "")"
                                @onclick='() => SelectCategory("MCP")'>
                            <span class="nav-label">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
                                    <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
                                    <line x1="6" y1="6" x2="6.01" y2="6"></line>
                                    <line x1="6" y1="18" x2="6.01" y2="18"></line>
                                </svg>
                                <span>MCP</span>
                            </span>
                        </button>
                    }

                    @if (MatchesSearch("Connections connectors Spotify Postman Home Assistant MCP browser"))
                    {
                        <button type="button" class="settings-nav-item @(activeCategory == "Connectors" ? "active" : "")" @onclick='() => SelectCategory("Connectors")'>
                            <span class="nav-label"><span>Connectors</span></span>
                            <span class="setting-hint">@connectorCatalog.Count</span>
                        </button>
                    }

                    @if (MatchesSearch("Git repository branch diff commit status"))
                    {
                        <button type="button"
                                class="settings-nav-item @(activeCategory == "Git" ? "active" : "")"
                                @onclick='() => SelectCategory("Git")'>
                            <span class="nav-label">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="6" cy="5" r="2"></circle>
                                    <circle cx="6" cy="19" r="2"></circle>
                                    <circle cx="18" cy="12" r="2"></circle>
                                    <path d="M6 7v10M8 5h4a6 6 0 0 1 6 6"></path>
                                </svg>
                                <span>Git</span>
                            </span>
                        </button>
                    }

                    <!-- Section: SYSTEM -->
                    <div class="settings-nav-title" style="margin-top: 10px;">System</div>

                    @if (MatchesSearch("Logs diagnostics output backend tracing"))
                    {
                        <button type="button"
                                class="settings-nav-item @(activeCategory == "Logs" ? "active" : "")"
                                @onclick='() => SelectCategory("Logs")'>
                            <span class="nav-label">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="8" y1="6" x2="21" y2="6"></line>
                                    <line x1="8" y1="12" x2="21" y2="12"></line>
                                    <line x1="8" y1="18" x2="21" y2="18"></line>
                                    <line x1="3" y1="6" x2="3.01" y2="6"></line>
                                    <line x1="3" y1="12" x2="3.01" y2="12"></line>
                                    <line x1="3" y1="18" x2="3.01" y2="18"></line>
                                </svg>
                                <span>Logs</span>
                            </span>
                        </button>
                    }

                    @if (MatchesSearch("About gram version author 2helix license"))
                    {
                        <button type="button"
                                class="settings-nav-item @(activeCategory == "About" ? "active" : "")"
                                @onclick='() => SelectCategory("About")'>
                            <span class="nav-label">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                </svg>
                                <span>About</span>
                            </span>
                        </button>
                    }
                </nav>
            </div>

            <!-- Sidebar Footer: Save Button -->
            <div class="settings-sidebar-footer">
                <button type="button"
                        class="btn-sidebar-save @(isSaved ? "saved" : "")"
                        disabled="@(!isDirty && !isSaved)"
                        @onclick="SaveSettings">
                    @(isSaved ? "✓ Saved" : "Save Changes")
                </button>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="settings-main">
            <section class="settings-content-area">

                @* 1. GENERAL *@
                @if (activeCategory == "General")
                {
                    <div class="settings-header">
                        <h2 class="settings-section-title">General Settings</h2>
                        <p class="settings-section-desc">Personalize your assistant's identity, communication tone, speech feedback, and keyboard shortcuts.</p>
                    </div>

                    <!-- Group 1: Identity & Tone -->
                    <div class="settings-subhead">Identity & Tone</div>
                    <div class="settings-group">
                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Assistant Name</span>
                                <span class="setting-desc">The name Gram introduces itself with across conversations.</span>
                            </div>
                            <div class="setting-control">
                                <input class="setting-input" @bind="assistantName" @bind:event="oninput" @bind:after="MarkDirty" />
                            </div>
                        </div>

                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Persona & Tone</span>
                                <span class="setting-desc">Default behavioral style and communication format.</span>
                            </div>
                            <div class="setting-control">
                                <select class="setting-select" @bind="personaTone" @bind:after="MarkDirty">
                                    <option value="concise">Concise & Pragmatic</option>
                                    <option value="programmer">Technical Pair Programmer</option>
                                    <option value="minimalist">Strict Minimalist (Direct answers)</option>
                                    <option value="creative">Creative & Analytical</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Group 2: Voice & Acoustics -->
                    <div class="settings-subhead">Voice & Audio Input</div>
                    <div class="settings-group">
                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Auto-send on silence</span>
                                <span class="setting-desc">Automatically submit voice transcription when you pause speaking.</span>
                            </div>
                            <div class="setting-control">
                                <label class="setting-toggle">
                                    <input type="checkbox" class="setting-checkbox" @bind="autoSendVoice" @bind:after="MarkDirty" />
                                    <span class="setting-desc">@(autoSendVoice ? "Enabled" : "Disabled")</span>
                                </label>
                            </div>
                        </div>

                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Audio chime feedback</span>
                                <span class="setting-desc">Play soft acoustic feedback when voice transcription starts and finishes.</span>
                            </div>
                            <div class="setting-control">
                                <label class="setting-toggle">
                                    <input type="checkbox" class="setting-checkbox" @bind="playVoiceChime" @bind:after="MarkDirty" />
                                    <span class="setting-desc">@(playVoiceChime ? "Enabled" : "Disabled")</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Group 3: Keyboard Shortcuts -->
                    <div class="settings-subhead">Keyboard Shortcuts</div>
                    <div class="settings-group">
                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">New Chat</span>
                                <span class="setting-desc">Start a fresh conversation thread.</span>
                            </div>
                            <div class="setting-control">
                                <kbd class="dt-kbd">@Platform.ModifierKeyLabel+N</kbd>
                            </div>
                        </div>

                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Open Preferences</span>
                                <span class="setting-desc">Toggle the full-screen preferences view.</span>
                            </div>
                            <div class="setting-control">
                                <kbd class="dt-kbd">@Platform.ModifierKeyLabel+,</kbd>
                            </div>
                        </div>

                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Toggle Sidebar</span>
                                <span class="setting-desc">Collapse or expand the left conversation rail.</span>
                            </div>
                            <div class="setting-control">
                                <kbd class="dt-kbd">@Platform.ModifierKeyLabel+Shift+S</kbd>
                            </div>
                        </div>

                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Toggle Chat Info</span>
                                <span class="setting-desc">Collapse or expand the inspector sheet.</span>
                            </div>
                            <div class="setting-control">
                                <kbd class="dt-kbd">@Platform.ModifierKeyLabel+Shift+I</kbd>
                            </div>
                        </div>
                    </div>
                }

                @* 2. THEMES *@
                @if (activeCategory == "Themes")
                {
                    <div class="settings-header">
                        <h2 class="settings-section-title">Appearance</h2>
                        <p class="settings-section-desc">Select an interface palette for your desktop application. Colors apply immediately and persist across sessions.</p>
                    </div>

                    <div class="settings-subhead">Themes</div>
                    <div class="theme-list">
                        @foreach (var entry in ThemeService.CatalogThemes)
                        {
                            var isSelected = ThemeService.ActiveThemeName.Equals(entry.Key, StringComparison.OrdinalIgnoreCase);
                            <div class="theme-row @(isSelected ? "selected" : "")"
                                 @onclick="() => HandleSelectTheme(entry.Key)">
                                <div class="theme-row-left">
                                    <span class="theme-radio-dot"></span>
                                    <div class="theme-row-info">
                                        <span class="theme-row-name">@entry.Key</span>
                                        @if (isSelected)
                                        {
                                            <span class="theme-row-desc">Currently Active</span>
                                        }
                                    </div>
                                </div>
                                <div class="theme-swatches">
                                    @foreach (var color in entry.Value.ToArray())
                                    {
                                        <span class="swatch-dot" style="background-color: @color;" title="@color"></span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                @* 3. MODELS & PROVIDERS *@
                @if (activeCategory == "Models")
                {
                    <div class="settings-header">
                        <h2 class="settings-section-title">Models & Provider Keys</h2>
                        <p class="settings-section-desc">Manage installed models, toggle favorites, and supply Bring-Your-Own-Key (BYOK) provider credentials.</p>
                    </div>

                    <!-- Group 1: Connected Providers & API Keys -->
                    <div class="settings-subhead">Connected Providers & API Keys</div>
                    <div class="settings-group">
                        <div class="setting-item">
                            <div class="setting-info">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span class="setting-title">Anthropic</span>
                                    <span class="provider-status @(!string.IsNullOrWhiteSpace(apiKeyAnthropic) ? "connected" : "disconnected")">
                                        @(!string.IsNullOrWhiteSpace(apiKeyAnthropic) ? "BYOK Active" : "Not Configured")
                                    </span>
                                </div>
                                <span class="setting-desc">Claude 3.7 Sonnet, Haiku</span>
                            </div>
                            <div class="setting-control">
                                <input type="password" class="setting-input" placeholder="sk-ant-..." @bind="apiKeyAnthropic" @bind:event="oninput" @bind:after="MarkDirty" />
                            </div>
                        </div>

                        <div class="setting-item">
                            <div class="setting-info">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span class="setting-title">OpenAI</span>
                                    <span class="provider-status @(!string.IsNullOrWhiteSpace(apiKeyOpenAI) ? "connected" : "disconnected")">
                                        @(!string.IsNullOrWhiteSpace(apiKeyOpenAI) ? "BYOK Active" : "Not Configured")
                                    </span>
                                </div>
                                <span class="setting-desc">GPT-4o, o-series reasoning models</span>
                            </div>
                            <div class="setting-control">
                                <input type="password" class="setting-input" placeholder="sk-proj-..." @bind="apiKeyOpenAI" @bind:event="oninput" @bind:after="MarkDirty" />
                            </div>
                        </div>

                        <div class="setting-item">
                            <div class="setting-info">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span class="setting-title">OpenRouter</span>
                                    <span class="provider-status @(!string.IsNullOrWhiteSpace(apiKeyOpenRouter) ? "connected" : "disconnected")">
                                        @(!string.IsNullOrWhiteSpace(apiKeyOpenRouter) ? "BYOK Active" : "Not Configured")
                                    </span>
                                </div>
                                <span class="setting-desc">Universal model router</span>
                            </div>
                            <div class="setting-control">
                                <input type="password" class="setting-input" placeholder="sk-or-..." @bind="apiKeyOpenRouter" @bind:event="oninput" @bind:after="MarkDirty" />
                            </div>
                        </div>

                        <div class="setting-item">
                            <div class="setting-info">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span class="setting-title">Google Gemini</span>
                                    <span class="provider-status @(!string.IsNullOrWhiteSpace(apiKeyGemini) ? "connected" : "disconnected")">
                                        @(!string.IsNullOrWhiteSpace(apiKeyGemini) ? "BYOK Active" : "Not Configured")
                                    </span>
                                </div>
                                <span class="setting-desc">Gemini 2.0 Flash / Pro</span>
                            </div>
                            <div class="setting-control">
                                <input type="password" class="setting-input" placeholder="AIzaSy..." @bind="apiKeyGemini" @bind:event="oninput" @bind:after="MarkDirty" />
                            </div>
                        </div>

                        <div class="setting-item">
                            <div class="setting-info">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span class="setting-title">Ollama</span>
                                    <span class="provider-status system">Local Engine</span>
                                </div>
                                <span class="setting-desc">Local offline inference endpoint URL</span>
                            </div>
                            <div class="setting-control">
                                <input type="text" class="setting-input" placeholder="http://localhost:11434" @bind="ollamaEndpoint" @bind:event="oninput" @bind:after="MarkDirty" />
                            </div>
                        </div>
                    </div>

                    <!-- Group 2: Installed Models -->
                    <div style="display: flex; align-items: center; justify-content: space-between; margin: 24px 0 8px 0;">
                        <span class="settings-subhead" style="margin: 0;">Installed Models</span>
                        <input class="setting-input" style="width: 180px; padding: 4px 8px; font-size: 11.5px;" placeholder="Filter models..." @bind="modelSearch" @bind:event="oninput" />
                    </div>

                    <div class="models-list">
                        @foreach (var model in FilteredModels)
                        {
                            <div class="model-item">
                                <div class="model-item-left">
                                    <button type="button" class="star-btn @(model.IsFavorite ? "active" : "")"
                                            @onclick="() => ModelService.ToggleFavorite(model.Id)"
                                            title="@(model.IsFavorite ? "Remove default" : "Set as default")">
                                        @(model.IsFavorite ? "★" : "☆")
                                    </button>
                                    <div class="model-info-block">
                                        <div class="model-title-row">
                                            <span class="model-name">@model.Name</span>
                                            <span class="model-provider-badge">@model.Provider</span>
                                            @if (model.ContextLength.HasValue)
                                            {
                                                <span class="setting-hint">
                                                    @(model.ContextLength.Value >= 1000000 ? $"{model.ContextLength.Value / 1000000}M" : model.ContextLength.Value >= 1000 ? $"{model.ContextLength.Value / 1000}k" : $"{model.ContextLength.Value}")
                                                </span>
                                            }
                                        </div>
                                        <span class="model-id-badge">@model.Id</span>
                                    </div>
                                </div>
                                <div class="model-item-right">
                                    <button type="button" class="btn-remove-model" @onclick="() => ModelService.RemoveModel(model.Id)" title="Remove model">✕</button>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Group 3: Add Custom Model -->
                    <div class="settings-subhead" style="margin-top: 24px;">Add Custom Model</div>
                    <div class="settings-group">
                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Model ID</span>
                                <span class="setting-desc">Provider model identifier string.</span>
                            </div>
                            <div class="setting-control">
                                <input class="setting-input" placeholder="e.g. claude-3-7-sonnet" @bind="newModelId" />
                            </div>
                        </div>

                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Display Name</span>
                                <span class="setting-desc">Human-readable name in picker.</span>
                            </div>
                            <div class="setting-control">
                                <input class="setting-input" placeholder="e.g. Claude 3.7 Sonnet" @bind="newModelName" />
                            </div>
                        </div>

                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Provider</span>
                                <span class="setting-desc">Target provider endpoint.</span>
                            </div>
                            <div class="setting-control">
                                <select class="setting-select" @bind="newModelProvider">
                                    <option value="Anthropic">Anthropic</option>
                                    <option value="OpenAI">OpenAI</option>
                                    <option value="OpenRouter">OpenRouter</option>
                                    <option value="Google">Google</option>
                                    <option value="Ollama">Ollama (Local)</option>
                                </select>
                            </div>
                        </div>

                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Context Length</span>
                                <span class="setting-desc">Maximum supported token window.</span>
                            </div>
                            <div class="setting-control" style="gap: 8px;">
                                <input class="setting-input" type="number" placeholder="200000" @bind="newModelContext" />
                                <button type="button" class="btn-secondary" @onclick="HandleAddModel">Add</button>
                            </div>
                        </div>
                    </div>
                }

                @* 4. PROMPTS *@
                @if (activeCategory == "Prompts")
                {
                    <div class="settings-header">
                        <h2 class="settings-section-title">Prompts</h2>
                        <p class="settings-section-desc">Add instructions that apply to every conversation with Gram, or inspect the system prompt.</p>
                    </div>

                    <!-- Custom Instructions (no cards, clean & simple) -->
                    <div class="prompt-plain-block">
                        <div class="prompt-plain-header">
                            <div>
                                <label class="prompt-plain-label" for="custom-instructions-input">Custom Instructions</label>
                                <p class="prompt-plain-desc">Preferences and instructions automatically included with every request to Gram.</p>
                            </div>
                            <button type="button" class="btn-secondary" @onclick="InsertSampleInstructions">Insert Template</button>
                        </div>
                        <textarea id="custom-instructions-input"
                                  class="prompt-plain-textarea"
                                  rows="7"
                                  placeholder="What would you like Gram to know about you to provide better responses? (e.g. coding conventions, communication style, project preferences)..."
                                  @bind="customInstructions"
                                  @bind:event="oninput"
                                  @bind:after="MarkDirty"></textarea>
                        @if (!string.IsNullOrEmpty(customInstructions))
                        {
                            <span class="prompt-char-count">@customInstructions.Length characters</span>
                        }
                    </div>

                    <!-- Base System Prompt (no cards, clean & simple) -->
                    <div class="prompt-plain-block" style="margin-top: 28px;">
                        <div class="prompt-plain-header">
                            <div>
                                <label class="prompt-plain-label">System Prompt (v@(GramSystemPrompt.Version))</label>
                                <p class="prompt-plain-desc">Core behavioral instruction set governing reasoning and tool orchestration.</p>
                            </div>
                            <button type="button" class="btn-secondary" @onclick="CopyBasePrompt">Copy</button>
                        </div>
                        <pre class="prompt-plain-preview">@GramSystemPrompt.DefaultBasePrompt</pre>
                    </div>
                }

                @* 5. CAPABILITIES *@
                @if (activeCategory == "Capabilities")
                {
                    <div class="settings-header">
                        <h2 class="settings-section-title">Capabilities & Permissions</h2>
                        <p class="settings-section-desc">Manage local shell execution, file system operations, and automated tool approvals.</p>
                    </div>

                    <div class="settings-subhead">Agent Execution Security Mode</div>
                    <div class="settings-group">
                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Execution Mode</span>
                                <span class="setting-desc">Controls when Gram asks for approval before running terminal commands or modifying files.</span>
                            </div>
                            <div class="setting-control">
                                <select class="setting-select" value="@Session.CurrentPermissionMode" @onchange="OnPermissionModeChanged">
                                    <option value="SafeAutoApprove">Safe Auto-Approve (Recommended)</option>
                                    <option value="FullAutonomous">Full Autonomous (No Prompts)</option>
                                    <option value="AskAlways">Ask Always (Strict Confirmation)</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="settings-subhead">Autonomous Tool Approvals</div>
                    <div class="settings-group">
                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Auto-Approve Read Commands</span>
                                <span class="setting-desc">Allow safe inspection commands (ls, cat, git status) without manual confirmation.</span>
                            </div>
                            <div class="setting-control">
                                <label class="setting-toggle">
                                    <input type="checkbox" class="setting-checkbox" @bind="autoApproveRead" @bind:after="MarkDirty" />
                                    <span class="setting-desc">@(autoApproveRead ? "Enabled" : "Disabled")</span>
                                </label>
                            </div>
                        </div>

                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Auto-Approve File Modifications</span>
                                <span class="setting-desc">Allow workspace file edits without interactive prompt.</span>
                            </div>
                            <div class="setting-control">
                                <label class="setting-toggle">
                                    <input type="checkbox" class="setting-checkbox" @bind="autoApproveWrite" @bind:after="MarkDirty" />
                                    <span class="setting-desc">@(autoApproveWrite ? "Enabled" : "Disabled")</span>
                                </label>
                            </div>
                        </div>

                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Max Parallel Tools</span>
                                <span class="setting-desc">Maximum concurrent tool invocations per reasoning cycle.</span>
                            </div>
                            <div class="setting-control">
                                <select class="setting-select" @bind="maxParallelTools" @bind:after="MarkDirty">
                                    <option value="1">1 (Sequential)</option>
                                    <option value="2">2 (Balanced)</option>
                                    <option value="4">4 (High Concurrency)</option>
                                    <option value="8">8 (Aggressive)</option>
                                </select>
                            </div>
                        </div>
                    </div>
                }

                @* 6. MCP & SKILLS *@
                @if (activeCategory == "MCP")
                {
                    <div class="settings-header">
                        <h2 class="settings-section-title">MCP & Agent Skills</h2>
                        <p class="settings-section-desc">Connect external tools and services via Model Context Protocol (MCP) and procedural skills.</p>
                    </div>

                    <div class="settings-subhead">Configured MCP Servers</div>
                    <div class="settings-group">
                        @if (ToolboxService.McpServers.Count == 0)
                        {
                            <div class="setting-item">
                                <div class="setting-info">
                                    <span class="setting-desc">No MCP servers registered yet. Add a server below.</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            @foreach (var server in ToolboxService.McpServers)
                            {
                                <div class="setting-item">
                                    <div class="setting-info">
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <span class="setting-title">@server.Name</span>
                                            <span class="provider-status system">stdio</span>
                                        </div>
                                        <span class="setting-desc">@server.Command @server.Arguments</span>
                                    </div>
                                    <div class="setting-control">
                                        <button type="button" class="btn-remove-model" @onclick="() => ToolboxService.RemoveMcpServer(server.Id)">✕</button>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="settings-subhead" style="margin-top: 24px;">Add MCP Server</div>
                    <div class="settings-group">
                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Server Name</span>
                                <span class="setting-desc">Unique identifier for this tool server.</span>
                            </div>
                            <div class="setting-control">
                                <input class="setting-input" placeholder="e.g. filesystem" @bind="newMcpName" />
                            </div>
                        </div>

                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Command</span>
                                <span class="setting-desc">Executable binary name.</span>
                            </div>
                            <div class="setting-control">
                                <input class="setting-input" placeholder="e.g. npx" @bind="newMcpCommand" />
                            </div>
                        </div>

                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Arguments</span>
                                <span class="setting-desc">Command-line arguments.</span>
                            </div>
                            <div class="setting-control" style="gap: 8px;">
                                <input class="setting-input" placeholder="e.g. -y @@modelcontextprotocol/server-filesystem /path" @bind="newMcpArgs" />
                                <button type="button" class="btn-secondary" @onclick="HandleAddMcp">Add</button>
                            </div>
                        </div>
                    </div>
                }

                @* 7. GIT *@
                @if (activeCategory == "Git")
                {
                    <div class="settings-header">
                        <h2 class="settings-section-title">Git Workspace</h2>
                        <p class="settings-section-desc">Workspace version control configuration and system environment.</p>
                    </div>

                    <div class="settings-subhead">Repository Information</div>
                    <div class="settings-group">
                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Workspace Directory</span>
                                <span class="setting-desc">Current Git project root directory.</span>
                            </div>
                            <div class="setting-control">
                                <span class="setting-value" style="font-family: var(--dt-font-mono); font-size: 11.5px;">@Directory.GetCurrentDirectory()</span>
                            </div>
                        </div>

                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Git Executable</span>
                                <span class="setting-desc">System git CLI status.</span>
                            </div>
                            <div class="setting-control">
                                <span class="provider-status connected">Detected</span>
                            </div>
                        </div>
                    </div>
                }

                @* 8. CONNECTORS *@
                @if (activeCategory == "Connectors")
                {
                    <div class="settings-header"><h2 class="settings-section-title">Connectors</h2><p class="settings-section-desc">Connected services and permission-aware actions shared with Gram.</p></div>
                    <div class="settings-group">
                        @foreach (var connector in connectorCatalog)
                        {
                            var connection = connectorConnections.FirstOrDefault(c => c.ConnectorId.Equals(connector.Id, StringComparison.OrdinalIgnoreCase) && c.IsConnected);
                            <div class="setting-item">
                                <div class="setting-info"><span class="setting-title">@connector.Name</span><span class="setting-desc">@connector.Description</span></div>
                                <div class="setting-control">
                                    <span class="provider-status @(connection != null ? "connected" : connector.IsEnabled ? "system" : "")">@(connection != null ? "Connected" : connector.IsEnabled ? connector.RequiresConnection ? "Needs setup" : "Available" : "Experimental")</span>
                                    @if (connector.Id == "spotify") { <a class="btn-secondary" href="@(BackendUrl.TrimEnd('/') + "/api/v1/connectors/spotify/authorize?returnUrl=%2F")" style="text-decoration:none; font-size:11px;">@(connection == null ? "Connect" : "Reconnect")</a> }
                                </div>
                            </div>
                        }
                    </div>
                }

                @* 9. LOGS *@
                @if (activeCategory == "Logs")
                {
                    <div class="settings-header">
                        <h2 class="settings-section-title">Logs & Diagnostics</h2>
                        <p class="settings-section-desc">System storage paths and backend service connectivity status.</p>
                    </div>

                    <div class="settings-subhead">Service Endpoints & Storage</div>
                    <div class="settings-group">
                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Core Backend Service</span>
                                <span class="setting-desc">HTTP address of the local engine.</span>
                            </div>
                            <div class="setting-control">
                                <span class="setting-value" style="font-family: var(--dt-font-mono); font-size: 11.5px;">@BackendUrl</span>
                            </div>
                        </div>

                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Data Storage Directory</span>
                                <span class="setting-desc">Local database and session storage path.</span>
                            </div>
                            <div class="setting-control">
                                <span class="setting-value" style="font-family: var(--dt-font-mono); font-size: 11.5px;">@StorageService.DataDirectory</span>
                            </div>
                        </div>

                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Reveal Storage in Finder</span>
                                <span class="setting-desc">Open local configuration and storage folder.</span>
                            </div>
                            <div class="setting-control">
                                <button type="button" class="btn-secondary" @onclick="HandleRevealDataFolder">Reveal in Finder</button>
                            </div>
                        </div>
                    </div>
                }

                @* 9. ABOUT *@
                @if (activeCategory == "About")
                {
                    <div class="settings-header">
                        <h2 class="settings-section-title">About Gram</h2>
                        <p class="settings-section-desc">Next-generation autonomous agentic engineering intelligence platform.</p>
                    </div>

                    <div class="settings-subhead">Platform Details</div>
                    <div class="settings-group">
                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Gram Desktop Edition</span>
                                <span class="setting-desc">Blazor Native AOT Shell (.NET 9.0)</span>
                            </div>
                            <div class="setting-control">
                                <span class="setting-value" style="font-weight: 600;">v1.0.0 Native</span>
                            </div>
                        </div>

                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Lead Architect</span>
                                <span class="setting-desc">System design and engineering.</span>
                            </div>
                            <div class="setting-control">
                                <span style="font-weight: 600; color: var(--text-primary);">Taufeeq Ali</span>
                            </div>
                        </div>

                        <div class="setting-item">
                            <div class="setting-info">
                                <span class="setting-title">Organization</span>
                                <span class="setting-desc">Company ownership.</span>
                            </div>
                            <div class="setting-control">
                                <a href="https://2helix.com" target="_blank" class="link-action" style="font-weight: 600;">
                                    2Helix ↗
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </section>
        </main>
    </div>
</div>

@code {
    [Parameter] public string BackendUrl { get; set; } = "http://localhost:7337";
    [Parameter] public EventCallback OnClose { get; set; }

    private string activeCategory = "General";
    private string searchQuery = "";
    private string modelSearch = "";
    private bool isDirty = false;
    private bool isSaved = false;

    // Form fields
    private string assistantName = "Gram";
    private string personaTone = "concise";
    private bool autoSendVoice = false;
    private bool playVoiceChime = true;
    private string customInstructions = "";
    private bool autoApproveRead = true;
    private bool autoApproveWrite = false;
    private string maxParallelTools = "4";
    private IReadOnlyList<ConnectorDescriptor> connectorCatalog = [];
    private IReadOnlyList<ConnectorConnection> connectorConnections = [];

    private string apiKeyAnthropic = "";
    private string apiKeyOpenAI = "";
    private string apiKeyOpenRouter = "";
    private string apiKeyGemini = "";
    private string ollamaEndpoint = "http://localhost:11434";

    private string newModelId = "";
    private string newModelName = "";
    private string newModelProvider = "Anthropic";
    private int newModelContext = 200000;

    private string newMcpName = "";
    private string newMcpCommand = "";
    private string newMcpArgs = "";

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnChange += OnThemeChanged;
        LoadSettings();
        try
        {
            await Session.LoadSecuritySettingsAsync();
            connectorCatalog = await BackendClient.GetConnectorsAsync();
            connectorConnections = await BackendClient.GetConnectorConnectionsAsync();
        }
        catch {}
    }

    private async Task OnPermissionModeChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ExecutionPermissionMode>(e.Value?.ToString(), out var mode))
        {
            await Session.SetPermissionModeAsync(mode);
            MarkDirty();
        }
    }

    private void OnThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void LoadSettings()
    {
        assistantName = SettingsService.GetSetting("Assistant:Name", "Gram");
        personaTone = SettingsService.GetSetting("Assistant:PersonaTone", "concise");
        autoSendVoice = SettingsService.GetSetting("Voice:AutoSend", "false") == "true";
        playVoiceChime = SettingsService.GetSetting("Voice:PlayChime", "true") == "true";
        customInstructions = SettingsService.GetSetting("Prompts:CustomInstructions", "");
        apiKeyAnthropic = SettingsService.GetSetting("Providers:Anthropic:ApiKey", "");
        apiKeyOpenAI = SettingsService.GetSetting("Providers:OpenAI:ApiKey", "");
        apiKeyOpenRouter = SettingsService.GetSetting("Providers:OpenRouter:ApiKey", "");
        apiKeyGemini = SettingsService.GetSetting("Providers:Gemini:ApiKey", "");
        ollamaEndpoint = SettingsService.GetSetting("Providers:Ollama:Endpoint", "http://localhost:11434");
    }

    private void SelectCategory(string category)
    {
        activeCategory = category;
    }

    private bool MatchesSearch(string terms)
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return true;
        return terms.Contains(searchQuery.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private List<GramModel> FilteredModels =>
        ModelService.Models
            .Where(m => string.IsNullOrWhiteSpace(modelSearch) ||
                        m.Name.Contains(modelSearch, StringComparison.OrdinalIgnoreCase) ||
                        m.Id.Contains(modelSearch, StringComparison.OrdinalIgnoreCase) ||
                        m.Provider.Contains(modelSearch, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private void MarkDirty()
    {
        isDirty = true;
        isSaved = false;
    }

    private void HandleSelectTheme(string themeName)
    {
        ThemeService.SelectCatalogTheme(themeName);
        MarkDirty();
    }

    private void SaveSettings()
    {
        SettingsService.SetSetting("Assistant:Name", assistantName);
        SettingsService.SetSetting("Assistant:PersonaTone", personaTone);
        SettingsService.SetSetting("Voice:AutoSend", autoSendVoice ? "true" : "false");
        SettingsService.SetSetting("Voice:PlayChime", playVoiceChime ? "true" : "false");
        SettingsService.SetSetting("Prompts:CustomInstructions", customInstructions);
        SettingsService.SetSetting("Providers:Anthropic:ApiKey", apiKeyAnthropic);
        SettingsService.SetSetting("Providers:OpenAI:ApiKey", apiKeyOpenAI);
        SettingsService.SetSetting("Providers:OpenRouter:ApiKey", apiKeyOpenRouter);
        SettingsService.SetSetting("Providers:Gemini:ApiKey", apiKeyGemini);
        SettingsService.SetSetting("Providers:Ollama:Endpoint", ollamaEndpoint);

        isDirty = false;
        isSaved = true;
    }

    private async Task CopyBasePrompt()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("gramDesktop.copyText", GramSystemPrompt.DefaultBasePrompt);
        }
        catch {}
    }

    private void InsertSampleInstructions()
    {
        customInstructions = "• Always provide clean, production-ready code with concise explanations.\n• Follow Apple HIG design aesthetics.\n• Keep responses direct and minimize conversational filler.";
        MarkDirty();
    }

    private void HandleAddModel()
    {
        if (string.IsNullOrWhiteSpace(newModelId)) return;
        ModelService.AddModels([new DiscoveredModel
        {
            Id = newModelId.Trim(),
            Name = string.IsNullOrWhiteSpace(newModelName) ? newModelId.Trim() : newModelName.Trim(),
            Provider = newModelProvider,
            ContextLength = newModelContext,
            IsSelected = true
        }]);
        newModelId = "";
        newModelName = "";
        MarkDirty();
    }

    private void HandleAddMcp()
    {
        if (string.IsNullOrWhiteSpace(newMcpName) || string.IsNullOrWhiteSpace(newMcpCommand)) return;
        ToolboxService.AddMcpServer(new McpServerConfig
        {
            Name = newMcpName.Trim(),
            Command = newMcpCommand.Trim(),
            Arguments = newMcpArgs.Trim(),
            Transport = "stdio",
            IsEnabled = true
        });
        newMcpName = "";
        newMcpCommand = "";
        newMcpArgs = "";
        MarkDirty();
    }

    private void HandleRevealDataFolder()
    {
        try
        {
            var path = StorageService.DataDirectory;
            if (System.Runtime.InteropServices.RuntimeInformation.IsOSPlatform(System.Runtime.InteropServices.OSPlatform.OSX))
            {
                System.Diagnostics.Process.Start("open", $"\"{path}\"");
            }
            else if (System.Runtime.InteropServices.RuntimeInformation.IsOSPlatform(System.Runtime.InteropServices.OSPlatform.Windows))
            {
                System.Diagnostics.Process.Start("explorer.exe", $"\"{path}\"");
            }
            else
            {
                System.Diagnostics.Process.Start("xdg-open", $"\"{path}\"");
            }
        }
        catch {}
    }

    public void Dispose()
    {
        ThemeService.OnChange -= OnThemeChanged;
    }
}
