@namespace Gram.Desktop.Components
@using Gram.Desktop.Components.Platform
@using Gram.Desktop.Services
@using Gram.Blazor.Shared
@using Microsoft.JSInterop
@inject IPlatformService Platform
@inject DesktopSession Session
@inject WorkspaceTabService TabService
@inject StorageService StorageService
@inject IJSRuntime JSRuntime

<aside class="dt-sidebar @(IsOpen ? "open" : "closed") @Platform.PlatformCssClass" data-ui-region="sidebar" role="navigation" aria-label="Conversations">
    <!-- Header: Toggle + Search + New Chat Button -->
    <div class="dt-sidebar-header">
        <button type="button"
                class="dt-icon-btn dt-sidebar-toggle-btn"
                data-action="toggle-sidebar"
                @onclick="OnToggle"
                title="Toggle Sidebar (@Platform.ModifierKeyLabel+B)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="9" y1="3" x2="9" y2="21"></line>
            </svg>
        </button>

        <div class="dt-search-input-wrap">
            <svg class="dt-search-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <textarea @ref="searchInputRef"
                      class="dt-search-textarea"
                      rows="1"
                      placeholder="Search chats..."
                      value="@searchQuery"
                      @oninput="HandleSearch"
                      @onkeydown="HandleSearchKeyDown"></textarea>
            @if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                <button type="button"
                        class="dt-search-clear-btn"
                        @onclick="ClearSearch"
                        title="Clear search">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            }
        </div>

        @if (string.IsNullOrWhiteSpace(searchQuery))
        {
            <div class="dt-sidebar-new-wrap">
                <button type="button"
                        class="dt-icon-btn dt-sidebar-new-btn @(isNewMenuOpen ? "active" : "")"
                        data-action="new-chat"
                        @onmousedown="HandleNewButtonMouseDown"
                        @onmouseup="HandleNewButtonMouseUp"
                        @onmouseleave="HandleNewButtonMouseLeave"
                        @onclick="HandleNewButtonClick"
                        @oncontextmenu="HandleNewButtonContextMenu"
                        @oncontextmenu:preventDefault="true"
                        disabled="@(IsStreaming || IsLoading)"
                        title="New Chat (@Platform.ModifierKeyLabel+T) — Hold or right-click for options">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19" />
                        <line x1="5" y1="12" x2="19" y2="12" />
                    </svg>
                </button>

                @if (isNewMenuOpen)
                {
                    <div class="dt-context-backdrop" @onclick="() => isNewMenuOpen = false"></div>
                    <div class="dt-new-menu-popover" @onclick:stopPropagation="true">
                        <button type="button" class="dt-new-menu-item" @onclick="HandleMenuNewChat">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                            </svg>
                            <span class="dt-new-menu-label">New Chat</span>
                            <kbd class="dt-new-menu-shortcut">@Platform.ModifierKeyLabel+N</kbd>
                        </button>

                        <button type="button" class="dt-new-menu-item" @onclick="HandleMenuNewTerminal">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="4 17 10 11 4 5"></polyline>
                                <line x1="12" y1="19" x2="20" y2="19"></line>
                            </svg>
                            <span class="dt-new-menu-label">New Terminal</span>
                            <kbd class="dt-new-menu-shortcut">⌥T</kbd>
                        </button>

                        <button type="button" class="dt-new-menu-item" @onclick="HandleMenuOpenGit">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="18" cy="18" r="3"></circle>
                                <circle cx="6" cy="6" r="3"></circle>
                                <path d="M6 9v12"></path>
                                <path d="M18 9a9 9 0 0 0-9-9"></path>
                            </svg>
                            <span class="dt-new-menu-label">Git Changes</span>
                            <kbd class="dt-new-menu-shortcut">⌥G</kbd>
                        </button>

                        <div class="dt-new-menu-divider"></div>

                        <button type="button" class="dt-new-menu-item @(TabService.IsSplitView ? "active" : "")" @onclick="HandleMenuToggleSplit">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="12" y1="3" x2="12" y2="21"></line>
                            </svg>
                            <span class="dt-new-menu-label">@(TabService.IsSplitView ? "Unlink Split View" : "Split Current View")</span>
                            <kbd class="dt-new-menu-shortcut">⌥\</kbd>
                        </button>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Scrollable Conversation List -->
    <div class="dt-sidebar-list">
        @if (IsLoading && (Conversations == null || Conversations.Count == 0))
        {
            <div style="display: flex; flex-direction: column; gap: 6px; padding: 8px;">
                <div style="height: 28px; background: var(--dt-bg-surface); border-radius: var(--dt-radius-sm); opacity: 0.6;"></div>
                <div style="height: 28px; background: var(--dt-bg-surface); border-radius: var(--dt-radius-sm); opacity: 0.4; width: 75%;"></div>
            </div>
        }
        else if (FilteredConversations.Count == 0 && ArchivedConversations.Count == 0)
        {
            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 140px; text-align: center; color: var(--dt-text-muted); gap: 6px; padding: 16px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
                <span style="font-size: 11.5px; font-weight: 500;">No chats found</span>
            </div>
        }
        else
        {
            @foreach (var group in GroupedConversations)
            {
                <div class="dt-conv-group" style="display: flex; flex-direction: column; gap: 2px;">
                    <div class="dt-group-label">
                        @group.Key
                    </div>
                    @foreach (var conv in group.Value)
                    {
                        var isActive = ActiveConversationId == conv.Id;
                        <div class="dt-conv-item @(isActive ? "active" : "")"
                             @onclick="() => HandleSelectChat(conv.Id)"
                             @oncontextmenu="e => HandleContextMenu(e, conv)"
                             @oncontextmenu:preventDefault="true"
                             role="button"
                             tabindex="0">
                            <div class="dt-conv-top">
                                @if (renamingChatId == conv.Id)
                                {
                                    <div class="dt-rename-wrap" @onclick:stopPropagation="true">
                                        <input class="dt-rename-input"
                                               @bind="renameInput"
                                               @bind:event="oninput"
                                               @onkeydown="e => HandleRenameKeyDown(e, conv)"
                                               @onblur="() => CommitRename(conv)"
                                               autofocus />
                                    </div>
                                }
                                else
                                {
                                    <span class="dt-conv-title">
                                        @(string.IsNullOrWhiteSpace(conv.Title) ? "Untitled session" : conv.Title)
                                    </span>
                                }
                            </div>
                            <div class="dt-conv-meta">
                                <span>@FormatRelativeTime(conv.Created)</span>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (ArchivedConversations.Count > 0)
            {
                <div class="dt-sidebar-archived-toggle" @onclick="() => isArchivedExpanded = !isArchivedExpanded">
                    <div style="display: flex; align-items: center; gap: 6px;">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transform: rotate(@(isArchivedExpanded ? "90deg" : "0deg")); transition: transform 0.15s ease;">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                        <span>Archived</span>
                    </div>
                    <span class="dt-conv-badge">@ArchivedConversations.Count</span>
                </div>

                @if (isArchivedExpanded)
                {
                    <div class="dt-sidebar-archived-list">
                        @foreach (var conv in ArchivedConversations)
                        {
                            var isActive = ActiveConversationId == conv.Id;
                            <div class="dt-conv-item @(isActive ? "active" : "")"
                                 @onclick="() => HandleSelectChat(conv.Id)"
                                 @oncontextmenu="e => HandleContextMenu(e, conv)"
                                 @oncontextmenu:preventDefault="true"
                                 role="button"
                                 tabindex="0">
                                <div class="dt-conv-top">
                                    @if (renamingChatId == conv.Id)
                                    {
                                        <div class="dt-rename-wrap" @onclick:stopPropagation="true">
                                            <input class="dt-rename-input"
                                                   @bind="renameInput"
                                                   @bind:event="oninput"
                                                   @onkeydown="e => HandleRenameKeyDown(e, conv)"
                                                   @onblur="() => CommitRename(conv)"
                                                   autofocus />
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="dt-conv-title">
                                            @(string.IsNullOrWhiteSpace(conv.Title) ? "Untitled session" : conv.Title)
                                        </span>
                                    }
                                </div>
                                <div class="dt-conv-meta">
                                    <span>@FormatRelativeTime(conv.Created)</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        }
    </div>

    <!-- Sidebar Footer: Settings & Context Tracker -->
    <div class="dt-sidebar-footer">
        <button type="button"
                class="dt-sidebar-footer-btn"
                @onclick="OnOpenSettings"
                title="Settings (@Platform.ModifierKeyLabel+,)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
            <span>Settings</span>
        </button>

        @{
            var activeModel = Models?.FirstOrDefault(m => m.Id == SelectedModelId)
                              ?? Session.Models?.FirstOrDefault(m => m.Id == SelectedModelId)
                              ?? Session.Models?.FirstOrDefault(m => m.IsEnabled);
            var breakdown = ContextMeterService.CalculateBreakdown(
                Session.ActiveConversation?.Messages,
                Session.DraftResponse,
                null,
                SelectedModelId,
                activeModel?.ContextLength,
                Session.CurrentStreamingToolCalls
            );
            var healthClass = breakdown.HealthStatus.ToString().ToLowerInvariant();
        }
        <div class="dt-token-meter-wrapper dt-footer-token-meter">
            <button type="button"
                    class="dt-token-meter-pill @healthClass"
                    @onclick="ToggleContextHud"
                    title="Context Window: @ContextMeterService.FormatTokens(breakdown.TotalTokens) / @ContextMeterService.FormatTokens(breakdown.ContextLimit) (@ContextMeterService.FormatPercentage(breakdown.UsagePercentage)) - Click to inspect">
                <span class="dt-token-meter-dot"></span>
                <span class="dt-token-meter-text mono">@ContextMeterService.FormatTokens(breakdown.TotalTokens)</span>
                <span class="dt-token-meter-pct">@ContextMeterService.FormatPercentage(breakdown.UsagePercentage)</span>
            </button>

            @if (isContextHudOpen)
            {
                <div class="dt-context-backdrop" @onclick="() => isContextHudOpen = false"></div>
                <div class="dt-context-hud-popover pop-up" @onclick:stopPropagation="true">
                    <div class="dt-hud-popover-header">
                        <div class="dt-hud-popover-title-row">
                            <span class="dt-hud-popover-title">Context Window</span>
                            <span class="dt-hud-status-badge @healthClass">
                                @breakdown.HealthStatus
                            </span>
                        </div>
                        <div class="dt-hud-popover-model">@(activeModel?.Name ?? SelectedModelId ?? "Default Model")</div>
                    </div>

                    <!-- Proportional segmented bar -->
                    <div class="dt-hud-meter-track" title="@ContextMeterService.FormatPercentage(breakdown.UsagePercentage) used">
                        <div class="dt-hud-bar-segment sys" style="width: @(breakdown.SystemPercentage.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%" title="System: @ContextMeterService.FormatTokens(breakdown.SystemTokens)"></div>
                        <div class="dt-hud-bar-segment msg" style="width: @(breakdown.MessagesPercentage.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%" title="Messages: @ContextMeterService.FormatTokens(breakdown.MessagesTokens)"></div>
                        <div class="dt-hud-bar-segment tool" style="width: @(breakdown.ToolPercentage.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%" title="Tools: @ContextMeterService.FormatTokens(breakdown.ToolTokens)"></div>
                        @if (breakdown.DraftPercentage > 0.1)
                        {
                            <div class="dt-hud-bar-segment draft" style="width: @(breakdown.DraftPercentage.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%" title="Draft: @ContextMeterService.FormatTokens(breakdown.DraftTokens)"></div>
                        }
                    </div>

                    <!-- Details breakdown list -->
                    <div class="dt-hud-popover-details">
                        <div class="dt-hud-popover-row">
                            <div class="dt-hud-popover-legend-label">
                                <span class="dt-hud-legend-dot sys"></span>
                                <span>System & Instructions</span>
                            </div>
                            <span class="dt-hud-popover-val mono">@ContextMeterService.FormatTokens(breakdown.SystemTokens)</span>
                        </div>
                        <div class="dt-hud-popover-row">
                            <div class="dt-hud-popover-legend-label">
                                <span class="dt-hud-legend-dot msg"></span>
                                <span>Conversation Messages (@breakdown.MessageCount)</span>
                            </div>
                            <span class="dt-hud-popover-val mono">@ContextMeterService.FormatTokens(breakdown.MessagesTokens)</span>
                        </div>
                        <div class="dt-hud-popover-row">
                            <div class="dt-hud-popover-legend-label">
                                <span class="dt-hud-legend-dot tool"></span>
                                <span>Tool Execution Results (@breakdown.ToolCallCount)</span>
                            </div>
                            <span class="dt-hud-popover-val mono">@ContextMeterService.FormatTokens(breakdown.ToolTokens)</span>
                        </div>
                        @if (breakdown.DraftTokens > 0)
                        {
                            <div class="dt-hud-popover-row">
                                <div class="dt-hud-popover-legend-label">
                                    <span class="dt-hud-legend-dot draft"></span>
                                    <span>Active Draft</span>
                                </div>
                                <span class="dt-hud-popover-val mono">@ContextMeterService.FormatTokens(breakdown.DraftTokens)</span>
                            </div>
                        }
                        <div class="dt-hud-popover-divider"></div>
                        <div class="dt-hud-popover-row highlight">
                            <span>Remaining Headroom</span>
                            <span class="dt-hud-popover-val mono text-success">@ContextMeterService.FormatTokens(breakdown.RemainingTokens)</span>
                        </div>
                        <div class="dt-hud-popover-row muted">
                            <span>Total Window Limit</span>
                            <span class="dt-hud-popover-val mono">@ContextMeterService.FormatTokens(breakdown.ContextLimit)</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Chat Context Menu -->
    @if (isContextMenuOpen && contextMenuChat != null)
    {
        <div class="dt-context-backdrop" @onclick="CloseContextMenu"></div>
        <div class="dt-context-menu" style="left: @(contextMenuX)px; top: @(contextMenuY)px;" @onclick:stopPropagation="true">
            <div class="dt-context-header">
                <span class="dt-context-title">@(string.IsNullOrWhiteSpace(contextMenuChat.Title) ? "Untitled session" : contextMenuChat.Title)</span>
            </div>
            <div class="dt-context-separator"></div>

            <button type="button" class="dt-context-item" @onclick="HandleAddRefToChat">
                <span>Add to Chat</span>
            </button>

            <button type="button" class="dt-context-item" @onclick="HandleStartRename">
                <span>Rename</span>
            </button>

            <button type="button" class="dt-context-item" @onclick="HandleCopyTitle">
                <span>Copy Title</span>
            </button>

            <button type="button" class="dt-context-item" @onclick="HandleShare">
                <span>Share</span>
            </button>

            <div class="dt-context-separator"></div>

            <button type="button" class="dt-context-item" @onclick="HandleToggleArchive">
                <span>@(archivedChatIds.Contains(contextMenuChat.Id) ? "Unarchive Chat" : "Archive Chat")</span>
            </button>

            <button type="button" class="dt-context-item destructive" @onclick="HandleDeleteChat">
                <span>Delete Chat</span>
            </button>
        </div>
    }
</aside>

@code {
    [Parameter] public IReadOnlyList<ConversationSummary>? Conversations { get; set; }
    [Parameter] public string? ActiveConversationId { get; set; }
    [Parameter] public bool IsOpen { get; set; } = true;
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsStreaming { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
    [Parameter] public EventCallback<string> OnSelectConversation { get; set; }
    [Parameter] public EventCallback OnNewConversation { get; set; }
    [Parameter] public EventCallback<ConversationSummary> OnAddReference { get; set; }
    [Parameter] public EventCallback OnOpenSettings { get; set; }
    [Parameter] public string? SelectedModelId { get; set; }
    [Parameter] public IReadOnlyList<ModelSummary>? Models { get; set; }

    private bool isContextHudOpen = false;
    private void ToggleContextHud() => isContextHudOpen = !isContextHudOpen;

    // Long-press New button state
    private bool isNewMenuOpen = false;
    private CancellationTokenSource? newButtonPressCts;
    private bool isLongPress = false;

    private string searchQuery = "";
    private HashSet<string> archivedChatIds = new();
    private bool isArchivedExpanded = false;

    // Inline rename state
    private string? renamingChatId;
    private string renameInput = "";

    // Context menu state
    private bool isContextMenuOpen = false;
    private ConversationSummary? contextMenuChat;
    private double contextMenuX;
    private double contextMenuY;

    private const string ArchivedFileName = "desktop_archived_chats.json";

    protected override async Task OnInitializedAsync()
    {
        await LoadArchivedStateAsync();
    }

    private ElementReference searchInputRef;

    private async Task HandleSearch(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        try
        {
            await JSRuntime.InvokeVoidAsync("gramDesktop.autoResizeTextarea", searchInputRef);
        }
        catch { }
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await ClearSearch();
        }
    }

    private async Task ClearSearch()
    {
        searchQuery = "";
        try
        {
            await JSRuntime.InvokeVoidAsync("gramDesktop.autoResizeTextarea", searchInputRef);
        }
        catch { }
    }

    private List<ConversationSummary> FilteredConversations =>
        Conversations == null ? new List<ConversationSummary>() :
        Conversations
            .Where(c => !archivedChatIds.Contains(c.Id))
            .Where(c => string.IsNullOrWhiteSpace(searchQuery) || (c.Title ?? "").Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private List<ConversationSummary> ArchivedConversations =>
        Conversations == null ? new List<ConversationSummary>() :
        Conversations
            .Where(c => archivedChatIds.Contains(c.Id))
            .Where(c => string.IsNullOrWhiteSpace(searchQuery) || (c.Title ?? "").Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private Dictionary<string, List<ConversationSummary>> GroupedConversations
    {
        get
        {
            var dict = new Dictionary<string, List<ConversationSummary>>();
            var now = DateTimeOffset.UtcNow;

            foreach (var conv in FilteredConversations)
            {
                var days = (now - conv.Created).TotalDays;
                var key = days < 1 ? "Today" :
                          days < 7 ? "Previous 7 Days" :
                          days < 30 ? "Previous 30 Days" : "Older";

                if (!dict.TryGetValue(key, out var list))
                {
                    list = new List<ConversationSummary>();
                    dict[key] = list;
                }
                list.Add(conv);
            }
            return dict;
        }
    }

    private string FormatRelativeTime(DateTimeOffset dt)
    {
        var span = DateTimeOffset.UtcNow - dt;
        if (span.TotalMinutes < 1) return "Just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return dt.ToString("MMM d");
    }

    private async Task HandleSelectChat(string convId)
    {
        if (renamingChatId == convId) return;
        CloseContextMenu();
        await OnSelectConversation.InvokeAsync(convId);
    }

    private void HandleContextMenu(MouseEventArgs e, ConversationSummary conv)
    {
        contextMenuChat = conv;
        contextMenuX = Math.Max(10, Math.Min(e.ClientX, 220));
        contextMenuY = Math.Max(10, Math.Min(e.ClientY, 550));
        isContextMenuOpen = true;
    }

    private void CloseContextMenu()
    {
        isContextMenuOpen = false;
        contextMenuChat = null;
    }

    private async Task HandleAddRefToChat()
    {
        if (contextMenuChat == null) return;
        var chat = contextMenuChat;
        CloseContextMenu();
        await OnAddReference.InvokeAsync(chat);
    }

    private void HandleStartRename()
    {
        if (contextMenuChat == null) return;
        renamingChatId = contextMenuChat.Id;
        renameInput = contextMenuChat.Title ?? "";
        CloseContextMenu();
    }

    private async Task HandleRenameKeyDown(KeyboardEventArgs e, ConversationSummary conv)
    {
        if (e.Key == "Enter")
        {
            await CommitRename(conv);
        }
        else if (e.Key == "Escape")
        {
            renamingChatId = null;
        }
    }

    private async Task CommitRename(ConversationSummary conv)
    {
        if (renamingChatId == null) return;
        var newTitle = renameInput?.Trim();
        renamingChatId = null;
        if (!string.IsNullOrWhiteSpace(newTitle) && newTitle != conv.Title)
        {
            await Session.RenameConversationAsync(conv.Id, newTitle);
            TabService.UpdateChatTabTitle(conv.Id, newTitle);
        }
    }

    private async Task HandleCopyTitle()
    {
        if (contextMenuChat == null) return;
        var title = contextMenuChat.Title;
        CloseContextMenu();
        try
        {
            await JSRuntime.InvokeVoidAsync("gramDesktop.copyText", title);
        }
        catch {}
    }

    private async Task HandleShare()
    {
        if (contextMenuChat == null) return;
        var chat = contextMenuChat;
        CloseContextMenu();
        var shareText = $"Gram Chat: {chat.Title}\nModel: {chat.ModelId ?? "Default"}\nMessages: {chat.MessageCount}\nCreated: {chat.Created.ToLocalTime():g}";
        try
        {
            await JSRuntime.InvokeVoidAsync("gramDesktop.copyText", shareText);
        }
        catch {}
    }

    private async Task HandleToggleArchive()
    {
        if (contextMenuChat == null) return;
        var chatId = contextMenuChat.Id;
        CloseContextMenu();

        if (archivedChatIds.Contains(chatId))
        {
            archivedChatIds.Remove(chatId);
        }
        else
        {
            archivedChatIds.Add(chatId);
            if (ActiveConversationId == chatId)
            {
                var next = Conversations?.FirstOrDefault(c => !archivedChatIds.Contains(c.Id) && c.Id != chatId);
                if (next != null)
                {
                    await OnSelectConversation.InvokeAsync(next.Id);
                }
                else
                {
                    await OnNewConversation.InvokeAsync();
                }
            }
        }
        await SaveArchivedStateAsync();
    }

    private async Task HandleDeleteChat()
    {
        if (contextMenuChat == null) return;
        var chat = contextMenuChat;
        CloseContextMenu();

        // Close open tab if exists
        var openTab = TabService.OpenTabs.FirstOrDefault(t => t.ChatId == chat.Id);
        if (openTab != null)
        {
            TabService.CloseTab(openTab.Id);
        }

        // If active, select next
        if (ActiveConversationId == chat.Id)
        {
            var next = Conversations?.FirstOrDefault(c => c.Id != chat.Id && !archivedChatIds.Contains(c.Id));
            if (next != null)
            {
                await OnSelectConversation.InvokeAsync(next.Id);
            }
            else
            {
                await OnNewConversation.InvokeAsync();
            }
        }

        await Session.DeleteConversationAsync(chat.Id);
        archivedChatIds.Remove(chat.Id);
        await SaveArchivedStateAsync();
    }

    private async Task LoadArchivedStateAsync()
    {
        try
        {
            var filePath = Path.Combine(StorageService.DataDirectory, ArchivedFileName);
            if (File.Exists(filePath))
            {
                var json = await File.ReadAllTextAsync(filePath);
                var ids = System.Text.Json.JsonSerializer.Deserialize<List<string>>(json);
                if (ids != null)
                {
                    archivedChatIds = new HashSet<string>(ids);
                }
            }
        }
        catch {}
    }

    private async Task SaveArchivedStateAsync()
    {
        try
        {
            var filePath = Path.Combine(StorageService.DataDirectory, ArchivedFileName);
            var json = System.Text.Json.JsonSerializer.Serialize(archivedChatIds.ToList());
            await File.WriteAllTextAsync(filePath, json);
        }
        catch {}
    }

    private void HandleNewButtonMouseDown(MouseEventArgs e)
    {
        if (e.Button != 0) return;
        isLongPress = false;
        newButtonPressCts?.Cancel();
        newButtonPressCts?.Dispose();
        newButtonPressCts = new CancellationTokenSource();
        var token = newButtonPressCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(350, token);
                if (!token.IsCancellationRequested)
                {
                    isLongPress = true;
                    await InvokeAsync(() =>
                    {
                        isNewMenuOpen = true;
                        StateHasChanged();
                    });
                }
            }
            catch (TaskCanceledException) { }
        });
    }

    private void HandleNewButtonMouseUp(MouseEventArgs e)
    {
        if (e.Button != 0) return;
        newButtonPressCts?.Cancel();
    }

    private void HandleNewButtonMouseLeave()
    {
        newButtonPressCts?.Cancel();
    }

    private void HandleNewButtonContextMenu()
    {
        newButtonPressCts?.Cancel();
        isLongPress = false;
        isNewMenuOpen = true;
    }

    private async Task HandleNewButtonClick()
    {
        if (isLongPress)
        {
            isLongPress = false;
            return;
        }

        if (isNewMenuOpen) return;

        await OnNewConversation.InvokeAsync();
    }

    private async Task HandleMenuNewChat()
    {
        isNewMenuOpen = false;
        await OnNewConversation.InvokeAsync();
    }

    private void HandleMenuNewTerminal()
    {
        isNewMenuOpen = false;
        TabService.OpenTerminalTab();
    }

    private void HandleMenuOpenGit()
    {
        isNewMenuOpen = false;
        TabService.OpenGitTab();
    }

    private void HandleMenuToggleSplit()
    {
        isNewMenuOpen = false;
        TabService.ToggleSplitView();
    }
