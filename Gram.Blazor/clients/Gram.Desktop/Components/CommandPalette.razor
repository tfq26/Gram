@namespace Gram.Desktop.Components
@using Gram.Desktop.Services
@using Gram.Blazor.Shared
@inject CommandPaletteService PaletteService
@inject DesktopSession Session
@inject WorkspaceTabService TabService
@inject WorkspaceFileService FileService
@inject PtyTerminalService PtyTerminalService
@inject GitGramService GitGram
@inject DesktopLayoutService LayoutService
@inject IJSRuntime JSRuntime
@implements IDisposable

@if (PaletteService.IsOpen)
{
    <div class="dt-palette-backdrop" @onclick="PaletteService.Close"></div>
    <div class="dt-palette-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-label="Command Palette">
        <!-- Search & Filter Header -->
        <div class="dt-palette-search-box">
            <svg class="dt-palette-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input @ref="searchInputRef"
                   type="text"
                   class="dt-palette-input"
                   placeholder="Type a command or search (chats, files, tabs)..."
                   value="@PaletteService.Query"
                   @oninput="HandleQueryInput"
                   @onkeydown="HandleKeyDown"
                   autofocus />
            <kbd class="dt-palette-esc-key" @onclick="PaletteService.Close">esc</kbd>
        </div>

        <!-- Filter Chips -->
        <div class="dt-palette-chips">
            @foreach (var cat in Enum.GetValues<CommandPaletteCategory>())
            {
                <button type="button"
                        class="dt-palette-chip @(PaletteService.ActiveCategory == cat ? "active" : "")"
                        @onclick="() => PaletteService.SetCategory(cat)">
                    @cat.ToString()
                </button>
            }
        </div>

        <!-- Results List -->
        @{
            var items = GetFilteredItems();
        }
        <div class="dt-palette-list" @ref="listContainerRef">
            @if (items.Count == 0)
            {
                <div class="dt-palette-empty">
                    <span>No matching commands, chats, or files found</span>
                </div>
            }
            else
            {
                @for (int i = 0; i < items.Count; i++)
                {
                    var item = items[i];
                    var isSelected = i == PaletteService.SelectedIndex;
                    var itemIndex = i;

                    <div class="dt-palette-item @(isSelected ? "selected" : "")"
                         @onclick="() => ExecuteItem(item)"
                         @onmouseenter="() => PaletteService.SetSelectedIndex(itemIndex)">
                        <div class="dt-palette-item-icon">
                            @if (!string.IsNullOrWhiteSpace(item.IconSvg))
                            {
                                @((MarkupString)item.IconSvg)
                            }
                            else
                            {
                                <span>✦</span>
                            }
                        </div>
                        <div class="dt-palette-item-content">
                            <span class="dt-palette-item-title">@item.Title</span>
                            @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                            {
                                <span class="dt-palette-item-sub">@item.Subtitle</span>
                            }
                        </div>
                        <div class="dt-palette-item-meta">
                            <span class="dt-palette-cat-badge @item.Category.ToString().ToLowerInvariant()">@item.Category</span>
                            @if (!string.IsNullOrWhiteSpace(item.Shortcut))
                            {
                                <span class="dt-palette-shortcut">@item.Shortcut</span>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Footer Shortcuts -->
        <div class="dt-palette-footer">
            <div class="dt-palette-footer-hint">
                <kbd>↑</kbd><kbd>↓</kbd> <span>Navigate</span>
            </div>
            <div class="dt-palette-footer-hint">
                <kbd>↵</kbd> <span>Select</span>
            </div>
            <div class="dt-palette-footer-hint">
                <kbd>esc</kbd> <span>Close</span>
            </div>
            <div class="dt-palette-footer-count">
                <span>@items.Count results</span>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback<string> OnSelectConversation { get; set; }
    [Parameter] public EventCallback OnNewConversation { get; set; }
    [Parameter] public EventCallback OnToggleSidebar { get; set; }
    [Parameter] public EventCallback OnToggleInfosheet { get; set; }
    [Parameter] public EventCallback OnToggleExpandedChat { get; set; }
    [Parameter] public EventCallback OnOpenSettings { get; set; }
    [Parameter] public EventCallback<string> OnInsertPrompt { get; set; }

    private ElementReference searchInputRef;
    private ElementReference listContainerRef;

    protected override void OnInitialized()
    {
        PaletteService.OnChange += HandleServiceChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (PaletteService.IsOpen)
        {
            try
            {
                await searchInputRef.FocusAsync();
            }
            catch {}
        }
    }

    private void HandleServiceChange() => InvokeAsync(StateHasChanged);

    private void HandleQueryInput(ChangeEventArgs e)
    {
        PaletteService.SetQuery(e.Value?.ToString() ?? "");
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        var items = GetFilteredItems();
        if (items.Count == 0)
        {
            if (e.Key == "Escape") PaletteService.Close();
            return;
        }

        switch (e.Key)
        {
            case "ArrowDown":
                var next = (PaletteService.SelectedIndex + 1) % items.Count;
                PaletteService.SetSelectedIndex(next);
                break;
            case "ArrowUp":
                var prev = (PaletteService.SelectedIndex - 1 + items.Count) % items.Count;
                PaletteService.SetSelectedIndex(prev);
                break;
            case "Enter":
                if (PaletteService.SelectedIndex >= 0 && PaletteService.SelectedIndex < items.Count)
                {
                    await ExecuteItem(items[PaletteService.SelectedIndex]);
                }
                break;
            case "Escape":
                PaletteService.Close();
                break;
        }
    }

    private async Task ExecuteItem(CommandPaletteItem item)
    {
        PaletteService.Close();
        if (item.ActionAsync != null)
        {
            await item.ActionAsync();
        }
        else
        {
            item.Action?.Invoke();
        }
    }

    private List<CommandPaletteItem> GetFilteredItems()
    {
        var list = new List<CommandPaletteItem>();
        var query = PaletteService.Query.Trim();
        var cat = PaletteService.ActiveCategory;

        // 1. Core Commands
        if (cat == CommandPaletteCategory.All || cat == CommandPaletteCategory.Command)
        {
            list.Add(new CommandPaletteItem
            {
                Title = "New Chat",
                Subtitle = "Create a fresh conversation context",
                Category = CommandPaletteCategory.Command,
                Shortcut = "⌘T",
                IconSvg = "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"/><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/></svg>",
                ActionAsync = async () => await OnNewConversation.InvokeAsync()
            });

            list.Add(new CommandPaletteItem
            {
                Title = "Open Terminal",
                Subtitle = "Interactive PTY shell terminal tab",
                Category = CommandPaletteCategory.Command,
                Shortcut = "⌃~",
                IconSvg = "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polyline points=\"4 17 10 11 4 5\"/><line x1=\"12\" y1=\"19\" x2=\"20\" y2=\"19\"/></svg>",
                Action = () => TabService.OpenTerminalTab()
            });

            list.Add(new CommandPaletteItem
            {
                Title = "Source Control & Git Changes",
                Subtitle = "Inspect changed files, unified diffs, and staging",
                Category = CommandPaletteCategory.Command,
                Shortcut = "⌥G",
                IconSvg = "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"18\" cy=\"18\" r=\"3\"/><circle cx=\"6\" cy=\"6\" r=\"3\"/><path d=\"M6 9v12\"/><path d=\"M18 9a9 9 0 0 0-9-9\"/></svg>",
                Action = () => TabService.OpenGitTab()
            });

            list.Add(new CommandPaletteItem
            {
                Title = "Toggle Split View",
                Subtitle = "Side-by-side tabs for chat, code, and terminal",
                Category = CommandPaletteCategory.Command,
                Shortcut = "⌘\\",
                IconSvg = "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"21\"/></svg>",
                Action = () => TabService.ToggleSplitView()
            });

            list.Add(new CommandPaletteItem
            {
                Title = "Toggle Sidebar",
                Subtitle = "Show or hide the conversations sidebar",
                Category = CommandPaletteCategory.Command,
                Shortcut = "⌘B",
                IconSvg = "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><line x1=\"9\" y1=\"3\" x2=\"9\" y2=\"21\"/></svg>",
                ActionAsync = async () => await OnToggleSidebar.InvokeAsync()
            });

            list.Add(new CommandPaletteItem
            {
                Title = "Toggle Info Sheet",
                Subtitle = "Show or hide inspector sheet for active tab",
                Category = CommandPaletteCategory.Command,
                Shortcut = "⌘I",
                IconSvg = "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><line x1=\"15\" y1=\"3\" x2=\"15\" y2=\"21\"/></svg>",
                ActionAsync = async () => await OnToggleInfosheet.InvokeAsync()
            });

            list.Add(new CommandPaletteItem
            {
                Title = "Toggle Expanded Chat",
                Subtitle = "Widen chat horizon and minimize side panes",
                Category = CommandPaletteCategory.Command,
                Shortcut = "⌘E",
                IconSvg = "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polyline points=\"15 3 21 3 21 9\"/><polyline points=\"9 21 3 21 3 15\"/><line x1=\"21\" y1=\"3\" x2=\"14\" y2=\"10\"/><line x1=\"3\" y1=\"21\" x2=\"10\" y2=\"14\"/></svg>",
                ActionAsync = async () => await OnToggleExpandedChat.InvokeAsync()
            });

            list.Add(new CommandPaletteItem
            {
                Title = "Open Settings",
                Subtitle = "Models, API keys, providers, and themes",
                Category = CommandPaletteCategory.Command,
                Shortcut = "⌘,",
                IconSvg = "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z\"/></svg>",
                ActionAsync = async () => await OnOpenSettings.InvokeAsync()
            });

            list.Add(new CommandPaletteItem
            {
                Title = "Build Solution",
                Subtitle = "Run dotnet build in active workspace terminal",
                Category = CommandPaletteCategory.Command,
                Shortcut = "⌘⇧B",
                IconSvg = "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\"/></svg>",
                ActionAsync = async () =>
                {
                    TabService.OpenTerminalTab();
                    if (TabService.ActiveTab != null)
                    {
                        await PtyTerminalService.WriteInputAsync(TabService.ActiveTab.Id, "dotnet build\n");
                    }
                }
            });

            list.Add(new CommandPaletteItem
            {
                Title = "Run Unit Tests",
                Subtitle = "Execute test runner in terminal",
                Category = CommandPaletteCategory.Command,
                Shortcut = "⌘⇧T",
                IconSvg = "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"/><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"/><polyline points=\"10 9 9 9 8 9\"/></svg>",
                ActionAsync = async () =>
                {
                    TabService.OpenTerminalTab();
                    if (TabService.ActiveTab != null)
                    {
                        await PtyTerminalService.WriteInputAsync(TabService.ActiveTab.Id, "dotnet test\n");
                    }
                }
            });

            list.Add(new CommandPaletteItem
            {
                Title = "Scan & Inspect Git",
                Subtitle = "Refresh git status and inspect changes",
                Category = CommandPaletteCategory.Command,
                IconSvg = "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 6L9 17l-5-5\"/></svg>",
                ActionAsync = async () =>
                {
                    await GitGram.RefreshAsync(Session.WorkspacePath);
                    TabService.OpenGitTab();
                }
            });
        }

        // 2. Open Workspace Tabs
        if (cat == CommandPaletteCategory.All || cat == CommandPaletteCategory.Tab)
        {
            foreach (var tab in TabService.OpenTabs)
            {
                var targetTab = tab;
                list.Add(new CommandPaletteItem
                {
                    Title = $"Tab: {targetTab.Title}",
                    Subtitle = targetTab.Type switch
                    {
                        WorkspaceTabType.Chat => "Chat session",
                        WorkspaceTabType.Terminal => "Terminal shell",
                        WorkspaceTabType.Git => "Source control inspector",
                        _ => "Workspace tab"
                    },
                    Category = CommandPaletteCategory.Tab,
                    IconSvg = targetTab.Type == WorkspaceTabType.Terminal
                        ? "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polyline points=\"4 17 10 11 4 5\"/><line x1=\"12\" y1=\"19\" x2=\"20\" y2=\"19\"/></svg>"
                        : targetTab.Type == WorkspaceTabType.Git
                            ? "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"18\" cy=\"18\" r=\"3\"/><circle cx=\"6\" cy=\"6\" r=\"3\"/></svg>"
                            : "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"/></svg>",
                    ActionAsync = async () =>
                    {
                        TabService.SelectTab(targetTab.Id);
                        if (!string.IsNullOrWhiteSpace(targetTab.ChatId))
                        {
                            await OnSelectConversation.InvokeAsync(targetTab.ChatId);
                        }
                    }
                });
            }
        }

        // 3. Saved Conversations (Chats)
        if (cat == CommandPaletteCategory.All || cat == CommandPaletteCategory.Chat)
        {
            foreach (var conv in Session.Conversations.Take(25))
            {
                var targetConv = conv;
                list.Add(new CommandPaletteItem
                {
                    Title = targetConv.Title,
                    Subtitle = $"{targetConv.MessageCount} messages · updated {targetConv.Updated:MMM d, HH:mm}",
                    Category = CommandPaletteCategory.Chat,
                    IconSvg = "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"/></svg>",
                    ActionAsync = async () =>
                    {
                        await OnSelectConversation.InvokeAsync(targetConv.Id);
                    }
                });
            }
        }

        // 4. Workspace Files
        if (cat == CommandPaletteCategory.All || cat == CommandPaletteCategory.File)
        {
            var files = FileService.CachedEntries.Take(60);
            foreach (var f in files)
            {
                var targetFile = f;
                list.Add(new CommandPaletteItem
                {
                    Title = targetFile.FileName,
                    Subtitle = targetFile.RelativePath,
                    Category = CommandPaletteCategory.File,
                    IconSvg = "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z\"/><polyline points=\"13 2 13 9 20 9\"/></svg>",
                    ActionAsync = async () =>
                    {
                        await OnInsertPrompt.InvokeAsync($"@{targetFile.RelativePath} ");
                    }
                });
            }
        }

        // Filter by Query string
        if (!string.IsNullOrWhiteSpace(query))
        {
            list = list.Where(item =>
                item.Title.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                (item.Subtitle != null && item.Subtitle.Contains(query, StringComparison.OrdinalIgnoreCase))
            ).ToList();
        }

        return list;
    }

    public void Dispose()
    {
        PaletteService.OnChange -= HandleServiceChange;
    }
}
