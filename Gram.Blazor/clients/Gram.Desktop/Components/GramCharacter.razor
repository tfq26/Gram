@namespace Gram.Desktop.Components
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div @ref="elementRef"
     id="@elementId"
     class="gram-character-container @Class @(isWaving ? "state-wave" : "") @(isThinking ? "state-thinking" : "") @(isLookingDown ? "state-lookdown" : "") @(isResearching ? "state-researching" : "") @(isDesigning ? "state-designing" : "") @(isReviewing ? "state-reviewing" : "") @(isComplete ? "state-complete" : "") @(isLanding ? "state-landing is-jumping" : "") @(isTypingName ? "state-typing-name is-recognizing" : "") @(isTypingPassword ? "state-typing-password is-covering-eyes" : "") @(isVoiceListening ? "state-voice-listening is-voice-listening" : "") @(isVoiceThinking ? "state-voice-thinking is-voice-thinking" : "") @(isVoiceSpeaking ? "state-voice-speaking is-voice-speaking" : "") @(isVoiceInterrupted ? "state-voice-interrupted is-voice-interrupted" : "")"
     style="width: @(Size)px; height: @(Size)px; display: inline-flex; align-items: center; justify-content: center; position: relative; overflow: visible; @Style"
     @onclick="HandleClick">
    
    <svg class="gram-character-svg" viewBox="@ComputedViewBox" width="100%" height="100%" fill="none" style="overflow: visible; display: block;">
        <defs>
            <!-- Refined Studio Lighting & Restrained Violet -->
            <linearGradient id="@($"charGrad_{uniqueId}")" x1="15%" y1="10%" x2="85%" y2="95%">
                <stop offset="0%" stop-color="#a78bfa" />
                <stop offset="45%" stop-color="#7c3aed" />
                <stop offset="100%" stop-color="#581c87" />
            </linearGradient>

            <!-- Soft expressive brow gradient -->
            <linearGradient id="@($"browPlateGrad_{uniqueId}")" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#4c1d95" />
                <stop offset="58%" stop-color="#2e1065" />
                <stop offset="100%" stop-color="#1e0a45" />
            </linearGradient>

            <!-- Holographic Watch Glow Gradient -->
            <linearGradient id="@($"watchGrad_{uniqueId}")" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#38bdf8" />
                <stop offset="100%" stop-color="#818cf8" />
            </linearGradient>

            <!-- Bright Glowing Eye Pupil Gradient -->
            <linearGradient id="@($"pupilGrad_{uniqueId}")" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#ffffff" />
                <stop offset="100%" stop-color="#ffffff" />
            </linearGradient>

            <linearGradient id="@($"voiceMicGrad_{uniqueId}")" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#f5eaff" />
                <stop offset="38%" stop-color="#c084fc" />
                <stop offset="100%" stop-color="#6b21a8" />
            </linearGradient>

            <filter id="@($"charGlow_{uniqueId}")" x="-25%" y="-25%" width="150%" height="150%">
                <feDropShadow dx="0" dy="3" stdDeviation="4" flood-color="#000000" flood-opacity="0.45" />
            </filter>

            <filter id="@($"eyeGlow_{uniqueId}")" x="-30%" y="-30%" width="160%" height="160%">
                <feDropShadow dx="0" dy="0" stdDeviation="1.5" flood-color="#c4b5fd" flood-opacity="0.4" />
            </filter>

            <filter id="@($"holoGlow_{uniqueId}")" x="-30%" y="-30%" width="160%" height="160%">
                <feDropShadow dx="0" dy="0" stdDeviation="3" flood-color="#38bdf8" flood-opacity="0.5" />
            </filter>
        </defs>

        <!-- Ambient Floating Root Group (Breathing Motion) -->
        <g class="gram-char-float">
            
            <!-- Soft Shadow / Ambient Floor Aura -->
            <ellipse class="gram-char-aura" cx="64" cy="123" rx="30" ry="3.5" fill="rgba(0, 0, 0, 0.4)" filter="blur(2px)" />

            <!-- Glass Tap Impact Ripple Rings -->
            <g class="gram-char-glass-ripple" style="opacity: 0;">
                <circle cx="64" cy="58" r="8" fill="none" stroke="#e9d5ff" stroke-width="1.2" />
                <circle cx="64" cy="58" r="16" fill="none" stroke="#c084fc" stroke-width="0.8" opacity="0.6" />
                <circle cx="64" cy="58" r="24" fill="none" stroke="#9333ea" stroke-width="0.5" opacity="0.3" />
            </g>

            <!-- Holographic Watch Projection (for Check-Watch idle) -->
            <g class="gram-char-holo-watch" transform="translate(36, 76)" style="opacity: 0;">
                <circle cx="0" cy="0" r="10" fill="rgba(56, 189, 248, 0.15)" stroke="url(#@($"watchGrad_{uniqueId}"))" stroke-width="1.2" filter="url(#@($"holoGlow_{uniqueId}"))" />
                <circle cx="0" cy="0" r="3" fill="#ffffff" />
                <!-- Clock Hands -->
                <line x1="0" y1="0" x2="0" y2="-5" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round" />
                <line x1="0" y1="0" x2="4" y2="0" stroke="#38bdf8" stroke-width="1.2" stroke-linecap="round" />
                <circle cx="0" cy="0" r="13" stroke="rgba(56, 189, 248, 0.4)" stroke-width="0.6" stroke-dasharray="2 2" />
            </g>

            <!-- Articulated Floating Robot Hand (Wave, Check Watch, Glass Tap) -->
            <g class="gram-char-hand" transform="translate(119, 61)" style="opacity: 0;">
                <g class="gram-char-hand-motion" filter="url(#@($"charGlow_{uniqueId}"))">
                    <!-- Soft aura behind the glove -->
                    <ellipse cx="4.5" cy="1" rx="14" ry="17" fill="rgba(168, 85, 247, 0.12)" />

                    <!-- Four rounded fingers -->
                    <rect x="-3.2" y="-9.3" width="5" height="13.2" rx="2.5"
                          transform="rotate(-16 -0.7 -2.7)"
                          fill="url(#@($"charGrad_{uniqueId}"))"
                          stroke="rgba(233, 213, 255, 0.42)" stroke-width="0.75" />
                    <rect x="1.1" y="-14.4" width="5" height="17.2" rx="2.5"
                          transform="rotate(-5 3.6 -5.8)"
                          fill="url(#@($"charGrad_{uniqueId}"))"
                          stroke="rgba(233, 213, 255, 0.46)" stroke-width="0.75" />
                    <rect x="5.6" y="-15.7" width="5" height="18.3" rx="2.5"
                          transform="rotate(4 8.1 -6.5)"
                          fill="url(#@($"charGrad_{uniqueId}"))"
                          stroke="rgba(233, 213, 255, 0.48)" stroke-width="0.75" />
                    <rect x="10" y="-12.4" width="4.8" height="15.4" rx="2.4"
                          transform="rotate(13 12.4 -4.7)"
                          fill="url(#@($"charGrad_{uniqueId}"))"
                          stroke="rgba(233, 213, 255, 0.42)" stroke-width="0.75" />

                    <!-- Rounded palm -->
                    <path d="M -2.1 -0.8
                             C 0.2 -2.7, 10.2 -2.7, 12.8 -0.4
                             C 14.7 1.3, 14.4 8.1, 11.8 10.8
                             C 9.2 13.5, 1.4 13.8, -1.2 11.1
                             C -3.5 8.7, -4.3 1.3, -2.1 -0.8 Z"
                          fill="url(#@($"charGrad_{uniqueId}"))"
                          stroke="rgba(243, 232, 255, 0.48)" stroke-width="0.9" />

                    <!-- Separate curled thumb -->
                    <path d="M -1.4 2.1
                             C -4.1 -0.4, -7.6 0.5, -7.9 3.2
                             C -8.2 5.2, -5.7 8.2, -1.8 9.2"
                          fill="none"
                          stroke="url(#@($"charGrad_{uniqueId}"))"
                          stroke-width="5.2" stroke-linecap="round" />

                    <!-- Knuckle lights -->
                    <circle cx="0.3" cy="1.2" r="1" fill="#e9d5ff" opacity="0.76" />
                    <circle cx="4.2" cy="0.1" r="1" fill="#e9d5ff" opacity="0.82" />
                    <circle cx="8.3" cy="0" r="1" fill="#e9d5ff" opacity="0.84" />
                    <circle cx="12" cy="1.1" r="0.9" fill="#e9d5ff" opacity="0.72" />

                    <!-- Wrist cuff -->
                    <path d="M 0.2 10.5 L 11.4 10.5 L 10.6 15.4
                             C 8 16.7, 3.4 16.7, 0.8 15.2 Z"
                          fill="#160724" stroke="rgba(192, 132, 252, 0.55)" stroke-width="0.9" />
                    <rect x="2.6" y="12.2" width="6.8" height="1.35" rx="0.68" fill="#a855f7" opacity="0.72" />
                </g>
            </g>

            <!-- Main Head Group -->
            <g class="gram-char-head">
                
                <!-- 1. Elongated Hexagon Body Shell (Spins independently during Body Spin!) -->
                <g class="gram-char-body-shell">
                    <path d="M 60.8 9.7 
                             C 62.7 8.6, 65.3 8.6, 67.2 9.7 
                             L 107.8 33.7 
                             C 109.8 34.9, 111 37.0, 111 39.3 
                             V 88.7 
                             C 111 91.0, 109.8 93.1, 107.8 94.3 
                             L 67.2 118.3 
                             C 65.3 119.4, 62.7 119.4, 60.8 118.3 
                             L 20.2 94.3 
                             C 18.2 93.1, 17 91.0, 17 88.7 
                             V 39.3 
                             C 17 37.0, 18.2 34.9, 20.2 33.7 Z"
                          fill="url(#@($"charGrad_{uniqueId}"))"
                          filter="url(#@($"charGlow_{uniqueId}"))" />

                    <!-- Cybernetic Facet Accent Ridges -->
                    <path d="M 64 10 L 64 36" stroke="rgba(255, 255, 255, 0.12)" stroke-width="1" />
                    <path d="M 18 39 L 45 46" stroke="rgba(255, 255, 255, 0.08)" stroke-width="1" />
                    <path d="M 110 39 L 83 46" stroke="rgba(255, 255, 255, 0.08)" stroke-width="1" />
                </g>

                <!-- 2. Eyebrows (Stay rock-solid & looking at user during body spin) -->
                <!-- Left Brow -->
                <g transform="translate(45, 41)">
                    <g class="gram-char-brow-l">
                        <path class="gram-char-brow-core"
                              d="M -10.5 2 C -5.2 -1.1, 3.2 -1.5, 10.5 1.2"
                              stroke="url(#@($"browPlateGrad_{uniqueId}"))" stroke-width="4.25" stroke-linecap="round" />
                        <path class="gram-char-brow-sheen"
                              d="M -9.4 1.25 C -4.5 -1.05, 2.5 -1.3, 9.3 0.72"
                              stroke="rgba(216, 180, 254, 0.42)" stroke-width="0.75" stroke-linecap="round" />
                    </g>
                </g>

                <!-- Right Brow -->
                <g transform="translate(83, 41)">
                    <g class="gram-char-brow-r">
                        <path class="gram-char-brow-core"
                              d="M -10.5 1.2 C -3.2 -1.5, 5.2 -1.1, 10.5 2"
                              stroke="url(#@($"browPlateGrad_{uniqueId}"))" stroke-width="4.25" stroke-linecap="round" />
                        <path class="gram-char-brow-sheen"
                              d="M -9.3 0.72 C -2.5 -1.3, 4.5 -1.05, 9.4 1.25"
                              stroke="rgba(216, 180, 254, 0.42)" stroke-width="0.75" stroke-linecap="round" />
                    </g>
                </g>

                <!-- 3. Eye Sockets & Glowing Squircle Pupils (Stay rock-solid during body spin) -->
                <!-- Left Eye Socket -->
                <rect x="34" y="51" width="22" height="22" rx="6" fill="#06020a" stroke="rgba(255, 255, 255, 0.05)" stroke-width="0.75" />
                <g transform="translate(45, 62)">
                    <g class="gram-char-gaze gram-char-gaze-l">
                        <g class="gram-char-blink">
                            <rect x="-7" y="-7" width="14" height="14" rx="4"
                                  fill="url(#@($"pupilGrad_{uniqueId}"))" 
                                  filter="url(#@($"eyeGlow_{uniqueId}"))" />
                        </g>
                    </g>
                </g>

                <!-- Right Eye Socket -->
                <rect x="72" y="51" width="22" height="22" rx="6" fill="#06020a" stroke="rgba(255, 255, 255, 0.05)" stroke-width="0.75" />
                <g transform="translate(83, 62)">
                    <g class="gram-char-gaze gram-char-gaze-r">
                        <g class="gram-char-blink">
                            <rect x="-7" y="-7" width="14" height="14" rx="4"
                                  fill="url(#@($"pupilGrad_{uniqueId}"))" 
                                  filter="url(#@($"eyeGlow_{uniqueId}"))" />
                        </g>
                    </g>
                </g>

                <!-- Handheld voice microphone; state CSS moves it between user-facing and speaking positions. -->
                <g class="gram-char-voice-mic" aria-hidden="true">
                    <path class="gram-char-voice-mic-arm" d="M 111 82 C 101 82, 94 78, 87 74" fill="none" stroke="#6b21a8" stroke-width="5" stroke-linecap="round" />
                    <rect class="gram-char-voice-mic-body" x="78" y="52" width="13" height="25" rx="6.5" fill="url(#@($"voiceMicGrad_{uniqueId}"))" stroke="#f3e8ff" stroke-width="0.9" />
                    <path class="gram-char-voice-mic-grille" d="M 81 57 H 88 M 80.5 60 H 88.5 M 80.5 63 H 88.5 M 81 66 H 88" fill="none" stroke="#4c1d95" stroke-width="1.05" stroke-linecap="round" />
                    <path d="M 75 74 Q 84.5 84 94 74" fill="none" stroke="#a855f7" stroke-width="1.8" stroke-linecap="round" />
                    <path d="M 84.5 83 V 91" fill="none" stroke="#c084fc" stroke-width="1.8" stroke-linecap="round" />
                    <path d="M 79.5 91 H 89.5" fill="none" stroke="#f3e8ff" stroke-width="1.4" stroke-linecap="round" />
                </g>

            </g>
        </g>
    </svg>
</div>

@code {
    [Parameter] public int Size { get; set; } = 96;
    [Parameter] public string State { get; set; } = "idle";
    [Parameter] public bool Interactive { get; set; } = true;
    [Parameter] public bool AutoWaveOnLoad { get; set; } = true;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";
    [Parameter] public string? ViewBox { get; set; }

    private string ComputedViewBox => !string.IsNullOrWhiteSpace(ViewBox)
        ? ViewBox
        : (Interactive ? "-28 -28 200 186" : "0 0 144 130");

    private ElementReference elementRef;
    private string uniqueId = Guid.NewGuid().ToString("N").Substring(0, 8);
    private string elementId => $"gram_char_{uniqueId}";
    private bool isInitialized = false;
    private string? lastAppliedState;

    private bool isWaving => State == "wave";
    private bool isThinking => State == "thinking";
    private bool isLookingDown => State == "look_down" || State == "typing";
    private bool isResearching => State == "researching" || State == "planning";
    private bool isDesigning => State == "designing" || State == "assembling";
    private bool isReviewing => State == "reviewing";
    private bool isComplete => State == "complete";
    private bool isLanding => State == "landing" || State == "excited" || State == "jump";
    private bool isTypingName => State == "typing_name" || State == "name" || State == "recognize";
    private bool isTypingPassword => State == "typing_password" || State == "password" || State == "peek_cover" || State == "shy";
    private bool isVoiceListening => State == "voice_listening" || State == "listening";
    private bool isVoiceThinking => State == "voice_thinking";
    private bool isVoiceSpeaking => State == "voice_speaking" || State == "speaking";
    private bool isVoiceInterrupted => State == "voice_interrupted" || State == "interrupted";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Interactive) return;

        if (firstRender && !isInitialized)
        {
            try
            {
                isInitialized = true;
                lastAppliedState = State;
                await JSRuntime.InvokeVoidAsync("gramCharacter.init", elementId, new
                {
                    state = State,
                    interactive = Interactive,
                    autoWaveOnLoad = AutoWaveOnLoad
                });
            }
            catch { }
        }
        else if (isInitialized && State != lastAppliedState)
        {
            lastAppliedState = State;
            try
            {
                await JSRuntime.InvokeVoidAsync("gramCharacter.setState", elementId, State);
            }
            catch { }
        }
    }

    private async Task HandleClick()
    {
        if (!Interactive) return;
        try
        {
            // Rotate through rich noticeable interactions on user click
            var actions = new[] { "wave", "body_spin", "tap_glass", "check_watch" };
            var randomAction = actions[Random.Shared.Next(actions.Length)];
            await JSRuntime.InvokeVoidAsync("gramCharacter.setState", elementId, randomAction, 2800);
        }
        catch { }
    }

    public async ValueTask DisposeAsync()
    {
        if (isInitialized && Interactive)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("gramCharacter.destroy", elementId);
            }
            catch { }
        }
    }
}
