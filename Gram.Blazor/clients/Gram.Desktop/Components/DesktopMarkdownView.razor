@namespace Gram.Desktop.Components
@using Gram.Blazor.Shared
@inject MarkdownService MarkdownService
@inject IJSRuntime JSRuntime

<div @ref="markdownElement" class="dt-markdown-body @Class">
    @((MarkupString)renderedHtml)
</div>

@code {
    [Parameter] public string? Content { get; set; }
    [Parameter] public string Class { get; set; } = "";
    private ElementReference markdownElement;
    private string? lastContent;
    private string renderedHtml = "";
    private bool contentChanged = false;

    protected override void OnParametersSet()
    {
        if (Content != lastContent)
        {
            lastContent = Content;
            renderedHtml = MarkdownService.RenderToHtml(Content);
            contentChanged = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || contentChanged)
        {
            contentChanged = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("gramAudio.renderMath", markdownElement);
            }
            catch
            {
                // Ignore JS interop exceptions during fast DOM teardown
            }
        }
    }
}
