@namespace Gram.Desktop.Components
@using Gram.Desktop.Components.Platform
@using Gram.Desktop.Services
@using Gram.Blazor.Shared
@using System.Runtime.InteropServices
@inject IPlatformService Platform
@inject WorkspaceTabService TabService
@inject DesktopSession Session
@inject TopBarService TopBarService
@inject CommandPaletteService PaletteService
@inject IJSRuntime JSRuntime
@implements IDisposable

<header class="dt-topbar dt-unified-topbar @Platform.PlatformCssClass" data-ui-region="unified-topbar" role="banner">
    <!-- LEFT: Workspace Tab Strip -->
    <div class="dt-topbar-left">
        <!-- Unified Tab Strip -->
        <div class="dt-canvas-tabs-container dt-unified-tabs" data-ui-region="canvas-tabs">
            <div class="dt-tabs-scroll-area" @ref="tabsScrollRef">
                @{
                    var renderedSplitIds = new HashSet<string>();
                }
                @foreach (var tab in TabService.OpenTabs)
                {
                    if (renderedSplitIds.Contains(tab.Id)) continue;

                    if (!string.IsNullOrEmpty(tab.SplitLinkedTabId))
                    {
                        var partner = TabService.OpenTabs.FirstOrDefault(t => t.Id == tab.SplitLinkedTabId);
                        if (partner != null)
                        {
                            renderedSplitIds.Add(tab.Id);
                            renderedSplitIds.Add(partner.Id);
                            var isPairActive = TabService.ActiveTabId == tab.Id || TabService.ActiveTabId == partner.Id;

                            <div class="dt-tab dt-split-tab-pill @(isPairActive ? "active" : "")"
                                 draggable="true"
                                 @ondragstart="() => HandleDragStart(tab.Id)"
                                 @ondragover:preventDefault="true"
                                 @ondrop="() => HandleDropOnTab(tab.Id)">

                                <!-- Left Segment -->
                                <div class="dt-split-segment @(TabService.ActiveTabId == tab.Id ? "focused" : "")"
                                     @onclick="(e) => HandleTabClick(e, tab)"
                                     @oncontextmenu="(e) => HandleTabContextMenu(e, tab)"
                                     @oncontextmenu:preventDefault="true"
                                     title="@tab.Title">
                                    @if (tab.IsPinned)
                                    {
                                        <span class="dt-tab-pin-icon" title="Pinned tab">📌</span>
                                    }
                                    else if (tab.Type == WorkspaceTabType.Terminal)
                                    {
                                        <span class="dt-tab-terminal-icon" style="margin-right: 4px; display: inline-flex; align-items: center;"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg></span>
                                    }
                                    else if (tab.Type == WorkspaceTabType.Git)
                                    {
                                        <span class="dt-tab-git-icon" style="margin-right: 4px; display: inline-flex; align-items: center;"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="18" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><path d="M6 9v12"></path><path d="M18 9a9 9 0 0 0-9-9"></path></svg></span>
                                    }
                                    <span class="dt-tab-title">@tab.Title</span>
                                    <button type="button"
                                            class="dt-tab-close"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => HandleCloseTab(tab)"
                                            title="Close tab (unlinks split)">✕</button>
                                </div>

                                <div class="dt-split-segment-divider" title="Linked split tab"></div>

                                <!-- Right Segment -->
                                <div class="dt-split-segment @(TabService.ActiveTabId == partner.Id ? "focused" : "")"
                                     @onclick="(e) => HandleTabClick(e, partner)"
                                     @oncontextmenu="(e) => HandleTabContextMenu(e, partner)"
                                     @oncontextmenu:preventDefault="true"
                                     title="@partner.Title">
                                    @if (partner.IsPinned)
                                    {
                                        <span class="dt-tab-pin-icon" title="Pinned tab">📌</span>
                                    }
                                    else if (partner.Type == WorkspaceTabType.Terminal)
                                    {
                                        <span class="dt-tab-terminal-icon" style="margin-right: 4px; display: inline-flex; align-items: center;"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg></span>
                                    }
                                    else if (partner.Type == WorkspaceTabType.Git)
                                    {
                                        <span class="dt-tab-git-icon" style="margin-right: 4px; display: inline-flex; align-items: center;"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="18" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><path d="M6 9v12"></path><path d="M18 9a9 9 0 0 0-9-9"></path></svg></span>
                                    }
                                    <span class="dt-tab-title">@partner.Title</span>
                                    <button type="button"
                                            class="dt-tab-close"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => HandleCloseTab(partner)"
                                            title="Close tab (unlinks split)">✕</button>
                                </div>
                            </div>
                            continue;
                        }
                    }

                    renderedSplitIds.Add(tab.Id);
                    var isCurrent = TabService.ActiveTabId == tab.Id;
                    var isMultiSelected = selectedTabIds.Contains(tab.Id);

                    <div class="dt-tab @(isCurrent ? "active" : "") @(isMultiSelected ? "selected" : "")"
                         draggable="true"
                         @ondragstart="() => HandleDragStart(tab.Id)"
                         @ondragover:preventDefault="true"
                         @ondrop="() => HandleDropOnTab(tab.Id)"
                         @onclick="(e) => HandleTabClick(e, tab)"
                         @oncontextmenu="(e) => HandleTabContextMenu(e, tab)"
                         @oncontextmenu:preventDefault="true"
                         title="@tab.Title">
                        @if (tab.IsPinned)
                        {
                            <span class="dt-tab-pin-icon" title="Pinned tab">📌</span>
                        }
                        else if (tab.Type == WorkspaceTabType.Terminal)
                        {
                            <span class="dt-tab-terminal-icon" style="margin-right: 4px; display: inline-flex; align-items: center;"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg></span>
                        }
                        else if (tab.Type == WorkspaceTabType.Git)
                        {
                            <span class="dt-tab-git-icon" style="margin-right: 4px; display: inline-flex; align-items: center;"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="18" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><path d="M6 9v12"></path><path d="M18 9a9 9 0 0 0-9-9"></path></svg></span>
                        }
                        <span class="dt-tab-title">@tab.Title</span>
                        @if (TabService.OpenTabs.Count > 1 && !tab.IsPinned)
                        {
                            <button type="button"
                                    class="dt-tab-close"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => HandleCloseTab(tab)"
                                    title="Close tab">✕</button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- CENTER: Context Widget (if set) -->
    @if (TopBarService.CenterWidget != null)
    {
        <div class="dt-topbar-center">
            @TopBarService.CenterWidget
        </div>
    }

    <!-- RIGHT: Contextual Actions & Global Utilities -->
    <div class="dt-topbar-right">
        @if (TopBarService.ContextActions.Count > 0)
        {
            <div class="dt-topbar-context-actions">
                @foreach (var action in TopBarService.ContextActions)
                {
                    <button type="button"
                            class="dt-topbar-action-btn @(action.IsActive ? "active" : "")"
                            @onclick="() => HandleActionClick(action)"
                            title="@(action.Tooltip ?? action.Label)">
                        @if (!string.IsNullOrWhiteSpace(action.IconSvg))
                        {
                            @((MarkupString)action.IconSvg)
                        }
                        <span>@action.Label</span>
                        @if (!string.IsNullOrWhiteSpace(action.Shortcut))
                        {
                            <span class="dt-topbar-action-shortcut">@action.Shortcut</span>
                        }
                    </button>
                }
            </div>
            <div class="dt-topbar-divider"></div>
        }
        <!-- Expand / Collapse Chat View Toggle -->
        <button type="button"
                class="dt-topbar-expand-btn @(IsExpandedChat ? "active" : "")"
                data-action="toggle-expanded-chat"
                @onclick="OnToggleExpandedChat"
                title="@(IsExpandedChat ? "Restore normal chat view (" + Platform.ModifierKeyLabel + "E)" : "Expand chat view (" + Platform.ModifierKeyLabel + "E)")"
                aria-label="Toggle expanded chat">
            @if (IsExpandedChat)
            {
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="4 14 10 14 10 20"></polyline>
                    <polyline points="20 10 14 10 14 4"></polyline>
                    <line x1="14" y1="10" x2="21" y2="3"></line>
                    <line x1="3" y1="21" x2="10" y2="14"></line>
                </svg>
                <span class="dt-topbar-expand-label">Collapse</span>
            }
            else
            {
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <polyline points="9 21 3 21 3 15"></polyline>
                    <line x1="21" y1="3" x2="14" y2="10"></line>
                    <line x1="3" y1="21" x2="10" y2="14"></line>
                </svg>
                <span class="dt-topbar-expand-label">Expand</span>
            }
            <kbd class="dt-topbar-kbd">@(Platform.ModifierKeyLabel)E</kbd>
        </button>

        <!-- Command Palette Trigger Pill -->
        <button type="button"
                class="dt-topbar-palette-btn"
                data-action="open-command-palette"
                @onclick="() => PaletteService.Toggle()"
                title="Command Palette (⌘K)">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span class="dt-topbar-palette-hint">Jump to...</span>
            <kbd class="dt-topbar-kbd">⌘K</kbd>
        </button>
    </div>
</header>

<!-- Tab Context Menu -->
@if (isContextMenuOpen && contextMenuTab != null)
{
    <div class="dt-context-backdrop" @onclick="CloseContextMenu"></div>
    <div class="dt-context-menu" style="left: @(contextMenuX)px; top: @(contextMenuY)px;" @onclick:stopPropagation="true">
        <div class="dt-context-header">
            <span class="dt-context-title">@contextMenuTab.Title</span>
            @if (selectedTabIds.Count > 1)
            {
                <span class="dt-context-badge">@selectedTabIds.Count selected</span>
            }
        </div>
        <div class="dt-context-separator"></div>

        @if (!string.IsNullOrEmpty(contextMenuTab.SplitLinkedTabId))
        {
            <button type="button" class="dt-context-item" @onclick="() => HandleUnlinkTab(contextMenuTab.Id)">
                <span>Separate Split Tabs</span>
            </button>
            <button type="button" class="dt-context-item" @onclick="HandleSwapPanes">
                <span>Swap Panes</span>
            </button>
            <button type="button" class="dt-context-item destructive" @onclick="() => HandleCloseBoth(contextMenuTab)">
                <span>Close Split Tab (Both)</span>
            </button>
        }
        else
        {
            <div class="dt-context-submenu-label">Split With</div>
            <button type="button" class="dt-context-item" @onclick="() => HandleSplitWithNewChat(contextMenuTab.Id)">
                <span>+ New Chat (Split)</span>
            </button>
            <button type="button" class="dt-context-item" @onclick="() => HandleSplitWithTerminal(contextMenuTab.Id)">
                <span>&gt;_ Terminal (Split)</span>
            </button>
            @foreach (var other in TabService.OpenTabs.Where(t => t.Id != contextMenuTab.Id && string.IsNullOrEmpty(t.SplitLinkedTabId)).Take(3))
            {
                <button type="button" class="dt-context-item" @onclick="() => HandleLinkWithTab(contextMenuTab.Id, other.Id)">
                    <span>Link with @other.Title</span>
                </button>
            }
        }

        <div class="dt-context-separator"></div>

        @if (selectedTabIds.Count > 1)
        {
            <button type="button" class="dt-context-item" @onclick="HandleCloseSelectedTabs">
                <span>Close @selectedTabIds.Count Selected Tabs</span>
            </button>
        }
        else
        {
            <button type="button" class="dt-context-item" @onclick="() => HandleCloseTab(contextMenuTab)">
                <span>Close Tab</span>
            </button>
        }

        <button type="button" class="dt-context-item" @onclick="HandleCloseOthers">
            <span>Close Others</span>
        </button>

        <button type="button" class="dt-context-item" @onclick="HandleCloseToTheRight">
            <span>Close to the Right</span>
        </button>

        <button type="button" class="dt-context-item destructive" @onclick="HandleCloseAllTabs">
            <span>Close All</span>
        </button>

        <div class="dt-context-separator"></div>

        <button type="button" class="dt-context-item" @onclick="HandleTogglePin">
            <span>@(contextMenuTab.IsPinned ? "Unpin Tab" : "Pin Tab")</span>
        </button>

        <button type="button" class="dt-context-item" @onclick="HandleDuplicateTab">
            <span>Duplicate Tab</span>
        </button>

        <div class="dt-context-separator"></div>

        <button type="button" class="dt-context-item" @onclick="HandleCopyAllTabTitles">
            <span>Copy All Tab Titles</span>
        </button>

        <button type="button" class="dt-context-item" @onclick="HandleAddTabToChat">
            <span>Add to Chat</span>
        </button>
    </div>
}

@code {
    [Parameter] public IReadOnlyList<ModelSummary>? Models { get; set; }
    [Parameter] public string? SelectedModelId { get; set; }
    [Parameter] public EventCallback<string> SelectedModelIdChanged { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsStreaming { get; set; }
    [Parameter] public bool IsSidebarOpen { get; set; }
    [Parameter] public bool IsInfosheetOpen { get; set; }
    [Parameter] public bool IsSettingsOpen { get; set; }
    [Parameter] public EventCallback OnToggleSidebar { get; set; }
    [Parameter] public EventCallback OnToggleInfosheet { get; set; }
    [Parameter] public bool IsExpandedChat { get; set; }
    [Parameter] public EventCallback OnToggleExpandedChat { get; set; }
    [Parameter] public EventCallback OnOpenSettings { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<string> OnSelectConversation { get; set; }
    [Parameter] public EventCallback OnNewConversation { get; set; }
    [Parameter] public EventCallback<ConversationSummary> OnAddReferencedChat { get; set; }

    private ElementReference tabsScrollRef;
    private HashSet<string> selectedTabIds = new();
    private string? lastSelectedTabId = null;
    private bool isContextMenuOpen = false;
    private WorkspaceTab? contextMenuTab;
    private double contextMenuX = 0;
    private double contextMenuY = 0;
    private string detectedShellName = "zsh";

    protected override void OnInitialized()
    {
        TabService.OnTabsChanged += HandleTabsChanged;
        TopBarService.OnChanged += HandleTopBarChanged;

        var isWindows = RuntimeInformation.IsOSPlatform(OSPlatform.Windows);
        if (isWindows)
        {
            detectedShellName = "pwsh";
        }
        else
        {
            var userShell = Environment.GetEnvironmentVariable("SHELL");
            detectedShellName = !string.IsNullOrWhiteSpace(userShell) ? System.IO.Path.GetFileName(userShell) : "zsh";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("gramDesktop.enableTabsWheel", tabsScrollRef);
            }
            catch {}
        }
    }

    private void HandleTabsChanged() => InvokeAsync(StateHasChanged);
    private void HandleTopBarChanged() => InvokeAsync(StateHasChanged);

    private async Task HandleActionClick(TopBarAction action)
    {
        if (action.OnClickAsync != null)
        {
            await action.OnClickAsync();
        }
        else
        {
            action.OnClick?.Invoke();
        }
    }

    private void HandleOpenTerminalTab()
    {
        TabService.OpenTerminalTab();
    }

    private void HandleOpenGitTab()
    {
        TabService.OpenGitTab();
    }

    private async Task HandleNewChatTab()
    {
        await OnNewConversation.InvokeAsync();
    }

    private void HandleToggleSplit()
    {
        TabService.ToggleSplitView();
    }

    private void HandleDragStart(string tabId)
    {
        TabService.SetDraggingTab(tabId);
    }

    private void HandleDropOnTab(string targetTabId)
    {
        if (!string.IsNullOrEmpty(TabService.DraggedTabId) && TabService.DraggedTabId != targetTabId)
        {
            TabService.LinkTabs(targetTabId, TabService.DraggedTabId);
        }
        TabService.SetDraggingTab(null);
    }

    private void HandleUnlinkTab(string tabId)
    {
        TabService.UnlinkTabs(tabId);
        CloseContextMenu();
    }

    private void HandleSwapPanes()
    {
        TabService.SwapSplitTabs();
        CloseContextMenu();
    }

    private void HandleSplitWithNewChat(string tabId)
    {
        var newChat = new WorkspaceTab
        {
            Title = "New chat",
            Type = WorkspaceTabType.Chat,
            ChatId = "default",
            Icon = null
        };
        TabService.OpenTabs.Add(newChat);
        TabService.LinkTabs(tabId, newChat.Id);
        CloseContextMenu();
    }

    private void HandleSplitWithTerminal(string tabId)
    {
        var term = new WorkspaceTab
        {
            Title = "Terminal",
            Type = WorkspaceTabType.Terminal,
            Icon = "💻"
        };
        TabService.OpenTabs.Add(term);
        TabService.LinkTabs(tabId, term.Id);
        CloseContextMenu();
    }

    private void HandleLinkWithTab(string tabId, string otherTabId)
    {
        TabService.LinkTabs(tabId, otherTabId);
        CloseContextMenu();
    }

    private void HandleCloseBoth(WorkspaceTab tab)
    {
        var partnerId = tab.SplitLinkedTabId;
        TabService.CloseTab(tab.Id);
        if (!string.IsNullOrEmpty(partnerId))
        {
            TabService.CloseTab(partnerId);
        }
        CloseContextMenu();
    }

    private async Task HandleTabClick(MouseEventArgs e, WorkspaceTab tab)
    {
        CloseContextMenu();

        if (e.CtrlKey || e.MetaKey)
        {
            if (selectedTabIds.Contains(tab.Id))
                selectedTabIds.Remove(tab.Id);
            else
                selectedTabIds.Add(tab.Id);
            lastSelectedTabId = tab.Id;
        }
        else if (e.ShiftKey && lastSelectedTabId != null)
        {
            var allTabs = TabService.OpenTabs;
            var idx1 = allTabs.FindIndex(t => t.Id == lastSelectedTabId);
            var idx2 = allTabs.FindIndex(t => t.Id == tab.Id);
            if (idx1 >= 0 && idx2 >= 0)
            {
                var min = Math.Min(idx1, idx2);
                var max = Math.Max(idx1, idx2);
                for (int i = min; i <= max; i++)
                {
                    selectedTabIds.Add(allTabs[i].Id);
                }
            }
        }
        else
        {
            selectedTabIds.Clear();
            selectedTabIds.Add(tab.Id);
            lastSelectedTabId = tab.Id;
            TabService.SelectTab(tab.Id);
            if (!string.IsNullOrWhiteSpace(tab.ChatId))
            {
                await OnSelectConversation.InvokeAsync(tab.ChatId);
            }
        }
    }

    private void HandleTabContextMenu(MouseEventArgs e, WorkspaceTab tab)
    {
        contextMenuTab = tab;
        if (!selectedTabIds.Contains(tab.Id))
        {
            selectedTabIds.Clear();
            selectedTabIds.Add(tab.Id);
        }
        contextMenuX = Math.Min(e.ClientX, 700);
        contextMenuY = Math.Min(e.ClientY, 500);
        isContextMenuOpen = true;
    }

    private void CloseContextMenu()
    {
        isContextMenuOpen = false;
        contextMenuTab = null;
    }

    private void HandleCloseTab(WorkspaceTab tab)
    {
        TabService.CloseTab(tab.Id);
        selectedTabIds.Remove(tab.Id);
        CloseContextMenu();
    }

    private void HandleCloseSelectedTabs()
    {
        if (selectedTabIds.Count > 0)
        {
            TabService.CloseTabs(selectedTabIds);
            selectedTabIds.Clear();
        }
        CloseContextMenu();
    }

    private void HandleCloseOthers()
    {
        if (contextMenuTab != null)
        {
            TabService.CloseOthers(contextMenuTab.Id);
            selectedTabIds.Clear();
            selectedTabIds.Add(contextMenuTab.Id);
        }
        CloseContextMenu();
    }

    private void HandleCloseToTheRight()
    {
        if (contextMenuTab != null)
        {
            TabService.CloseToTheRight(contextMenuTab.Id);
            selectedTabIds.Clear();
            selectedTabIds.Add(contextMenuTab.Id);
        }
        CloseContextMenu();
    }

    private void HandleCloseAllTabs()
    {
        TabService.CloseAll();
        selectedTabIds.Clear();
        CloseContextMenu();
    }

    private void HandleTogglePin()
    {
        if (contextMenuTab != null)
        {
            TabService.TogglePinTab(contextMenuTab.Id);
        }
        CloseContextMenu();
    }

    private void HandleDuplicateTab()
    {
        if (contextMenuTab != null)
        {
            TabService.DuplicateTab(contextMenuTab.Id);
        }
        CloseContextMenu();
    }

    private async Task HandleCopyAllTabTitles()
    {
        var titles = string.Join("\n", TabService.OpenTabs.Select(t => $"- {t.Title} (ID: {t.ChatId})"));
        await JSRuntime.InvokeVoidAsync("gramDesktop.copyText", titles);
        CloseContextMenu();
    }

    private async Task HandleAddTabToChat()
    {
        if (contextMenuTab != null)
        {
            var targetIds = selectedTabIds.Count > 0 ? selectedTabIds : new HashSet<string> { contextMenuTab.Id };
            foreach (var tId in targetIds)
            {
                var tab = TabService.OpenTabs.FirstOrDefault(t => t.Id == tId);
                if (tab != null && !string.IsNullOrWhiteSpace(tab.ChatId))
                {
                    var matching = Session.Conversations.FirstOrDefault(c => c.Id == tab.ChatId);
                    if (matching != null)
                    {
                        await OnAddReferencedChat.InvokeAsync(matching);
                    }
                    else
                    {
                        var now = DateTimeOffset.UtcNow;
                        await OnAddReferencedChat.InvokeAsync(new ConversationSummary(tab.ChatId, tab.Title, now, now, null, 0, 0));
                    }
                }
            }
        }
        CloseContextMenu();
    }

    public void Dispose()
    {
        TabService.OnTabsChanged -= HandleTabsChanged;
        TopBarService.OnChanged -= HandleTopBarChanged;
    }
}
