@namespace Gram.Desktop.Components
@using Gram.Desktop.Services
@using Gram.Blazor.Shared
@using System.Runtime.InteropServices
@inject IPlatformService Platform
@inject DesktopSession Session
@inject PtyTerminalService PtyService
@inject WorkspaceTabService TabService
@inject IJSRuntime JSRuntime
@implements IDisposable

<aside class="dt-infosheet dt-terminal-infosheet @(IsOpen ? "open" : "closed") @Platform.PlatformCssClass" data-ui-region="terminal-infosheet" role="complementary" aria-label="Terminal info">
    <!-- Header -->
    <div class="dt-infosheet-header">
        <div class="dt-infosheet-header-left">
            <span class="dt-infosheet-title">Terminal info</span>
            <span class="dt-terminal-info-badge">PTY</span>
        </div>
        <button type="button"
                class="dt-icon-btn dt-infosheet-toggle-btn"
                @onclick="OnClose"
                title="Toggle Terminal Info">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="15" y1="3" x2="15" y2="21"></line>
            </svg>
        </button>
    </div>

    <!-- Scrollable Body -->
    <div class="dt-infosheet-body">
        <!-- Companion Character Stage -->
        <div class="dt-terminal-info-hero">
            <div class="dt-terminal-info-char">
                <DesktopGramCharacter Size="64" State="@characterState" Interactive="true" AutoWaveOnLoad="false" />
            </div>
            <div class="dt-terminal-info-status">
                <span class="dt-xterm-badge-dot"></span>
                <span>@(activeSession != null ? $"{shellName} interactive" : "Terminal ready")</span>
            </div>
        </div>

        @if (latestErrorLog != null)
        {
            <div class="dt-terminal-fix-banner">
                <div class="dt-fix-banner-left">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    <div>
                        <div class="dt-fix-title">Command failed (exit @latestErrorLog.ExitCode)</div>
                        <div class="dt-fix-subtitle mono" title="@latestErrorLog.Command">@latestErrorLog.Command</div>
                    </div>
                </div>
                <button type="button" class="dt-btn-fix-action" @onclick="() => HandleAskGramToFix(latestErrorLog)">
                    ⚡ Ask Gram to Fix
                </button>
            </div>
        }

        <!-- Workspace & Folder -->
        <div class="dt-info-group">
            <div class="dt-info-group-title">Workspace</div>
            <div class="dt-info-rows">
                <div class="dt-info-row">
                    <span class="dt-info-label">Folder</span>
                    <span class="dt-info-value" style="font-weight: 500; display: inline-flex; align-items: center; gap: 5px;">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--dt-text-muted);">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                        </svg>
                        <span>@(string.IsNullOrWhiteSpace(Session.WorkspacePath) ? "Default" : System.IO.Path.GetFileName(Session.WorkspacePath))</span>
                    </span>
                </div>
                <div class="dt-workspace-path-box mono" title="@Session.WorkspacePath">
                    @(string.IsNullOrWhiteSpace(Session.WorkspacePath) ? Environment.CurrentDirectory : Session.WorkspacePath)
                </div>
            </div>
        </div>

        <!-- Session & Shell Diagnostics -->
        <div class="dt-info-group">
            <div class="dt-info-group-title">Session Diagnostics</div>
            <div class="dt-info-rows">
                <div class="dt-info-row">
                    <span class="dt-info-label">Shell</span>
                    <span class="dt-info-value mono">@shellName</span>
                </div>
                @if (activeSession != null)
                {
                    <div class="dt-info-row">
                        <span class="dt-info-label">Process ID</span>
                        <span class="dt-info-value mono">PID @activeSession.Pid</span>
                    </div>
                    <div class="dt-info-row">
                        <span class="dt-info-label">Dimensions</span>
                        <span class="dt-info-value mono">@(activeSession.Cols > 0 ? $"{activeSession.Cols} × {activeSession.Rows}" : "Auto fit")</span>
                    </div>
                    <div class="dt-info-row">
                        <span class="dt-info-label">Architecture</span>
                        <span class="dt-info-value mono">@RuntimeInformation.ProcessArchitecture.ToString().ToLowerInvariant()</span>
                    </div>
                }
                <div class="dt-info-row">
                    <span class="dt-info-label">Encoding</span>
                    <span class="dt-info-value mono">UTF-8 / truecolor</span>
                </div>
            </div>
        </div>

        <!-- Quick Presets -->
        <div class="dt-info-group">
            <div class="dt-info-group-title">Quick Actions</div>
            <div class="dt-terminal-presets-grid">
                <button type="button" class="dt-preset-pill" @onclick='() => RunPresetCommand("git status")' title="Run git status in terminal">
                    <span class="dt-preset-prompt">❯</span> git status
                </button>
                <button type="button" class="dt-preset-pill" @onclick='() => RunPresetCommand("git diff")' title="Run git diff in terminal">
                    <span class="dt-preset-prompt">❯</span> git diff
                </button>
                <button type="button" class="dt-preset-pill" @onclick='() => RunPresetCommand("dotnet build")' title="Run dotnet build in terminal">
                    <span class="dt-preset-prompt">❯</span> dotnet build
                </button>
                <button type="button" class="dt-preset-pill" @onclick='() => RunPresetCommand("ls -la")' title="Run ls -la in terminal">
                    <span class="dt-preset-prompt">❯</span> ls -la
                </button>
                <button type="button" class="dt-preset-pill" @onclick='() => RunPresetCommand("clear")' title="Clear terminal screen">
                    <span class="dt-preset-prompt">❯</span> clear
                </button>
            </div>
        </div>

        <!-- Command Execution & Audit Logs -->
        <div class="dt-info-group dt-terminal-audit-group">
            <div class="dt-terminal-audit-header">
                <div class="dt-info-group-title" style="margin-bottom: 0;">Command History</div>
                @if (logs.Count > 0)
                {
                    <button type="button" class="dt-terminal-history-clear-btn" @onclick="HandleClearHistory" title="Clear command history">
                        Clear
                    </button>
                }
            </div>

            @if (logs.Count > 0)
            {
                <div class="dt-terminal-audit-list">
                    @foreach (var log in logs)
                    {
                        var isExpanded = expandedLogIds.Contains(log.Id);
                        <div class="dt-terminal-audit-card">
                            <div class="dt-terminal-audit-top">
                                <span class="dt-terminal-audit-cmd" title="@log.Command">
                                    <span class="dt-terminal-prompt">❯</span> @log.Command
                                </span>
                                <div class="dt-terminal-audit-actions">
                                    <button type="button" class="dt-terminal-audit-rerun-btn" @onclick="() => RunPresetCommand(log.Command)" title="Rerun command in active terminal">
                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
                                        <span>Rerun</span>
                                    </button>
                                    @if (log.ExitCode != 0 || HasErrorDiagnostic(log))
                                    {
                                        <button type="button" class="dt-terminal-audit-fix-btn" @onclick="() => HandleAskGramToFix(log)" title="Ask Gram to fix this error">
                                            ⚡ Fix
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="dt-terminal-audit-meta">
                                <span class="dt-terminal-audit-time">@log.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                                <span class="dt-terminal-audit-duration">@($"{log.ElapsedMs}ms")</span>
                                <span class="dt-terminal-exit-badge @(log.ExitCode == 0 ? "success" : "error")">
                                    exit @log.ExitCode
                                </span>
                                @if (!string.IsNullOrWhiteSpace(log.Stdout) || !string.IsNullOrWhiteSpace(log.Stderr))
                                {
                                    <button type="button" class="dt-terminal-audit-toggle" @onclick="() => ToggleExpand(log.Id)">
                                        @(isExpanded ? "Hide output" : "Show output")
                                    </button>
                                }
                            </div>
                            @if (isExpanded)
                            {
                                <div class="dt-terminal-audit-output">
                                    @if (!string.IsNullOrWhiteSpace(log.Stdout))
                                    {
                                        <pre class="dt-audit-stdout">@log.Stdout</pre>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(log.Stderr))
                                    {
                                        <pre class="dt-audit-stderr">@log.Stderr</pre>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="dt-info-empty" style="padding: 10px 0;">No command history recorded yet</div>
            }
        </div>
    </div>
</aside>

@code {
    [Parameter] public bool IsOpen { get; set; } = true;
    [Parameter] public string? TabId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string effectiveTabId => !string.IsNullOrWhiteSpace(TabId) ? TabId : "term-default";
    private PtySession? activeSession => PtyService.GetSession(effectiveTabId);

    private List<TerminalLogRecord> logs = new();
    private HashSet<string> expandedLogIds = new();
    private string shellName = "zsh";
    private string characterState = "idle";

    protected override async Task OnParametersSetAsync()
    {
        DetectShell();
        await RefreshLogsAsync();
    }

    private void DetectShell()
    {
        var sess = activeSession;
        if (sess != null && !string.IsNullOrWhiteSpace(sess.ShellPath))
        {
            shellName = System.IO.Path.GetFileName(sess.ShellPath);
            return;
        }

        if (RuntimeInformation.IsOSPlatform(OSPlatform.Windows))
        {
            shellName = "pwsh";
        }
        else
        {
            var userShell = Environment.GetEnvironmentVariable("SHELL");
            shellName = !string.IsNullOrWhiteSpace(userShell) ? System.IO.Path.GetFileName(userShell) : "zsh";
        }
    }

    private async Task RefreshLogsAsync()
    {
        try
        {
            var records = await Session.GetTerminalLogsAsync(Session.WorkspacePath, limit: 25);
            logs = records.OrderByDescending(r => r.Timestamp).ToList();
        }
        catch { }
    }

    private async Task RunPresetCommand(string command)
    {
        if (string.IsNullOrWhiteSpace(command)) return;

        characterState = "thinking";
        StateHasChanged();

        try
        {
            await PtyService.WriteInputAsync(effectiveTabId, command + "\n");
        }
        catch { }

        _ = Task.Delay(800).ContinueWith(_ =>
        {
            characterState = "idle";
            InvokeAsync(StateHasChanged);
        });
    }

    private void ToggleExpand(string id)
    {
        if (expandedLogIds.Contains(id))
            expandedLogIds.Remove(id);
        else
            expandedLogIds.Add(id);
    }

    private async Task HandleClearHistory()
    {
        logs.Clear();
        expandedLogIds.Clear();
        await Session.ClearTerminalLogsAsync(Session.WorkspacePath);
        StateHasChanged();
    }

    private TerminalLogRecord? latestErrorLog => logs.FirstOrDefault(l => l.ExitCode != 0 || HasErrorDiagnostic(l));

    private bool HasErrorDiagnostic(TerminalLogRecord log)
    {
        var text = (log.Stderr + " " + log.Stdout).ToLowerInvariant();
        return text.Contains("error cs") || text.Contains("failed") || text.Contains("exception:") || text.Contains("fatal:") || text.Contains("cannot find");
    }

    private async Task HandleAskGramToFix(TerminalLogRecord log)
    {
        var errorSnippet = !string.IsNullOrWhiteSpace(log.Stderr) ? log.Stderr : log.Stdout;
        if (errorSnippet.Length > 2500) errorSnippet = errorSnippet[..2500] + "\n...[truncated]";
        var prompt = $"The terminal command `{log.Command}` failed (exit {log.ExitCode}).\n\nDiagnostics & Error Output:\n```\n{errorSnippet}\n```\n\nPlease analyze what caused this failure, diagnose the issue, and provide or implement the fix.";

        var chatTab = TabService.OpenTabs.FirstOrDefault(t => t.Type == WorkspaceTabType.Chat);
        if (chatTab != null)
        {
            TabService.SelectTab(chatTab.Id);
        }
        else
        {
            TabService.OpenChatTab("default", "Chat");
        }

        try
        {
            await Session.SendAsync(prompt);
        }
        catch (Exception ex)
        {
            GramLog.Error("TerminalInfosheet", $"Failed to send fix prompt: {ex.Message}");
        }
    }

    public void Dispose()
    {
    }
}
