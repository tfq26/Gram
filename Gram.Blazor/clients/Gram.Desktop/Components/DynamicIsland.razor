@namespace Gram.Desktop.Components
@using Gram.Blazor.Shared
@using Gram.Desktop.Services
@inject DesktopSession Session
@inject WorkspaceTabService TabService

<div class="dt-island-container">
    <div class="dt-island @IslandClass @(isExpanded ? "expanded" : "")"
         @onclick="ToggleExpand"
         title="@IslandTooltip"
         role="button"
         tabindex="0"
         @onkeydown="HandleKeyDown">
        
        @if (Session.ActivePermissionRequest != null)
        {
            <!-- 1. Urgent Permission Alert State -->
            <div class="dt-island-content alert">
                <span class="dt-island-label warning">Approval Required</span>
                <span class="dt-island-chevron">▾</span>
            </div>
        }
        else if (IsStreaming)
        {
            <!-- 2. Active Task / Streaming State with Audio Visualizer -->
            <div class="dt-island-content streaming">
                <span class="dt-island-sparkle">✦</span>
                <span class="dt-island-label">@GetActiveTaskLabel()</span>
                
                <!-- Reactive 6-bar Audio/Frequency Visualizer -->
                <div class="dt-island-visualizer active">
                    <span class="dt-viz-bar bar-1"></span>
                    <span class="dt-viz-bar bar-2"></span>
                    <span class="dt-viz-bar bar-3"></span>
                    <span class="dt-viz-bar bar-4"></span>
                    <span class="dt-viz-bar bar-5"></span>
                    <span class="dt-viz-bar bar-6"></span>
                </div>

                @if (OnCancel.HasDelegate)
                {
                    <button type="button" 
                            class="dt-island-stop-btn" 
                            @onclick:stopPropagation="true" 
                            @onclick="OnCancel" 
                            title="Stop task (Esc)">✕</button>
                }
            </div>
            <div class="dt-island-progress">
                <div class="dt-island-progress-bar"></div>
            </div>
        }
        else if (IsListening)
        {
            <!-- 3. Voice / Listening State -->
            <div class="dt-island-content listening">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="dt-island-mic">
                    <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"></path>
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                    <line x1="12" y1="19" x2="12" y2="22"></line>
                </svg>
                <span class="dt-island-label">Listening</span>
                <div class="dt-island-visualizer voice">
                    <span class="dt-viz-bar bar-1"></span>
                    <span class="dt-viz-bar bar-2"></span>
                    <span class="dt-viz-bar bar-3"></span>
                    <span class="dt-viz-bar bar-4"></span>
                    <span class="dt-viz-bar bar-5"></span>
                </div>
            </div>
        }
        else if (IsLoading)
        {
            <!-- 4. Syncing / Connecting State -->
            <div class="dt-island-content loading">
                <div class="dt-island-spinner"></div>
                <span class="dt-island-label">Syncing</span>
            </div>
        }
        else
        {
            <!-- 5. Idle / Ready State -->
            <div class="dt-island-content idle">
                <span class="dt-island-brand">Gram</span>
                @if (!string.IsNullOrWhiteSpace(ActiveModelName))
                {
                    <span class="dt-island-sep">·</span>
                    <span class="dt-island-meta">@ActiveModelName</span>
                }
                <span class="dt-island-chevron">▾</span>
            </div>
        }
    </div>

    <!-- Click-to-Expand: Single Unified HUD Menu separated with dividers -->
    @if (isExpanded)
    {
        <div class="dt-island-backdrop" @onclick="() => isExpanded = false"></div>
        <div class="dt-island-hud" @onclick:stopPropagation="true">
            <!-- 1. Task Queue List (Flat, seamless) -->
            @{
                var tasks = GetTaskQueue();
            }
            <div class="dt-hud-queue-list">
                @if (tasks.Count == 0)
                {
                    <div class="dt-hud-queue-empty">No active or queued tasks</div>
                }
                else
                {
                    @foreach (var task in tasks)
                    {
                        <div class="dt-hud-queue-item @task.StatusKind">
                            <div class="dt-hud-queue-icon-wrap">
                                @if (task.StatusKind == "running")
                                {
                                    <div class="dt-hud-queue-spinner"></div>
                                }
                                else if (task.StatusKind == "pending")
                                {
                                    <span class="dt-hud-queue-icon pending">●</span>
                                }
                                else if (task.StatusKind == "failed")
                                {
                                    <span class="dt-hud-queue-icon failed">✕</span>
                                }
                                else
                                {
                                    <span class="dt-hud-queue-icon completed">✓</span>
                                }
                            </div>
                            <div class="dt-hud-queue-main">
                                <span class="dt-hud-queue-title">@task.Title</span>
                                @if (!string.IsNullOrWhiteSpace(task.Subtitle))
                                {
                                    <span class="dt-hud-queue-sub">@task.Subtitle</span>
                                }
                            </div>
                            <span class="dt-hud-queue-badge @task.StatusKind">@task.Status</span>
                        </div>
                    }
                }
            </div>

            <!-- Divider -->
            @if (Models != null && Models.Count > 0)
            {
                <div class="dt-hud-divider"></div>

                <!-- 2. Model Selection Row directly under divider -->
                <div class="dt-hud-model-row">
                    <span class="dt-hud-row-label">Model</span>
                    <div class="dt-hud-model-select-wrap">
                        <select class="dt-hud-model-select"
                                value="@SelectedModelId"
                                @onchange="HandleModelChanged"
                                disabled="@IsStreaming">
                            @foreach (var model in Models.Where(m => m.IsEnabled))
                            {
                                <option value="@model.Id">@model.Name (@model.Provider)</option>
                            }
                        </select>
                        <svg class="dt-hud-select-arrow" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </div>
                </div>
            }

            <!-- 3. Stop Action (if streaming) -->
            @if (IsStreaming && OnCancel.HasDelegate)
            {
                <div class="dt-hud-divider"></div>
                <div class="dt-hud-action-row">
                    <button type="button" class="dt-hud-btn-cancel" @onclick="HandleCancelFromHud">
                        <span>Stop Task</span>
                        <kbd>Esc</kbd>
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public bool IsStreaming { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsListening { get; set; }
    [Parameter] public string? CurrentTask { get; set; }
    [Parameter] public string? ActiveModelName { get; set; }
    [Parameter] public IReadOnlyList<ModelSummary>? Models { get; set; }
    [Parameter] public string? SelectedModelId { get; set; }
    [Parameter] public EventCallback<string> SelectedModelIdChanged { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool isExpanded = false;

    private record HudTaskItem(string Title, string Subtitle, string Status, string StatusKind);

    private void ToggleExpand()
    {
        isExpanded = !isExpanded;
    }

    private async Task HandleModelChanged(ChangeEventArgs e)
    {
        var modelId = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(modelId))
        {
            SelectedModelId = modelId;
            await SelectedModelIdChanged.InvokeAsync(modelId);
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            ToggleExpand();
        }
        else if (e.Key == "Escape" && isExpanded)
        {
            isExpanded = false;
        }
    }

    private async Task HandleCancelFromHud()
    {
        isExpanded = false;
        await OnCancel.InvokeAsync();
    }

    private List<HudTaskItem> GetTaskQueue()
    {
        var list = new List<HudTaskItem>();

        // 1. Pending approval request (waiting on user confirmation)
        if (Session.ActivePermissionRequest != null)
        {
            var req = Session.ActivePermissionRequest;
            var target = !string.IsNullOrWhiteSpace(req.ExactTarget)
                ? Path.GetFileName(req.ExactTarget)
                : (!string.IsNullOrWhiteSpace(req.Command)
                    ? (req.Command.Length > 36 ? req.Command[..36] + "…" : req.Command)
                    : "");
            list.Add(new HudTaskItem(req.OperationType ?? "Operation", target, "Pending", "pending"));
        }

        // 2. Active streaming tool calls (currently running)
        var runningTools = Session.CurrentStreamingToolCalls.Where(t => string.IsNullOrEmpty(t.Result) && !t.IsError).ToList();
        foreach (var tool in runningTools)
        {
            list.Add(new HudTaskItem(
                ToolNameHelper.GetDisplayName(tool.ToolName),
                GetCleanTarget(tool),
                "Running",
                "running"
            ));
        }

        // 3. If streaming LLM generation without tool executing
        if (IsStreaming && runningTools.Count == 0 && Session.ActivePermissionRequest == null)
        {
            list.Add(new HudTaskItem("Generate Response", ActiveModelName ?? "Gram", "Running", "running"));
        }

        // 4. Completed tool calls from current stream
        var completedCurrent = Session.CurrentStreamingToolCalls.Where(t => !string.IsNullOrEmpty(t.Result) || t.IsError).ToList();
        foreach (var tool in completedCurrent)
        {
            list.Add(new HudTaskItem(
                ToolNameHelper.GetDisplayName(tool.ToolName),
                GetCleanTarget(tool),
                tool.IsError ? "Failed" : "Done",
                tool.IsError ? "failed" : "completed"
            ));
        }

        // 5. If idle with no active tools, display recent completed tasks from the active conversation's last assistant turn
        if (list.Count == 0 && Session.ActiveConversation?.Messages != null)
        {
            var lastWithTools = Session.ActiveConversation.Messages
                .LastOrDefault(m => m.ToolCalls != null && m.ToolCalls.Count > 0);
            if (lastWithTools?.ToolCalls != null)
            {
                foreach (var tool in lastWithTools.ToolCalls)
                {
                    list.Add(new HudTaskItem(
                        ToolNameHelper.GetDisplayName(tool.ToolName),
                        GetCleanTarget(tool),
                        tool.IsError ? "Failed" : "Done",
                        tool.IsError ? "failed" : "completed"
                    ));
                }
            }
        }

        return list;
    }

    private static string GetCleanTarget(ToolCallInfo tool)
    {
        if (string.IsNullOrWhiteSpace(tool.Arguments)) return "";
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(tool.Arguments);
            var root = doc.RootElement;
            if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                foreach (var prop in root.EnumerateObject())
                {
                    var name = prop.Name.ToLowerInvariant();
                    if (name is "filepath" or "targetfile" or "path" or "file" or "searchdirectory")
                    {
                        var val = prop.Value.GetString() ?? "";
                        return Path.GetFileName(val);
                    }
                    if (name is "command" or "commandline" or "cmd")
                    {
                        var val = prop.Value.GetString() ?? "";
                        return val.Length > 34 ? val[..34] + "…" : val;
                    }
                    if (name is "query" or "pattern")
                    {
                        var val = prop.Value.GetString() ?? "";
                        return $"\"{val}\"";
                    }
                }
            }
        }
        catch
        {
        }
        return tool.Arguments.Length > 34 ? tool.Arguments[..34] + "…" : tool.Arguments;
    }

    private string GetActiveTaskLabel()
    {
        if (!string.IsNullOrWhiteSpace(CurrentTask)) return CurrentTask;

        if (Session.CurrentStreamingToolCalls.Count > 0)
        {
            var tool = Session.CurrentStreamingToolCalls.Last();
            var name = tool.ToolName.ToLowerInvariant();
            if (name.Contains("terminal") || name.Contains("command")) return "Terminal";
            if (name.Contains("file") && name.Contains("pick")) return "Reading File";
            if (name.Contains("write") || name.Contains("edit")) return "Editing File";
            if (name.Contains("search")) return "Searching";
            return ToolNameHelper.GetDisplayName(tool.ToolName);
        }

        if (!string.IsNullOrWhiteSpace(ActiveModelName))
        {
            return $"{ActiveModelName} · Thinking";
        }

        return "Generating...";
    }

    private string IslandClass
    {
        get
        {
            if (Session.ActivePermissionRequest != null) return "is-alert";
            if (IsStreaming) return "is-streaming";
            if (IsListening) return "is-listening";
            if (IsLoading) return "is-loading";
            return "is-idle";
        }
    }

    private string IslandTooltip => Session.ActivePermissionRequest != null
        ? "Action requires your approval (Click to inspect)"
        : IsStreaming
            ? "Gram is actively executing tasks (Click to inspect)"
            : "Tasks and model settings (Click to inspect)";
}
