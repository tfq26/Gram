@namespace Gram.Desktop.Components
@using Gram.Blazor.Shared
@using Gram.Desktop.Services
@using System.Text.Json.Nodes
@inject IJSRuntime JSRuntime
@inject DesktopSession Session
@inject WorkspaceTabService TabService
@inject PtyTerminalService PtyService

@{
    var isRunning = string.IsNullOrWhiteSpace(ToolCall.Result) && !ToolCall.IsError;
    var stepSentence = GetStepSentence(isRunning);
    var targetKind = GetTargetKind();
    var targetText = GetTargetText();
}

<div class="dt-tool-card @(ToolCall.IsError ? "is-error" : (isRunning ? "is-running" : "is-complete")) @(isExpanded ? "is-expanded" : "")">
    <!-- Collapsed Minimal Header Row: Full Step Sentence Format -->
    <div class="dt-tool-header" @onclick="ToggleExpand" role="button" tabindex="0" title="Click to @(isExpanded ? "collapse" : "inspect") details">
        <div class="dt-tool-meta">
            <div class="dt-tool-info">
                <span class="dt-tool-sentence" title="@stepSentence">@stepSentence</span>
            </div>
        </div>

        <div class="dt-tool-controls">
            @if (isRunning)
            {
                <span class="dt-tool-status running">Running...</span>
                <button type="button" class="dt-tool-stop-btn" @onclick:stopPropagation="true" @onclick="CancelExecution" title="Stop tool execution">
                    ■ Stop
                </button>
            }
            else if (ToolCall.IsError)
            {
                <span class="dt-tool-status error">Failed</span>
            }

            @if (targetKind == "command" && !string.IsNullOrWhiteSpace(targetText))
            {
                <button type="button" class="dt-tool-terminal-btn" @onclick:stopPropagation="true" @onclick="SendToTerminal" title="Run in interactive terminal">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
                    <span>Terminal</span>
                </button>
            }

            @if (isExpanded)
            {
                <button type="button" class="dt-tool-copy-btn" @onclick:stopPropagation="true" @onclick="CopyContent" title="Copy output">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                    <span>@(isCopied ? "Copied" : "Copy")</span>
                </button>
            }

            <span class="dt-tool-chevron @(isExpanded ? "expanded" : "")" aria-hidden="true">
                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
            </span>
        </div>
    </div>

    <!-- Direct Single Expanded Surface (No 2 cards! Seamless output directly underneath) -->
    @if (isExpanded)
    {
        <div class="dt-tool-output-area">
            @if (IsWebSearchTool)
            {
                var sources = GetSources();
                @if (sources.Count > 0)
                {
                    <div class="dt-tool-sources-row">
                        @foreach (var src in sources)
                        {
                            <a href="@src.Url" target="_blank" rel="noopener noreferrer" class="dt-tool-source-chip" title="@src.Url">
                                <img src="https://www.google.com/s2/favicons?domain=@src.Domain&sz=32" alt="" class="dt-source-fav" onerror="this.style.display='none'" />
                                <span class="dt-source-name">@(string.IsNullOrWhiteSpace(src.Title) ? src.Domain : src.Title)</span>
                            </a>
                        }
                    </div>
                }
            }

            @if (IsSubagentTool)
            {
                var (agentType, _, taskPrompt, _) = GetSubagentDetails();
                @if (!string.IsNullOrWhiteSpace(taskPrompt))
                {
                    <div class="dt-tool-subagent-prompt">
                        <span class="dt-tool-persona-pill">@agentType</span>
                        <span class="dt-tool-task-text">@taskPrompt</span>
                    </div>
                }
            }

            @if (ComputedDiff != null && ComputedDiff.Lines.Count > 0)
            {
                <Gram.Blazor.Components.InteractiveDiffViewer Diff="@ComputedDiff" CheckpointId="@ExtractedCheckpointId" OnRollback="HandleRollbackAsync" />
                @if (!string.IsNullOrWhiteSpace(ToolCall.Result))
                {
                    <div class="dt-tool-result-note">@ToolCall.Result</div>
                }
            }
            else if (!string.IsNullOrWhiteSpace(ToolCall.Result))
            {
                var diagnostics = CompilerDiagnosticParser.Parse(ToolCall.Result);
                @if (diagnostics.Count > 0)
                {
                    var errorCount = diagnostics.Count(d => d.Severity == "ERROR");
                    var warnCount = diagnostics.Count(d => d.Severity == "WARNING");
                    <div class="dt-tool-diag-inline">
                        <span class="dt-diag-title">Diagnostics:</span>
                        @if (errorCount > 0) { <span class="dt-diag-badge error">@errorCount error@(errorCount > 1 ? "s" : "")</span> }
                        @if (warnCount > 0) { <span class="dt-diag-badge warning">@warnCount warning@(warnCount > 1 ? "s" : "")</span> }
                    </div>
                }

                @if (IsSubagentTool)
                {
                    <div class="dt-tool-prose @(ToolCall.IsError ? "is-error-text" : "")">
                        <MarkdownView Content="@ToolCall.Result" />
                    </div>
                }
                else
                {
                    <pre class="dt-tool-output-code @(ToolCall.IsError ? "error" : "")">@ToolCall.Result</pre>
                }
            }
            else if (!IsWebSearchTool)
            {
                <div class="dt-tool-empty-output">(No output returned)</div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public ToolCallInfo ToolCall { get; set; } = new();
    private bool isExpanded = false;
    private bool isCopied = false;

    private void ToggleExpand() => isExpanded = !isExpanded;

    private bool IsWebSearchTool => ToolCall.ToolName.Equals("search_web", StringComparison.OrdinalIgnoreCase);

    private DiffFileItem? ComputedDiff => GetDiffModel();

    private string? ExtractedCheckpointId
    {
        get
        {
            if (string.IsNullOrWhiteSpace(ToolCall.Result)) return null;
            var match = System.Text.RegularExpressions.Regex.Match(ToolCall.Result, @"\[Checkpoint:\s*(chk-[a-zA-Z0-9]+)\]");
            return match.Success ? match.Groups[1].Value : null;
        }
    }

    private async Task HandleRollbackAsync(string checkpointId)
    {
        await Session.RollbackCheckpointAsync(checkpointId);
    }

    private DiffFileItem? GetDiffModel()
    {
        var name = ToolCall.ToolName.ToLowerInvariant();
        var isEditOrWrite = name.Contains("edit_file") || name.Contains("replace_file") || name.Contains("write_file") || name.Contains("write_to_file");
        if (!isEditOrWrite) return null;

        var args = ParsedArguments;
        var filePath = GetCleanPath(GetFullTargetFilePath());
        var target = args.GetValueOrDefault("targetContent") ?? args.GetValueOrDefault("TargetContent") ?? "";
        var replacement = args.GetValueOrDefault("replacementContent") ?? args.GetValueOrDefault("ReplacementContent") ?? args.GetValueOrDefault("CodeContent") ?? args.GetValueOrDefault("content") ?? "";

        if (!string.IsNullOrEmpty(target) || !string.IsNullOrEmpty(replacement))
        {
            return DiffEngine.ComputeDiff(filePath, target, replacement);
        }

        if (!string.IsNullOrWhiteSpace(ToolCall.Result) && (ToolCall.Result.Contains("@@") || ToolCall.Result.Contains("[diff_block_start]")))
        {
            return DiffEngine.ParseUnifiedDiff(ToolCall.Result, filePath);
        }

        return null;
    }

    private bool IsSubagentTool =>
        ToolCall.ToolName.Contains("subagent", StringComparison.OrdinalIgnoreCase) ||
        ToolCall.ToolName.Equals("invoke_subagent", StringComparison.OrdinalIgnoreCase) ||
        ToolCall.ToolName.Equals("spawn_subagent", StringComparison.OrdinalIgnoreCase) ||
        ToolCall.ToolName.Equals("get_subagent_status", StringComparison.OrdinalIgnoreCase) ||
        ToolCall.ToolName.Equals("list_subagents", StringComparison.OrdinalIgnoreCase) ||
        ToolCall.ToolName.Equals("manage_subagents", StringComparison.OrdinalIgnoreCase);

    private record SearchSourceItem(string Title, string Url, string Domain);

    private Dictionary<string, string> ParsedArguments
    {
        get
        {
            var dict = new Dictionary<string, string>();
            if (string.IsNullOrWhiteSpace(ToolCall.Arguments)) return dict;
            try
            {
                var node = JsonNode.Parse(ToolCall.Arguments);
                if (node is JsonObject obj)
                {
                    foreach (var kvp in obj)
                    {
                        dict[kvp.Key] = kvp.Value?.ToString() ?? "";
                    }
                }
            }
            catch
            {
                dict["args"] = ToolCall.Arguments;
            }
            return dict;
        }
    }

    private (string SubagentType, string RoleTitle, string TaskPrompt, string SandboxId) GetSubagentDetails()
    {
        var args = ParsedArguments;
        var subagentType = args.GetValueOrDefault("subagentType") ?? args.GetValueOrDefault("TypeName") ?? args.GetValueOrDefault("type") ?? "Agent";
        var role = args.GetValueOrDefault("role") ?? args.GetValueOrDefault("Role") ?? CapitalizeWords(subagentType);
        var prompt = args.GetValueOrDefault("taskPrompt") ?? args.GetValueOrDefault("Prompt") ?? args.GetValueOrDefault("prompt") ?? "";
        var sandbox = args.GetValueOrDefault("useSandbox") ?? args.GetValueOrDefault("Workspace") ?? "";

        return (CapitalizeWords(subagentType), role, prompt, sandbox);
    }

    private string GetStepSentence(bool isRunning)
    {
        var name = (ToolCall.ToolName ?? "").ToLowerInvariant();
        var args = ParsedArguments;

        if (IsWebSearchTool)
        {
            var q = GetSearchQuery();
            if (!string.IsNullOrWhiteSpace(q))
            {
                return isRunning ? $"Searching the web for “{q}”..." : $"Searched the web for “{q}”";
            }
            return isRunning ? "Searching the web..." : "Searched the web";
        }

        if (name.Contains("fetch_web") || name.Contains("read_url") || name.Contains("fetch_url"))
        {
            var url = args.GetValueOrDefault("url") ?? args.GetValueOrDefault("Url") ?? "";
            var domain = "";
            try
            {
                if (!string.IsNullOrWhiteSpace(url))
                {
                    var uri = new Uri(url);
                    domain = uri.Host.StartsWith("www.") ? uri.Host[4..] : uri.Host;
                }
            }
            catch { domain = url; }

            var target = !string.IsNullOrWhiteSpace(domain) ? domain : url;
            if (!string.IsNullOrWhiteSpace(target))
            {
                return isRunning ? $"Fetching content from {target}..." : $"Fetched content from {target}";
            }
            return isRunning ? "Fetching web content..." : "Fetched web content";
        }

        if (IsSubagentTool)
        {
            var (_, roleTitle, _, _) = GetSubagentDetails();
            var role = !string.IsNullOrWhiteSpace(roleTitle) ? roleTitle : "specialized";
            return isRunning ? $"Delegating task to {role} subagent..." : $"Completed task with {role} subagent";
        }

        if (name.Contains("rollback") || name.Contains("undo"))
        {
            return isRunning ? "Rolling back recent changes..." : "Rolled back recent changes";
        }

        if (name.Contains("validate"))
        {
            var mode = args.GetValueOrDefault("mode") ?? "test";
            var target = mode == "build" ? "build suite" : "test suite";
            return isRunning ? $"Validating {target}..." : $"Validated {target}";
        }

        if (name.Contains("run_command") || name.Contains("bash") || name.Contains("exec") || name.Contains("cmd"))
        {
            var cmd = args.GetValueOrDefault("command") ?? args.GetValueOrDefault("CommandLine") ?? args.GetValueOrDefault("cmd") ?? "";
            var shortCmd = cmd.Length > 55 ? cmd[..52] + "..." : cmd;
            if (!string.IsNullOrWhiteSpace(shortCmd))
            {
                return isRunning ? $"Running command \"{shortCmd}\"..." : $"Ran command \"{shortCmd}\"";
            }
            return isRunning ? "Running command..." : "Executed command";
        }

        if (name.Contains("write_file") || name.Contains("edit_file") || name.Contains("write_to_file") || name.Contains("replace_file"))
        {
            var path = args.GetValueOrDefault("filePath") ?? args.GetValueOrDefault("TargetFile") ?? args.GetValueOrDefault("path") ?? "";
            var clean = GetCleanPath(path);
            var isEdit = name.Contains("edit") || name.Contains("replace");
            if (!string.IsNullOrWhiteSpace(clean))
            {
                if (isEdit)
                    return isRunning ? $"Editing file {clean}..." : $"Edited file {clean}";
                return isRunning ? $"Writing file {clean}..." : $"Created file {clean}";
            }
            return isRunning ? "Updating file..." : "Updated file";
        }

        if (name.Contains("view_file") || name.Contains("read_file"))
        {
            var path = args.GetValueOrDefault("filePath") ?? args.GetValueOrDefault("AbsolutePath") ?? args.GetValueOrDefault("path") ?? "";
            var clean = GetCleanPath(path);
            if (!string.IsNullOrWhiteSpace(clean))
            {
                return isRunning ? $"Reading file {clean}..." : $"Read file {clean}";
            }
            return isRunning ? "Reading file..." : "Read file";
        }

        if (name.Contains("find_files") || name.Contains("find_by_name") || name.Contains("grep"))
        {
            var q = args.GetValueOrDefault("query") ?? args.GetValueOrDefault("Query") ?? args.GetValueOrDefault("pattern") ?? args.GetValueOrDefault("Pattern") ?? "";
            if (!string.IsNullOrWhiteSpace(q))
            {
                return isRunning ? $"Searching codebase for “{q}”..." : $"Searched codebase for “{q}”";
            }
            return isRunning ? "Searching files..." : "Searched files";
        }

        if (name.Contains("list_directory") || name.Contains("list_dir"))
        {
            var path = args.GetValueOrDefault("directoryPath") ?? args.GetValueOrDefault("DirectoryPath") ?? args.GetValueOrDefault("path") ?? "";
            var clean = GetCleanPath(path);
            if (!string.IsNullOrWhiteSpace(clean))
            {
                return isRunning ? $"Listing directory {clean}..." : $"Listed directory {clean}";
            }
            return isRunning ? "Listing directory..." : "Listed directory";
        }

        var displayName = ToolNameHelper.GetDisplayName(ToolCall.ToolName);
        return isRunning ? $"Executing {displayName}..." : $"Executed {displayName}";
    }

    private string GetTargetKind()
    {
        var name = (ToolCall.ToolName ?? "").ToLowerInvariant();
        if (name.Contains("run_command") || name.Contains("bash") || name.Contains("exec") || name.Contains("cmd")) return "command";
        return "";
    }

    private string GetTargetText()
    {
        var args = ParsedArguments;
        return args.GetValueOrDefault("command") ?? args.GetValueOrDefault("CommandLine") ?? args.GetValueOrDefault("cmd") ?? "";
    }

    private (string ActionLabel, string TargetText, string TargetKind) GetToolSummaryInfo()
    {
        var name = ToolCall.ToolName.ToLowerInvariant();
        var args = ParsedArguments;
        var displayName = ToolNameHelper.GetDisplayName(ToolCall.ToolName);

        if (IsWebSearchTool)
        {
            var q = GetSearchQuery();
            return ("Searched web", !string.IsNullOrWhiteSpace(q) ? $"“{q}”" : "", "web");
        }

        if (IsSubagentTool)
        {
            var (_, roleTitle, _, _) = GetSubagentDetails();
            return ("Subagent", roleTitle, "subagent");
        }

        if (name.Contains("rollback") || name.Contains("undo"))
        {
            var id = args.GetValueOrDefault("checkpointId") ?? "";
            return ("Rollback", string.IsNullOrWhiteSpace(id) ? "Latest change" : id, "rollback");
        }

        if (name.Contains("validate"))
        {
            var mode = args.GetValueOrDefault("mode") ?? "test";
            return ("Validate", mode == "build" ? "Build suite" : "Test suite", "validate");
        }

        if (name.Contains("run_command") || name.Contains("bash") || name.Contains("exec") || name.Contains("cmd"))
        {
            var cmd = args.GetValueOrDefault("command") ?? args.GetValueOrDefault("CommandLine") ?? args.GetValueOrDefault("cmd") ?? "";
            return ("Ran command", cmd, "command");
        }

        if (name.Contains("write_file") || name.Contains("edit_file") || name.Contains("write_to_file") || name.Contains("replace_file"))
        {
            var path = args.GetValueOrDefault("filePath") ?? args.GetValueOrDefault("TargetFile") ?? args.GetValueOrDefault("path") ?? "";
            return (name.Contains("edit") || name.Contains("replace") ? "Edited file" : "Wrote file", GetCleanPath(path), "file-write");
        }

        if (name.Contains("view_file") || name.Contains("read_file"))
        {
            var path = args.GetValueOrDefault("filePath") ?? args.GetValueOrDefault("AbsolutePath") ?? args.GetValueOrDefault("path") ?? "";
            return ("Read file", GetCleanPath(path), "file-read");
        }

        if (name.Contains("find_files") || name.Contains("find_by_name") || name.Contains("grep") || name.Contains("list_directory") || name.Contains("list_dir"))
        {
            var q = args.GetValueOrDefault("query") ?? args.GetValueOrDefault("Query") ?? args.GetValueOrDefault("pattern") ?? args.GetValueOrDefault("Pattern") ?? args.GetValueOrDefault("directoryPath") ?? "";
            return ("Searched files", !string.IsNullOrWhiteSpace(q) ? $"“{q}”" : "", "search");
        }

        var firstArg = args.Values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v) && v.Length < 60) ?? "";
        return (displayName, firstArg, "custom");
    }

    private string GetFullTargetFilePath()
    {
        var args = ParsedArguments;
        return args.GetValueOrDefault("filePath") ?? args.GetValueOrDefault("AbsolutePath") ?? args.GetValueOrDefault("TargetFile") ?? args.GetValueOrDefault("path") ?? "";
    }

    private string GetCleanPath(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";
        var parts = raw.Split(new[] { '/', '\\' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length <= 2) return raw;
        return $"{parts[^2]}/{parts[^1]}";
    }

    private string Capitalize(string s) => string.IsNullOrEmpty(s) ? s : char.ToUpperInvariant(s[0]) + s[1..];

    private string CapitalizeWords(string s)
    {
        if (string.IsNullOrEmpty(s)) return s;
        return string.Join(" ", s.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(Capitalize));
    }

    private int GetOutputLineCount()
    {
        if (string.IsNullOrEmpty(ToolCall.Result)) return 0;
        return ToolCall.Result.Split('\n').Length;
    }

    private string GetSearchQuery()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(ToolCall.Arguments)) return "";
            var node = JsonNode.Parse(ToolCall.Arguments);
            return node?["query"]?.ToString() ?? node?["Query"]?.ToString() ?? "";
        }
        catch
        {
            return "";
        }
    }

    private List<SearchSourceItem> GetSources()
    {
        var list = new List<SearchSourceItem>();
        if (string.IsNullOrWhiteSpace(ToolCall.Result)) return list;

        var matches = System.Text.RegularExpressions.Regex.Matches(ToolCall.Result, @"\[(.*?)\]\((https?://.*?)\)");
        foreach (System.Text.RegularExpressions.Match m in matches)
        {
            var title = m.Groups[1].Value.Trim();
            var url = m.Groups[2].Value.Trim();
            var domain = "";
            try
            {
                var uri = new Uri(url);
                domain = uri.Host.StartsWith("www.") ? uri.Host[4..] : uri.Host;
            }
            catch
            {
                domain = url;
            }

            if (!list.Any(s => s.Url == url || s.Domain == domain))
            {
                list.Add(new SearchSourceItem(title, url, domain));
            }
        }

        if (list.Count == 0)
        {
            var urls = WebContentService.ExtractUrls(ToolCall.Result);
            foreach (var url in urls)
            {
                try
                {
                    var uri = new Uri(url);
                    var domain = uri.Host.StartsWith("www.") ? uri.Host[4..] : uri.Host;
                    if (!list.Any(s => s.Domain == domain))
                    {
                        list.Add(new SearchSourceItem(domain, url, domain));
                    }
                }
                catch {}
            }
        }

        return list;
    }

    private async Task CopyContent()
    {
        var textToCopy = !string.IsNullOrWhiteSpace(ToolCall.Result)
            ? ToolCall.Result
            : GetFullTargetFilePath();

        if (string.IsNullOrWhiteSpace(textToCopy))
        {
            var (_, targetText, _) = GetToolSummaryInfo();
            textToCopy = targetText;
        }

        if (string.IsNullOrEmpty(textToCopy)) return;

        try
        {
            await JSRuntime.InvokeVoidAsync("gramDesktop.copyText", textToCopy);
            isCopied = true;
            StateHasChanged();
            await Task.Delay(1400);
            isCopied = false;
            StateHasChanged();
        }
        catch {}
    }

    private async Task CancelExecution()
    {
        try
        {
            await Session.CancelAsync();
        }
        catch (Exception ex)
        {
            GramLog.Error("DesktopToolCard", $"Error canceling tool execution: {ex.Message}");
        }
    }

    private async Task SendToTerminal()
    {
        var (_, targetText, _) = GetToolSummaryInfo();
        if (string.IsNullOrWhiteSpace(targetText)) return;

        try
        {
            TabService.OpenTerminalTab();
            var termTab = TabService.OpenTabs.FirstOrDefault(t => t.Type == WorkspaceTabType.Terminal);
            var tabId = termTab?.Id ?? "term-default";

            await PtyService.StartOrGetSessionAsync(tabId, Session.WorkspacePath);
            await PtyService.WriteInputAsync(tabId, targetText + "\n");
        }
        catch (Exception ex)
        {
            GramLog.Error("DesktopToolCard", $"Failed to send command to terminal: {ex.Message}");
        }
    }
}
