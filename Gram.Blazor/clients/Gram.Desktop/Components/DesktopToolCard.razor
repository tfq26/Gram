@namespace Gram.Desktop.Components
@using Gram.Blazor.Shared
@using System.Text.Json.Nodes
@inject IJSRuntime JSRuntime

@{
    var isRunning = string.IsNullOrWhiteSpace(ToolCall.Result) && !ToolCall.IsError;
    var (actionLabel, targetText, targetKind) = GetToolSummaryInfo();
}

<div class="dt-tool-card @(ToolCall.IsError ? "is-error" : (isRunning ? "is-running" : "is-complete"))">
    <div class="dt-tool-header" @onclick="ToggleExpand">
        <div class="dt-tool-meta">
            <div class="dt-tool-icon @targetKind">
                @if (targetKind == "command")
                {
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="4 17 10 11 4 5"></polyline>
                        <line x1="12" y1="19" x2="20" y2="19"></line>
                    </svg>
                }
                else if (targetKind == "file-write")
                {
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                    </svg>
                }
                else if (targetKind == "file-read")
                {
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                    </svg>
                }
                else if (targetKind == "search")
                {
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                }
                else
                {
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                }
            </div>

            <div class="dt-tool-info">
                <span class="dt-tool-action">@actionLabel</span>
                @if (!string.IsNullOrWhiteSpace(targetText))
                {
                    <span class="dt-tool-target" title="@targetText">
                        @if (targetKind == "command")
                        {
                            <span class="dt-tool-sym">❯</span>
                        }
                        <span>@targetText</span>
                    </span>
                }
            </div>
        </div>

        <div class="dt-tool-controls">
            @if (isRunning)
            {
                <span class="dt-tool-status running">
                    <span class="dt-tool-spinner"></span>
                    <span>Running</span>
                </span>
            }
            else if (ToolCall.IsError)
            {
                <span class="dt-tool-status error">Failed</span>
            }
            else
            {
                <span class="dt-tool-status success">
                    @(GetOutputLineCount() > 0 ? $"{GetOutputLineCount()} lines" : "Done")
                </span>
            }

            <button type="button" class="dt-tool-chevron @(isExpanded ? "expanded" : "")" aria-label="Toggle details">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </button>
        </div>
    </div>

    @if (isExpanded)
    {
        <div class="dt-tool-body">
            @if (ParsedArguments.Count > 0)
            {
                <div class="dt-tool-section">
                    <div class="dt-tool-section-title">Arguments</div>
                    <div class="dt-tool-params">
                        @foreach (var kv in ParsedArguments)
                        {
                            <div class="dt-tool-param-row">
                                <span class="dt-tool-param-key">@kv.Key:</span>
                                <span class="dt-tool-param-val">@kv.Value</span>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(ToolCall.Result))
            {
                <div class="dt-tool-section">
                    <div class="dt-tool-section-header">
                        <span class="dt-tool-section-title">Output</span>
                        <button type="button" class="dt-tool-copy-btn" @onclick="CopyOutput" title="Copy output">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                            </svg>
                            <span>Copy</span>
                        </button>
                    </div>
                    <pre class="dt-tool-console @(ToolCall.IsError ? "error" : "")">@ToolCall.Result</pre>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public ToolCallInfo ToolCall { get; set; } = new();
    private bool isExpanded = false;

    private void ToggleExpand() => isExpanded = !isExpanded;

    private Dictionary<string, string> ParsedArguments
    {
        get
        {
            var dict = new Dictionary<string, string>();
            if (string.IsNullOrWhiteSpace(ToolCall.Arguments)) return dict;
            try
            {
                var node = JsonNode.Parse(ToolCall.Arguments);
                if (node is JsonObject obj)
                {
                    foreach (var kvp in obj)
                    {
                        dict[kvp.Key] = kvp.Value?.ToString() ?? "";
                    }
                }
            }
            catch
            {
                dict["args"] = ToolCall.Arguments;
            }
            return dict;
        }
    }

    private (string ActionLabel, string TargetText, string TargetKind) GetToolSummaryInfo()
    {
        var name = ToolCall.ToolName.ToLowerInvariant();
        var args = ParsedArguments;
        var displayName = ToolNameHelper.GetDisplayName(ToolCall.ToolName);

        if (name.Contains("run_command") || name.Contains("bash") || name.Contains("exec") || name.Contains("cmd"))
        {
            var cmd = args.GetValueOrDefault("command") ?? args.GetValueOrDefault("CommandLine") ?? args.GetValueOrDefault("cmd") ?? "";
            return ("Terminal", cmd, "command");
        }

        if (name.Contains("write_file") || name.Contains("edit_file") || name.Contains("write_to_file") || name.Contains("replace_file"))
        {
            var path = args.GetValueOrDefault("filePath") ?? args.GetValueOrDefault("TargetFile") ?? args.GetValueOrDefault("path") ?? "";
            return (name.Contains("edit") ? "Edit File" : "Write File", GetCleanPath(path), "file-write");
        }

        if (name.Contains("view_file") || name.Contains("read_file"))
        {
            var path = args.GetValueOrDefault("filePath") ?? args.GetValueOrDefault("AbsolutePath") ?? args.GetValueOrDefault("path") ?? "";
            return ("Read File", GetCleanPath(path), "file-read");
        }

        if (name.Contains("find_files") || name.Contains("grep") || name.Contains("list_directory"))
        {
            var q = args.GetValueOrDefault("query") ?? args.GetValueOrDefault("pattern") ?? args.GetValueOrDefault("directoryPath") ?? "";
            return (displayName, !string.IsNullOrWhiteSpace(q) ? $"\"{q}\"" : "Files", "search");
        }

        var firstArg = args.Values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v) && v.Length < 60) ?? "";
        return (displayName, firstArg, "custom");
    }

    private string GetCleanPath(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";
        var parts = raw.Split(new[] { '/', '\\' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length <= 2) return raw;
        return $"{parts[^2]}/{parts[^1]}";
    }

    private int GetOutputLineCount()
    {
        if (string.IsNullOrEmpty(ToolCall.Result)) return 0;
        return ToolCall.Result.Split('\n').Length;
    }

    private async Task CopyOutput()
    {
        if (string.IsNullOrEmpty(ToolCall.Result)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("gramDesktop.copyText", ToolCall.Result);
        }
        catch {}
    }
}
