<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Gram.Desktop</AssemblyName>
    <RootNamespace>Gram.Desktop</RootNamespace>
    <ApplicationIcon>Resources/AppIcon.ico</ApplicationIcon>
    <Product>Gram</Product>
    <AssemblyTitle>Gram</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Gram.Blazor.csproj" ReferenceOutputAssembly="true" />
    <ProjectReference Include="../GramBox.Contracts/GramBox.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
    <PackageReference Include="Porta.Pty" Version="1.0.7" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="Resources\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
