@page "/sandbox-test"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@rendermode InteractiveServer
@using Gram.Blazor.Shared
@inject IGramBoxService GramBox
@inject IPlatformSandboxController PlatformSandboxController
@inject SandboxAuditService SandboxAudit

<PageTitle>Sandbox Test · Gram</PageTitle>

<div class="voice-test-page search-test-page">
    <div class="voice-test-card search-test-card">
        <div class="voice-test-header"><div><span class="voice-test-eyebrow">DIAGNOSTIC TOOL</span><h1>Gram Box test</h1><p>Create a disposable native sandbox and measure a command using the same execution path as agents.</p></div><a class="voice-test-back" href="/">Back to chat</a></div>
            <div class="search-test-input-panel">
            <p>Resource enforcement: <strong>@PlatformSandboxController.Capabilities.EnforcementMode</strong> · @PlatformSandboxController.Capabilities.Explanation</p><p>Audit log: <code>@SandboxAudit.LogPath</code></p>
            <label class="voice-test-section-label" for="sandboxCommand">Command</label>
            <input id="sandboxCommand" class="search-test-query" @bind="command" />
            <div class="voice-test-controls"><button type="button" class="voice-test-button" @onclick="CreateAsync" disabled="@running">Create sandbox</button><button type="button" class="voice-test-secondary-button" @onclick="RunAsync" disabled="@(running || active == null)">Run command</button><button type="button" class="voice-test-secondary-button" @onclick="CloseAsync" disabled="@(running || active == null)">Close sandbox</button><span class="voice-test-status">@status</span></div>
        </div>
        @if (active != null)
        {
            <section class="search-test-run"><div class="search-test-run-header"><div><span class="search-test-status-pill pass">@active.Id</span><h2>@active.Name</h2></div><strong>@active.Status</strong></div><p>Worktree: <code>@active.WorktreePath</code></p><p>Budget: @active.ResourceBudget?.CpuCores CPU · @FormatBytes(active.ResourceBudget?.MemoryBytes ?? 0) memory · @FormatBytes(active.ResourceBudget?.DiskBytes ?? 0) disk</p></section>
        }
        @if (lastResult != null)
        {
            <section class="search-test-run"><div class="voice-test-section-label">Last execution</div><p>Success: @lastResult.Success · Exit code: @lastResult.ExitCode · @lastResult.ElapsedMs ms · CPU: @lastResult.CpuTimeMs ms · Peak memory: @FormatBytes(lastResult.PeakWorkingSetBytes) · Output: @lastResult.OutputBytes bytes</p><pre class="artifact-code-pre">@lastResult.Stdout@lastResult.Stderr</pre></section>
        }
    </div>
</div>

@code {
    private GramBoxSandboxSession? active;
    private GramBoxExecutionResult? lastResult;
    private string command = "dotnet --info";
    private string status = "Ready";
    private bool running;

    private async Task CreateAsync()
    {
        if (running) return;
        running = true;
        try { active = await GramBox.CreateSandboxAsync(Environment.CurrentDirectory, taskName: "Manual resource test"); status = $"Created {active.Id}"; }
        catch (Exception ex) { status = $"Create failed: {ex.Message}"; }
        finally { running = false; }
    }

    private async Task RunAsync()
    {
        if (running || active == null) return;
        running = true;
        try { lastResult = await GramBox.ExecuteAsync(command, active.Id, timeoutSeconds: 120); status = lastResult.Success ? "Command completed" : "Command failed"; }
        finally { running = false; }
    }

    private async Task CloseAsync()
    {
        if (running || active == null) return;
        await GramBox.CloseSandboxAsync(active.Id);
        active = null; lastResult = null; status = "Sandbox closed";
    }

    private static string FormatBytes(long value) => value < 1024 ? $"{value} B" : value < 1024 * 1024 ? $"{value / 1024d:0.0} KB" : $"{value / 1024d / 1024d:0.0} MB";
}
