@page "/sandbox-benchmark"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@rendermode InteractiveServer
@using Gram.Blazor.Shared
@inject SandboxBenchmarkService BenchmarkService

<PageTitle>Sandbox Benchmark · Gram</PageTitle>

<div class="voice-test-page search-test-page">
    <div class="voice-test-card search-test-card">
        <div class="voice-test-header"><div><span class="voice-test-eyebrow">DIAGNOSTIC TOOL</span><h1>Ten-sandbox benchmark</h1><p>Creates a temporary repository, measures ten native sandboxes, runs bounded commands, and removes everything when finished.</p></div><a class="voice-test-back" href="/">Back to chat</a></div>
        <div class="voice-test-controls"><button type="button" class="voice-test-button" @onclick="RunAsync" disabled="@running">@(running ? "Benchmark running..." : "Run benchmark")</button><span class="voice-test-status">@status</span></div>
        @if (report != null)
        {
            <section class="search-test-summary"><div class="voice-test-section-label">Benchmark result</div><div class="voice-test-grid search-test-metrics"><div><span>Sandboxes</span><strong>@report.SandboxCount</strong></div><div><span>Create time</span><strong>@FormatMs(report.CreationMilliseconds)</strong></div><div><span>Commands</span><strong>@report.SuccessfulCommands / @report.SandboxCount</strong></div><div><span>Command time</span><strong>@FormatMs(report.CommandMilliseconds)</strong></div><div><span>Repository size</span><strong>@FormatBytes(report.RepositoryBytes)</strong></div><div><span>Worktree size</span><strong>@FormatBytes(report.WorktreeBytes)</strong></div><div><span>Gram RAM delta</span><strong>@FormatBytes(report.ProcessWorkingSetAfterBytes - report.ProcessWorkingSetBeforeBytes)</strong></div><div><span>Enforcement</span><strong>@report.EnforcementMode</strong></div></div>@if (report.Error != null) { <div class="voice-test-error">@report.Error</div> }</section>
        }
    </div>
</div>

@code {
    private SandboxBenchmarkReport? report;
    private bool running;
    private string status = "Ready";
    private async Task RunAsync()
    {
        if (running) return;
        running = true; report = null; status = "Creating temporary repository and ten sandboxes...";
        try { report = await BenchmarkService.RunAsync(10); status = report.Error == null ? "Benchmark complete; temporary files removed." : "Benchmark failed; temporary files cleaned where possible."; }
        finally { running = false; }
    }
    private static string FormatMs(long value) => $"{value / 1000d:0.00}s";
    private static string FormatBytes(long value) => value < 1024 * 1024 ? $"{value / 1024d:0.0} KB" : $"{value / 1024d / 1024d:0.0} MB";
}
