    private void OnQuotaNotification(QuotaNotification notification)
    {
        _ = InvokeAsync(() =>
        {
            if (notification.IsExhausted)
            {
                SonnerService.Error("Quota exhausted", notification.Message, 7000);
                if (isGenerating)
                {
                    try
                    {
                        chatCts?.Cancel();
                    }
                    catch { }
                    isGenerating = false;
                    var lastAssistant = Active.Messages.LastOrDefault(m => m.Role == "assistant");
                    if (lastAssistant != null)
                    {
                        if (string.IsNullOrWhiteSpace(lastAssistant.Text))
                        {
                            lastAssistant.Text = $"[Generation stopped · {notification.Message}]";
                        }
                        else if (!lastAssistant.Text.Contains("[Generation stopped"))
                        {
                            lastAssistant.Text += $"\n\n[Generation stopped · {notification.Message}]";
                        }
                    }
                }
            }
            else
            {
                SonnerService.Warning("Quota running low", notification.Message, 6000);
            }
            StateHasChanged();
        });
    }

    private static (string MainText, bool HasStoppedNotice, string? StoppedDetail) ParseStoppedMessage(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return (string.Empty, false, null);
        }

        var trimmed = text.Trim();
        if (trimmed.Equals("[Generation stopped]", StringComparison.OrdinalIgnoreCase))
        {
            return (string.Empty, true, null);
        }

        if (trimmed.StartsWith("[Generation stopped", StringComparison.OrdinalIgnoreCase) && trimmed.EndsWith("]"))
        {
            var inner = trimmed[1..^1];
            var parts = inner.Split('·', StringSplitOptions.TrimEntries);
            var detail = parts.Length > 1 ? parts[1] : null;
            return (string.Empty, true, detail);
        }

        if (trimmed.StartsWith("⚠️ Generation stopped", StringComparison.OrdinalIgnoreCase))
        {
            var colonIdx = trimmed.IndexOf(':');
            var detail = colonIdx >= 0 ? trimmed[(colonIdx + 1)..].Trim() : null;
            return (string.Empty, true, detail);
        }

        const string bracketMarker = "\n\n[Generation stopped";
        var idx = text.IndexOf(bracketMarker, StringComparison.OrdinalIgnoreCase);
        if (idx >= 0)
        {
            var main = text[..idx].TrimEnd();
            var suffix = text[idx..].Trim();
            if (suffix.EndsWith("]")) suffix = suffix[1..^1];
            var parts = suffix.Split('·', StringSplitOptions.TrimEntries);
            var detail = parts.Length > 1 ? parts[1] : null;
            return (main, true, detail);
        }

        const string emojiMarker = "\n\n⚠️ Generation stopped";
        var emojiIdx = text.IndexOf(emojiMarker, StringComparison.OrdinalIgnoreCase);
        if (emojiIdx >= 0)
        {
            var main = text[..emojiIdx].TrimEnd();
            var suffix = text[(emojiIdx + emojiMarker.Length)..].Trim();
            if (suffix.StartsWith(":")) suffix = suffix[1..].Trim();
            return (main, true, string.IsNullOrWhiteSpace(suffix) ? null : suffix);
        }

        return (text, false, null);
    }

    private static string GetPresentationStatusLabel(ContentProject project)
    {
        var ready = project.Sections.Count(section => section.Status == ContentSectionStatus.Ready);
        return project.Status switch
        {
            ContentProjectStatus.Planning => "Planning the story",
            ContentProjectStatus.NeedsRevision => "Refining a section",
            ContentProjectStatus.ReadyForAssembly => "Reviewing slide balance",
            ContentProjectStatus.Assembled => "Presentation ready",
            _ when ready == 0 => "Gathering evidence and drafting sections",
            _ when ready < project.Sections.Count => $"Designing the next slide · {ready} ready",
            _ => "Reviewing slide balance"
        };
    }

