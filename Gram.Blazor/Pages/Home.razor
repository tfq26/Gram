    private async Task DeleteConversation(string id)
    {
        if (conversations.Count <= 1) return;
        var targetId = id;
        var index = conversations.FindIndex(x => x.Id == targetId);
        if (index >= 0)
        {
            if (activeId == targetId)
            {
                var nextIndex = index > 0 ? index - 1 : index + 1;
                if (nextIndex < conversations.Count)
                {
                    activeId = conversations[nextIndex].Id;
                    ChatStateService.ActiveChatTitle = Active.Title;
