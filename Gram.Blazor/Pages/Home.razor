    private int EstimateTokens(List<Message> msgs)
    {
        if (msgs == null || msgs.Count == 0) return 0;
        int chars = msgs.Sum(m => m.Text.Length + (m.Thinking?.Length ?? 0));
        return Math.Max(1, chars / 4);
    }

    private void PopulateMentions()
    {
        allMentions = new List<MentionItem>
        {
            new("web-search", MentionKind.Web, "Search the web", "Force live search through the configured provider", "Actions", "web"),
            new("toolbox", MentionKind.Toolbox, "Gram Toolbox", "Enabled tools, skills, and MCP capabilities", "Actions", "toolbox")
        };

        foreach (var attachment in Active.Attachments.OrderByDescending(item => item.CreatedAt).Take(40))
        {
            var size = attachment.SizeBytes < 1024
                ? $"{attachment.SizeBytes} B"
                : $"{Math.Max(1, attachment.SizeBytes / 1024)} KB";
            allMentions.Add(new MentionItem(
                $"attachment:{attachment.Id}",
                MentionKind.File,
                attachment.FileName,
                $"Attached to this chat · {size}",
                "Files",
                attachment.FileName));
        }

        foreach (var artifact in Active.Artifacts.Take(20))
        {
            allMentions.Add(new MentionItem($"artifact:{artifact.Id}", MentionKind.Artifact, artifact.FileName, artifact.Title, "Artifacts", artifact.Id));
        }

        mentionsPopulatedAt = DateTimeOffset.UtcNow;
        ApplyMentionFilter("");
    }

    private void ApplyMentionFilter(string query)
    {
        var normalized = query.Trim().TrimStart('@');
        filteredMentions = allMentions
            .Select(item => (Item: item, Score: MentionScore(item, normalized)))
            .Where(result => string.IsNullOrWhiteSpace(normalized) || result.Score > 0)
            .OrderBy(result => MentionCategoryOrder(result.Item.Category))
            .ThenByDescending(result => result.Score)
            .ThenBy(result => allMentions.IndexOf(result.Item))
            .Take(16)
            .Select(result => result.Item)
            .ToList();
        selectedMentionIndex = 0;
    }

    private static int MentionScore(MentionItem item, string query)
    {
        if (string.IsNullOrWhiteSpace(query)) return 1;
        if (item.Title.StartsWith(query, StringComparison.OrdinalIgnoreCase)) return 100;
        if (item.Title.Contains(query, StringComparison.OrdinalIgnoreCase)) return 70;
        if (item.Target.Contains(query, StringComparison.OrdinalIgnoreCase)) return 55;
        if (item.Description.Contains(query, StringComparison.OrdinalIgnoreCase)) return 30;

        var queryParts = query.Split(['/', '-', '_', ' '], StringSplitOptions.RemoveEmptyEntries);
        return queryParts.All(part => $"{item.Title} {item.Target}".Contains(part, StringComparison.OrdinalIgnoreCase)) ? 20 : 0;
    }

    private static int MentionCategoryOrder(string category) => category switch
    {
        "Actions" => 0,
        "Files" => 1,
        "Artifacts" => 2,
        _ => 4
    };

