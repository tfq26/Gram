    private async Task CommitAllDiffs()
    {
        var ok = await GitGram.CommitChangesAsync("chore: autonomous repository sync", Environment.CurrentDirectory);
        if (ok)
        {
            LoadGitDiff();
        }
    }

    private void LoadGitDiff()
    {
        try
        {
            activeDiffs.Clear();
            var statusProcess = new System.Diagnostics.Process
            {
                StartInfo = new System.Diagnostics.ProcessStartInfo
                {
                    FileName = "git",
                    Arguments = "diff HEAD",
                    WorkingDirectory = Environment.CurrentDirectory,
                    RedirectStandardOutput = true,
                    RedirectStandardError = true,
                    UseShellExecute = false,
                    CreateNoWindow = true
                }
            };
            statusProcess.Start();
            var diffText = statusProcess.StandardOutput.ReadToEnd();
            statusProcess.WaitForExit(3000);

            if (!string.IsNullOrWhiteSpace(diffText))
            {
                var files = diffText.Split("diff --git ", StringSplitOptions.RemoveEmptyEntries);
                foreach (var f in files)
                {
                    var lines = f.Split('\n');
                    var header = lines.FirstOrDefault() ?? "";
                    var fileName = header.Split(' ').LastOrDefault()?.TrimStart('b', '/') ?? "file";
                    var diffItem = new DiffFileItem { FilePath = fileName, Status = "Modified" };

                    int oldLn = 0, newLn = 0;
                    foreach (var l in lines.Skip(1))
                    {
                        if (l.StartsWith("+++") || l.StartsWith("---")) continue;
                        if (l.StartsWith("@@"))
                        {
                            diffItem.Lines.Add(new DiffLine { Type = "header", Content = l });
                        }
                        else if (l.StartsWith("+"))
                        {
                            newLn++;
                            diffItem.Lines.Add(new DiffLine { Type = "add", Content = l, NewLineNumber = newLn });
                        }
                        else if (l.StartsWith("-"))
                        {
                            oldLn++;
                            diffItem.Lines.Add(new DiffLine { Type = "delete", Content = l, OldLineNumber = oldLn });
                        }
                        else
                        {
                            oldLn++;
                            newLn++;
                            diffItem.Lines.Add(new DiffLine { Type = "context", Content = l, OldLineNumber = oldLn, NewLineNumber = newLn });
                        }
                    }
                    activeDiffs.Add(diffItem);
                }
            }
            else
            {
                // Fallback demo diff if git workspace is clean
                activeDiffs.Add(new DiffFileItem
                {
                    FilePath = "Workspace is clean (No uncommitted changes)",
                    Status = "Clean",
                    Lines = [new DiffLine { Type = "header", Content = "No uncommitted modifications detected." }]
                });
            }
        }
        catch (Exception ex)
        {
            activeDiffs.Add(new DiffFileItem
            {
                FilePath = "Git Diff Error",
                Status = "Error",
                Lines = [new DiffLine { Type = "delete", Content = ex.Message }]
            });
        }
        OpenSidecar(SidecarTab.GitDiff);
    }


