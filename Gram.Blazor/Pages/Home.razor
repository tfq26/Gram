                                            <div style="display: flex; align-items: center; gap: 6px;">
                                                <span class="mention-badge">@art.Language</span>
                                                <Button Variant="outline" Size="sm" OnClick:stopPropagation="true" OnClick="() => ApplyArtifact(art)">
                                                    Apply
                                                </Button>
                                            </div>
                                        </div>
                                    }
                                </div>
