    private async Task SelectMentionAsync(MentionItem mention)
    {
        if (!pendingMentions.Any(item => item.Id.Equals(mention.Id, StringComparison.OrdinalIgnoreCase)))
        {
            pendingMentions.Add(new MentionReference
            {
                Id = mention.Id,
                Kind = mention.Kind,
                Label = mention.Title,
                Target = mention.Target
            });
        }

        try
        {
            draft = await JSRuntime.InvokeAsync<string>(
                "gramAudio.replaceMentionAtCaret",
                "composerTextarea",
                activeMentionStart,
                activeMentionEnd);
        }
        catch
        {
            if (activeMentionStart >= 0 && activeMentionEnd >= activeMentionStart && activeMentionEnd <= draft.Length)
            {
                draft = draft.Remove(activeMentionStart, activeMentionEnd - activeMentionStart);
            }
        }

        showMentionPopup = false;
        activeMentionStart = -1;
        activeMentionEnd = -1;
        StateHasChanged();
        try { await JSRuntime.InvokeVoidAsync("gramAudio.focusComposer", "composerTextarea"); } catch { }
    }

