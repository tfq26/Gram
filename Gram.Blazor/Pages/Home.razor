    private sealed class CompressedImageResult
    {
        public string? Base64 { get; set; }
        public string? ContentType { get; set; }
        public int Width { get; set; }
        public int Height { get; set; }
    }

    private async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        isAttachMenuOpen = false;
        foreach (var file in e.GetMultipleFiles(10))
        {
            try
            {
                var contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/png" : file.ContentType;
                var fileName = file.Name;
                Stream uploadStream;

                try
                {
                    using var readStream = file.OpenReadStream(25 * 1024 * 1024);
                    using var ms = new MemoryStream();
                    await readStream.CopyToAsync(ms);
                    var base64 = Convert.ToBase64String(ms.ToArray());

                    var compressed = await JSRuntime.InvokeAsync<CompressedImageResult>("gramMedia.compressImage", base64, contentType, 1920, 0.82);
                    if (compressed != null && !string.IsNullOrEmpty(compressed.Base64))
                    {
                        var compressedBytes = Convert.FromBase64String(compressed.Base64);
                        uploadStream = new MemoryStream(compressedBytes);
                        contentType = compressed.ContentType ?? "image/webp";
                        if (!fileName.EndsWith(".webp", StringComparison.OrdinalIgnoreCase))
                        {
                            fileName = Path.GetFileNameWithoutExtension(fileName) + ".webp";
                        }
                    }
                    else
                    {
                        uploadStream = new MemoryStream(ms.ToArray());
                    }
                }
                catch
                {
                    uploadStream = file.OpenReadStream(25 * 1024 * 1024);
                }

                using (uploadStream)
                {
                    var attInfo = await SessionStorage.SaveAttachmentAsync(Active.Id, fileName, uploadStream, contentType);
                    if (!Active.Attachments.Any(a => a.FileName == attInfo.FileName))
                    {
                        Active.Attachments.Add(attInfo);
                    }
                    if (!attachedFiles.Contains(attInfo.FileName))
                    {
                        attachedFiles.Add(attInfo.FileName);
                    }
                    SonnerService.Success("Image attached", $"{fileName} ready for visual analysis");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Home] Error uploading image {file.Name}: {ex.Message}");
                SonnerService.Error("Upload failed", ex.Message);
            }
        }
        await SaveConversationThroughApiAsync(Active);
        StateHasChanged();
    }

