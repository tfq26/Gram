        {
            if (allMentions.Count == 0 || DateTimeOffset.UtcNow - mentionsPopulatedAt > TimeSpan.FromSeconds(3)) PopulateMentions();
            activeMentionStart = mentionState.Start;
            activeMentionEnd = mentionState.End;
            ApplyMentionFilter(mentionState.Query);
