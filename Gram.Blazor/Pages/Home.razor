    [JSInvokable]
    public async Task HandleMentionKey(string key)
    {
        if (!showMentionPopup) return;
        if (key == "Escape")
        {
            showMentionPopup = false;
        }
        else if (key == "ArrowDown" && filteredMentions.Count > 0)
        {
            selectedMentionIndex = (selectedMentionIndex + 1) % filteredMentions.Count;
        }
        else if (key == "ArrowUp" && filteredMentions.Count > 0)
        {
            selectedMentionIndex = (selectedMentionIndex - 1 + filteredMentions.Count) % filteredMentions.Count;
        }
        else if ((key == "Enter" || key == "Tab") && filteredMentions.Count > 0)
        {
            await SelectMentionAsync(filteredMentions[Math.Clamp(selectedMentionIndex, 0, filteredMentions.Count - 1)]);
            return;
        }

        StateHasChanged();
        try { await JSRuntime.InvokeVoidAsync("gramAudio.scrollMentionIntoView", selectedMentionIndex); } catch { }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && showMentionPopup)
        {
            showMentionPopup = false;
            preventEnter = false;
            return;
        }

        if (e.Key == "Enter" && !e.ShiftKey)
        {
            if (showMentionPopup && filteredMentions.Count > 0)
            {
                await SelectMentionAsync(filteredMentions[Math.Clamp(selectedMentionIndex, 0, filteredMentions.Count - 1)]);
                preventEnter = true;
                return;
            }

            preventEnter = true;
            await Send();
        }
        else
        {
            preventEnter = false;
        }
    }

    private async Task Send()
    {
        if (isGenerating) return;

        var wasVoice = voiceState == VoiceState.UserSpeaking;
        var isVoiceTurn = voiceConversationActive && wasVoice;

        if (wasVoice)
        {
            var finalTranscript = await StopVoice();
            if (!string.IsNullOrWhiteSpace(finalTranscript))
            {
                draft = finalTranscript;
            }
        }

        var text = draft.Trim();

        if (string.IsNullOrWhiteSpace(text) && attachedFiles.Count == 0 && pendingMentions.Count == 0 && !wasVoice)
        {
            return;
        }

        draft = "";
        try { await JSRuntime.InvokeVoidAsync("gramAudio.resetTextarea", "composerTextarea"); } catch (Exception) {}
        StateHasChanged();

        var userMessageText = text;
        if (wasVoice && string.IsNullOrWhiteSpace(userMessageText))
        {
            userMessageText = "Voice message";
        }

        if (attachedFiles.Count > 0)
        {
            var filesSuffix = $" [Attached: {string.Join(", ", attachedFiles)}]";
            userMessageText = string.IsNullOrWhiteSpace(userMessageText) ? filesSuffix.Trim() : $"{userMessageText}{filesSuffix}";
            attachedFiles.Clear();
        }

        if (string.IsNullOrWhiteSpace(userMessageText) && pendingMentions.Count > 0)
        {
            userMessageText = "Use the selected context.";
        }

        var mentionsForMessage = pendingMentions.Select(CloneMention).ToList();
        pendingMentions.Clear();
        var userMsg = new Message("user", userMessageText) { Mentions = mentionsForMessage };

        // If this conversation is not yet in the conversations list, add it now
        if (!conversations.Any(c => c.Id == Active.Id))
        {
            conversations.Insert(0, Active);
        }

        Active.Messages.Add(userMsg);

        // Append to transcript.jsonl
        await SessionStorage.AppendTranscriptEntryAsync(Active.Id, new TranscriptEntry
        {
            Step = Active.Messages.Count,
            Type = TranscriptEntryType.USER_INPUT,
            Role = "user",
            Content = userMessageText,
            Mentions = userMsg.Mentions.Select(CloneMention).ToList(),
            Timestamp = userMsg.Timestamp
        });

        var isFirstMessage = Active.Messages.Count(m => m.Role == "user") == 1;
        if (isFirstMessage)
        {
            Active.Title = userMessageText.Length > 28 ? userMessageText[..28] + "…" : userMessageText;
            ChatStateService.ActiveChatTitle = Active.Title;
        }

        var assistantMessage = await GenerateAssistantResponseAsync(userMessageText, isFirstMessage);
        if (isVoiceTurn && voiceConversationActive)
        {
            await SpeakVoiceResponseAsync(assistantMessage);
        }
    }

    private async Task<Message> GenerateAssistantResponseAsync(string promptText, bool isFirstMessage = false)
    {
        var assistantMsg = new Message("assistant", "");
        Active.Messages.Add(assistantMsg);
        Active.Updated = DateTimeOffset.UtcNow;
        isGenerating = true;
        StateHasChanged();
        _ = JSRuntime.InvokeVoidAsync("gramAudio.scrollToBottom", "messagesContainer");

        chatCts?.Cancel();
        chatCts = new CancellationTokenSource();
        var token = chatCts.Token;

        var effectiveModelId = !string.IsNullOrWhiteSpace(Active.ModelId) ? Active.ModelId : activeModelId;
        if (string.IsNullOrWhiteSpace(effectiveModelId))
        {
            effectiveModelId = ModelService.Models.FirstOrDefault(m => m.IsFavorite)?.Id 
                               ?? ModelService.Models.FirstOrDefault()?.Id 
                               ?? "anthropic/claude-3.7-sonnet";
        }

        currentRun = AgentRunTracker.Start(Active.Id, effectiveModelId);
        showRunDetails = false;
        StateHasChanged();

        var currentUserMessage = Active.Messages.LastOrDefault(message => message.Role == "user");
        var isPresentationMode = PresentationGenerationService.IsPresentationRequest(promptText, currentUserMessage?.Mentions);

        if (isPresentationMode && !effectiveModelId.Equals("gram-q-plus", StringComparison.OrdinalIgnoreCase))
        {
            effectiveModelId = "gram-q-plus";
            SonnerService.Info("Presentation mode", "Presentation generation is routed through Gram Q+ for reliability.");
        }

        if (isFirstMessage)
        {
            _ = AutoGenerateChatTitleAsync(Active, promptText, effectiveModelId);
        }

        // Assemble Context with explicit mentions, workspace attachments, and rolling memory.
        await ContextBuilder.EnsureContextSummaryAsync(Active);
        var workspacePath = Environment.CurrentDirectory;
        var mentionResolution = await MentionResolver.ResolveAsync(
            currentUserMessage?.Mentions,
            Active,
            workspacePath,
            promptText,
            token);
        var contextResult = await ContextBuilder.AssembleContextAsync(
            Active,
            workspacePath: workspacePath,
            relevanceQuery: promptText,
            additionalSystemPrompt: voiceConversationActive ? GramSystemPrompt.VoiceConversationPrompt : null,
            mentionedContext: mentionResolution.Context);

        try
        {
            assistantMsg.ToolCalls = new List<ToolCallInfo>();

            await foreach (var step in AgentWorkflowRouter.RunAsync(new AgentWorkflowRequest(
                effectiveModelId,
                promptText,
                contextResult.Messages,
                workspacePath,
                contextResult.SystemPrompt,
                8,
                contextResult.RepositoryMap,
                null,
                mentionResolution.ForcedWebSearchQuery,
                isPresentationMode || mentionResolution.IsPresentationRequested,
                token)))
            {
                if (currentRun != null)
                {
                    var status = step.ToolCall != null ? AgentRunStatus.Executing : AgentRunStatus.Executing;
                    AgentRunTracker.Update(currentRun.Id, status, step.ToolCall != null ? $"Using {step.ToolCall.ToolName}" : "Generating response");
                    currentRun = AgentRunTracker.Get(currentRun.Id);
                }
                if (!string.IsNullOrWhiteSpace(step.ErrorMessage))
                {
                    assistantMsg.ErrorDetail = step.ErrorMessage;
                }

                if (!string.IsNullOrEmpty(step.ContentDelta))
                {
                    assistantMsg.Text += step.ContentDelta;
                }

                if (step.ToolCall != null)
                {
                    var existing = assistantMsg.ToolCalls.FirstOrDefault(t => t.Id == step.ToolCall.Id);
                    if (existing != null)
                    {
                        existing.Result = step.ToolCall.Result;
                        existing.IsError = step.ToolCall.IsError;
                    }
                    else
                    {
                        assistantMsg.ToolCalls.Add(step.ToolCall);
                    }

                    // Record tool call entry in session storage
                    if (!string.IsNullOrWhiteSpace(step.ToolCall.Result))
                    {
                        _ = SessionStorage.AppendTranscriptEntryAsync(Active.Id, new TranscriptEntry
                        {
                            Step = Active.Messages.Count,
                            Type = TranscriptEntryType.TOOL_RESULT,
                            ToolName = step.ToolCall.ToolName,
                            ToolArgs = step.ToolCall.Arguments,
                            ToolResult = step.ToolCall.Result,
                            Timestamp = DateTimeOffset.UtcNow
                        });
                    }
                }

                if (step.PromptTokens.HasValue)
                {
                    Active.PromptTokens = step.PromptTokens.Value;
                }
                if (step.CachedPromptTokens.HasValue)
                {
                    Active.CachedPromptTokens = step.CachedPromptTokens.Value;
                }
                if (step.CompletionTokens.HasValue)
                {
                    Active.CompletionTokens = step.CompletionTokens.Value;
                }
                if (step.LatencyMs.HasValue)
                {
                    Active.LastLatencyMs = step.LatencyMs.Value;
                }

                StateHasChanged();
                _ = JSRuntime.InvokeVoidAsync("gramAudio.scrollToBottom", "messagesContainer");
            }
        }
        catch (OperationCanceledException)
        {
            if (currentRun != null) AgentRunTracker.Complete(currentRun.Id, AgentRunStatus.Cancelled, "Generation cancelled.");
            if (string.IsNullOrWhiteSpace(assistantMsg.Text) && (assistantMsg.ToolCalls == null || assistantMsg.ToolCalls.Count == 0))
            {
                assistantMsg.Text = "[Generation stopped]";
            }
        }
        catch (Exception ex)
        {
            if (currentRun != null) AgentRunTracker.Complete(currentRun.Id, AgentRunStatus.Failed, ex.Message);
            assistantMsg.ErrorDetail = ex.Message;
        }
        finally
        {
            if (currentRun != null && currentRun.Status is not (AgentRunStatus.Cancelled or AgentRunStatus.Failed))
            {
                AgentRunTracker.Complete(currentRun.Id);
                currentRun = AgentRunTracker.Get(currentRun.Id);
            }
            isGenerating = false;
            assistantMsg.Timestamp = DateTimeOffset.UtcNow;

            // Append final response to transcript.jsonl
            await SessionStorage.AppendTranscriptEntryAsync(Active.Id, new TranscriptEntry
            {
                Step = Active.Messages.Count,
                Type = TranscriptEntryType.MODEL_RESPONSE,
                Role = "assistant",
                Content = assistantMsg.Text,
                Timestamp = assistantMsg.Timestamp
            });

            await ConversationService.SaveConversationAsync(Active);
            StateHasChanged();
            _ = JSRuntime.InvokeVoidAsync("gramAudio.scrollToBottom", "messagesContainer");
        }

        return assistantMsg;
    }

