@page "/"
@rendermode InteractiveServer
@using Gram.Blazor.Shared
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JSRuntime
@inject Gram.Blazor.Shared.ModelService ModelService
@inject Gram.Blazor.Shared.ChatStateService ChatStateService
@inject Gram.Blazor.Shared.ConversationService ConversationService
@inject Gram.Blazor.Shared.SettingsService SettingsService
@inject Gram.Blazor.Shared.SessionStorageService SessionStorage
@inject Gram.Blazor.Shared.StorageService StorageService
@inject Gram.Blazor.Shared.AgentSecurityService SecurityService
@inject Gram.Blazor.Shared.AgentOrchestrator AgentOrchestrator
@inject Gram.Blazor.Shared.IAgentWorkflowRouter AgentWorkflowRouter
@inject Gram.Blazor.Shared.ContextBuilder ContextBuilder
@inject Gram.Blazor.Shared.MentionResolver MentionResolver
@inject Gram.Blazor.Shared.PresentationGenerationService PresentationGeneration
@inject Gram.Blazor.Shared.IQuotaTracker QuotaTracker
@inject Gram.Blazor.Shared.IAgentRunTracker AgentRunTracker
@inject NavigationManager NavManager
@inject Gram.Blazor.Shared.WorkspaceTabService TabService
@inject Gram.Blazor.Shared.IAuthService AuthService
@inject Gram.Blazor.Shared.ISonnerService SonnerService
@inject Gram.Blazor.Shared.GitGramService GitGram
@inject Gram.Blazor.Shared.IGramBoxService GramBox
@inject Gram.Blazor.Shared.IStreamingTranscriberFactory StreamingTranscriberFactory
@inject Gram.Blazor.Shared.ITextToSpeechProvider TextToSpeechProvider
@implements IAsyncDisposable

<PageTitle>Gram</PageTitle>

<div class="workspace-panes @(isSidebarOpen ? "left-open" : "left-closed") @(isSettingsSheetOpen ? "right-open" : "right-closed")">
    <!-- Mobile Backdrop for slide-over drawer -->
    <div class="mobile-sidebar-backdrop @(isSidebarOpen ? "visible" : "")" @onclick="() => ToggleSidebar(false)"></div>

    <!-- Left Pane: Chats Rail -->
    <aside class="pane pane-left @(isSidebarOpen ? "open" : "closed")">
        <div class="pane-content">
            <div class="rail-header">
                <span class="rail-title">Previous Chats</span>
                @if (isSidebarOpen)
                {
                    <button class="btn-pane-toggle sidebar-toggle-btn active" @onclick="() => ToggleSidebar(false)" title="Collapse sidebar" aria-label="Collapse sidebar">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="9" y1="3" x2="9" y2="21"></line>
                        </svg>
                    </button>
                }
            </div>

            <button class="btn-new-chat" @onclick="NewConversation">
                + New chat
            </button>

            <div class="conversation-list">
                @foreach (var chat in conversations)
                {
                    <div class="conversation-item @(chat.Id == activeId ? "active" : "")" 
                         @onclick="() => SelectConversation(chat.Id)"
                         @oncontextmenu="e => OnChatContextMenu(e, chat)"
                         @oncontextmenu:preventDefault="true">
                        <div class="conv-meta">
                            <span class="conv-title">@chat.Title</span>
                            <span class="conv-time">@chat.Updated.ToLocalTime().ToString("MMM d")</span>
                        </div>
                        @if (conversations.Count > 1)
                        {
                            <button class="conv-delete" title="Delete" @onclick:stopPropagation="true" @onclick="() => DeleteConversation(chat.Id)">✕</button>
                        }
                    </div>
                }
            </div>

            <!-- Sidebar User Profile Footer -->
            <div class="rail-user-footer" style="padding: 10px 12px; border-top: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between; margin-top: auto; position: relative;">
                @if (AuthService.CurrentUser.IsAuthenticated)
                {
                    <button type="button" class="user-pill" style="width: 100%; justify-content: flex-start; padding: 4px 6px; background: transparent; border: none; gap: 8px;" @onclick="() => showSidebarUserDropdown = !showSidebarUserDropdown">
                        <Avatar Size="sm" Src="@AuthService.CurrentUser.Image" Alt="@AuthService.CurrentUser.Name" Fallback="@(AuthService.CurrentUser.Name.FirstOrDefault().ToString().ToUpperInvariant())" />
                        <div style="display: flex; flex-direction: column; align-items: flex-start; min-width: 0; flex: 1; text-align: left;">
                            <span class="user-name" style="font-size: 12px; font-weight: 600; color: var(--text-primary); max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@AuthService.CurrentUser.Name</span>
                            <span style="font-size: 10px; color: var(--text-muted); max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@(AuthService.CurrentUser.Email ?? "Local User")</span>
                        </div>
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.6; margin-left: auto;">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>

                    @if (showSidebarUserDropdown)
                    {
                        <div class="shadcn-context-menu-backdrop" @onclick="() => showSidebarUserDropdown = false"></div>
                        <div class="user-profile-popover" style="position: absolute; left: 10px; bottom: calc(100% + 6px); width: 210px; background: var(--bg-panel); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 6px; box-shadow: var(--shadow-md); z-index: 9999; display: flex; flex-direction: column; gap: 2px;" @onclick:stopPropagation="true">
                            <div style="padding: 8px 10px; border-bottom: 1px solid var(--border-color); margin-bottom: 4px;">
                                <div style="font-size: 13px; font-weight: 600; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@AuthService.CurrentUser.Name</div>
                                <div style="font-size: 11px; color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@(AuthService.CurrentUser.Email ?? "Local User")</div>
                            </div>

                            <a href="/settings" class="shadcn-context-menu-item" @onclick="() => showSidebarUserDropdown = false">
                                <span class="shadcn-context-menu-label">Settings</span>
                            </a>

                            <div class="shadcn-context-menu-separator"></div>

                            <button type="button" class="shadcn-context-menu-item destructive" @onclick="HandleSidebarLogout">
                                <span class="shadcn-context-menu-label">Sign Out</span>
                            </button>
                        </div>
                    }
                }
                else
                {
                    <button class="btn-secondary" style="width: 100%; font-size: 11.5px; padding: 5px 8px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background: var(--bg-panel); color: var(--text-primary); cursor: pointer;" @onclick='() => NavManager.NavigateTo("/login")'>
                        Sign In
                    </button>
                }
            </div>
        </div>
    </aside>

    <!-- Center Pane: Main Chat Area -->
    <main class="pane pane-center">
        <header class="chat-header">
            <div class="chat-header-left" style="display: flex; align-items: center; gap: 8px;">
                @if (!isSidebarOpen)
                {
                    <button class="btn-pane-toggle sidebar-toggle-btn" @onclick="() => ToggleSidebar(true)" title="Open sidebar" aria-label="Open sidebar">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="9" y1="3" x2="9" y2="21"></line>
                        </svg>
                    </button>
                }

                <button class="btn-pane-toggle mobile-new-chat-btn" @onclick="NewConversation" title="New chat">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </button>

                <!-- Custom Animated Model Switcher Select -->
                <div class="model-dropdown-wrapper">
                    <button type="button" 
                            class="model-dropdown-trigger @(isModelMenuOpen ? "open" : "")" 
                            @onclick="() => isModelMenuOpen = !isModelMenuOpen"
                            title="Switch AI model">
                        <ModelIcon ModelId="@activeModelId" Size="14" />
                        <span class="model-trigger-name">@(ActiveModel?.Name ?? activeModelId)</span>
                        <svg class="model-dropdown-chevron @(isModelMenuOpen ? "open" : "")" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>

                    @if (isModelMenuOpen)
                    {
                        <div class="model-dropdown-backdrop" @onclick="() => isModelMenuOpen = false"></div>
                        <div class="model-dropdown-menu" @onclick:stopPropagation="true">
                            @foreach (var model in ModelService.Models.OrderByDescending(m => m.IsFavorite))
                            {
                                var isSelected = model.Id == activeModelId;
                                var quota = GetModelQuotaDisplay(model);
                                <button type="button" 
                                        class="model-dropdown-item @(isSelected ? "active" : "")" 
                                        @onclick="() => SelectModel(model.Id)">
                                    <div class="model-item-info">
                                        <ModelIcon ModelId="@model.Id" Size="14" />
                                        <div class="model-item-text">
                                            <span class="model-item-label">@model.Name</span>
                                            <span class="model-item-quota @quota.CssClass">@quota.Text</span>
                                        </div>
                                    </div>
                                    <div class="model-item-trailing">
                                        @if (model.IsFavorite)
                                        {
                                            <span class="model-item-favorite" title="Favorite model">★</span>
                                        }
                                        @if (isSelected)
                                        {
                                            <svg class="model-item-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        }
                                    </div>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="chat-actions">
                <button class="btn-pane-toggle @(TabService.IsSplitView ? "active" : "")" 
                        @onclick="ToggleSplitView" 
                        title="@(TabService.IsSplitView ? "Close split view" : "Split tabs side-by-side")">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="12" y1="3" x2="12" y2="21"></line>
                    </svg>
                </button>

                <button class="btn-pane-toggle @(isSettingsSheetOpen ? "active" : "")" 
                        @onclick="() => isSettingsSheetOpen = !isSettingsSheetOpen" 
                        title="Toggle sidecar panel">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="4" y1="21" x2="4" y2="14"></line>
                        <line x1="4" y1="10" x2="4" y2="3"></line>
                        <line x1="12" y1="21" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12" y2="3"></line>
                        <line x1="20" y1="21" x2="20" y2="16"></line>
                        <line x1="20" y1="12" x2="20" y2="3"></line>
                        <line x1="1" y1="14" x2="7" y2="14"></line>
                        <line x1="9" y1="8" x2="15" y2="8"></line>
                        <line x1="17" y1="16" x2="23" y2="16"></line>
                    </svg>
                </button>
            </div>
        </header>

        <div class="@(TabService.IsSplitView || TabService.IsDraggingTab ? "split-workspace-container" : "chat-pane-single")" style="display: flex; flex: 1; min-height: 0; width: 100%; height: 100%; overflow: hidden;">
                <div class="@(TabService.IsSplitView || TabService.IsDraggingTab ? "split-pane-half primary" : "")" style="position: relative; display: flex; flex-direction: column; flex: 1; min-width: 0; height: 100%; overflow: hidden; transition: flex 0.2s cubic-bezier(0.16, 1, 0.3, 1);">
                    @if (TabService.ActiveTab?.Type == WorkspaceTabType.Presentation)
                    {
                        <div class="presentation-deck-workspace-view">
                            <div class="deck-workspace-topbar">
                                <div class="deck-workspace-title-block">
                                    <span class="deck-workspace-icon">📽️</span>
                                    <span class="deck-workspace-title">@(TabService.ActiveTab.Title ?? "Presentation Deck")</span>
                                </div>
                                <div class="deck-workspace-actions">
                                    @if (!string.IsNullOrWhiteSpace(TabService.ActiveTab.PresentationPath))
                                    {
                                        <button type="button" class="btn-deck-action" @onclick="() => OpenPresentationFullscreen(TabService.ActiveTab.PresentationPath)" title="Open presentation in new window">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                                <polyline points="15 3 21 3 21 9"></polyline>
                                                <line x1="10" y1="14" x2="21" y2="3"></line>
                                            </svg>
                                            <span>Open in New Window</span>
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="deck-workspace-viewport">
                                @if (!string.IsNullOrWhiteSpace(TabService.ActiveTab.PresentationPath) && File.Exists(TabService.ActiveTab.PresentationPath))
                                {
                                    <iframe class="deck-workspace-iframe" srcdoc="@GetPresentationHtmlContent(TabService.ActiveTab.PresentationPath)" title="Presentation Deck"></iframe>
                                }
                                else
                                {
                                    <div class="deck-workspace-empty">
                                        <p>Presentation deck is compiling...</p>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    <div class="primary-chat-wrapper" style="@(TabService.ActiveTab?.Type == WorkspaceTabType.Presentation ? "display: none;" : "display: flex; flex-direction: column; flex: 1; min-height: 0; width: 100%; height: 100%;")">
                        @if (voiceConversationActive || voiceState != VoiceState.Idle)
                        {
                        <div class="center-voice-overlay" aria-live="polite">
                            <div class="voice-conversation-stage">
                                <div class="center-voice-visualizer @(voiceState == VoiceState.GramSpeaking ? "speaking" : "")" 
                                     id="visualizerBars" 
                                     @onclick="EndVoiceConversation" 
                                     role="button" 
                                     tabindex="0" 
                                     title="Click to end voice conversation (Esc)">
                                    <span class="v-bar"></span>
                                    <span class="v-bar"></span>
                                    <span class="v-bar"></span>
                                    <span class="v-bar"></span>
                                    <span class="v-bar"></span>
                                    <span class="v-bar"></span>
                                    <span class="v-bar"></span>
                                </div>
                                
                                @if (!string.IsNullOrWhiteSpace(voiceLastResponse))
                                {
                                    <div class="voice-response-live-text">
                                        @voiceLastResponse
                                    </div>
                                }

                                <button type="button" class="voice-end-session-btn" @onclick="EndVoiceConversation" title="End voice conversation (Esc)">
                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                                        <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                                    </svg>
                                    <span>End voice</span>
                                </button>
                            </div>
                        </div>
                    }

                    @if (TabService.IsSplitView)
                    {
                        <div class="split-pane-header">
                            <div class="split-pane-title">
                                <span class="split-badge">Split A</span>
                                <span>@Active.Title</span>
                            </div>
                            <div class="split-actions-group">
                                <button type="button" 
                                        class="btn-split-action" 
                                        @onclick="SendLastReplyToRightChat"
                                        disabled="@(Active.Messages.Count(m => m.Role == "assistant") == 0)"
                                        title="Send Gram A's latest response to Gram B">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="9 18 15 12 9 6"></polyline>
                                    </svg>
                                    <span>Send Output to B</span>
                                </button>
                            </div>
                        </div>
                    }

                    <div class="messages-container @(voiceConversationActive ? "voice-conversation-hidden" : "")" id="messagesContainer">
                        @if (currentRun != null && isGenerating)
                        {
                            <button type="button" class="agent-run-status" @onclick="() => showRunDetails = !showRunDetails" aria-expanded="@showRunDetails">
                                <span class="agent-run-dot"></span>
                                <span>@currentRun.StatusText</span>
                                @if (currentRun.ToolCalls > 0)
                                {
                                    <span class="agent-run-detail">@currentRun.ToolCalls tool@(currentRun.ToolCalls == 1 ? "" : "s")</span>
                                }
                                <span class="agent-run-chevron">@(showRunDetails ? "⌃" : "⌄")</span>
                            </button>
                            @if (showRunDetails && currentRun != null)
                            {
                                <div class="agent-run-inspector">
                                    <div class="agent-run-inspector-head"><span>Run details</span><span class="agent-run-id">@currentRun.Id</span></div>
                                    <div class="agent-run-metrics">
                                        <span><b>Model</b> @currentRun.ModelId</span>
                                        <span><b>Iteration</b> @currentRun.Iteration</span>
                                        <span><b>Tools</b> @currentRun.ToolCalls</span>
                                    </div>
                                    <div class="agent-run-events">
                                        @foreach (var runEvent in AgentRunTracker.GetEvents(currentRun.Id, 5).AsEnumerable().Reverse())
                                        {
                                            <div><span>@runEvent.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span> @runEvent.Message</div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        @if (PresentationProgressVisible)
                        {
                            <div class="presentation-builder-card" role="status" aria-live="polite">
                                <div class="presentation-builder-header">
                                    <div class="builder-header-left">
                                        <div class="builder-mascot-wrapper">
                                            <GramCharacter Size="48" State="@PresentationMascotState" Interactive="false" AutoWaveOnLoad="false" Class="presentation-builder-mascot" />
                                        </div>
                                        <div class="builder-meta-block">
                                            <div class="builder-eyebrow-row">
                                                <span class="builder-badge">Interactive Deck Builder</span>
                                                <span class="builder-percent-chip">@PresentationProgressPercent% Complete</span>
                                            </div>
                                            <h3 class="builder-deck-title">@activePresentationProject!.Title</h3>
                                            <p class="builder-activity-desc">@GetPresentationCurrentActivityText(activePresentationProject)</p>
                                        </div>
                                    </div>

                                    <div class="builder-header-right">
                                        @if (activePresentationProject.Status == ContentProjectStatus.Assembled && !string.IsNullOrWhiteSpace(activePresentationProject.FinalArtifactPath))
                                        {
                                            <button type="button" class="btn-builder-view-deck" @onclick="() => OpenPresentationDeckTab(activePresentationProject)">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                                                </svg>
                                                <span>Present Deck</span>
                                            </button>
                                        }
                                        <button type="button" class="btn-builder-dismiss" @onclick="() => isPresentationCardDismissed = true" title="Dismiss builder banner">
                                            ✕
                                        </button>
                                    </div>
                                </div>

                                <div class="presentation-slide-cards-grid">
                                    @foreach (var sec in activePresentationProject.Sections.OrderBy(s => s.Order))
                                    {
                                        var isReady = sec.Status == ContentSectionStatus.Ready;
                                        var isGen = sec.Status == ContentSectionStatus.Generating;
                                        <div class="presentation-slide-card @(isReady ? "ready" : (isGen ? "generating" : "queued"))">
                                            <div class="slide-card-header">
                                                <span class="slide-card-num">Slide @sec.Order.ToString("D2")</span>
                                                <div class="slide-card-status-indicator">
                                                    @if (isReady)
                                                    {
                                                        <div class="slide-status-check" title="Slide complete">
                                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                                <polyline points="20 6 9 17 4 12"></polyline>
                                                            </svg>
                                                        </div>
                                                    }
                                                    else if (isGen)
                                                    {
                                                        <div class="slide-status-spinner" title="Drafting content & visuals...">
                                                            <svg class="spinner-ring" viewBox="0 0 24 24" width="14" height="14">
                                                                <circle class="spinner-track" cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2.5"></circle>
                                                                <circle class="spinner-arc" cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></circle>
                                                            </svg>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="slide-status-queued" title="Queued">
                                                            <span class="queued-dot"></span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            <div class="slide-card-body">
                                                <span class="slide-card-title" title="@sec.Title">@sec.Title</span>
                                                @if (!string.IsNullOrWhiteSpace(sec.NarrativeJob))
                                                {
                                                    <span class="slide-card-job" title="@sec.NarrativeJob">@sec.NarrativeJob</span>
                                                }
                                            </div>

                                            <div class="slide-card-footer">
                                                <span class="slide-card-state-label">
                                                    @(isReady ? "Ready" : (isGen ? "Drafting..." : "Waiting"))
                                                </span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (Active.Messages.Count == 0)
                        {
                            <div class="harness-empty-state @(voiceState != VoiceState.Idle ? "voice-fade-out" : "")">
                                <GramCharacter Size="108" State="@(isGenerating ? "thinking" : "idle")" AutoWaveOnLoad="true" Class="empty-state-character" />
                                <h2>How can I help?</h2>
                                <p>Type a message or tap the microphone to speak.</p>
                            </div>
                        }
                        else
                        {
                @foreach (var message in Active.Messages)
                {
                    @if (message.Role == "user")
                    {
                        <div class="message-entry user">
                            <div class="user-message-row">
                                <div class="message-body user-body">
                                    @if (message.Mentions.Count > 0)
                                    {
                                        <div class="message-context-list">
                                            @foreach (var mention in message.Mentions)
                                            {
                                                <span class="message-context-item">@MentionIcon(mention.Kind)<span>@mention.Label</span></span>
                                            }
                                        </div>
                                    }
                                    <div class="user-message-text">@message.Text</div>
                                    <button type="button" class="btn-msg-edit" @onclick="() => EditUserPrompt(message)" title="Edit prompt">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="message-entry assistant">
                            <div class="message-header">
                                <ModelIcon ModelId="@activeModelId" Size="14" />
                                <span>Gram</span>
                            </div>
                            <div class="message-body assistant-body">
                                @if (message.ToolCalls != null && message.ToolCalls.Count > 0)
                                {
                                    <div class="message-tool-calls" style="margin-bottom: 8px;">
                                        @foreach (var tool in message.ToolCalls)
                                        {
                                            <ToolCallCard ToolCall="@tool" />
                                        }
                                    </div>
                                }

                                @if (string.IsNullOrEmpty(message.Text) && isGenerating && message == Active.Messages.LastOrDefault())
                                {
                                    @if (message.ToolCalls == null || message.ToolCalls.Count == 0)
                                    {
                                        <div class="assistant-thinking-indicator">
                                            <GramCharacter Size="30" State="thinking" Interactive="false" AutoWaveOnLoad="false" Class="assistant-thinking-character" />
                                            <div class="thought-bubble" role="status" aria-label="Gram is formulating a response">
                                                <span class="thought-bubble-dot"></span>
                                                <span class="thought-bubble-dot"></span>
                                                <span class="thought-bubble-dot"></span>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    var stoppedInfo = ParseStoppedMessage(message.Text);
                                    @if (!string.IsNullOrWhiteSpace(stoppedInfo.MainText))
                                    {
                                        <MarkdownView Content="@stoppedInfo.MainText" />
                                    }
                                    @if (stoppedInfo.HasStoppedNotice)
                                    {
                                        <div class="generation-stopped-pill">
                                            <span class="stopped-indicator-dot"></span>
                                            <span class="stopped-indicator-label">Generation stopped</span>
                                            @if (!string.IsNullOrWhiteSpace(stoppedInfo.StoppedDetail))
                                            {
                                                <span class="stopped-indicator-sep">·</span>
                                                <span class="stopped-indicator-detail">@stoppedInfo.StoppedDetail</span>
                                            }
                                        </div>
                                    }
                                }

                            @if (!string.IsNullOrEmpty(message.ErrorDetail))
                            {
                                var msgKey = message.Timestamp.Ticks.ToString();
                                var isExpanded = expandedErrorIds.Contains(msgKey);
                                <div class="message-error-box">
                                    <div class="error-header">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <line x1="12" y1="8" x2="12" y2="12"></line>
                                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                        </svg>
                                        <span>An error occurred while generating this response.</span>
                                    </div>
                                    <button type="button" class="error-details-toggle" @onclick="() => ToggleErrorDetails(msgKey)">
                                        @(isExpanded ? "Hide full error details ▲" : "View full error details ▼")
                                    </button>
                                    @if (isExpanded)
                                    {
                                        <pre class="error-details-pre">@message.ErrorDetail</pre>
                                    }
                                </div>
                            }
                        </div>
                        @if (message.Role == "assistant" && (!string.IsNullOrEmpty(message.Text) || !string.IsNullOrEmpty(message.ErrorDetail)) && !(isGenerating && message == Active.Messages.LastOrDefault()))
                        {
                            <div class="message-actions">
                                <button type="button" class="btn-msg-action @(copiedMessageId == message.Timestamp.Ticks.ToString() ? "copied" : "")" 
                                        @onclick="() => CopyResponseText(message)" 
                                        title="Copy response">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                                    </svg>
                                    <span>@(copiedMessageId == message.Timestamp.Ticks.ToString() ? "Copied" : "Copy")</span>
                                </button>

                                <button type="button" class="btn-msg-action @(speakingMessageId == message.Timestamp.Ticks.ToString() ? "active" : "")" 
                                        @onclick="() => ToggleReadAloud(message)" 
                                        title="@(speakingMessageId == message.Timestamp.Ticks.ToString() ? "Stop speaking" : "Read aloud")">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                                        <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                                    </svg>
                                    <span>@(speakingMessageId == message.Timestamp.Ticks.ToString() ? "Stop" : "Read aloud")</span>
                                </button>

                                <button type="button" class="btn-msg-action" 
                                        @onclick="() => RetryResponseAsync(message)" 
                                        disabled="@isGenerating" 
                                        title="Retry response">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="23 4 23 10 17 10"></polyline>
                                        <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                                    </svg>
                                    <span>Retry</span>
                                </button>
                            </div>
                        }
                    </div>
                }
            }
        }
        </div>
        

        @if (pendingMentions.Count > 0)
        {
            <div class="mention-context-tray" aria-label="Selected context">
                @foreach (var mention in pendingMentions)
                {
                    <span class="mention-context-chip">
                        @MentionIcon(mention.Kind)
                        <span title="@mention.Target">@mention.Label</span>
                        <button type="button" @onclick="() => RemoveMention(mention.Id)" title="Remove @mention.Label" aria-label="Remove @mention.Label">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
                        </button>
                    </span>
                }
            </div>
        }

        <div class="composer-wrapper @(pendingMentions.Count > 0 ? "has-context-mentions" : "")">
            @if (attachedFiles.Count > 0)
            {
                <div class="attachment-tray">
                    @foreach (var fileName in attachedFiles)
                    {
                        var att = Active.Attachments.FirstOrDefault(a => a.FileName == fileName);
                        var isImg = att?.IsImage ?? (fileName.EndsWith(".png", StringComparison.OrdinalIgnoreCase) || fileName.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || fileName.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) || fileName.EndsWith(".webp", StringComparison.OrdinalIgnoreCase) || fileName.EndsWith(".svg", StringComparison.OrdinalIgnoreCase));
                        <div class="attachment-pill">
                            @if (isImg)
                            {
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="attachment-icon">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                    <polyline points="21 15 16 10 5 21"></polyline>
                                </svg>
                            }
                            else
                            {
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="attachment-icon">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                </svg>
                            }
                            <span class="attachment-name">@fileName</span>
                            <button type="button" class="btn-remove-attachment" @onclick="() => RemoveFile(fileName)" title="Remove">✕</button>
                        </div>
                    }
                </div>
            }

            <div class="composer-box">
                <!-- Context Mentions Popup -->
                @if (showMentionPopup)
                {
                    <div class="mention-popup" role="listbox" aria-label="Add context" @onclick:stopPropagation="true">
                        <div class="mention-popup-header">
                            <span>Add context</span>
                        </div>
                        <div class="mention-results">
                            @if (filteredMentions.Count == 0)
                            {
                                <div class="mention-empty">No matching context</div>
                            }
                            else
                            {
                                @foreach (var group in filteredMentions.GroupBy(item => item.Category))
                                {
                                    <div class="mention-group-label">@group.Key</div>
                                    @foreach (var mention in group)
                                    {
                                        var mentionIndex = filteredMentions.IndexOf(mention);
                                        <button type="button"
                                                id="mention-option-@mentionIndex"
                                                role="option"
                                                aria-selected="@(mentionIndex == selectedMentionIndex)"
                                                class="mention-item @(mentionIndex == selectedMentionIndex ? "selected" : "")"
                                                @onmousedown:preventDefault="true"
                                                @onclick="() => SelectMentionAsync(mention)">
                                            <span class="mention-icon">@MentionIcon(mention.Kind)</span>
                                            <span class="mention-copy">
                                                <span class="mention-title">@mention.Title</span>
                                                <span class="mention-desc">@mention.Description</span>
                                            </span>
                                        </button>
                                    }
                                }
                            }
                        </div>
                    </div>
                }

                <InputFile id="imageFileInput" OnChange="HandleImageSelected" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml" style="display: none;" multiple />
                <InputFile id="docFileInput" OnChange="HandleDocFileSelected" accept=".cs,.razor,.ts,.js,.py,.json,.md,.txt,.html,.css,.sql,.yml,.yaml,.xml,.csv,.pdf,.sh,.go,.rs,.cpp,.c,.h" style="display: none;" multiple />

                <div class="composer-inner">
                    <div class="composer-actions-left" style="position: relative;">
                        <button type="button" 
                                class="btn-composer-icon attach-trigger @(isAttachMenuOpen ? "open" : "")" 
                                @onclick="ToggleAttachMenu" 
                                title="Attach"
                                aria-label="Attach"
                                aria-expanded="@isAttachMenuOpen">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="plus-icon @(isAttachMenuOpen ? "rotated" : "")">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                        </button>

                        @if (isAttachMenuOpen)
                        {
                            <div class="attach-backdrop" @onclick="CloseAttachMenu"></div>
                            <div class="attach-popover" @onclick:stopPropagation="true">
                                <label for="imageFileInput" class="attach-popover-item" @onclick="CloseAttachMenu">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="attach-item-icon">
                                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                        <polyline points="21 15 16 10 5 21"></polyline>
                                    </svg>
                                    <span>Upload image</span>
                                </label>

                                <label for="docFileInput" class="attach-popover-item" @onclick="CloseAttachMenu">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="attach-item-icon">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                        <polyline points="14 2 14 8 20 8"></polyline>
                                        <line x1="16" y1="13" x2="8" y2="13"></line>
                                        <line x1="16" y1="17" x2="8" y2="17"></line>
                                    </svg>
                                    <span>Upload file</span>
                                </label>
                            </div>
                        }
                    </div>

                    <textarea @ref="textareaRef"
                              id="composerTextarea"
                              class="composer-textarea"
                              value="@draft"
                              @oninput="OnInputChanged"
                              @onkeydown="HandleKeyDown"
                              @onkeydown:preventDefault="preventEnter"
                              placeholder="@(voiceState == VoiceState.UserSpeaking ? "Listening..." : "Message Gram · type @ to add context")"
                              rows="1"></textarea>

                    <div class="composer-actions-right">
                        @if (voiceState == VoiceState.Idle)
                        {
                            <button class="btn-composer-icon voice-btn"
                                    @onclick="ToggleVoice"
                                    title="Voice input">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                                    <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                                    <line x1="12" y1="19" x2="12" y2="23"></line>
                                    <line x1="8" y1="23" x2="16" y2="23"></line>
                                </svg>
                            </button>
                        }

                        @if (voiceState != VoiceState.Idle)
                        {
                            <div class="audio-device-picker">
                                <button type="button"
                                        class="audio-device-trigger @(isAudioDeviceMenuOpen ? "open" : "")"
                                        @onclick="ToggleAudioDeviceMenu"
                                        title="@AudioDeviceSummaryTitle"
                                        aria-label="Choose audio input and output devices"
                                        aria-expanded="@isAudioDeviceMenuOpen">
                                    <svg class="audio-device-trigger-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M12 3a3 3 0 0 0-3 3v5a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3z"></path>
                                        <path d="M5 11a7 7 0 0 0 14 0"></path>
                                        <line x1="12" y1="18" x2="12" y2="21"></line>
                                        <line x1="9" y1="21" x2="15" y2="21"></line>
                                    </svg>
                                    <span class="audio-device-trigger-label">@ShortAudioDeviceName(SelectedAudioInputLabel) <span aria-hidden="true">·</span> @ShortAudioDeviceName(SelectedAudioOutputLabel)</span>
                                    <svg class="audio-device-trigger-chevron @(isAudioDeviceMenuOpen ? "open" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <polyline points="6 9 12 15 18 9"></polyline>
                                    </svg>
                                </button>

                                @if (isAudioDeviceMenuOpen)
                                {
                                    <div class="audio-device-backdrop" @onclick="CloseAudioDeviceMenu"></div>
                                    <div class="audio-device-menu" @onclick:stopPropagation="true">
                                        <div class="audio-device-menu-header">
                                            <span>Audio devices</span>
                                            <span class="audio-device-menu-status">@(audioDevicesLoaded ? "Connected" : "Detecting")</span>
                                        </div>

                                        <div class="audio-device-section">
                                            <div class="audio-device-section-label">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <rect x="9" y="2" width="6" height="12" rx="3"></rect>
                                                    <path d="M5 11a7 7 0 0 0 14 0"></path>
                                                </svg>
                                                <span>Input</span>
                                            </div>
                                            @if (!AudioInputDevices.Any())
                                            {
                                                <div class="audio-device-empty">No microphones detected</div>
                                            }
                                            else
                                            {
                                                @foreach (var device in AudioInputDevices)
                                                {
                                                    <button type="button" class="audio-device-option @(device.DeviceId == selectedAudioInputDeviceId ? "selected" : "")" @onclick="() => SelectAudioInputDevice(device.DeviceId)">
                                                        <span class="audio-device-option-icon">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                                <path d="M12 3a3 3 0 0 0-3 3v5a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3z"></path>
                                                                <path d="M5 11a7 7 0 0 0 14 0"></path>
                                                            </svg>
                                                        </span>
                                                        <span class="audio-device-option-text">
                                                            <span>@AudioDeviceLabel(device, "microphone")</span>
                                                            <small>Microphone</small>
                                                        </span>
                                                        @if (device.DeviceId == selectedAudioInputDeviceId)
                                                        {
                                                            <svg class="audio-device-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                                <polyline points="20 6 9 17 4 12"></polyline>
                                                            </svg>
                                                        }
                                                    </button>
                                                }
                                            }
                                        </div>

                                        <div class="audio-device-section">
                                            <div class="audio-device-section-label">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                                                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                                                    <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                                                </svg>
                                                <span>Output</span>
                                            </div>
                                            @if (!AudioOutputDevices.Any())
                                            {
                                                <div class="audio-device-empty">No speakers detected</div>
                                            }
                                            else
                                            {
                                                @foreach (var device in AudioOutputDevices)
                                                {
                                                    <button type="button" class="audio-device-option @(device.DeviceId == selectedAudioOutputDeviceId ? "selected" : "")" @onclick="() => SelectAudioOutputDevice(device.DeviceId)">
                                                        <span class="audio-device-option-icon">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                                                                <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                                                            </svg>
                                                        </span>
                                                        <span class="audio-device-option-text">
                                                            <span>@AudioDeviceLabel(device, "speaker")</span>
                                                            <small>Speaker</small>
                                                        </span>
                                                        @if (device.DeviceId == selectedAudioOutputDeviceId)
                                                        {
                                                            <svg class="audio-device-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                                <polyline points="20 6 9 17 4 12"></polyline>
                                                            </svg>
                                                        }
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @if (TabService.IsSplitView && SecondaryConversation != null)
                        {
                            <button type="button" 
                                    class="btn-split-action" 
                                    style="font-size: 11px; padding: 3px 7px;"
                                    @onclick="SendDraftToRightChat" 
                                    disabled="@(string.IsNullOrWhiteSpace(draft))"
                                    title="Send this draft to Split B">
                                <span>Send to B</span>
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="9 18 15 12 9 6"></polyline>
                                </svg>
                            </button>
                        }

                        @if (isGenerating)
                        {
                            <button class="btn-composer-send stop-btn"
                                    @onclick="StopGeneration"
                                    title="Stop generation">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
                                    <rect x="4" y="4" width="16" height="16" rx="2" />
                                </svg>
                            </button>
                        }
                        else
                        {
                            <button class="btn-composer-send"
                                    @onclick="Send"
                                    disabled="@(string.IsNullOrWhiteSpace(draft) && attachedFiles.Count == 0 && pendingMentions.Count == 0 && voiceState == VoiceState.Idle)"
                                    title="Send">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="19" x2="12" y2="5"></line>
                                    <polyline points="5 12 12 5 19 12"></polyline>
                                </svg>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
        </div>
        </div>

        @if (TabService.IsSplitView)
        {
            <SplitChatPane Conversation="@SecondaryConversation" 
                           AvailableConversations="@conversations" 
                           OnConversationChanged="OnSecondaryConversationChanged" 
                           OnSendToPrimaryChat="HandleSendToPrimaryChat" />
        }
        else if (TabService.IsDraggingTab)
        {
            <div class="split-drag-drop-target @(isHoveringSplitTarget ? "hover-active" : "")"
                 @ondragenter="() => isHoveringSplitTarget = true"
                 @ondragleave="() => isHoveringSplitTarget = false"
                 @ondragover:preventDefault="true"
                 @ondrop="HandleDropOnSplitTarget">
                <div class="split-drop-content">
                    <div class="split-drop-icon-box">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="12" y1="3" x2="12" y2="21"></line>
                        </svg>
                    </div>
                    <span class="split-drop-heading">Drop tab here to split side-by-side</span>
                    <span class="split-drop-subtext">Collapse and open this chat in a dual-agent workspace</span>
                </div>
            </div>
        }
        </div>
        
    </main>

    <!-- Right Pane: Reusable Multi-Purpose Sidecar -->
    <aside class="pane pane-right @(isSettingsSheetOpen ? "open" : "closed")">
        <div class="pane-content">
            <div class="sheet-header">
                <!-- Sidecar Header Mode Switcher -->
                <div class="sidecar-header-tabs">
                    <button type="button" class="sidecar-tab-btn @(activeSidecarTab == SidecarTab.Settings ? "active" : "")" @onclick="() => activeSidecarTab = SidecarTab.Settings">
                        <span>Settings</span>
                    </button>
                    @if (Active.Artifacts.Count > 0 || activeSidecarTab == SidecarTab.Artifact)
                    {
                        <button type="button" class="sidecar-tab-btn @(activeSidecarTab == SidecarTab.Artifact ? "active" : "")" @onclick="() => activeSidecarTab = SidecarTab.Artifact">
                            <span>Artifacts</span>
                            @if (Active.Artifacts.Count > 0)
                            {
                                <span class="sidecar-tab-count">@Active.Artifacts.Count</span>
                            }
                        </button>
                    }
                    @if (IsProjectActive)
                    {
                        <button type="button" class="sidecar-tab-btn @(activeSidecarTab == SidecarTab.GitDiff ? "active" : "")" @onclick="LoadGitDiff">
                            <span>Diff</span>
                            @if (activeDiffs.Count > 0)
                            {
                                <span class="sidecar-tab-count">@activeDiffs.Count</span>
                            }
                        </button>
                        <button type="button" class="sidecar-tab-btn @(activeSidecarTab == SidecarTab.GitGram ? "active" : "")" @onclick="() => activeSidecarTab = SidecarTab.GitGram">
                            <span>Git</span>
                        </button>
                        <button type="button" class="sidecar-tab-btn @(activeSidecarTab == SidecarTab.Sandboxes ? "active" : "")" @onclick="() => activeSidecarTab = SidecarTab.Sandboxes">
                            <span>Sandboxes</span>
                            @if (GramBox.ActiveSessions.Count > 0)
                            {
                                <span class="sidecar-tab-count">@GramBox.ActiveSessions.Count</span>
                            }
                        </button>
                    }
                </div>

                <button class="btn-pane-toggle" @onclick="() => isSettingsSheetOpen = false" title="Close sidecar">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <div class="sheet-body" style="padding: 14px 16px; overflow-y: auto; display: flex; flex-direction: column; gap: 14px; height: 100%;">
                @if (activeSidecarTab == SidecarTab.Settings)
                {
                    <div class="sheet-field">
                        <label class="sheet-label">Model</label>
                        <select class="sheet-select" @bind="activeModelId">
                            @foreach (var model in ModelService.Models.OrderByDescending(m => m.IsFavorite))
                            {
                                <option value="@model.Id">@(model.IsFavorite ? "★ " : "")@model.Name</option>
                            }
                        </select>
                    </div>

                    <div class="sheet-field">
                        <label class="sheet-label">Permissions</label>
                        <select class="sheet-select" value="@SecurityService.Settings.PermissionMode" @onchange="OnPermissionModeChanged">
                            <option value="@ExecutionPermissionMode.FullAutonomous">Autonomous (Auto-run edits & sandbox commands)</option>
                            <option value="@ExecutionPermissionMode.SafeAutoApprove">Safe (Auto-run safe commands, prompt on risky)</option>
                            <option value="@ExecutionPermissionMode.AskAlways">Ask always (Prompt before running commands)</option>
                        </select>
                    </div>

                    <div class="sheet-field">
                        <label class="sheet-label">Title</label>
                        <input type="text" class="sheet-input" @bind="Active.Title" @bind:event="oninput" @bind:after="OnTitleChanged" placeholder="Chat title" />
                    </div>

                    <!-- Project Workspace Mode Toggle -->
                    <div class="sheet-toggle-row">
                        <div class="sheet-toggle-text">
                            <span class="sheet-toggle-title">Project Workspace</span>
                            <span class="sheet-toggle-desc">Enable repository diffs, git control, and sandbox engine</span>
                        </div>
                        <input type="checkbox" class="sheet-checkbox" checked="@Active.IsProject" @onchange="ToggleProjectMode" />
                    </div>

                    @if (IsProjectActive)
                    {
                        <div class="sheet-project-active-badge">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #22c55e;">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                            </svg>
                            <span>Project tools active · Diff, Git & Sandbox tabs available</span>
                        </div>
                    }

                    <div class="sheet-field">
                        <label class="sheet-label">System prompt override</label>
                        <textarea class="sheet-textarea" 
                                  @bind="Active.SystemPromptOverride" 
                                  @bind:event="oninput" 
                                  rows="3" 
                                  placeholder="Optional instructions for this chat..."></textarea>
                    </div>

                    <div class="sheet-field">
                        <label class="sheet-label">Rules</label>
                        <textarea class="sheet-textarea" 
                                  @bind="Active.Rules" 
                                  @bind:event="oninput" 
                                  rows="2" 
                                  placeholder="Specific rules or constraints..."></textarea>
                    </div>

                    @if (Active.Attachments.Count > 0)
                    {
                        <div class="sheet-field">
                            <label class="sheet-label">Attached files (@Active.Attachments.Count)</label>
                            <div class="sheet-items-list" style="display: flex; flex-direction: column; gap: 4px; max-height: 120px; overflow-y: auto;">
                                @foreach (var att in Active.Attachments)
                                {
                                    <div class="sheet-item-row" style="display: flex; align-items: center; justify-content: space-between; font-size: 11.5px; padding: 4px 8px; background: var(--bg-hover); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                                        <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 160px;" title="@att.FileName">@att.FileName</span>
                                        <span style="color: var(--text-muted); font-size: 10px;">@(att.SizeBytes < 1024 ? $"{att.SizeBytes}B" : $"{att.SizeBytes / 1024}KB")</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Sleek Session Usage Row -->
                    <div class="sheet-usage-row">
                        <span class="sheet-usage-label">Session Usage</span>
                        <span class="sheet-usage-val">
                            @(Active.PromptTokens + Active.CompletionTokens > 0 ? $"{(Active.PromptTokens + Active.CompletionTokens):N0} tokens" : $"~{EstimateTokens(Active.Messages)} tokens")
                            @if (Active.LastLatencyMs > 0)
                            {
                                <span> · @(Active.LastLatencyMs)ms</span>
                            }
                        </span>
                    </div>

                    <div class="sheet-danger-zone">
                        <Button Variant="destructive" 
                                Size="sm" 
                                Class="w-full" 
                                Disabled="@(Active.Messages.Count == 0)" 
                                OnClick="ClearCurrentChat">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                            <span>Clear conversation</span>
                        </Button>
                    </div>
                }
                else if (activeSidecarTab == SidecarTab.Artifact)
                {
                    <div class="artifact-viewer">
                        @if (selectedArtifact != null)
                        {
                            <div class="artifact-toolbar" style="display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="font-weight: 600; font-size: 13px;">@selectedArtifact.FileName</span>
                                    <Badge Variant="outline" Style="font-size: 10px;">@selectedArtifact.Language</Badge>
                                </div>
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <Button Variant="default" Size="sm" OnClick="() => ApplyArtifact(selectedArtifact)">
                                        Apply to Workspace
                                    </Button>
                                    <Button Variant="secondary" Size="sm" OnClick="() => selectedArtifact = null">Back</Button>
                                </div>
                            </div>

                            @if (selectedArtifact.Language?.ToLowerInvariant() == "html" || selectedArtifact.FileName.EndsWith(".html") || selectedArtifact.FileName.EndsWith(".svg"))
                            {
                                <div class="artifact-live-preview">
                                    @((MarkupString)selectedArtifact.Content)
                                </div>
                            }
                            else
                            {
                                <pre class="artifact-code-pre">@selectedArtifact.Content</pre>
                            }
                        }
                        else
                        {
                            <div style="font-size: 12.5px; font-weight: 600; color: var(--text-primary); margin-bottom: 6px;">
                                Artifacts & Deliverables (@Active.Artifacts.Count)
                            </div>

                            @if (Active.Artifacts.Count == 0)
                            {
                                <div style="font-size: 12px; color: var(--text-muted); text-align: center; padding: 24px 0;">
                                    No artifacts generated yet. When models produce standalone code files, HTML snippets, or reports, they appear here.
                                </div>
                            }
                            else
                            {
                                <div style="display: flex; flex-direction: column; gap: 6px;">
                                    @foreach (var art in Active.Artifacts)
                                    {
                                        <div class="sheet-item-row" style="display: flex; align-items: center; justify-content: space-between; padding: 8px 10px; background: var(--bg-panel-subtle); border-radius: var(--radius-md); border: 1px solid var(--border-color); cursor: pointer;" @onclick="() => ViewArtifact(art)">
                                            <div style="display: flex; flex-direction: column; min-width: 0;">
                                                <span style="font-weight: 600; font-size: 12.5px; color: var(--text-primary);">@art.FileName</span>
                                                <span style="font-size: 11px; color: var(--text-muted);">@art.Title</span>
