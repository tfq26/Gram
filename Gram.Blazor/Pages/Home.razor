            new("git-branch", "@git:branch", "Include current branch and commit log", "", "Git", "@git:branch "),
            new("web-search", "@web:", "Trigger live web search query context", "", "Web", "@web:"),
            new("toolbox", "@toolbox", "Include active Gram Toolbox engines & MCP tools", "", "Toolbox", "@toolbox "),
            new("docs", "@docs", "Reference workspace documentation & architecture", "", "Workspace", "@docs ")
        };

        // Add workspace files if available
        try
        {
            var files = Directory.GetFiles(Environment.CurrentDirectory, "*.*", SearchOption.TopDirectoryOnly)
                .Where(f => !Path.GetFileName(f).StartsWith(".") && !f.Contains("bin") && !f.Contains("obj"))
                .Take(6);

            foreach (var f in files)
