    private async Task ExecuteBulkDeleteAsync(List<string> targetIds)
    {
        if (targetIds == null || targetIds.Count == 0) return;

        var deletedCount = 0;
        foreach (var id in targetIds)
        {
            TabService.CloseTabsForChat(id);
            await DeleteConversationThroughApiAsync(id);
            deletedCount++;
        }

        if (targetIds.Contains(activeId))
        {
            var remaining = conversations.FirstOrDefault(c => !targetIds.Contains(c.Id));
            if (remaining != null)
            {
                activeId = remaining.Id;
                ChatStateService.ActiveChatTitle = Active.Title;
            }
            else
            {
                NewConversation();
            }
        }

        StateHasChanged();
        SonnerService.Success("Deleted", deletedCount == 1 ? "Conversation deleted." : $"{deletedCount} conversations deleted.");
    }

