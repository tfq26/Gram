    private async Task RetryResponseAsync(Message assistantMessage)
    {
        if (isGenerating) return;

        // Find the index of this assistant message in the conversation
        var idx = Active.Messages.IndexOf(assistantMessage);
        if (idx < 0) return;

        // Locate the user prompt directly preceding or before this assistant message
        Message? lastUserMsg = null;
        for (int i = idx - 1; i >= 0; i--)
        {
            if (Active.Messages[i].Role == "user")
            {
                lastUserMsg = Active.Messages[i];
                break;
            }
        }

        if (lastUserMsg == null)
        {
            SonnerService.Warning("Retry unavailable", "No preceding user prompt found to retry.");
            return;
        }

        // Remove the old assistant response attempt cleanly (hides previous attempt)
        Active.Messages.RemoveAt(idx);

        // Re-generate response using the existing user prompt in background
        await GenerateAssistantResponseAsync(lastUserMsg.Text);
    }

    private async Task AutoGenerateChatTitleAsync(Conversation conversation, string firstPrompt, string modelId)
    {
        try
        {
            var generatedTitle = await ModelService.GenerateTitleAsync(modelId, firstPrompt);
            if (!string.IsNullOrWhiteSpace(generatedTitle))
            {
                conversation.Title = generatedTitle;
                if (conversation.Id == activeId)
                {
                    ChatStateService.ActiveChatTitle = generatedTitle;
                }
                TabService.UpdateChatTabTitle(conversation.Id, generatedTitle);
                await ConversationService.SaveConversationAsync(conversation);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch {}
    }

    private bool showSidebarUserDropdown = false;

    private async Task HandleSidebarLogout()
    {
        showSidebarUserDropdown = false;
        try
        {
            // 1. Cancel any active streaming or voice generation safely
            chatCts?.Cancel();
            await StopVoice();

            // 2. Safely save conversation state and tabs
            if (Active.Messages.Count > 0)
            {
                await ConversationService.SaveConversationAsync(Active);
            }
            TabService.SaveTabs();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Home] Error saving state before sign out: {ex.Message}");
        }

        // 3. Clear auth session in database and state
        await AuthService.LogoutAsync();
        SonnerService.Info("Signed out", "Session ended safely.");

        // 4. Redirect cleanly to login page
        NavManager.NavigateTo("/login");
    }

    private void OnPermissionModeChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ExecutionPermissionMode>(e.Value?.ToString(), out var mode))
        {
            SecurityService.UpdatePermissionMode(mode);
            SonnerService.Info("Permissions updated", $"Agent execution mode: {mode}");
            StateHasChanged();
        }
    }

    private void OnAuthChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            ConversationService.OnChange -= OnConversationsChanged;
            ChatStateService.OnTitleRenamed -= OnExternalTitleRenamed;
            ChatStateService.OnNewChatRequested -= HandleNewChatRequested;
            TabService.OnTabsChanged -= OnTabsUpdated;
            TabService.OnDragStateChanged -= OnTabsUpdated;
            GitGram.OnStateChanged -= OnGitGramStateChanged;
            GramBox.OnStatusChanged -= OnGramBoxStatusChanged;
            PresentationGeneration.ProjectUpdated -= OnPresentationProjectUpdated;
            QuotaTracker.OnNotification -= OnQuotaNotification;
            AuthService.OnAuthStateChanged -= OnAuthChanged;
            await StopVoice();
            chatCts?.Cancel();
            dotNetHelper?.Dispose();
        }
        catch (Exception) {}
    }
}
