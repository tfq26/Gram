    private async Task ToggleVoice()
    {
        if (voiceState == VoiceState.Idle)
        {
            voiceConversationActive = true;
            voiceLastResponse = "";
            await StartVoiceCaptureAsync();
        }
        else
        {
            await EndVoiceConversation();
        }
    }

    private async Task StartVoiceCaptureAsync()
    {
        voiceState = VoiceState.UserSpeaking;
        StateHasChanged();

        try
        {
            usingAssemblyAi = StreamingTranscriberFactory.IsConfigured;
            var startMethod = usingAssemblyAi ? "gramAudio.startAssemblyAiVoice" : "gramAudio.startVoice";
            var success = await JSRuntime.InvokeAsync<bool>(startMethod, dotNetHelper, "visualizerBars", selectedAudioInputDeviceId);

            if (!success && usingAssemblyAi)
            {
                // Keep voice input usable if the cloud provider is temporarily unavailable.
                usingAssemblyAi = false;
                success = await JSRuntime.InvokeAsync<bool>("gramAudio.startVoice", dotNetHelper, "visualizerBars", selectedAudioInputDeviceId);
            }

            if (!success)
            {
                usingAssemblyAi = false;
                voiceConversationActive = false;
                voiceState = VoiceState.Idle;
                StateHasChanged();
            }
            else
            {
                await RefreshAudioDevicesAsync();
            }
        }
        catch (Exception)
        {
            usingAssemblyAi = false;
            voiceConversationActive = false;
            voiceState = VoiceState.Idle;
            StateHasChanged();
        }
    }

    private async Task EndVoiceConversation()
    {
        voiceConversationActive = false;
        await StopVoice();
        try { await JSRuntime.InvokeVoidAsync("gramAudio.stopSpeech"); }
        catch (Exception) {}
        voiceLastResponse = "";
        StateHasChanged();
    }

    private async Task SpeakVoiceResponseAsync(Message assistantMessage)
    {
        var responseText = assistantMessage.Text?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(responseText) || responseText == "[Generation stopped]")
        {
            await StartVoiceCaptureAsync();
            return;
        }

        voiceLastResponse = responseText;
        voiceState = VoiceState.GramSpeaking;
        StateHasChanged();

        var started = false;
        try
        {
            if (TextToSpeechProvider.IsConfigured)
            {
                started = await JSRuntime.InvokeAsync<bool>("gramAudio.speakServerText", responseText, dotNetHelper);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Voice TTS] {ex.Message}");
        }

        if (!started)
        {
            try
            {
                started = await JSRuntime.InvokeAsync<bool>("gramAudio.speakText", responseText, dotNetHelper, 1.0, 1.0);
            }
            catch (Exception) {}
        }

        if (!started && voiceConversationActive)
        {
            await StartVoiceCaptureAsync();
        }
    }

