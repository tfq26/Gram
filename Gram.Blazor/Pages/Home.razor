    private string GetPresentationCurrentActivityText(ContentProject? project)
    {
        if (project == null) return "Preparing presentation deck...";
        if (project.Status == ContentProjectStatus.Assembled)
        {
            return $"All {project.Sections.Count} slides have been drafted, styled, and compiled into an interactive deck.";
        }
        if (IsPresentationFailed)
        {
            var failedSection = project.Sections.FirstOrDefault(s => s.Status == ContentSectionStatus.Failed);
            if (failedSection != null)
            {
                return $"Encountered an issue generating Slide {failedSection.Order}: \"{failedSection.Title}\".";
            }
            if (project.Sections.Count == 0)
            {
                return "Generation stopped before slides could be drafted. Please try again with a refined prompt.";
            }
            return $"Generation interrupted with {PresentationReadySections} of {project.Sections.Count} slides completed.";
        }
        if (project.Status == ContentProjectStatus.ReadyForAssembly)
        {
            return "Reviewing slide balance, typography, and compiling interactive HTML deck...";
        }
        
        var activeGenSection = project.Sections.FirstOrDefault(s => s.Status == ContentSectionStatus.Generating);
        if (activeGenSection != null)
        {
            var job = !string.IsNullOrWhiteSpace(activeGenSection.NarrativeJob) ? $" · {activeGenSection.NarrativeJob}" : "";
            return $"Drafting Slide {activeGenSection.Order}: \"{activeGenSection.Title}\"{job}";
        }

        var readyCount = project.Sections.Count(s => s.Status == ContentSectionStatus.Ready);
        if (readyCount > 0)
        {
            return $"{readyCount} of {project.Sections.Count} slides completed · Queueing next slide batch...";
        }

        return "Analyzing narrative brief, gathering background data, and planning slide structure...";
    }

