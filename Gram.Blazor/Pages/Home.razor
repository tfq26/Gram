    [JSInvokable]
    public async Task HandleMentionKey(string key)
    {
        if (!showMentionPopup) return;
        if (key == "Escape")
        {
            showMentionPopup = false;
        }
        else if (key == "ArrowDown" && filteredMentions.Count > 0)
        {
            selectedMentionIndex = (selectedMentionIndex + 1) % filteredMentions.Count;
        }
        else if (key == "ArrowUp" && filteredMentions.Count > 0)
        {
            selectedMentionIndex = (selectedMentionIndex - 1 + filteredMentions.Count) % filteredMentions.Count;
        }
        else if ((key == "Enter" || key == "Tab") && filteredMentions.Count > 0)
        {
            await SelectMentionAsync(filteredMentions[Math.Clamp(selectedMentionIndex, 0, filteredMentions.Count - 1)]);
            return;
        }

        StateHasChanged();
        try { await JSRuntime.InvokeVoidAsync("gramAudio.scrollMentionIntoView", selectedMentionIndex); } catch { }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && showMentionPopup)
        {
            showMentionPopup = false;
            preventEnter = false;
            return;
        }

        if (e.Key == "Enter" && !e.ShiftKey)
        {
            if (showMentionPopup && filteredMentions.Count > 0)
            {
                await SelectMentionAsync(filteredMentions[Math.Clamp(selectedMentionIndex, 0, filteredMentions.Count - 1)]);
                preventEnter = true;
                return;
            }

            preventEnter = true;
            await Send();
        }
        else
        {
            preventEnter = false;
        }
    }

    private async Task Send()
    {
        if (isGenerating) return;

        var wasVoice = voiceState == VoiceState.UserSpeaking;
        var isVoiceTurn = voiceConversationActive && wasVoice;

        if (wasVoice)
        {
            var finalTranscript = await StopVoice();
            if (!string.IsNullOrWhiteSpace(finalTranscript))
            {
                draft = finalTranscript;
            }
        }

        var text = draft.Trim();

        if (string.IsNullOrWhiteSpace(text) && attachedFiles.Count == 0 && pendingMentions.Count == 0 && !wasVoice)
        {
            return;
        }

        draft = "";
        try { await JSRuntime.InvokeVoidAsync("gramAudio.resetTextarea", "composerTextarea"); } catch (Exception) {}
        StateHasChanged();

        var userMessageText = text;
        if (wasVoice && string.IsNullOrWhiteSpace(userMessageText))
        {
            userMessageText = "Voice message";
        }

        if (attachedFiles.Count > 0)
        {
            var filesSuffix = $" [Attached: {string.Join(", ", attachedFiles)}]";
            userMessageText = string.IsNullOrWhiteSpace(userMessageText) ? filesSuffix.Trim() : $"{userMessageText}{filesSuffix}";
            attachedFiles.Clear();
        }

        if (string.IsNullOrWhiteSpace(userMessageText) && pendingMentions.Count > 0)
        {
            userMessageText = "Use the selected context.";
        }

        var mentionsForMessage = pendingMentions.Select(CloneMention).ToList();
        pendingMentions.Clear();
        var userMsg = new Message("user", userMessageText) { Mentions = mentionsForMessage };

        // If this conversation is not yet in the conversations list, add it now
        if (!conversations.Any(c => c.Id == Active.Id))
        {
            conversations.Insert(0, Active);
        }

        Active.Messages.Add(userMsg);

        // Append to transcript.jsonl
        await SessionStorage.AppendTranscriptEntryAsync(Active.Id, new TranscriptEntry
        {
            Step = Active.Messages.Count,
            Type = TranscriptEntryType.USER_INPUT,
            Role = "user",
            Content = userMessageText,
            Mentions = userMsg.Mentions.Select(CloneMention).ToList(),
            Timestamp = userMsg.Timestamp
        });

        var isFirstMessage = Active.Messages.Count(m => m.Role == "user") == 1;
        if (isFirstMessage)
        {
            var initialTitle = ModelService.GenerateFallbackTitle(userMessageText);
            Active.Title = initialTitle;
            var initialMeta = conversations.FirstOrDefault(c => c.Id == Active.Id);
            if (initialMeta != null) initialMeta.Title = initialTitle;
            ChatStateService.ActiveChatTitle = initialTitle;
            TabService.UpdateChatTabTitle(Active.Id, initialTitle);
        }

        var assistantMessage = await GenerateAssistantResponseAsync(userMessageText, isFirstMessage, isVoiceTurn);
    }

    private async Task<Message> GenerateAssistantResponseAsync(string promptText, bool isFirstMessage = false, bool isVoiceTurn = false)
    {
        var assistantMsg = new Message("assistant", "");
        Active.Messages.Add(assistantMsg);
        Active.Updated = DateTimeOffset.UtcNow;
        isGenerating = true;
        StateHasChanged();
        _ = JSRuntime.InvokeVoidAsync("gramAudio.scrollToBottom", "messagesContainer");

        chatCts?.Cancel();
        chatCts = new CancellationTokenSource();
        var token = chatCts.Token;

        var effectiveModelId = !string.IsNullOrWhiteSpace(Active.ModelId) ? Active.ModelId : activeModelId;
        if (string.IsNullOrWhiteSpace(effectiveModelId))
        {
            effectiveModelId = ModelService.Models.FirstOrDefault(m => m.IsFavorite)?.Id 
                               ?? ModelService.Models.FirstOrDefault()?.Id 
                               ?? "anthropic/claude-3.7-sonnet";
        }

        currentRun = null;
        showRunDetails = false;
        StateHasChanged();

        var currentUserMessage = Active.Messages.LastOrDefault(message => message.Role == "user");
        var isPresentationMode = PresentationGenerationService.IsPresentationRequest(promptText, currentUserMessage?.Mentions);

        if (isPresentationMode && !effectiveModelId.Equals("gram-q-plus-plus", StringComparison.OrdinalIgnoreCase))
        {
            effectiveModelId = "gram-q-plus-plus";
            SonnerService.Info("Presentation mode", "Presentation generation is routed through Gram Q+ for reliability.");
        }

        if (isFirstMessage)
        {
            _ = AutoGenerateChatTitleAsync(Active, promptText, effectiveModelId);
        }

        // Assemble Context with explicit mentions, workspace attachments, and rolling memory.
        await ContextBuilder.EnsureContextSummaryAsync(Active);
        var workspacePath = Environment.CurrentDirectory;
        var mentionResolution = await MentionResolver.ResolveAsync(
            currentUserMessage?.Mentions,
            Active,
            workspacePath,
            promptText,
            token);
        isPresentationSession = isPresentationMode || mentionResolution.IsPresentationRequested;
        var contextResult = await ContextBuilder.AssembleContextAsync(
            Active,
            workspacePath: workspacePath,
            relevanceQuery: promptText,
            additionalSystemPrompt: voiceConversationActive ? GramSystemPrompt.VoiceConversationPrompt : null,
            mentionedContext: mentionResolution.Context);

        var streamBuffer = new SmoothStreamBuffer(
            async chunk =>
            {
                await InvokeAsync(() =>
                {
                    assistantMsg.Text += chunk;
                    StateHasChanged();
                });
            },
            () =>
            {
                _ = JSRuntime.InvokeVoidAsync("gramAudio.scrollToBottom", "messagesContainer");
                return Task.CompletedTask;
            });

        // Real-Time Pipelined Streaming Speech
        var isVoiceStreaming = isVoiceTurn && voiceConversationActive;
        var voiceSpeechGenId = isVoiceStreaming ? Guid.NewGuid().ToString() : null;
        var voiceSentenceBuffer = new System.Text.StringBuilder();

        if (isVoiceStreaming && voiceSpeechGenId != null)
        {
            voiceState = VoiceState.GramSpeaking;
            StateHasChanged();
            _ = JSRuntime.InvokeVoidAsync("gramAudio.startStreamingSpeech", voiceSpeechGenId);
        }

        try
        {
            assistantMsg.ToolCalls = new List<ToolCallInfo>();
            streamBuffer.Start(token);
            var result = await ChatSessionController.ExecuteAsync(Active.Id, new SendMessageRequest(
                promptText, effectiveModelId, workspacePath,
                isPresentationMode || mentionResolution.IsPresentationRequested,
                mentionResolution.ForcedWebSearchQuery,
                contextResult.Messages, contextResult.SystemPrompt, contextResult.RepositoryMap), async update =>
                {
                    if (update.Run is not null) currentRun = AgentRunTracker.Get(update.Run.Id);
                    if (update.PresentationProject is not null)
                    {
                        activePresentationProject = update.PresentationProject;
                        isPresentationCardDismissed = false;
                    }
                    if (!string.IsNullOrEmpty(update.ContentDelta))
                    {
                        streamBuffer.Enqueue(update.ContentDelta);

                        // Pipelined chunk tokenizer for sub-600ms voice responsiveness
                        if (isVoiceStreaming && voiceSpeechGenId != null)
                        {
                            voiceSentenceBuffer.Append(update.ContentDelta);
                            var buf = voiceSentenceBuffer.ToString();
                            int splitIdx = -1;
                            for (int i = 0; i < buf.Length - 1; i++)
                            {
                                char c = buf[i];
                                char next = buf[i + 1];
                                if ((c == '.' || c == '!' || c == '?' || c == '\n') && (char.IsWhiteSpace(next) || c == '\n'))
                                {
                                    splitIdx = i + 1;
                                    break;
                                }
                            }

                            if (splitIdx > 0)
                            {
                                var sentence = buf.Substring(0, splitIdx).Trim();
                                voiceSentenceBuffer.Remove(0, splitIdx);
                                if (!string.IsNullOrWhiteSpace(sentence))
                                {
                                    _ = JSRuntime.InvokeVoidAsync("gramAudio.enqueueSpeechChunk", sentence, false, voiceSpeechGenId, dotNetHelper, 1.05, 1.0, TextToSpeechProvider.IsConfigured);
                                }
                            }
                        }
                    }
                    if (!string.IsNullOrWhiteSpace(update.ErrorMessage)) assistantMsg.ErrorDetail = update.ErrorMessage;
                    if (update.ToolCall is not null)
                    {
                        var existing = assistantMsg.ToolCalls.FirstOrDefault(t => t.Id == update.ToolCall.Id);
                        if (existing is not null) { existing.Result = update.ToolCall.Result; existing.IsError = update.ToolCall.IsError; }
                        else assistantMsg.ToolCalls.Add(update.ToolCall);
                        await InvokeAsync(StateHasChanged);
                        _ = JSRuntime.InvokeVoidAsync("gramAudio.scrollToBottom", "messagesContainer");
                    }
                }, token);

            await streamBuffer.FlushAndCompleteAsync();

            // Flush final spoken sentence
            if (isVoiceStreaming && voiceSpeechGenId != null)
            {
                var remaining = voiceSentenceBuffer.ToString().Trim();
                voiceSentenceBuffer.Clear();
                _ = JSRuntime.InvokeVoidAsync("gramAudio.enqueueSpeechChunk", remaining, true, voiceSpeechGenId, dotNetHelper, 1.05, 1.0, TextToSpeechProvider.IsConfigured);
            }

            if (result.Run is not null) currentRun = AgentRunTracker.Get(result.Run.Id);
            if (!string.IsNullOrWhiteSpace(result.ErrorMessage) && !result.Cancelled) assistantMsg.ErrorDetail = result.ErrorMessage;
            if (result.Cancelled && string.IsNullOrWhiteSpace(assistantMsg.Text) && assistantMsg.ToolCalls.Count == 0)
                assistantMsg.Text = "[Generation stopped]";
        }
        catch (OperationCanceledException)
        {
            streamBuffer.Cancel();
            if (isVoiceStreaming) _ = JSRuntime.InvokeVoidAsync("gramAudio.stopSpeech");
            if (currentRun != null) await BackendRunApi.CancelAsync(currentRun.Id, "Generation cancelled.");
            if (string.IsNullOrWhiteSpace(assistantMsg.Text) && (assistantMsg.ToolCalls == null || assistantMsg.ToolCalls.Count == 0))
            {
                assistantMsg.Text = "[Generation stopped]";
            }
        }
        catch (Exception ex)
        {
            if (currentRun != null) AgentRunTracker.Complete(currentRun.Id, AgentRunStatus.Failed, ex.Message);
            assistantMsg.ErrorDetail = ex.Message;
        }
        finally
        {
            if (currentRun != null && currentRun.CompletedAt is null && currentRun.Status is not (AgentRunStatus.Cancelled or AgentRunStatus.Failed))
            {
                AgentRunTracker.Complete(currentRun.Id);
                currentRun = AgentRunTracker.Get(currentRun.Id);
            }
            isGenerating = false;
            assistantMsg.Timestamp = DateTimeOffset.UtcNow;

            // Append final response to transcript.jsonl
            await SessionStorage.AppendTranscriptEntryAsync(Active.Id, new TranscriptEntry
            {
                Step = Active.Messages.Count,
                Type = TranscriptEntryType.MODEL_RESPONSE,
                Role = "assistant",
                Content = assistantMsg.Text,
                Timestamp = assistantMsg.Timestamp
            });

            if (IsPresentationFailed && activePresentationProject != null)
            {
                SonnerService.Error("Presentation generation stopped or encountered an error before all slides were completed.");
            }

            await SaveConversationThroughApiAsync(Active);
            StateHasChanged();
            _ = JSRuntime.InvokeVoidAsync("gramAudio.scrollToBottom", "messagesContainer");
        }

        return assistantMsg;
    }

    private void StopGeneration()
    {
        chatCts?.Cancel();
        isGenerating = false;
        StateHasChanged();
    }

    private void ToggleErrorDetails(string messageKey)
    {
        if (expandedErrorIds.Contains(messageKey))
        {
            expandedErrorIds.Remove(messageKey);
        }
        else
        {
            expandedErrorIds.Add(messageKey);
        }
        StateHasChanged();
    }

    private async Task CopyResponseText(Message message)
    {
        if (string.IsNullOrEmpty(message.Text)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", message.Text);
            copiedMessageId = message.Timestamp.Ticks.ToString();
            SonnerService.Success("Copied", "Response text copied to clipboard.");
            StateHasChanged();

            _ = Task.Delay(2000).ContinueWith(_ =>
            {
                copiedMessageId = null;
                _ = InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            SonnerService.Error("Copy failed", ex.Message);
        }
    }

    private void EditUserPrompt(Message message)
    {
        draft = message.Text;
        pendingMentions.Clear();
        pendingMentions.AddRange(message.Mentions.Select(CloneMention));
        StateHasChanged();
        _ = JSRuntime.InvokeVoidAsync("gramAudio.autoResizeTextarea", textareaRef);
    }

    private async Task ToggleReadAloud(Message msg)
    {
        var msgId = msg.Timestamp.Ticks.ToString();
        if (speakingMessageId == msgId)
        {
            await JSRuntime.InvokeVoidAsync("gramAudio.stopSpeech");
            speakingMessageId = null;
            StateHasChanged();
            return;
        }

        try
        {
            speakingMessageId = msgId;
            StateHasChanged();
            var started = false;
            try
            {
                if (TextToSpeechProvider.IsConfigured)
                {
                    started = await JSRuntime.InvokeAsync<bool>("gramAudio.speakServerText", msg.Text, dotNetHelper);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[ElevenLabs TTS] {ex.Message}");
            }

            if (!started)
            {
                started = await JSRuntime.InvokeAsync<bool>("gramAudio.speakText", msg.Text, dotNetHelper, 1.0, 1.0);
            }
            if (!started)
            {
                speakingMessageId = null;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            speakingMessageId = null;
            Console.WriteLine($"[TTS Error] {ex.Message}");
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnSpeechSynthesisEnded()
    {
        speakingMessageId = null;
        if (voiceConversationActive && voiceState == VoiceState.GramSpeaking)
        {
            _ = InvokeAsync(async () => await StartVoiceCaptureAsync());
        }
        else
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task RetryResponseAsync(Message assistantMessage)
    {
        if (isGenerating) return;

        // Find the index of this assistant message in the conversation
        var idx = Active.Messages.IndexOf(assistantMessage);
        if (idx < 0) return;

        // Locate the user prompt directly preceding or before this assistant message
        Message? lastUserMsg = null;
        for (int i = idx - 1; i >= 0; i--)
        {
            if (Active.Messages[i].Role == "user")
            {
                lastUserMsg = Active.Messages[i];
                break;
            }
        }

        if (lastUserMsg == null)
        {
            SonnerService.Warning("Retry unavailable", "No preceding user prompt found to retry.");
            return;
        }

        // Remove the old assistant response attempt cleanly (hides previous attempt)
        Active.Messages.RemoveAt(idx);

        // Re-generate response using the existing user prompt in background
        await GenerateAssistantResponseAsync(lastUserMsg.Text);
    }

    private async Task AutoGenerateChatTitleAsync(Conversation conversation, string firstPrompt, string modelId)
    {
        try
        {
            var generatedTitle = await ModelService.GenerateTitleAsync(modelId, firstPrompt);
            if (!string.IsNullOrWhiteSpace(generatedTitle) && generatedTitle != "New chat")
            {
                conversation.Title = generatedTitle;
                var meta = conversations.FirstOrDefault(c => c.Id == conversation.Id);
                if (meta != null)
                {
                    meta.Title = generatedTitle;
                }
                if (conversation.Id == activeId)
                {
                    ChatStateService.ActiveChatTitle = generatedTitle;
                }
                TabService.UpdateChatTabTitle(conversation.Id, generatedTitle);
                await SaveConversationThroughApiAsync(conversation);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch {}
    }

    private bool showSidebarUserDropdown = false;

    private async Task HandleSidebarLogout()
    {
        showSidebarUserDropdown = false;
        try
        {
            // 1. Cancel any active streaming or voice generation safely
            chatCts?.Cancel();
            await StopVoice();

            // 2. Safely save conversation state and tabs
            if (Active.Messages.Count > 0)
            {
            await SaveConversationThroughApiAsync(Active);
            }
            TabService.SaveTabs();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Home] Error saving state before sign out: {ex.Message}");
        }

        // 3. Clear auth session in database and state
        await AuthService.LogoutAsync();
        SonnerService.Info("Signed out", "Session ended safely.");

        // 4. Redirect cleanly to login page
        NavManager.NavigateTo("/login");
    }

    private void OnPermissionModeChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ExecutionPermissionMode>(e.Value?.ToString(), out var mode))
        {
            SecurityService.UpdatePermissionMode(mode);
            SonnerService.Info("Permissions updated", $"Agent execution mode: {mode}");
            StateHasChanged();
        }
    }

    private void OnAuthChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            ConversationService.OnChange -= OnConversationsChanged;
            ProjectService.OnChange -= OnProjectServiceChanged;
            ChatStateService.OnTitleRenamed -= OnExternalTitleRenamed;
            ChatStateService.OnNewChatRequested -= HandleNewChatRequested;
            TabService.OnTabsChanged -= OnTabsUpdated;
            TabService.OnDragStateChanged -= OnTabsUpdated;
            GitGram.OnStateChanged -= OnGitGramStateChanged;
            GramBox.OnStatusChanged -= OnGramBoxStatusChanged;
            QuotaTracker.OnNotification -= OnQuotaNotification;
            AuthService.OnAuthStateChanged -= OnAuthChanged;
            await StopVoice();
            chatCts?.Cancel();
            dotNetHelper?.Dispose();
        }
        catch (Exception) {}
    }
}
