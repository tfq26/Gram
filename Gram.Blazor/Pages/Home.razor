@code {
    private enum VoiceState { Idle, UserSpeaking, GramSpeaking }

    private List<Conversation> conversations => ConversationService.Conversations;
    private string activeId = "default";
    private string draft = "";
    private readonly List<string> attachedFiles = new();
    private VoiceState voiceState = VoiceState.Idle;
    private string whisperStatus = "Ready";
    private bool usingAssemblyAi;
    private bool autoSendVoice = true;
    private bool autoSendingVoice;
    private bool voiceConversationActive;
    private string voiceLastResponse = "";
    private DotNetObjectReference<Home>? dotNetHelper;
    private ElementReference textareaRef;
    private CancellationTokenSource? voiceCts;
    private CancellationTokenSource? chatCts;
    private string activeModelId = "";
    private bool isSidebarOpen = false;
    private bool isSettingsSheetOpen = false;
    private SidecarTab activeSidecarTab = SidecarTab.Settings;
    private ArtifactInfo? selectedArtifact;
    private List<DiffFileItem> activeDiffs = new();
    private bool preventEnter = false;
    private bool isGenerating = false;
    private AgentRunSnapshot? currentRun;
    private bool showRunDetails;
    private bool isContextMenuOpen = false;
    private bool isModelMenuOpen = false;
    private bool isAudioDeviceMenuOpen = false;
    private bool audioDevicesLoaded = false;
    private List<AudioDeviceInfo> audioDevices = new();
    private string selectedAudioInputDeviceId = "";
    private string selectedAudioOutputDeviceId = "";
    private double contextMenuX = 0;
    private double contextMenuY = 0;
    private Conversation? contextMenuTarget;
    private string? copiedMessageId;
    private string? speakingMessageId;
    private readonly HashSet<string> expandedErrorIds = new();
    private ContentProject? activePresentationProject;
    private string presentationStatusLabel = "Planning the story";
    private int presentationStatusVersion;
    private bool isPresentationCardDismissed = false;
    private bool IsProjectActive => Active.IsProject || Active.Attachments.Any(a => !a.IsImage) || Active.Artifacts.Count > 0 || GramBox.ActiveSessions.Count > 0 || activeDiffs.Count > 0;
    private bool PresentationProgressVisible => activePresentationProject != null && !isPresentationCardDismissed;
    private int PresentationReadySections => activePresentationProject?.Sections.Count(section => section.Status == ContentSectionStatus.Ready) ?? 0;
    private int PresentationProgressPercent => activePresentationProject?.Sections.Count > 0
        ? Math.Clamp((int)Math.Round(PresentationReadySections * 100d / activePresentationProject.Sections.Count), 0, 100)
        : 0;
    private string PresentationMascotState => activePresentationProject?.Status switch
    {
        ContentProjectStatus.Assembled => "complete",
        ContentProjectStatus.ReadyForAssembly => "reviewing",
        ContentProjectStatus.NeedsRevision => "reviewing",
        ContentProjectStatus.Failed => "idle",
        _ when PresentationReadySections > 0 => "designing",
        _ => "researching"
    };

    private string GetPresentationCurrentActivityText(ContentProject? project)
    {
        if (project == null) return "Preparing presentation deck...";
        if (project.Status == ContentProjectStatus.Assembled)
        {
            return $"All {project.Sections.Count} slides have been drafted, styled, and compiled into an interactive deck.";
        }
        if (project.Status == ContentProjectStatus.ReadyForAssembly)
        {
            return "Reviewing slide balance, typography, and compiling interactive HTML deck...";
        }
        if (project.Status == ContentProjectStatus.Failed)
        {
            return "Generation encountered an issue. You can retry with a revised prompt.";
        }
        
        var activeGenSection = project.Sections.FirstOrDefault(s => s.Status == ContentSectionStatus.Generating);
        if (activeGenSection != null)
        {
            var job = !string.IsNullOrWhiteSpace(activeGenSection.NarrativeJob) ? $" · {activeGenSection.NarrativeJob}" : "";
            return $"Drafting Slide {activeGenSection.Order}: \"{activeGenSection.Title}\"{job}";
        }

        var readyCount = project.Sections.Count(s => s.Status == ContentSectionStatus.Ready);
        if (readyCount > 0)
        {
            return $"{readyCount} of {project.Sections.Count} slides completed · Queueing next slide batch...";
        }

        return "Analyzing narrative brief, gathering background data, and planning slide structure...";
    }

    private (string Text, string CssClass, int? Percent) GetModelQuotaDisplay(GramModel model)
    {
        var snapshots = QuotaTracker.GetSnapshots();
        var actualModelName = model.Id;
        if (model.Id.StartsWith("google/", StringComparison.OrdinalIgnoreCase)) actualModelName = model.Id["google/".Length..];
        else if (model.Id.StartsWith("anthropic/", StringComparison.OrdinalIgnoreCase)) actualModelName = model.Id["anthropic/".Length..];
        else if (model.Id.StartsWith("openai/", StringComparison.OrdinalIgnoreCase)) actualModelName = model.Id["openai/".Length..];

        var isGramQPlus = model.Id.Equals("gram-q-plus", StringComparison.OrdinalIgnoreCase);
        var isGramQ = model.Id.Equals("gram-q", StringComparison.OrdinalIgnoreCase);

        var snapshot = snapshots.FirstOrDefault(s =>
            (isGramQPlus && (s.Scope.Equals("system", StringComparison.OrdinalIgnoreCase) || s.Model.Contains("gemini", StringComparison.OrdinalIgnoreCase) || s.Provider.Equals("google", StringComparison.OrdinalIgnoreCase)))
            || (isGramQ && (s.Scope.Equals("system", StringComparison.OrdinalIgnoreCase) || s.Model.Contains("gpt-oss", StringComparison.OrdinalIgnoreCase) || s.Provider.Equals("groq", StringComparison.OrdinalIgnoreCase)))
            || s.Model.Equals(model.Id, StringComparison.OrdinalIgnoreCase)
            || s.Model.Equals(actualModelName, StringComparison.OrdinalIgnoreCase));

        if (snapshot != null)
        {
            if (snapshot.IsExhausted || (snapshot.CooldownUntil.HasValue && snapshot.CooldownUntil > DateTimeOffset.UtcNow) || snapshot.LastStatusCode == 429)
            {
                if (snapshot.CooldownUntil.HasValue && snapshot.CooldownUntil > DateTimeOffset.UtcNow)
                {
                    var seconds = Math.Max(1, (int)Math.Ceiling((snapshot.CooldownUntil.Value - DateTimeOffset.UtcNow).TotalSeconds));
                    return ($"Cooldown · {seconds}s", "cooldown", 0);
                }
                return ("Quota exhausted (429)", "low", 0);
            }

            if (snapshot.RemainingPercent.HasValue)
            {
                var p = snapshot.RemainingPercent.Value;
                var css = p <= 15 ? "low" : "";
                if (snapshot.RequestsRemaining.HasValue && snapshot.RequestsLimit.HasValue)
                {
                    return ($"{p}% · {snapshot.RequestsRemaining.Value:N0}/{snapshot.RequestsLimit.Value:N0} reqs", css, p);
                }
                return ($"{p}% remaining", css, p);
            }

            if (snapshot.ObservedRequests > 0)
            {
                return ($"Active · {snapshot.ObservedRequests} reqs", "", 100);
            }
        }

        var provId = model.Provider.ToLowerInvariant();
        var hasKey = !string.IsNullOrWhiteSpace(ModelService.GetUserApiKey(provId))
                     || !string.IsNullOrWhiteSpace(ModelService.GetUserApiKey("openrouter"))
                     || !string.IsNullOrWhiteSpace(ModelService.GetSystemApiKey("groq"))
                     || !string.IsNullOrWhiteSpace(ModelService.GetSystemApiKey("google"));

        if (isGramQ || isGramQPlus)
        {
            return ("System quota", "", 100);
        }

        if (!hasKey && !provId.Equals("ollama", StringComparison.OrdinalIgnoreCase))
        {
            return ("Key required", "missing", null);
        }

        return ("100% available", "", 100);
    }

    private void ToggleProjectMode(ChangeEventArgs e)
    {
        Active.IsProject = (bool)(e.Value ?? false);
        if (!IsProjectActive && (activeSidecarTab == SidecarTab.GitDiff || activeSidecarTab == SidecarTab.GitGram || activeSidecarTab == SidecarTab.Sandboxes))
        {
            activeSidecarTab = SidecarTab.Settings;
        }
        _ = ConversationService.SaveConversationAsync(Active);
        StateHasChanged();
    }

    private void OpenSidecar(SidecarTab tab)
    {
        activeSidecarTab = tab;
        isSettingsSheetOpen = true;
        StateHasChanged();
    }

    private void ViewArtifact(ArtifactInfo art)
    {
        selectedArtifact = art;
        OpenSidecar(SidecarTab.Artifact);
    }

    private async Task ApplyArtifact(ArtifactInfo? art)
    {
        if (art == null) return;
        var relPath = string.IsNullOrWhiteSpace(art.RelativePath) ? art.FileName : art.RelativePath;
        var success = await GitGram.ApplyArtifactToWorkspaceAsync(relPath, art.Content, Environment.CurrentDirectory);
        if (success)
        {
            LoadGitDiff();
        }
    }

