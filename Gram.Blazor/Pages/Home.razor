            if (saved is null) return;
            conversation.Version = saved.Version;
            conversation.Updated = saved.Updated;
        }
        catch (ConversationVersionConflictException)
        {
            SonnerService.Warning("Conversation changed", "This chat was updated elsewhere. Reload it before saving again.");
