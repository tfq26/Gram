    private async Task ArchiveFromContextMenu(Conversation? chat)
    {
        isContextMenuOpen = false;
        if (chat == null) return;

        var compactEnabled = SettingsService.GetSetting("compactOnArchive", "false") == "true";
        if (compactEnabled)
        {
            await ContextBuilder.CompactForArchiveAsync(chat);
        }

        chat.IsArchived = true;
        await SaveConversationThroughApiAsync(chat);

        if (chat.Id == activeId)
        {
            var nextActive = conversations.FirstOrDefault(c => !c.IsArchived && c.Id != chat.Id);
            if (nextActive != null)
            {
                await SelectConversation(nextActive.Id);
            }
            else
            {
                NewConversation();
            }
        }

        SonnerService.Success("Chat archived", compactEnabled ? $"'{chat.Title}' archived and memory compacted." : $"'{chat.Title}' moved to archive.");
        await InvokeAsync(StateHasChanged);
    }

    private async Task ArchiveSelectedFromContextMenu()
    {
        isContextMenuOpen = false;
        if (contextMenuSelectedIds.Count == 0) return;

        var idsToArchive = contextMenuSelectedIds.ToList();
        contextMenuSelectedIds.Clear();
        var compactEnabled = SettingsService.GetSetting("compactOnArchive", "false") == "true";

        var wasActiveArchived = false;
        foreach (var id in idsToArchive)
        {
            var chat = conversations.FirstOrDefault(c => c.Id == id);
            if (chat != null)
            {
                if (compactEnabled)
                {
                    await ContextBuilder.CompactForArchiveAsync(chat);
                }
                chat.IsArchived = true;
                await SaveConversationThroughApiAsync(chat);
                if (chat.Id == activeId) wasActiveArchived = true;
            }
        }

        if (wasActiveArchived)
        {
            var nextActive = conversations.FirstOrDefault(c => !c.IsArchived);
            if (nextActive != null)
            {
                await SelectConversation(nextActive.Id);
            }
            else
            {
                NewConversation();
            }
        }

        SonnerService.Success("Chats archived", $"Archived {idsToArchive.Count} chats.");
        await InvokeAsync(StateHasChanged);
    }

