@page "/summary-test"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@rendermode InteractiveServer
@using System.Diagnostics
@using Gram.Blazor.Shared
@inject AgentOrchestrator AgentOrchestrator
@inject SummaryDiagnosticsLogService SummaryLog
@inject IQuotaTracker QuotaTracker
@inject IModelGateway ModelGateway

<PageTitle>Summary Test · Gram</PageTitle>

<div class="voice-test-page search-test-page">
    <div class="voice-test-card search-test-card">
        <div class="voice-test-header">
            <div>
                <span class="voice-test-eyebrow">DIAGNOSTIC TOOL</span>
                <h1>Controlled summarization test</h1>
                <p>Runs Gram against a fixed eight-source corpus and ten questions without web retrieval, so summarization and cross-source reasoning can be evaluated independently.</p>
            </div>
            <a class="voice-test-back" href="/">Back to chat</a>
        </div>
        <div class="voice-test-controls">
            <button type="button" class="voice-test-button" @onclick="RunAllAsync" disabled="@running">Run 10 questions</button>
            <button type="button" class="voice-test-secondary-button" @onclick="Clear" disabled="@running">Clear</button>
            <span class="voice-test-status @(running ? "listening" : "")">@status</span>
        </div>
        @if (results.Count > 0)
        {
            <div class="search-test-summary">
                <div class="voice-test-section-label">Run summary</div>
                <div class="voice-test-grid search-test-metrics">
                    <div><span>Questions</span><strong>@results.Count / 10</strong></div>
                    <div><span>Answers produced</span><strong>@results.Count(item => !string.IsNullOrWhiteSpace(item.Answer))</strong></div>
                    <div><span>Average model time</span><strong>@(results.Count == 0 ? 0 : results.Average(item => item.ElapsedMs).ToString("0")) ms</strong></div>
                    <div><span>Log</span><strong>JSONL</strong></div>
                </div>
                <div class="search-test-log-path">Detailed results are saved to <code>@SummaryLog.LogPath</code></div>
            </div>
        }
        @foreach (var result in results)
        {
            <section class="search-test-run">
                <div class="search-test-run-header"><div><span class="search-test-status-pill @(result.QualityPassed ? "pass" : "fail")">@result.Skill · @result.Attempts attempt@(result.Attempts == 1 ? "" : "s")</span><h2>@result.Question</h2></div><strong class="search-test-latency">@result.ElapsedMs ms</strong></div>
                @if (!string.IsNullOrWhiteSpace(result.Error))
                { <div class="voice-test-error">@result.Error</div> }
                else
                { <div class="search-test-answer"><div class="voice-test-section-label">Model answer</div><p>@result.Answer</p><span class="search-test-answer-quality @(result.QualityPassed ? "pass" : "fail")">@(result.QualityPassed ? "Expected evidence found" : $"Missing expected evidence: {string.Join(", ", result.MissingTerms ?? [])}")</span></div> }
            </section>
        }
    </div>
</div>

@code {
    private readonly List<Result> results = [];
    private bool running;
    private string status = "Ready to test";

    private async Task RunAllAsync()
    {
        if (running) return;
        results.Clear(); running = true;
        try
        {
            var consecutiveTimeouts = 0;
            foreach (var question in SummaryEvaluationCorpus.Questions)
            {
                status = $"Testing {question.Id}: {question.Skill}";
                await InvokeAsync(StateHasChanged);
                var item = await RunQuestionAsync(question);
                results.Insert(0, item);
                consecutiveTimeouts = item.FailureKind == "model_timeout" ? consecutiveTimeouts + 1 : 0;
                await SummaryLog.AppendAsync(new { runId = Guid.NewGuid().ToString("N")[..12], timestamp = DateTimeOffset.UtcNow, question.Id, question.Question, question.Skill, expectedSources = question.ExpectedSourceIds, expectedAnswerTerms = question.ExpectedAnswerTerms, model = "gram-q-plus", attempts = item.Attempts, failureKind = item.FailureKind, qualityPassed = item.QualityPassed, missingTerms = item.MissingTerms, elapsedMilliseconds = item.ElapsedMs, answer = item.Answer, error = item.Error, sourceCount = SummaryEvaluationCorpus.Sources.Count });
                await InvokeAsync(StateHasChanged);
                if (consecutiveTimeouts >= 2)
                {
                    status = "Stopped after repeated model timeouts; retry the suite later";
                    await InvokeAsync(StateHasChanged);
                    break;
                }
            }
            status = "Summarization diagnostics complete";
        }
        finally { running = false; }
    }

        private async Task<Result> RunQuestionAsync(SummaryTestQuestion question)
    {
        var timer = Stopwatch.StartNew();
        for (var attempt = 1; attempt <= 3; attempt++)
        {
            await WaitForProviderAsync(question.Id);
            var answer = new System.Text.StringBuilder();
            string? error = null;
            var failureKind = "";
            try
            {
                using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(45));
                try
                {
                    await foreach (var step in ModelGateway.StreamAsync(new ModelRequest(
                        "gram-q-plus",
                        [new Message("user", $"Question: {question.Question}\n\nControlled sources:\n{SummaryEvaluationCorpus.BuildContext()}")],
                        "You are evaluating a controlled source collection. Answer only from the supplied sources. Cite the mock source URLs inline. Distinguish measured results, company claims, and forecasts. If the sources do not establish something, say so clearly."), timeout.Token))
                    {
                        if (step.Text != null) answer.Append(step.Text);
                        if (step.Error != null) error = step.Error;
                    }
                }
                catch (OperationCanceledException) when (timeout.IsCancellationRequested)
                {
                    failureKind = "model_timeout";
                    error = "[Model timeout] The model did not complete within 45 seconds.";
                }
            }
            catch (OperationCanceledException) { failureKind = "cancelled"; error = "The evaluation was cancelled."; }
            catch (Exception ex)
            {
                error = ex.Message;
                failureKind = IsQuotaError(error) ? "quota" : error.Contains("canceled", StringComparison.OrdinalIgnoreCase) ? "model_timeout" : "error";
            }

            if (failureKind.Length == 0 && error?.Contains("canceled", StringComparison.OrdinalIgnoreCase) == true)
            {
                failureKind = "model_timeout";
                error = "[Model timeout] The model did not complete within 45 seconds.";
            }

            if (string.IsNullOrWhiteSpace(error) || (!IsQuotaError(error) && failureKind != "model_timeout") || attempt == (failureKind == "model_timeout" ? 2 : 3))
            {
                timer.Stop();
                var answerText = answer.ToString().Trim();
                var missingTerms = question.ExpectedAnswerTerms?.Where(term => !answerText.Contains(term, StringComparison.OrdinalIgnoreCase)).ToList() ?? [];
                return new Result(question.Id, question.Question, question.Skill, answerText, timer.ElapsedMilliseconds, error, attempt, missingTerms.Count == 0 && string.IsNullOrWhiteSpace(error), missingTerms, failureKind);
            }

            var waitSeconds = failureKind == "model_timeout" ? 2 : Math.Clamp(ParseRetrySeconds(error) ?? 5, 1, 60);
            status = $"Quota cooldown for {question.Id}; retrying in {waitSeconds}s (attempt {attempt + 1}/3)";
            await InvokeAsync(StateHasChanged);
            await Task.Delay(TimeSpan.FromSeconds(waitSeconds + 1));
        }
        timer.Stop();
        return new Result(question.Id, question.Question, question.Skill, "", timer.ElapsedMilliseconds, "Retry limit reached.", 3, false, [], "error");
    }

    private async Task WaitForProviderAsync(string questionId)
    {
        var key = QuotaRequestKey.Create("google", "gemini-3-flash-preview", "system", "system");
        while (!QuotaTracker.CanRequest(key, out var reason))
        {
            var seconds = ParseRetrySeconds(reason ?? "") ?? 5;
            seconds = Math.Clamp(seconds + 1, 1, 90);
            status = $"Quota cooldown before {questionId}; next attempt in {seconds}s";
            await InvokeAsync(StateHasChanged);
            await Task.Delay(TimeSpan.FromSeconds(seconds));
        }
    }

    private static bool IsQuotaError(string error) => error.Contains("quota", StringComparison.OrdinalIgnoreCase) || error.Contains("rate limit", StringComparison.OrdinalIgnoreCase) || error.Contains("cooling down", StringComparison.OrdinalIgnoreCase);
    private static int? ParseRetrySeconds(string error)
    {
        var match = System.Text.RegularExpressions.Regex.Match(error, @"retry in about (\d+) seconds", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return match.Success && int.TryParse(match.Groups[1].Value, out var seconds) ? seconds : null;
    }

    private void Clear() { results.Clear(); status = "Ready to test"; }
    private sealed record Result(string Id, string Question, string Skill, string Answer, long ElapsedMs, string? Error, int Attempts, bool QualityPassed = false, IReadOnlyList<string>? MissingTerms = null, string FailureKind = "")
    {
        public bool IsTimeout => FailureKind == "model_timeout";
    }
}
