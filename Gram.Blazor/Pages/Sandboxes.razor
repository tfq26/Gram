@page "/sandboxes"
@rendermode InteractiveServer
@namespace Gram.Blazor.Pages
@using Gram.Blazor.Shared
@using Gram.Blazor.Components.ShadCn
@inject IGramBoxService GramBox
@inject NavigationManager Navigation
@inject ISonnerService SonnerService
@inject ConversationService ConversationService
@implements IDisposable

<div class="sandboxes-dashboard-container" style="display: flex; flex-direction: column; height: 100vh; width: 100vw; background: var(--bg-app, #09090b); color: var(--text-primary, #ededed); overflow: hidden; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
    <!-- Top Header -->
    <header style="display: flex; align-items: center; justify-content: space-between; padding: 14px 24px; border-bottom: 1px solid var(--border-color, #27272a); background: var(--bg-panel, #121215);">
        <div style="display: flex; align-items: center; gap: 14px;">
            <a href="/" class="btn-secondary" style="display: flex; align-items: center; gap: 6px; padding: 6px 12px; font-size: 12px; text-decoration: none; border-radius: var(--radius-sm, 6px);">
                <span>←</span>
                <span>Back to Chat</span>
            </a>
            <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 18px;">📦</span>
                <h1 style="font-size: 16px; font-weight: 600; margin: 0; color: var(--text-primary, #ededed);">
                    Sandboxes & Worktrees
                </h1>
                <span style="font-size: 11px; background: var(--bg-hover, #27272a); padding: 2px 8px; border-radius: 12px; color: var(--text-muted, #a1a1aa);">
                    @GramBox.ActiveSessions.Count Total
                </span>
            </div>
        </div>

        <div style="display: flex; align-items: center; gap: 10px;">
            <button type="button" class="btn-primary" style="padding: 6px 14px; font-size: 12.5px;" @onclick="() => showCreateModal = true">
                + Create Sandbox
            </button>
        </div>
    </header>

    <!-- Main Content Area -->
    <div style="display: flex; flex-direction: column; flex: 1; min-height: 0; padding: 20px 24px; overflow-y: auto; gap: 16px;">
        <!-- Telemetry Cards Row -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;">
            @{
                var sessions = GramBox.ActiveSessions;
                var runningCount = sessions.Count(s => s.MajorState == SandboxMajorState.RunningCommand);
                var readyCount = sessions.Count(s => s.MajorState == SandboxMajorState.Ready);
                var mergedCount = sessions.Count(s => s.MajorState == SandboxMajorState.Merged);
                var totalRamMb = sessions.Sum(s => s.PeakWorkingSetBytes) / (1024 * 1024);
            }
            <div style="background: var(--bg-panel, #121215); border: 1px solid var(--border-color, #27272a); border-radius: var(--radius-md, 8px); padding: 14px;">
                <div style="font-size: 11px; color: var(--text-muted, #a1a1aa); text-transform: uppercase; font-weight: 600;">Active Sessions</div>
                <div style="font-size: 22px; font-weight: 700; color: var(--text-primary, #ededed); margin-top: 4px;">@sessions.Count</div>
                <div style="font-size: 11px; color: var(--text-muted, #a1a1aa); margin-top: 2px;">Zero-RAM Worktree Engine</div>
            </div>

            <div style="background: var(--bg-panel, #121215); border: 1px solid var(--border-color, #27272a); border-radius: var(--radius-md, 8px); padding: 14px;">
                <div style="font-size: 11px; color: var(--text-muted, #a1a1aa); text-transform: uppercase; font-weight: 600;">Running Commands</div>
                <div style="font-size: 22px; font-weight: 700; color: @(runningCount > 0 ? "var(--accent, #3b82f6)" : "var(--text-primary, #ededed)"); margin-top: 4px;">
                    @runningCount
                </div>
                <div style="font-size: 11px; color: var(--text-muted, #a1a1aa); margin-top: 2px;">Isolated Process Execution</div>
            </div>

            <div style="background: var(--bg-panel, #121215); border: 1px solid var(--border-color, #27272a); border-radius: var(--radius-md, 8px); padding: 14px;">
                <div style="font-size: 11px; color: var(--text-muted, #a1a1aa); text-transform: uppercase; font-weight: 600;">Ready for Review</div>
                <div style="font-size: 22px; font-weight: 700; color: #22c55e; margin-top: 4px;">@readyCount</div>
                <div style="font-size: 11px; color: var(--text-muted, #a1a1aa); margin-top: 2px;">Available to Merge</div>
            </div>

            <div style="background: var(--bg-panel, #121215); border: 1px solid var(--border-color, #27272a); border-radius: var(--radius-md, 8px); padding: 14px;">
                <div style="font-size: 11px; color: var(--text-muted, #a1a1aa); text-transform: uppercase; font-weight: 600;">Working Set RAM</div>
                <div style="font-size: 22px; font-weight: 700; color: var(--text-primary, #ededed); margin-top: 4px;">@totalRamMb MB</div>
                <div style="font-size: 11px; color: var(--text-muted, #a1a1aa); margin-top: 2px;">Peak Process Footprint</div>
            </div>
        </div>

        <!-- Filter & Search Controls -->
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 6px;">
                <button type="button" class="btn-subtle @(filterTab == "All" ? "active" : "")" style="padding: 6px 12px; font-size: 12px; border-radius: var(--radius-sm, 6px);" @onclick='() => filterTab = "All"'>
                    All (@sessions.Count)
                </button>
                <button type="button" class="btn-subtle @(filterTab == "Active" ? "active" : "")" style="padding: 6px 12px; font-size: 12px; border-radius: var(--radius-sm, 6px);" @onclick='() => filterTab = "Active"'>
                    Ready (@readyCount)
                </button>
                <button type="button" class="btn-subtle @(filterTab == "Running" ? "active" : "")" style="padding: 6px 12px; font-size: 12px; border-radius: var(--radius-sm, 6px);" @onclick='() => filterTab = "Running"'>
                    Running (@runningCount)
                </button>
                <button type="button" class="btn-subtle @(filterTab == "Merged" ? "active" : "")" style="padding: 6px 12px; font-size: 12px; border-radius: var(--radius-sm, 6px);" @onclick='() => filterTab = "Merged"'>
                    Merged (@mergedCount)
                </button>
            </div>

            <div style="min-width: 260px;">
                <input class="setting-input"
                       @bind="searchQuery"
                       @bind:event="oninput"
                       placeholder="Filter by ID, branch, origin chat, or task..."
                       style="font-size: 12.5px; padding: 7px 12px; width: 100%; border-radius: var(--radius-sm, 6px);" />
            </div>
        </div>

        <!-- Sandboxes List -->
        @{
            var filteredSessions = sessions.Where(s =>
            {
                if (filterTab == "Active" && s.MajorState != SandboxMajorState.Ready) return false;
                if (filterTab == "Running" && s.MajorState != SandboxMajorState.RunningCommand) return false;
                if (filterTab == "Merged" && s.MajorState != SandboxMajorState.Merged) return false;

                if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    var q = searchQuery.Trim();
                    return s.Id.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                           s.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                           s.BranchName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                           s.OriginatingChatId.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                           (s.TaskDescription != null && s.TaskDescription.Contains(q, StringComparison.OrdinalIgnoreCase));
                }
                return true;
            }).ToList();
        }

        @if (filteredSessions.Count == 0)
        {
            <div style="padding: 48px 24px; text-align: center; border: 1px dashed var(--border-color, #27272a); border-radius: var(--radius-md, 8px); background: var(--bg-panel, #121215); margin-top: 12px;">
                <div style="font-size: 32px; margin-bottom: 8px;">📦</div>
                <div style="font-size: 14px; font-weight: 600; color: var(--text-primary, #ededed);">No Sandboxes Found</div>
                <div style="font-size: 12px; color: var(--text-muted, #a1a1aa); margin-top: 4px;">
                    @(string.IsNullOrWhiteSpace(searchQuery) ? "No active worktrees matching the current filter." : "No sandboxes match your search query.")
                </div>
            </div>
        }
        else
        {
            <div style="display: flex; flex-direction: column; gap: 12px;">
                @foreach (var session in filteredSessions)
                {
                    <div style="background: var(--bg-panel, #121215); border: 1px solid var(--border-color, #27272a); border-radius: var(--radius-md, 8px); padding: 16px; display: flex; flex-direction: column; gap: 12px;">
                        <!-- Card Header -->
                        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <span style="font-size: 16px;">📦</span>
                                <div>
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <span style="font-size: 14px; font-weight: 600; color: var(--text-primary, #ededed);">
                                            @(!string.IsNullOrWhiteSpace(session.Name) ? session.Name : $"Sandbox {session.Id}")
                                        </span>
                                        <span style="font-size: 11px; font-family: monospace; color: var(--text-muted, #a1a1aa); background: var(--bg-hover, #27272a); padding: 1px 6px; border-radius: 4px;">
                                            @session.BranchName
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(session.OriginatingChatId))
                                        {
                                            <a href="/?c=@session.OriginatingChatId" style="font-size: 11px; color: var(--accent, #3b82f6); text-decoration: none; background: rgba(59, 130, 246, 0.1); padding: 1px 6px; border-radius: 4px;">
                                                Chat: @session.OriginatingChatId
                                            </a>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(session.TaskDescription))
                                    {
                                        <div style="font-size: 12px; color: var(--text-secondary, #d4d4d8); margin-top: 2px;">
                                            @session.TaskDescription
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Major State Badge -->
                            <div style="display: flex; align-items: center; gap: 8px;">
                                @switch (session.MajorState)
                                {
                                    case SandboxMajorState.RunningCommand:
                                        <span style="display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--accent, #3b82f6); font-weight: 600; background: rgba(59, 130, 246, 0.1); padding: 3px 10px; border-radius: 12px;">
                                            <span class="pulse-dot" style="width: 6px; height: 6px; border-radius: 50%; background: var(--accent, #3b82f6); animation: pulse 1s infinite;"></span>
                                            Running: @session.CurrentCommand
                                        </span>
                                        break;
                                    case SandboxMajorState.Ready:
                                        <span style="display: flex; align-items: center; gap: 6px; font-size: 12px; color: #22c55e; font-weight: 600; background: rgba(34, 197, 94, 0.1); padding: 3px 10px; border-radius: 12px;">
                                            <span style="width: 6px; height: 6px; border-radius: 50%; background: #22c55e;"></span>
                                            Ready (Idle)
                                        </span>
                                        break;
                                    case SandboxMajorState.Merged:
                                        <span style="display: flex; align-items: center; gap: 6px; font-size: 12px; color: #3b82f6; font-weight: 600; background: rgba(59, 130, 246, 0.1); padding: 3px 10px; border-radius: 12px;">
                                            Merged into @session.TargetBranch
                                        </span>
                                        break;
                                    case SandboxMajorState.Conflict:
                                        <span style="display: flex; align-items: center; gap: 6px; font-size: 12px; color: #f97316; font-weight: 600; background: rgba(249, 115, 22, 0.1); padding: 3px 10px; border-radius: 12px;">
                                            ⚠️ Merge Conflict
                                        </span>
                                        break;
                                    case SandboxMajorState.Error:
                                        <span style="display: flex; align-items: center; gap: 6px; font-size: 12px; color: #ef4444; font-weight: 600; background: rgba(239, 68, 68, 0.1); padding: 3px 10px; border-radius: 12px;">
                                            ❌ Error
                                        </span>
                                        break;
                                    default:
                                        <span style="font-size: 12px; color: var(--text-muted, #a1a1aa); background: var(--bg-hover, #27272a); padding: 3px 10px; border-radius: 12px;">
                                            @session.MajorState
                                        </span>
                                        break;
                                }
                            </div>
                        </div>

                        <!-- Card Metadata & Stats -->
                        <div style="display: flex; align-items: center; justify-content: space-between; font-size: 11.5px; color: var(--text-muted, #a1a1aa); background: var(--bg-panel-subtle, #18181b); padding: 8px 12px; border-radius: var(--radius-sm, 6px); flex-wrap: wrap; gap: 8px;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <span>📁 <strong>@session.ModifiedFiles.Count</strong> modified files</span>
                                @if (session.Insertions > 0 || session.Deletions > 0)
                                {
                                    <span style="color: #22c55e;">+@session.Insertions</span>
                                    <span style="color: #ef4444;">-@session.Deletions</span>
                                }
                                <span>🌿 Base: @session.TargetBranch</span>
                            </div>
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <span>RAM: <strong>@(session.PeakWorkingSetBytes > 0 ? $"{session.PeakWorkingSetBytes / (1024 * 1024)}MB" : "0MB")</strong></span>
                                <span>CPU: <strong>@(session.CpuTimeMs)ms</strong></span>
                                <span>Created: @session.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                            </div>
                        </div>

                        <!-- Modified Files Chips -->
                        @if (session.ModifiedFiles.Count > 0)
                        {
                            <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                                @foreach (var file in session.ModifiedFiles.Take(8))
                                {
                                    <span style="font-size: 11px; font-family: monospace; background: var(--bg-hover, #27272a); padding: 2px 8px; border-radius: 4px; color: var(--text-secondary, #d4d4d8);">
                                        @file
                                    </span>
                                }
                                @if (session.ModifiedFiles.Count > 8)
                                {
                                    <span style="font-size: 11px; color: var(--text-muted, #a1a1aa);">+@(session.ModifiedFiles.Count - 8) more</span>
                                }
                            </div>
                        }

                        <!-- Action Bar -->
                        <div style="display: flex; align-items: center; justify-content: flex-end; gap: 8px; border-top: 1px solid var(--border-color, #27272a); padding-top: 10px;">
                            @if (session.MajorState != SandboxMajorState.Disposed)
                            {
                                <button type="button" class="btn-secondary" style="margin: 0; padding: 4px 12px; font-size: 11.5px;" @onclick="() => HandlePreviewDiff(session.Id)">
                                    Review Diff
                                </button>
                                @if (session.MajorState == SandboxMajorState.Ready && session.ModifiedFiles.Count > 0)
                                {
                                    <button type="button" class="btn-primary" style="margin: 0; padding: 4px 14px; font-size: 11.5px;" @onclick="() => HandleCommitAndMerge(session.Id)">
                                        Commit & Merge
                                    </button>
                                }
                                <button type="button" class="btn-subtle" style="margin: 0; padding: 4px 8px; font-size: 11.5px; color: var(--text-danger, #ef4444);" @onclick="() => HandleCloseSandbox(session.Id)">
                                    Discard / Prune
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Simple Create Sandbox Modal -->
@if (showCreateModal)
{
    <div class="modal-backdrop" @onclick="() => showCreateModal = false">
        <div class="modal-dialog" style="max-width: 480px; border-radius: var(--radius-lg, 12px);" @onclick:stopPropagation="true">
            <div class="modal-header" style="padding: 16px 20px; border-bottom: 1px solid var(--border-color, #27272a);">
                <span class="modal-title" style="font-size: 15px; font-weight: 600;">Create Isolated Sandbox Worktree</span>
                <button class="btn-close-modal" @onclick="() => showCreateModal = false">✕</button>
            </div>
            <div class="modal-body" style="padding: 16px 20px; display: flex; flex-direction: column; gap: 12px;">
                <div class="sheet-field">
                    <label class="sheet-label">Task Name / Description</label>
                    <input class="sheet-input" @bind="newSandboxTaskName" placeholder="e.g. Auth Spike Experiment" />
                </div>
                <div class="sheet-field">
                    <label class="sheet-label">Branch Name (Optional)</label>
                    <input class="sheet-input" @bind="newSandboxBranchName" placeholder="e.g. gram/auth-spike" />
                </div>
            </div>
            <div class="modal-footer" style="padding: 12px 20px; border-top: 1px solid var(--border-color, #27272a); display: flex; justify-content: flex-end; gap: 8px;">
                <button type="button" class="btn-secondary" @onclick="() => showCreateModal = false">Cancel</button>
                <button type="button" class="btn-primary" @onclick="CreateSandbox">Create</button>
            </div>
        </div>
    </div>
}

@code {
    private string filterTab = "All";
    private string searchQuery = "";
    private bool showCreateModal = false;
    private string newSandboxTaskName = "";
    private string newSandboxBranchName = "";

    protected override void OnInitialized()
    {
        GramBox.OnSandboxStateChanged += HandleStateChanged;
        GramBox.OnStatusChanged += HandleStatusChanged;
    }

    private void HandleStateChanged(GramBoxSandboxSession session, SandboxMajorState state)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleStatusChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task CreateSandbox()
    {
        if (string.IsNullOrWhiteSpace(newSandboxTaskName))
        {
            newSandboxTaskName = "Manual Sandbox Experiment";
        }
        try
        {
            var session = await GramBox.CreateSandboxAsync(
                baseRepoPath: Environment.CurrentDirectory,
                branchName: string.IsNullOrWhiteSpace(newSandboxBranchName) ? null : newSandboxBranchName,
                taskName: newSandboxTaskName);

            SonnerService.Success("Sandbox Created", $"Worktree ready on branch '{session.BranchName}'.");
            showCreateModal = false;
            newSandboxTaskName = "";
            newSandboxBranchName = "";
        }
        catch (Exception ex)
        {
            SonnerService.Error("Creation Failed", ex.Message);
        }
    }

    private async Task HandleCommitAndMerge(string sandboxId)
    {
        var session = GramBox.GetSandbox(sandboxId);
        if (session == null) return;

        var ok = await GramBox.CommitChangesAsync($"feat: merge sandbox {session.Id}", sandboxId);
        if (ok)
        {
            SonnerService.Success("Merged", $"Sandbox '{session.Name}' changes committed successfully.");
        }
        else
        {
            SonnerService.Error("Merge Failed", "Could not commit or merge changes.");
        }
    }

    private void HandlePreviewDiff(string sandboxId)
    {
        GramBox.SelectActiveSession(sandboxId);
        Navigation.NavigateTo("/?tab=sandboxes");
    }

    private async Task HandleCloseSandbox(string sandboxId)
    {
        await GramBox.CloseSandboxAsync(sandboxId);
        SonnerService.Info("Sandbox Disposed", "Worktree pruned and released.");
    }

    public void Dispose()
    {
        GramBox.OnSandboxStateChanged -= HandleStateChanged;
        GramBox.OnStatusChanged -= HandleStatusChanged;
    }
}
