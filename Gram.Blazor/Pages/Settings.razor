            return;
        }

        if (newPasswordInput.Length < 6)
        {
            SonnerService.Error("Password too short", "New password must be at least 6 characters.");
            return;
        }

        isResettingPassword = true;
        StateHasChanged();
        try
        {
            var result = await AuthService.ResetPasswordAsync(currentPasswordInput, newPasswordInput);
            if (result.Success)
            {
                SonnerService.Success("Password updated", "Your password has been changed successfully.");
                showPasswordModal = false;
                currentPasswordInput = "";
                newPasswordInput = "";
            }
            else
