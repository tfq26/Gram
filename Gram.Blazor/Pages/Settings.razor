    private static string GetTokenCreationUrl(GitProviderType type, string instanceUrl)
    {
        var trimmed = (instanceUrl ?? "").TrimEnd('/');
        return type switch
        {
            GitProviderType.GitHub => string.IsNullOrWhiteSpace(trimmed) || trimmed.Equals("https://github.com", StringComparison.OrdinalIgnoreCase)
                ? "https://github.com/settings/tokens/new?scopes=repo,read:user,workflow&description=Gram+AI+Pair+Programmer"
                : $"{trimmed}/settings/tokens/new?scopes=repo,read:user,workflow&description=Gram+AI+Pair+Programmer",
            GitProviderType.GitLab => string.IsNullOrWhiteSpace(trimmed) || trimmed.Equals("https://gitlab.com", StringComparison.OrdinalIgnoreCase)
                ? "https://gitlab.com/-/user_settings/personal_access_tokens?name=Gram+AI+Pair+Programmer&scopes=api,read_user,read_repository,write_repository"
                : $"{trimmed}/-/user_settings/personal_access_tokens?name=Gram+AI+Pair+Programmer&scopes=api,read_user,read_repository,write_repository",
            GitProviderType.Forgejo => string.IsNullOrWhiteSpace(trimmed) || trimmed.Equals("https://codeberg.org", StringComparison.OrdinalIgnoreCase)
                ? "https://codeberg.org/user/settings/applications"
                : $"{trimmed}/user/settings/applications",
            GitProviderType.Bitbucket => "https://bitbucket.org/account/settings/app-passwords/",
            _ => "https://github.com/settings/tokens"
        };
    }

    private static string GetTokenPlaceholder(GitProviderType type)
    {
        return type switch
        {
            GitProviderType.GitHub => "ghp_... or github_pat_...",
            GitProviderType.GitLab => "glpat-...",
