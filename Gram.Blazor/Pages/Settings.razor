    private async Task LoadAudioDevicesAsync()
    {
        try
        {
            audioDevices = await JSRuntime.InvokeAsync<List<AudioDeviceInfo>>("gramAudio.getAudioDevices") ?? new();
            selectedAudioInputDeviceId = SettingsService.GetSetting("selectedAudioInputDeviceId", "");
            selectedAudioOutputDeviceId = SettingsService.GetSetting("selectedAudioOutputDeviceId", "");
            if (int.TryParse(SettingsService.GetSetting("inputVolume", "100"), out var inVol)) inputVolume = inVol;
            if (int.TryParse(SettingsService.GetSetting("outputVolume", "100"), out var outVol)) outputVolume = outVol;
            autoSensitivity = SettingsService.GetSetting("autoSensitivity", "true") == "true";
            if (int.TryParse(SettingsService.GetSetting("sensitivityThreshold", "20"), out var thresh)) sensitivityThreshold = thresh;
            echoCancellation = SettingsService.GetSetting("echoCancellation", "true") == "true";
            noiseSuppression = SettingsService.GetSetting("noiseSuppression", "true") == "true";
            autoGainControl = SettingsService.GetSetting("autoGainControl", "true") == "true";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Settings] LoadAudioDevices error: {ex.Message}");
        }
    }

