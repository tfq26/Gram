    {
        customInstructions = "• Always provide clean, production-ready code with concise explanations.\n• Prioritize modern C# (.NET 9) and TypeScript best practices.\n• Keep responses direct and minimize conversational filler.";
        MarkDirty();
    }

    private void OnBeforeNavigation(LocationChangingContext context)
    {
        if (IsDirty)
        {
            // Changes unsaved
        }
    }

    private void OnServiceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SettingsService.OnChange -= OnServiceChanged;
        ModelService.OnChange -= OnServiceChanged;
        ThemeService.OnChange -= OnServiceChanged;
    }
}
