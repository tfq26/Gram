@page "/settings"
@rendermode InteractiveServer
@using Gram.Blazor.Shared
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@inject ThemeService ThemeService
@inject ModelService ModelService
@inject SettingsService SettingsService
@inject StorageService StorageService
@inject ISonnerService SonnerService
@inject IAuthService AuthService
@inject IQuotaTracker QuotaTracker
@inject IConnectorRegistry ConnectorRegistry
@inject IConnectorConnectionStore ConnectorConnectionStore
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Settings · Gram</PageTitle>

<NavigationLock OnBeforeInternalNavigation="OnBeforeNavigation" ConfirmExternalNavigation="@IsDirty" />

<div class="settings-layout">
    <aside class="settings-sidebar">
        <div class="settings-sidebar-body">
            <!-- Back to Chat Link -->
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                <a href="/" class="mobile-back-to-chat-btn" style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--text-secondary);">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                    <span>Back to Chat</span>
                </a>
                <span style="font-size: 10px; font-family: var(--font-mono); color: var(--text-muted); text-transform: uppercase;">Web App</span>
            </div>

            <!-- Search -->
            <div class="settings-search-box">
                <input class="settings-search-input" @bind="searchQuery" @bind:event="oninput" placeholder="Search settings..." />
            </div>

            <!-- Navigation Links -->
            <nav class="settings-nav-list">
                @if (MatchesSearch("General assistant persona tone voice audio"))
                {
                    <button type="button" class="settings-nav-item @(activeCategory == "General" ? "active" : "")"
                            @onclick='() => SelectCategory("General")'>
                        <span class="nav-label">General & Voice</span>
                    </button>
                }

                @if (MatchesSearch("Models providers api keys intelligence context length byok"))
                {
                    <button type="button" class="settings-nav-item @(activeCategory == "Models" ? "active" : "")"
                            @onclick='() => SelectCategory("Models")'>
                        <span class="nav-label">Models & Providers</span>
                        <span class="setting-hint" style="font-size: 11px;">@ModelService.Models.Count</span>
                    </button>
                }

                @if (MatchesSearch("Prompts system prompt custom instructions guidelines rules"))
                {
                    <button type="button" class="settings-nav-item @(activeCategory == "Prompts" ? "active" : "")"
                            @onclick='() => SelectCategory("Prompts")'>
                        <span class="nav-label">Prompts & Instructions</span>
                    </button>
                }

                @if (MatchesSearch("Themes appearance colors palette dark light"))
                {
                    <button type="button" class="settings-nav-item @(activeCategory == "Themes" ? "active" : "")"
                            @onclick='() => SelectCategory("Themes")'>
                        <span class="nav-label">Appearance & Themes</span>
                    </button>
                }

                @if (MatchesSearch("Quota usage tokens requests limits rate"))
                {
                    <button type="button" class="settings-nav-item @(activeCategory == "Quota" ? "active" : "")"
                            @onclick='() => SelectCategory("Quota")'>
                        <span class="nav-label">Quota & Usage</span>
                    </button>
                }

                @if (MatchesSearch("Account security password profile auth memory"))
                {
                    <button type="button" class="settings-nav-item @(activeCategory == "Account" ? "active" : "")"
                            @onclick='() => SelectCategory("Account")'>
                        <span class="nav-label">Account & Personalization</span>
                    </button>
                    <a class="settings-nav-item" href="/memory" style="text-decoration: none;">Memory</a>
                }

                @if (MatchesSearch("Connections connectors spotify postman home assistant mcp browser"))
                {
                    <button type="button" class="settings-nav-item @(activeCategory == "Connectors" ? "active" : "")" @onclick='() => SelectCategory("Connectors")'>
                        <span class="nav-label">Connections · Connectors</span>
                        <span class="setting-hint" style="font-size: 11px;">@connectors.Count</span>
                    </button>
                }

                @if (MatchesSearch("About gram version author 2helix license"))
                {
                    <button type="button" class="settings-nav-item @(activeCategory == "About" ? "active" : "")"
                            @onclick='() => SelectCategory("About")'>
                        <span class="nav-label">About Gram</span>
                    </button>
                }
            </nav>
        </div>

        <div class="settings-sidebar-footer">
            <button class="btn-sidebar-save @(isSaved ? "saved" : "")"
                    disabled="@(!IsDirty && !isSaved)"
                    @onclick="SaveSettings">
                @(isSaved ? "✓ Saved" : "Save changes")
            </button>
        </div>
    </aside>

    <main class="settings-main">
        <section class="settings-content-area">

        @if (activeCategory == "General")
        {
            <div class="settings-header" style="margin-bottom: 20px;">
                <h2 class="settings-section-title">General & Voice Settings</h2>
                <p class="settings-section-desc">Personalize your web assistant's identity, communication style, and speech input settings.</p>
            </div>

            <div class="settings-group">
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Assistant name</span>
                        <span class="setting-desc">The name Gram introduces itself with.</span>
                    </div>
                    <div class="setting-control">
                        <input class="setting-input" @bind="assistantName" @bind:event="oninput" @bind:after="MarkDirty" />
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Persona & tone</span>
                        <span class="setting-desc">Default behavioral style and communication format.</span>
                    </div>
                    <div class="setting-control">
                        <select class="setting-select" @bind="personaTone" @bind:after="MarkDirty">
                            <option value="concise">Concise & Pragmatic</option>
                            <option value="programmer">Technical Pair Programmer</option>
                            <option value="minimalist">Strict Minimalist (Direct answers)</option>
                            <option value="creative">Creative & Analytical</option>
                        </select>
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Auto-send on silence</span>
                        <span class="setting-desc">Automatically submit voice transcription when you pause speaking.</span>
                    </div>
                    <div class="setting-control">
                        <label class="setting-toggle">
                            <input type="checkbox" class="setting-checkbox" @bind="autoSendVoice" @bind:after="MarkDirty" />
                            <span class="setting-desc">@(autoSendVoice ? "Enabled" : "Disabled")</span>
                        </label>
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Audio chime feedback</span>
                        <span class="setting-desc">Play soft acoustic feedback when voice transcription starts and finishes.</span>
                    </div>
                    <div class="setting-control">
                        <label class="setting-toggle">
                            <input type="checkbox" class="setting-checkbox" @bind="playVoiceChime" @bind:after="MarkDirty" />
                            <span class="setting-desc">@(playVoiceChime ? "Enabled" : "Disabled")</span>
                        </label>
                    </div>
                </div>
            </div>
        }
        else if (activeCategory == "Models")
        {
            <div class="settings-header" style="margin-bottom: 20px;">
                <h2 class="settings-section-title">Models & Provider Keys</h2>
                <p class="settings-section-desc">Manage installed models, toggle favorites, and supply Bring-Your-Own-Key (BYOK) provider credentials.</p>
            </div>

            <!-- Provider API Keys Accordion / Cards -->
            <h3 style="font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin: 0 0 10px 0;">Connected Providers</h3>
            <div class="settings-group" style="margin-bottom: 24px;">
                @foreach (var provider in ModelService.Providers)
                {
                    var pHealth = ModelService.GetHealth(provider.Id);
                    var hasKey = ModelService.HasUserKey(provider.Id);
                    var isSys = ModelService.IsSystemManaged(provider.Id);
                    var isTesting = testingProviders.Contains(provider.Id);

                    <div class="setting-item">
                        <div class="setting-info">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span class="setting-title">@provider.Name</span>
                                @if (isTesting)
                                {
                                    <span class="provider-status checking">Testing...</span>
                                }
                                else if (hasKey)
                                {
                                    <span class="provider-status connected">BYOK Active</span>
                                }
                                else if (isSys)
                                {
                                    <span class="provider-status system">System Included</span>
                                }
                                else
                                {
                                    <span class="provider-status disconnected">Not Configured</span>
                                }
                            </div>
                            <span class="setting-desc">@(provider.BaseUrl ?? "Default API Endpoint")</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <button type="button" class="btn-secondary" style="margin: 0; font-size: 11px;" @onclick="() => OpenProviderModal(provider)">
                                Configure Key
                            </button>
                            <button type="button" class="btn-secondary" style="margin: 0; font-size: 11px;" @onclick="() => CheckProviderHealth(provider.Id)" disabled="@isTesting">
                                Ping
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- Models List -->
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
                <h3 style="font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin: 0;">Installed Models</h3>
                <input class="setting-input" style="width: 200px; padding: 4px 8px; font-size: 11.5px;" placeholder="Filter models..." @bind="modelSearch" @bind:event="oninput" />
            </div>

            <div class="models-list">
                @foreach (var model in FilteredModels)
                {
                    <div class="model-item">
                        <div class="model-item-left">
                            <button type="button" class="star-btn @(model.IsFavorite ? "active" : "")"
                                    @onclick="() => ModelService.ToggleFavorite(model.Id)"
                                    title="@(model.IsFavorite ? "Remove favorite" : "Add to favorites")">
                                @(model.IsFavorite ? "★" : "☆")
                            </button>
                            <div class="model-info-block">
                                <div class="model-title-row">
                                    <span class="model-name">@model.Name</span>
                                    <span class="model-provider-badge">@model.Provider</span>
                                    @if (model.ContextLength.HasValue)
                                    {
                                        <span class="setting-hint">
                                            @(model.ContextLength.Value >= 1000000 ? $"{model.ContextLength.Value / 1000000}M" : model.ContextLength.Value >= 1000 ? $"{model.ContextLength.Value / 1000}k" : $"{model.ContextLength.Value}")
                                        </span>
                                    }
                                </div>
                                <span class="model-id-badge">@model.Id</span>
                            </div>
                        </div>

                        <div class="model-item-right">
                            <button type="button" class="btn-remove-model" @onclick="() => ModelService.RemoveModel(model.Id)" title="Remove model">✕</button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (activeCategory == "Prompts")
        {
            <div class="settings-header" style="margin-bottom: 20px;">
                <h2 class="settings-section-title">Prompts & Custom Instructions</h2>
                <p class="settings-section-desc">View the foundational operating instructions and add personal behavioral preferences.</p>
            </div>

            <div class="settings-group">
                <!-- Base System Prompt View -->
                <div class="setting-item" style="flex-direction: column; align-items: stretch; gap: 10px;">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div class="setting-info">
                            <span class="setting-title">Core System Prompt (v@(GramSystemPrompt.Version))</span>
                            <span class="setting-desc">Root behavioral instruction set governing model reasoning and output standards.</span>
                        </div>
                        <button type="button" class="btn-secondary" style="margin: 0;" @onclick="CopyBasePrompt">Copy</button>
                    </div>
                    <pre style="background: var(--bg-panel-subtle); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 12px; font-size: 11px; max-height: 180px; overflow-y: auto; white-space: pre-wrap; margin: 0; color: var(--text-secondary);">@GramSystemPrompt.DefaultBasePrompt</pre>
                </div>

                <!-- Custom User Instructions -->
                <div class="setting-item" style="flex-direction: column; align-items: stretch; gap: 10px;">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div class="setting-info">
                            <span class="setting-title">Custom User Instructions</span>
                            <span class="setting-desc">Additional personal preferences layered on top of the base system prompt.</span>
                        </div>
                        <button type="button" class="btn-secondary" style="margin: 0;" @onclick="InsertSampleInstructions">Insert Template</button>
                    </div>
                    <textarea class="setting-textarea"
                              rows="6"
                              placeholder="Provide optional personal instructions layered on top of the base prompt...&#10;&#10;Examples:&#10;• Always provide clean, production-ready code with concise explanations.&#10;• Prioritize modern C# (.NET 9) and TypeScript best practices.&#10;• Keep responses direct and minimize conversational filler."
                              @bind="customInstructions"
                              @bind:event="oninput"
                              @bind:after="MarkDirty"></textarea>
                    <span style="font-size: 11px; color: var(--text-muted);">@customInstructions.Length characters</span>
                </div>
            </div>
        }
        else if (activeCategory == "Themes")
        {
            <div class="settings-header" style="margin-bottom: 20px;">
                <h2 class="settings-section-title">Appearance & Color Themes</h2>
                <p class="settings-section-desc">Select an interface palette for your web workspace.</p>
            </div>

            <div class="theme-list">
                @foreach (var entry in ThemeService.CatalogThemes)
                {
                    var isSelected = ThemeService.ActiveThemeName.Equals(entry.Key, StringComparison.OrdinalIgnoreCase);
                    <div class="theme-row @(isSelected ? "selected" : "")"
                         @onclick="() => ThemeService.SelectCatalogTheme(entry.Key)">
                        <div class="theme-row-left">
                            <span class="theme-radio-dot"></span>
                            <div class="theme-row-info">
                                <span class="theme-row-name">@entry.Key</span>
                            </div>
                        </div>
                        <div class="theme-swatches">
                            @foreach (var color in entry.Value.ToArray())
                            {
                                <span class="swatch-dot" style="background-color: @color;" title="@color"></span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else if (activeCategory == "Quota")
        {
            <div class="settings-header" style="margin-bottom: 20px;">
                <h2 class="settings-section-title">Model Quota & Usage</h2>
                <p class="settings-section-desc">Track observed token consumption and provider rate limits.</p>
            </div>

            <div class="settings-group">
                @if (QuotaTracker.GetSnapshots().Count == 0)
                {
                    <div class="setting-item">
                        <div class="setting-info">
                            <span class="setting-desc">No model requests have been observed in this session yet.</span>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var snapshot in QuotaTracker.GetSnapshots())
                    {
                        <div class="setting-item quota-setting-item">
                            <div class="setting-info">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span class="setting-title">@snapshot.Model</span>
                                    <span class="provider-status @(snapshot.Scope == "system" ? "system" : "connected")">@(snapshot.Scope == "system" ? "System" : "BYOK")</span>
                                </div>
                                <span class="setting-desc">@snapshot.Provider · @snapshot.ObservedRequests observed request(s)</span>
                                @if (snapshot.ObservedInputTokens > 0 || snapshot.ObservedOutputTokens > 0)
                                {
                                    <span class="setting-desc">Tokens: @snapshot.ObservedInputTokens.ToString("N0") in · @snapshot.ObservedOutputTokens.ToString("N0") out</span>
                                }
                            </div>
                            <div style="font-size: 12.5px; font-weight: 600;">
                                @if (snapshot.RemainingPercent.HasValue)
                                {
                                    <span>@snapshot.RemainingPercent% remaining</span>
                                }
                                else
                                {
                                    <span style="color: var(--text-muted);">Active</span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        }
        else if (activeCategory == "Connectors")
        {
            <div class="settings-header" style="margin-bottom: 20px;"><h2 class="settings-section-title">Connectors</h2><p class="settings-section-desc">Services Gram can use through shared, permission-aware actions.</p></div>
            <div class="settings-group">
                @foreach (var connector in connectors)
                {
                    var connection = connectorConnections.FirstOrDefault(c => c.ConnectorId.Equals(connector.Id, StringComparison.OrdinalIgnoreCase) && c.IsConnected);
                    <div class="setting-item">
                        <div class="setting-info"><span class="setting-title">@connector.Name</span><span class="setting-desc">@connector.Description</span></div>
                        <div class="setting-control"><span class="provider-status @(connection != null ? "connected" : connector.IsEnabled ? "system" : "")">@(connection != null ? "Connected" : connector.IsEnabled ? "Available" : "Experimental")</span></div>
                    </div>
                }
            </div>
        }
        else if (activeCategory == "Account")
        {
            <div class="settings-header" style="margin-bottom: 20px;">
                <h2 class="settings-section-title">Account & Personalization</h2>
                <p class="settings-section-desc">User authentication and personalized agent memory management.</p>
            </div>

            <div class="settings-group">
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Structured Long-Term Memory</span>
                        <span class="setting-desc">Gram remembers key facts, preferences, and workspace context across sessions.</span>
                    </div>
                    <div class="setting-control">
                        <a href="/memory" class="btn-secondary" style="text-decoration: none; font-size: 11.5px;">
                            Review Memories ↗
                        </a>
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">User Authentication</span>
                        <span class="setting-desc">Manage credentials and authenticated session scope.</span>
                    </div>
                    <div class="setting-control">
                        <span class="provider-status connected">Active</span>
                    </div>
                </div>
            </div>
        }
        else if (activeCategory == "About")
        {
            <div class="settings-header" style="margin-bottom: 20px;">
                <h2 class="settings-section-title">About Gram</h2>
                <p class="settings-section-desc">Modular intelligence shell and autonomous workspace platform.</p>
            </div>

            <div class="settings-group">
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Gram Web Edition</span>
                        <span class="setting-desc">Blazor InteractiveServer (.NET 9.0)</span>
                    </div>
                    <div class="setting-control">
                        <span class="setting-value">v1.0.0</span>
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Lead Architect</span>
                        <span class="setting-desc">System design and engineering</span>
                    </div>
                    <div class="setting-control">
                        <span style="font-weight: 600; color: var(--text-primary);">Taufeeq Ali</span>
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Brand & Organization</span>
                        <span class="setting-desc">Company ownership</span>
                    </div>
                    <div class="setting-control">
                        <a href="https://2helix.com" target="_blank" class="link-action" style="font-weight: 600;">
                            2Helix ↗
                        </a>
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Privacy Policy & Terms</span>
                        <span class="setting-desc">Data handling and terms of service</span>
                    </div>
                    <div class="setting-control" style="display: flex; gap: 12px;">
                        <a href="https://2helix.com/privacy" target="_blank" class="link-action">Privacy ↗</a>
                        <a href="https://2helix.com/terms" target="_blank" class="link-action">Terms ↗</a>
                    </div>
                </div>
            </div>
        }

        </section>
    </main>
</div>

<!-- In-Page Provider Config Modal for Web -->
@if (editingProvider != null)
{
    <div class="modal-backdrop" @onclick="() => editingProvider = null">
        <div class="modal-dialog" style="max-width: 440px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <span class="modal-title">Configure @editingProvider.Name</span>
                <button type="button" class="btn-close-modal" @onclick="() => editingProvider = null">✕</button>
            </div>
            <div class="modal-body" style="padding: 18px 20px; display: flex; flex-direction: column; gap: 14px;">
                <div class="sheet-field">
                    <label class="sheet-label">API Key</label>
                    <input type="password" class="sheet-input" @bind="providerKeyInput" placeholder="sk-..." />
                    <span style="font-size: 11px; color: var(--text-muted); margin-top: 4px; display: block;">
                        Your key is encrypted locally on the server.
                    </span>
                </div>
                <div class="sheet-field">
                    <label class="sheet-label">Base URL (Optional)</label>
                    <input type="text" class="sheet-input" @bind="providerBaseUrlInput" placeholder="https://..." />
                </div>
            </div>
            <div class="modal-footer" style="display: flex; justify-content: flex-end; gap: 8px; padding: 12px 18px; border-top: 1px solid var(--border-color);">
                <button type="button" class="btn-secondary" style="margin: 0;" @onclick="() => editingProvider = null">Cancel</button>
                <button type="button" class="btn-primary" style="margin: 0;" @onclick="SaveProviderConfig">Save Key</button>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "category")]
    public string? CategoryQuery { get; set; }

    private string activeCategory = "General";
    private string searchQuery = "";
    private bool isSaved = false;

    // Form fields
    private string assistantName = "Gram";
    private string personaTone = "concise";
    private bool autoSendVoice = true;
    private bool playVoiceChime = true;
    private string customInstructions = "";

    // Models tab state
    private string modelSearch = "";
    private ProviderConfig? editingProvider = null;
    private string providerKeyInput = "";
    private string providerBaseUrlInput = "";
    private HashSet<string> testingProviders = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<ConnectorDescriptor> connectors = Array.Empty<ConnectorDescriptor>();
    private IReadOnlyList<ConnectorConnection> connectorConnections = Array.Empty<ConnectorConnection>();

    private bool IsDirty =>
        assistantName != SettingsService.GetSetting("assistantName", "Gram") ||
        personaTone != SettingsService.GetSetting("personaTone", "concise") ||
        autoSendVoice != (bool.TryParse(SettingsService.GetSetting("autoSendVoice", "true"), out var b1) && b1) ||
        playVoiceChime != (bool.TryParse(SettingsService.GetSetting("playVoiceChime", "true"), out var b2) && b2) ||
        customInstructions != SettingsService.GetSetting("customInstructions", "");

    protected override void OnInitialized()
    {
        LoadSettingsData();
        SettingsService.OnChange += OnServiceChanged;
        ModelService.OnChange += OnServiceChanged;
        ThemeService.OnChange += OnServiceChanged;
        connectors = ConnectorRegistry.ListConnectors();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            connectorConnections = await ConnectorConnectionStore.ListAsync(user?.Id ?? "default");
        }
        catch { }
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(CategoryQuery) && CategoryQuery != activeCategory && !IsDirty)
        {
            activeCategory = CategoryQuery;
        }
    }

    private void LoadSettingsData()
    {
        assistantName = SettingsService.GetSetting("assistantName", "Gram");
        personaTone = SettingsService.GetSetting("personaTone", "concise");
        autoSendVoice = bool.TryParse(SettingsService.GetSetting("autoSendVoice", "true"), out var b1) && b1;
        playVoiceChime = bool.TryParse(SettingsService.GetSetting("playVoiceChime", "true"), out var b2) && b2;
        customInstructions = SettingsService.GetSetting("customInstructions", "");
        isSaved = false;
    }

    private void MarkDirty()
    {
        isSaved = false;
    }

    private void SaveSettings()
    {
        SettingsService.SetSetting("assistantName", assistantName);
        SettingsService.SetSetting("personaTone", personaTone);
        SettingsService.SetSetting("autoSendVoice", autoSendVoice.ToString().ToLowerInvariant());
        SettingsService.SetSetting("playVoiceChime", playVoiceChime.ToString().ToLowerInvariant());
        SettingsService.SetSetting("customInstructions", customInstructions);
        SettingsService.SaveSettings();

        isSaved = true;
        SonnerService.Success("Settings saved", "Your preferences have been updated.");
    }

    private void SelectCategory(string category)
    {
        activeCategory = category;
    }

    private bool MatchesSearch(string keywords)
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return true;
        return keywords.Contains(searchQuery.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private IEnumerable<GramModel> FilteredModels
    {
        get
        {
            var list = ModelService.Models.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(modelSearch))
            {
                var q = modelSearch.Trim();
                list = list.Where(m => m.Name.Contains(q, StringComparison.OrdinalIgnoreCase) || m.Id.Contains(q, StringComparison.OrdinalIgnoreCase));
            }
            return list;
        }
    }

    private void OpenProviderModal(ProviderConfig provider)
    {
        editingProvider = provider;
        providerKeyInput = "";
        providerBaseUrlInput = provider.BaseUrl ?? "";
    }

    private void SaveProviderConfig()
    {
        if (editingProvider == null) return;
        ModelService.UpdateProvider(editingProvider.Id, providerBaseUrlInput, string.IsNullOrWhiteSpace(providerKeyInput) ? null : providerKeyInput.Trim());
        SonnerService.Success("Provider updated", $"Saved credentials for {editingProvider.Name}");
        editingProvider = null;
    }

    private async Task CheckProviderHealth(string providerId)
    {
        testingProviders.Add(providerId);
        StateHasChanged();
        try
        {
            await ModelService.CheckProviderHealthAsync(providerId);
            SonnerService.Success("Health check completed", $"Provider {providerId} responded.");
        }
        catch (Exception ex)
        {
            SonnerService.Error("Health check failed", ex.Message);
        }
        finally
        {
            testingProviders.Remove(providerId);
            StateHasChanged();
        }
    }

    private async Task CopyBasePrompt()
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", GramSystemPrompt.DefaultBasePrompt);
        SonnerService.Success("Copied", "Base system prompt copied to clipboard.");
    }

