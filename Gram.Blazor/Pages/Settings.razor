        }
        catch (Exception ex)
        {
            SonnerService.Error("Error removing passkey", ex.Message);
        }
    }

    private async Task HandlePasswordReset()
    {
        if (string.IsNullOrWhiteSpace(currentPasswordInput) || string.IsNullOrWhiteSpace(newPasswordInput))
        {
