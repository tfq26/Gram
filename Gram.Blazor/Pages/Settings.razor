@page "/settings"
@rendermode InteractiveServer
@using Gram.Blazor.Shared
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@inject ThemeService ThemeService
@inject ModelService ModelService
@inject SettingsService SettingsService
@inject StorageService StorageService
@inject GitService GitService
@inject ISonnerService SonnerService
@inject IAuthService AuthService
@inject ToolboxManagerService ToolboxService
@inject IQuotaTracker QuotaTracker
@inject AgentSecurityService SecurityService
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@inject WorkspaceTabService TabService
@implements IDisposable

<PageTitle>Settings · Gram</PageTitle>

<NavigationLock OnBeforeInternalNavigation="OnBeforeNavigation" ConfirmExternalNavigation="@IsDirty" />

<div class="settings-layout @(showMobileSubpage ? "mobile-view-subpage" : "mobile-view-menu")">
    <aside class="settings-sidebar">
        <div class="settings-sidebar-body">
            <!-- Mobile Navigation Bar back to Chat -->
            <div class="mobile-settings-header">
                <a href="/" class="mobile-back-to-chat-btn">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                    <span>Chat</span>
                </a>
                <span class="mobile-settings-header-title">Settings</span>
            </div>

            <div class="settings-search-box">
                <input class="settings-search-input" @bind="search" @bind:event="oninput" placeholder="Search settings..." />
            </div>

            <nav class="settings-nav-list">
                <!-- General -->
                <button class="settings-nav-item @(activeCategory == "General" ? "active" : "")"
                        @onclick='() => SelectCategory("General")'>
                    <span class="nav-label">General</span>
                </button>

                <!-- Intelligence (Collapsible Category) -->
                <div class="settings-nav-group">
                    <button class="settings-nav-item @(activeCategory.StartsWith("Intelligence") ? "active" : "")"
                            @onclick="ToggleIntelligenceExpanded">
                        <span class="nav-label">Intelligence</span>
                        <svg class="nav-chevron @(intelligenceExpanded ? "expanded" : "")" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>

                    @if (intelligenceExpanded)
                    {
                        <div class="settings-nav-sublist">
                            <button class="settings-nav-subitem @(activeCategory == "Intelligence/Models" ? "active" : "")"
                                    @onclick='() => SelectCategory("Intelligence/Models")'>
                                <span>Models</span>
                                <span class="setting-hint" style="font-size: 11px;">@ModelService.Models.Count</span>
                            </button>

                            <button class="settings-nav-subitem @(activeCategory == "Intelligence/Providers" ? "active" : "")"
                                    @onclick='() => SelectCategory("Intelligence/Providers")'>
                                <span>Providers</span>
                            </button>

                            <button class="settings-nav-subitem @(activeCategory == "Intelligence/Quota" ? "active" : "")"
                                    @onclick='() => SelectCategory("Intelligence/Quota")'>
                                <span>Quota & Usage</span>
                            </button>

                            @if (SettingsService.IsFeatureSupported("localMcpServers"))
                            {
                                <button class="settings-nav-subitem @(activeCategory == "Intelligence/MCP" ? "active" : "")"
                                        @onclick='() => SelectCategory("Intelligence/MCP")'>
                                    <span>MCP Tools</span>
                                </button>
                            }

                            <button class="settings-nav-subitem @(activeCategory == "Intelligence/Tools" ? "active" : "")"
                                    @onclick='() => SelectCategory("Intelligence/Tools")'>
                                <span>Tools & Plugins</span>
                            </button>

                            <button class="settings-nav-subitem @(activeCategory == "Intelligence/Skills" ? "active" : "")"
                                    @onclick='() => SelectCategory("Intelligence/Skills")'>
                                <span>Prompts & Skills</span>
                            </button>
                        </div>
                    }
                </div>

                <!-- Themes -->
                <button class="settings-nav-item @(activeCategory == "Themes" ? "active" : "")"
                        @onclick='() => SelectCategory("Themes")'>
                    <span class="nav-label">Themes</span>
                </button>

                <!-- Toolbox & Extensions Hub -->
                <button class="settings-nav-item @(activeCategory == "Toolbox" ? "active" : "")"
                        @onclick='() => SelectCategory("Toolbox")'>
                    <span class="nav-label">Toolbox & CDE</span>
                    <span class="setting-hint" style="font-size: 11px;">@ToolboxService.InstalledTools.Count</span>
                </button>

                <!-- Account (Collapsible Category) -->
                <div class="settings-nav-group">
                    <button class="settings-nav-item @(activeCategory.StartsWith("Account") || activeCategory == "Auth" || activeCategory == "Audio" || activeCategory == "Git" ? "active" : "")"
                            @onclick="ToggleAccountExpanded">
                        <span class="nav-label">Account</span>
                        <svg class="nav-chevron @(accountExpanded ? "expanded" : "")" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>

                    @if (accountExpanded)
                    {
                        <div class="settings-nav-sublist">
                            <button class="settings-nav-subitem @(activeCategory == "Account/Auth" || activeCategory == "Auth" ? "active" : "")"
                                    @onclick='() => SelectCategory("Account/Auth")'>
                                <span>Profile & Security</span>
                            </button>

                            <button class="settings-nav-subitem @(activeCategory == "Account/Audio" || activeCategory == "Audio" ? "active" : "")"
                                    @onclick='() => SelectCategory("Account/Audio")'>
                                <span>Audio & Voice</span>
                            </button>

                            <button class="settings-nav-subitem @(activeCategory == "Account/Git" || activeCategory == "Git" ? "active" : "")"
                                    @onclick='() => SelectCategory("Account/Git")'>
                                <span>Git & Version Control</span>
                                @if (GitService.Accounts.Count > 0)
                                {
                                    <span class="setting-hint" style="font-size: 11px;">@GitService.Accounts.Count</span>
                                }
                            </button>
                        </div>
                    }
                </div>

                <!-- Logs -->
                <button class="settings-nav-item @(activeCategory == "Logs" ? "active" : "")"
                        @onclick='() => SelectCategory("Logs")'>
                    <span class="nav-label">System Logs</span>
                </button>

                <!-- About (Always available in all environments) -->
                <button class="settings-nav-item @(activeCategory == "About" ? "active" : "")"
                        @onclick='() => SelectCategory("About")'>
                    <span class="nav-label">About Gram</span>
                </button>
            </nav>
        </div>

        <div class="settings-sidebar-footer">
            <button class="btn-sidebar-save @(isSaved ? "saved" : "")"
                    disabled="@(!IsDirty && !isSaved)"
                    @onclick="SaveSettings">
                @(isSaved ? "Saved" : "Save changes")
            </button>
        </div>
    </aside>

    <main class="settings-main">
        <!-- Mobile Back Bar for Full-Screen Subpages -->
        <div class="mobile-settings-back-bar">
            <button class="mobile-back-btn" @onclick="() => showMobileSubpage = false">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
                <span>All Settings</span>
            </button>
            <span class="mobile-subpage-title">@GetCategoryDisplayName(activeCategory)</span>
        </div>

        <section class="settings-content-area">

        @if (activeCategory == "General")
        {
            <!-- General Settings View -->
            <div class="settings-group">
                <!-- Assistant Identity -->
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Assistant name</span>
                        <span class="setting-desc">The name Gram introduces itself with.</span>
                    </div>
                    <div class="setting-control">
                        <input class="setting-input" @bind="assistantName" @bind:event="oninput" />
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Persona & tone</span>
                        <span class="setting-desc">Default behavioral style and communication format.</span>
                    </div>
                    <div class="setting-control">
                        <select class="setting-select" @bind="personaTone">
                            <option value="concise">Concise & Pragmatic</option>
                            <option value="programmer">Technical Pair Programmer</option>
                            <option value="minimalist">Strict Minimalist (Direct answers)</option>
                            <option value="creative">Creative & Analytical</option>
                        </select>
                    </div>
                </div>

                <!-- Wake Word (Desktop Only) -->
                @if (SettingsService.IsFeatureSupported("wakeWord"))
                {
                    <div class="setting-item">
                        <div class="setting-info">
                            <span class="setting-title">Wake word phrase</span>
                            <span class="setting-desc">Spoken phrase that triggers hands-free listening.</span>
                        </div>
                        <div class="setting-control">
                            <input class="setting-input" @bind="wakeWord" @bind:event="oninput" placeholder="Hey Gram" />
                        </div>
                    </div>

                    <div class="setting-item">
                        <div class="setting-info">
                            <span class="setting-title">Hands-free wake word listening</span>
                            <span class="setting-desc">Continuously detect your wake word when Gram is in the background.</span>
                        </div>
                        <div class="setting-control">
                            <label class="setting-toggle">
                                <input type="checkbox" class="setting-checkbox" @bind="enableWakeWord" />
                                <span class="setting-desc">@(enableWakeWord ? "Enabled" : "Disabled")</span>
                            </label>
                        </div>
                    </div>
                }

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Auto-send on silence</span>
                        <span class="setting-desc">Automatically submit voice transcription after you stop speaking.</span>
                    </div>
                    <div class="setting-control">
                        <label class="setting-toggle">
                            <input type="checkbox" class="setting-checkbox" @bind="autoSendVoice" />
                            <span class="setting-desc">@(autoSendVoice ? "Enabled" : "Disabled")</span>
                        </label>
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Audio chime feedback</span>
                        <span class="setting-desc">Play a soft chime when voice recording starts and finishes.</span>
                    </div>
                    <div class="setting-control">
                        <label class="setting-toggle">
                            <input type="checkbox" class="setting-checkbox" @bind="playVoiceChime" />
                            <span class="setting-desc">@(playVoiceChime ? "Enabled" : "Disabled")</span>
                        </label>
                    </div>
                </div>

                <!-- App & Desktop Hotkeys (Desktop Only) -->
                @if (SettingsService.IsFeatureSupported("globalHotkey"))
                {
                    <div class="setting-item">
                        <div class="setting-info">
                            <span class="setting-title">Global summon hotkey</span>
                            <span class="setting-desc">Keyboard shortcut to bring Gram forward from any application.</span>
                        </div>
                        <div class="setting-control">
                            <input class="setting-input" @bind="globalHotkey" @bind:event="oninput" placeholder="Alt + Space" />
                        </div>
                    </div>
                }

                @if (SettingsService.IsFeatureSupported("systemStartup"))
                {
                    <div class="setting-item">
                        <div class="setting-info">
                            <span class="setting-title">Run at system startup</span>
                            <span class="setting-desc">Launch Gram minimized in the background on login.</span>
                        </div>
                        <div class="setting-control">
                            <label class="setting-toggle">
                                <input type="checkbox" class="setting-checkbox" @bind="startAtLogin" />
                                <span class="setting-desc">@(startAtLogin ? "Enabled" : "Disabled")</span>
                            </label>
                        </div>
                    </div>
                }

                @if (SettingsService.IsFeatureSupported("localFileStorage"))
                {
                    <div class="setting-item">
                        <div class="setting-info">
                            <span class="setting-title">Data storage location</span>
                            <span class="setting-desc">Local directory storing keys, history, and configuration.</span>
                        </div>
                        <div class="setting-control">
                            <span class="setting-value" style="font-size: 11.5px;">%AppData%\Gram</span>
                        </div>
                    </div>
                }
            </div>
        }
        else if (activeCategory == "Intelligence/Models")
        {
            <!-- Models Management -->
            <div class="models-toolbar">
                <input class="models-search" @bind="modelSearch" @bind:event="oninput" placeholder="Filter models by name or ID..." />

                <div style="display: flex; align-items: center; gap: 8px;">
                    <button class="subnav-tab @(showFavoritesOnly ? "active" : "")" @onclick="() => showFavoritesOnly = !showFavoritesOnly" title="Filter favorites">
                        @(showFavoritesOnly ? "★ Favorites" : "☆ All")
                    </button>
                    <button class="btn-primary-action" @onclick="OpenDiscoveryModal">
                        + Discover Models
                    </button>
                </div>
            </div>

            @if (FilteredModels.Count == 0)
            {
                <div class="harness-empty-state" style="padding: 32px 0;">
                    <h2>No models found</h2>
                    <p>Discover and add models from your connected providers.</p>
                    <button class="btn-primary-action" style="margin-top: 12px;" @onclick="OpenDiscoveryModal">
                        Discover OpenRouter Models
                    </button>
                </div>
            }
            else
            {
                <div class="models-list">
                    @foreach (var model in FilteredModels)
                    {
                        <div class="model-item">
                            <div class="model-item-left">
                                <button class="star-btn @(model.IsFavorite ? "active" : "")"
                                        @onclick="() => ModelService.ToggleFavorite(model.Id)"
                                        title="@(model.IsFavorite ? "Remove favorite" : "Add to favorites")">
                                    @(model.IsFavorite ? "★" : "☆")
                                </button>
                                <ModelIcon ModelId="@model.Id" Vendor="@model.Provider" Size="18" />
                                <div class="model-info-block">
                                    <div class="model-title-row">
                                        <span class="model-name">@model.Name</span>
                                        <span class="model-id-badge">@model.Id</span>
                                    </div>
                                    <div class="model-meta-row">
                                        <span class="model-provider-badge">@model.Provider</span>
                                        @if (model.ContextLength.HasValue)
                                        {
                                            <span>· @(model.ContextLength.Value >= 1000000 ? $"{model.ContextLength.Value / 1000000}M" : model.ContextLength.Value >= 1000 ? $"{model.ContextLength.Value / 1000}k" : $"{model.ContextLength.Value}")</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="model-item-right">
                                <button class="btn-remove-model" @onclick="() => ModelService.RemoveModel(model.Id)" title="Remove model">
                                    ✕
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else if (activeCategory == "Intelligence/Providers")
        {
            <!-- Providers View -->
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; padding: 0 4px;">
                <span class="setting-desc" style="margin-bottom: 0;">Configure your provider API keys or browse available models across all providers.</span>
                <button class="btn-primary-action" style="margin-top: 0; white-space: nowrap;" @onclick="OpenDiscoveryModal">
                    Discover Models ↗
                </button>
            </div>
            <div class="settings-group">
                @foreach (var provider in ModelService.Providers)
                {
                    if (provider.Id == "ollama" && !SettingsService.IsFeatureSupported("localOllama"))
                    {
                        continue;
                    }

                    var pHealth = ModelService.GetHealth(provider.Id);
                    var hasUserKey = ModelService.HasUserKey(provider.Id);
                    var isSystemManaged = ModelService.IsSystemManaged(provider.Id);
                    var isCheckingThis = checkingProviders.Contains(provider.Id);

                    <div class="setting-item">
                        <div class="setting-info">
                            <div style="display: flex; align-items: center; gap: 9px;">
                                <ModelIcon Vendor="@provider.Id" Size="18" />
                                <span class="setting-title">@provider.Name</span>
                                @if (isCheckingThis)
                                {
                                    <span class="provider-status checking">Checking health...</span>
                                }
                                else if (hasUserKey)
                                {
                                    <span class="provider-status connected" title="Using custom API key entered in settings">BYOK Active</span>
                                }
                                else if (isSystemManaged)
                                {
                                    <span class="provider-status system" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6; border-color: rgba(59, 130, 246, 0.3);" title="Using platform managed system key">System Included</span>
                                }
                                else if (provider.Id == "ollama" && pHealth.IsHealthy)
                                {
                                    <span class="provider-status connected">Connected</span>
                                }
                                else
                                {
                                    <span class="provider-status disconnected">Not Configured</span>
                                }
                            </div>
                            <span class="setting-desc">@(provider.BaseUrl ?? (provider.Id == "google" ? "Google AI Studio API" : "Default API Endpoint"))</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <button class="btn-icon-action" @onclick="() => OpenProviderModal(provider)" title="Configure @provider.Name settings" aria-label="Configure @provider.Name">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="3"></circle>
                                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                                </svg>
                            </button>
                            <button class="btn-icon-action" @onclick="() => CheckHealth(provider.Id)" disabled="@isCheckingThis" title="Test health for @provider.Name" aria-label="Test health for @provider.Name">
                                <svg class="@(isCheckingThis ? "spin" : "")" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (activeCategory == "Intelligence/Quota")
        {
            <div class="settings-group">
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Model quota and usage</span>
                        <span class="setting-desc">Provider limits are exact when the provider returns rate-limit headers; otherwise Gram reports observed local usage.</span>
                    </div>
                </div>

                @if (QuotaTracker.GetSnapshots().Count == 0)
                {
                    <div class="setting-item">
                        <div class="setting-info">
                            <span class="setting-desc">No model requests have been observed in this session yet.</span>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var snapshot in QuotaTracker.GetSnapshots())
                    {
                        <div class="setting-item quota-setting-item">
                            <div class="setting-info">
                                <div class="quota-setting-title">
                                    <span class="setting-title">@snapshot.Model</span>
                                    <span class="provider-status @(snapshot.Scope == "system" ? "system" : "connected")">@(snapshot.Scope == "system" ? "System" : "BYOK")</span>
                                </div>
                                <span class="setting-desc">@snapshot.Provider · @snapshot.Confidence data · @snapshot.ObservedRequests observed request(s)</span>
                                @if (snapshot.ObservedInputTokens > 0 || snapshot.ObservedOutputTokens > 0)
                                {
                                    <span class="setting-desc">Observed tokens: @snapshot.ObservedInputTokens.ToString("N0") in · @snapshot.ObservedOutputTokens.ToString("N0") out</span>
                                }
                            </div>
                            <div class="quota-setting-value">
                                @if (snapshot.RemainingPercent.HasValue)
                                {
                                    <strong class="@(snapshot.RemainingPercent <= 10 ? "quota-critical" : snapshot.RemainingPercent <= 25 ? "quota-warning" : "")">@snapshot.RemainingPercent% remaining</strong>
                                }
                                else
                                {
                                    <strong>Remaining unavailable</strong>
                                }
                                @if (snapshot.CooldownUntil > DateTimeOffset.UtcNow)
                                {
                                    <span>Retry @snapshot.CooldownUntil.Value.ToLocalTime().ToString("h:mm:ss tt")</span>
                                }
                                else if (snapshot.RequestsResetAt.HasValue || snapshot.TokensResetAt.HasValue)
                                {
                                    <span>Resets @((snapshot.RequestsResetAt ?? snapshot.TokensResetAt)!.Value.ToLocalTime().ToString("h:mm:ss tt"))</span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        }
        else if (activeCategory == "Intelligence/MCP")
        {
            <!-- MCP View -->
            <div class="settings-group">
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Connected MCP servers</span>
                        <span class="setting-desc">Model Context Protocol servers enable Gram to interact with local tools and filesystems.</span>
                    </div>
                    <div class="setting-control">
                        <button class="btn-secondary">Add server</button>
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Protocol status</span>
                        <span class="setting-desc">MCP daemon ready. No external servers attached.</span>
                    </div>
                    <div class="setting-control">
                        <span class="setting-value">Idle</span>
                    </div>
                </div>
            </div>
        }
        else if (activeCategory == "Intelligence/Tools")
        {
            <!-- Tools & Plugins View -->
            <div class="settings-group">
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Web Search capability</span>
                        <span class="setting-desc">Allow models to retrieve live real-time information from the web.</span>
                    </div>
                    <div class="setting-control">
                        <label class="setting-toggle">
                            <input type="checkbox" class="setting-checkbox" checked />
                            <span class="setting-desc">Enabled</span>
                        </label>
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Workspace file inspection</span>
                        <span class="setting-desc">Allow Gram to inspect files attached to chat.</span>
                    </div>
                    <div class="setting-control">
                        <label class="setting-toggle">
                            <input type="checkbox" class="setting-checkbox" checked />
                            <span class="setting-desc">Enabled</span>
                        </label>
                    </div>
                </div>
            </div>
        }
        else if (activeCategory == "Intelligence/Skills")
        {
            <!-- Prompts & Skills View -->
            <div class="settings-group">
                <!-- Grand Base System Prompt (Core Engine - Read-Only) -->
                <div class="setting-item" style="flex-direction: column; align-items: stretch; gap: 12px; background: var(--bg-panel); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 16px;">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div class="setting-info">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span class="setting-title" style="font-size: 14px; font-weight: 600;">Gram Core System Prompt</span>
                                <span class="provider-badge connected" style="font-size: 10px;">v@(GramSystemPrompt.Version)</span>
                                <span class="provider-badge disconnected" style="font-size: 10px;">Read-Only (Tuning Mode)</span>
                            </div>
                            <span class="setting-desc" style="margin-top: 4px;">
                                The foundational operating system prompt governing agent behavior, autonomous tool execution, Gram Box worktrees, code verification, and response standards.
                            </span>
                        </div>
                        <button class="btn-secondary" style="margin-top: 0;" @onclick="CopyBaseSystemPrompt">
                            Copy Prompt
                        </button>
                    </div>

                    <div style="position: relative;">
                        <pre style="background: #0b0914; border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 14px; color: #cbd5e1; font-family: var(--font-mono); font-size: 11.5px; line-height: 1.5; max-height: 280px; overflow-y: auto; white-space: pre-wrap; margin: 0;">@GramSystemPrompt.DefaultBasePrompt</pre>
                    </div>
                    
                    <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: var(--text-muted);">
                        <span>Read-only base prompt · Injected at the root of every model context assembly.</span>
                        <span style="font-family: var(--font-mono);">@GramSystemPrompt.DefaultBasePrompt.Length chars (~@(GramSystemPrompt.DefaultBasePrompt.Length / 4) tokens)</span>
                    </div>
                </div>

                <!-- Custom User Instructions (Additive Layer) -->
                <div class="setting-item" style="flex-direction: column; align-items: stretch; gap: 12px; margin-top: 14px;">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div class="setting-info">
                            <span class="setting-title">Custom User Instructions (Optional)</span>
                            <span class="setting-desc">Additional personal preferences, library choices, or guidelines layered on top of the base system prompt.</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <button class="btn-secondary" style="margin-top: 0;" @onclick="InsertSampleInstructions">
                                Insert Template
                            </button>
                            @if (!string.IsNullOrWhiteSpace(customInstructions))
                            {
                                <button class="btn-subtle" style="padding: 5px 10px;" @onclick="() => customInstructions = string.Empty">
                                    Clear
                                </button>
                            }
                        </div>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <textarea class="setting-textarea"
                                  @bind="customInstructions"
                                  @bind:event="oninput"
                                  rows="6"
                                  placeholder="Provide optional personal instructions layered on top of the base prompt...&#10;&#10;Examples:&#10;• Always provide clean, production-ready code with concise explanations.&#10;• Prioritize modern C# (.NET 9) and TypeScript best practices.&#10;• Keep responses direct and minimize conversational filler.&#10;• Format solutions with step-by-step diffs when applicable."></textarea>
                        
                        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11.5px; color: var(--text-muted);">
                            <span>Layered under &lt;user_custom_instructions&gt; in model context.</span>
                            <span style="font-family: var(--font-mono);">@customInstructions.Length characters</span>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (activeCategory == "Themes")
        {
            <!-- Themes View -->
            <div class="theme-section-header">
                <span class="theme-subtitle">Recently Used Colors</span>
                <span class="setting-desc">Loaded from your local user colors.</span>
            </div>

            <div class="theme-list">
                @foreach (var item in ThemeService.RecentThemes)
                {
                    <div class="theme-row @(ThemeService.ActiveThemeName.Equals(item.Name, StringComparison.OrdinalIgnoreCase) ? "selected" : "")"
                         @onclick="() => ThemeService.ApplyTheme(item.Name, item.Colors)">
                        <div class="theme-row-left">
                            <span class="theme-radio-dot"></span>
                            <div class="theme-row-info">
                                <span class="theme-row-name">@item.Name</span>
                                <span class="theme-row-desc">Used @item.LastUsed.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                            </div>
                        </div>
                        <div class="theme-swatches">
                            @foreach (var color in item.Colors.ToArray())
                            {
                                <span class="swatch-dot" style="background-color: @color;" title="@color"></span>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="theme-section-header" style="margin-top: 28px;">
                <span class="theme-subtitle">All Palettes (Catalog / Marketplace)</span>
                <span class="setting-desc">Explore palettes from colors.json.</span>
            </div>

            <div class="theme-list">
                @foreach (var entry in ThemeService.CatalogThemes)
                {
                    <div class="theme-row @(ThemeService.ActiveThemeName.Equals(entry.Key, StringComparison.OrdinalIgnoreCase) ? "selected" : "")"
                         @onclick="() => ThemeService.SelectCatalogTheme(entry.Key)">
                        <div class="theme-row-left">
                            <span class="theme-radio-dot"></span>
                            <div class="theme-row-info">
                                <span class="theme-row-name">@entry.Key</span>
                            </div>
                        </div>
                        <div class="theme-swatches">
                            @foreach (var color in entry.Value.ToArray())
                            {
                                <span class="swatch-dot" style="background-color: @color;" title="@color"></span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else if (activeCategory == "Toolbox")
        {
            <!-- Dedicated Toolbox & CDE Hub Settings View -->
            <div class="toolbox-settings-wrapper">
                <div class="toolbox-header-card">
                    <div class="toolbox-header-left">
                        <div class="toolbox-engine-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                            </svg>
                        </div>
                        <div>
                            <div class="toolbox-title-row">
                                <h3 class="toolbox-title">Gram Toolbox & CDE</h3>
                                <span class="toolbox-badge-pill status">
                                    <span class="toolbox-status-dot online"></span>
                                    <span>@ToolboxService.ToolboxStatus</span>
                                </span>
                                <span class="toolbox-badge-pill version">v@(ToolboxService.ToolboxVersion)</span>
                            </div>
                            <p class="toolbox-subtitle">
                                Modular sandboxed developer tools, Model Context Protocol (MCP) bridges, and autonomous agent domain skills.
                            </p>
                        </div>
                    </div>

                    <div class="toolbox-header-actions">
                        <button type="button" class="toolbox-btn-secondary" @onclick="TestToolboxHealth">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                            </svg>
                            <span>Diagnostics</span>
                        </button>
                    </div>
                </div>

                <!-- Security & Execution Safeguards -->
                <div class="settings-group">
                    <div class="setting-item">
                        <div class="setting-info">
                            <span class="setting-title">Execution Safeguards</span>
                            <span class="setting-desc">Security permission mode for mutating tools, file modifications, and terminal execution.</span>
                        </div>
                        <div class="setting-control">
                            <select class="setting-select" value="@SecurityService.Settings.PermissionMode" @onchange="OnPermissionModeChanged">
                                <option value="@ExecutionPermissionMode.FullAutonomous">Autonomous</option>
                                <option value="@ExecutionPermissionMode.SafeAutoApprove">Safe</option>
                                <option value="@ExecutionPermissionMode.AskAlways">Ask Always</option>
                            </select>
                        </div>
                    </div>

                    <div class="setting-item">
                        <div class="setting-info">
                            <span class="setting-title">Workspace Boundary Sandbox</span>
                            <span class="setting-desc">Enforce strict path containment within the current workspace directory.</span>
                        </div>
                        <div class="setting-control">
                            <label class="setting-toggle">
                                <input type="checkbox" class="setting-checkbox" checked="@SecurityService.Settings.EnforceWorkspaceSandboxing" @onchange="ToggleSandboxSandboxing" />
                                <span class="setting-desc">@(SecurityService.Settings.EnforceWorkspaceSandboxing ? "Enforced" : "Disabled")</span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Segmented Navigation Tabs -->
                <div class="toolbox-nav-tabs">
                    <button type="button" 
                            class="toolbox-tab-btn @(activeToolboxSection == "Tools" ? "active" : "")" 
                            @onclick='() => activeToolboxSection = "Tools"'>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                            <polyline points="2 17 12 22 22 17"></polyline>
                            <polyline points="2 12 12 17 22 12"></polyline>
                        </svg>
                        <span>Core Tools</span>
                        <span class="toolbox-tab-count">@ToolboxService.InstalledTools.Count</span>
                    </button>

                    <button type="button" 
                            class="toolbox-tab-btn @(activeToolboxSection == "MCP" ? "active" : "")" 
                            @onclick='() => activeToolboxSection = "MCP"'>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2v8"></path>
                            <path d="M12 18v4"></path>
                            <path d="M4.93 4.93l4.24 4.24"></path>
                            <path d="M14.83 14.83l4.24 4.24"></path>
                            <path d="M2 12h8"></path>
                            <path d="M18 12h4"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        <span>MCP Connections</span>
                        <span class="toolbox-tab-count">@ToolboxService.McpServers.Count</span>
                    </button>

                    <button type="button" 
                            class="toolbox-tab-btn @(activeToolboxSection == "Skills" ? "active" : "")" 
                            @onclick='() => activeToolboxSection = "Skills"'>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2a8 8 0 0 0-8 8c0 3.36 2.06 6.23 5 7.42V20a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2v-2.58c2.94-1.19 5-4.06 5-7.42a8 8 0 0 0-8-8z"></path>
                            <line x1="10" y1="22" x2="14" y2="22"></line>
                        </svg>
                        <span>Agent Skills</span>
                        <span class="toolbox-tab-count">@ToolboxService.Skills.Count</span>
                    </button>
                </div>

                <!-- Section Content -->
                @if (activeToolboxSection == "Tools")
                {
                    <div class="toolbox-grid">
                        @foreach (var tool in ToolboxService.InstalledTools)
                        {
                            <div class="toolbox-card @(tool.IsEnabled ? "is-enabled" : "is-disabled")">
                                <div class="toolbox-card-header">
                                    <div class="toolbox-card-identity">
                                        <div class="toolbox-card-icon">
                                            @if (tool.Category == "Sandbox")
                                            {
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
                                                    <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
                                                    <line x1="6" y1="6" x2="6.01" y2="6"></line>
                                                    <line x1="6" y1="18" x2="6.01" y2="6"></line>
                                                </svg>
                                            }
                                            else if (tool.Category == "Code")
                                            {
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="16 18 22 12 16 6"></polyline>
                                                    <polyline points="8 6 2 12 8 18"></polyline>
                                                </svg>
                                            }
                                            else if (tool.Category == "Browser")
                                            {
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="12" cy="12" r="10"></circle>
                                                    <circle cx="12" cy="12" r="4"></circle>
                                                    <line x1="21.17" y1="8" x2="12" y2="8"></line>
                                                    <line x1="3.95" y1="6.06" x2="8.54" y2="14"></line>
                                                    <line x1="10.88" y1="21.94" x2="15.46" y2="14"></line>
                                                </svg>
                                            }
                                            else if (tool.Category.Contains("Git") || tool.Category.Contains("VCS"))
                                            {
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <line x1="6" y1="3" x2="6" y2="15"></line>
                                                    <circle cx="18" cy="6" r="3"></circle>
                                                    <circle cx="6" cy="18" r="3"></circle>
                                                    <path d="M18 9a9 9 0 0 1-9 9"></path>
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                                    <polyline points="2 17 12 22 22 17"></polyline>
                                                    <polyline points="2 12 12 17 22 12"></polyline>
                                                </svg>
                                            }
                                        </div>
                                        <div class="toolbox-card-title-group">
                                            <span class="toolbox-card-name">@tool.Name</span>
                                            <span class="toolbox-category-tag">@tool.Category</span>
                                        </div>
                                    </div>

                                    <span class="toolbox-status-badge @(tool.IsEnabled ? "active" : "inactive")">
                                        @(tool.IsEnabled ? "Active" : "Disabled")
                                    </span>
                                </div>

                                <p class="toolbox-card-desc">
                                    @tool.Description
                                </p>

                                <div class="toolbox-card-footer">
                                    <span class="toolbox-card-meta">Runtime: @tool.Status</span>
                                    <div class="toolbox-card-actions">
                                        <button type="button" class="toolbox-btn-outline" @onclick="() => OpenToolInTab(tool)">
                                            <span>Configure</span>
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <line x1="7" y1="17" x2="17" y2="7"></line>
                                                <polyline points="7 7 17 7 17 17"></polyline>
                                            </svg>
                                        </button>
                                        <button type="button" class="toolbox-btn-ghost" @onclick="() => ToolboxService.ToggleTool(tool.Id)">
                                            @(tool.IsEnabled ? "Disable" : "Enable")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (activeToolboxSection == "MCP")
                {
                    <div class="toolbox-section-panel">
                        <div class="toolbox-section-header">
                            <div>
                                <h3 class="toolbox-section-title">Model Context Protocol (MCP) Bridges</h3>
                                <p class="toolbox-section-desc">
                                    Standardized JSON-RPC connections giving models tool-use access to SQLite, Git, Postgres, and external services.
                                </p>
                            </div>
                            <button type="button" class="toolbox-btn-primary" @onclick="() => showAddMcpModal = true">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                <span>Add MCP Server</span>
                            </button>
                        </div>

                        <div class="toolbox-mcp-list">
                            @foreach (var server in ToolboxService.McpServers)
                            {
                                <div class="toolbox-mcp-row">
                                    <div class="toolbox-mcp-left">
                                        <div class="toolbox-mcp-icon">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M12 2v8"></path>
                                                <path d="M12 18v4"></path>
                                                <path d="M4.93 4.93l4.24 4.24"></path>
                                                <path d="M14.83 14.83l4.24 4.24"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                        </div>
                                        <div>
                                            <div class="toolbox-mcp-title-row">
                                                <span class="toolbox-mcp-name">@server.Name</span>
                                                <span class="toolbox-transport-badge">@server.Transport</span>
                                                @if (server.IsConnected)
                                                {
                                                    <span class="toolbox-connected-badge">
                                                        <span>Connected (@server.ToolCount tools)</span>
                                                    </span>
                                                }
                                            </div>
                                            <code class="toolbox-mcp-command">
                                                @server.Command @server.Arguments
                                            </code>
                                        </div>
                                    </div>

                                    <div class="toolbox-mcp-actions">
                                        <button type="button" class="toolbox-btn-outline" @onclick='() => OpenToolInTab(new ToolboxToolInfo { Id = server.Id, Name = server.Name, Icon = "⚡" })'>
                                            <span>Inspect Schema</span>
                                        </button>
                                        <button type="button" class="toolbox-btn-danger-ghost" @onclick="() => ToolboxService.RemoveMcpServer(server.Id)" title="Delete server">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"></polyline>
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (activeToolboxSection == "Skills")
                {
                    <div class="toolbox-section-panel">
                        <div class="toolbox-section-header">
                            <div>
                                <h3 class="toolbox-section-title">Agent Skills & Guidelines</h3>
                                <p class="toolbox-section-desc">
                                    Modular domain guidelines, coding rules, and preferred toolchains injected during autonomous agent loops.
                                </p>
                            </div>
                            <button type="button" class="toolbox-btn-primary" @onclick="() => showAddSkillModal = true">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                <span>New Agent Skill</span>
                            </button>
                        </div>

                        <div class="toolbox-grid">
                            @foreach (var skill in ToolboxService.Skills)
                            {
                                <div class="toolbox-card">
                                    <div class="toolbox-card-header">
                                        <div class="toolbox-card-identity">
                                            <div class="toolbox-card-icon skill">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M12 2a8 8 0 0 0-8 8c0 3.36 2.06 6.23 5 7.42V20a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2v-2.58c2.94-1.19 5-4.06 5-7.42a8 8 0 0 0-8-8z"></path>
                                                </svg>
                                            </div>
                                            <span class="toolbox-card-name">@skill.Name</span>
                                        </div>
                                        <span class="toolbox-status-badge active">Active</span>
                                    </div>

                                    <p class="toolbox-card-desc">
                                        @skill.Description
                                    </p>

                                    <div class="toolbox-prompt-preview">
                                        <div class="toolbox-prompt-header">System Guidelines</div>
                                        <pre class="toolbox-prompt-code">@skill.SystemPrompt</pre>
                                    </div>

                                    <div class="toolbox-card-footer">
                                        <span class="toolbox-card-meta">Injected in prompts</span>
                                        <div class="toolbox-card-actions">
                                            <button type="button" class="toolbox-btn-outline" @onclick="() => OpenToolInTab(new ToolboxToolInfo { Id = skill.Id, Name = skill.Name, Icon = skill.Icon })">
                                                <span>Edit</span>
                                            </button>
                                            <button type="button" class="toolbox-btn-danger-ghost" @onclick="() => ToolboxService.RemoveSkill(skill.Id)">
                                                <span>Delete</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else if (activeCategory == "Auth" || activeCategory == "Account/Auth")
        {
            <!-- Dedicated Account & Auth View -->
            <div class="settings-group">
                <!-- Profile Avatar -->
                <div class="setting-item" style="align-items: center;">
                    <div class="setting-info">
                        <span class="setting-title">Profile avatar</span>
                        <span class="setting-desc">Upload a custom profile photo (JPG, PNG, SVG, HEIC, or WebP). Displayed across chats and navigation.</span>
                    </div>
                    <div class="setting-control" style="display: flex; align-items: center; gap: 14px;">
                        <div class="avatar-preview-wrap" style="width: 48px; height: 48px; border-radius: 50%; overflow: hidden; border: 1.5px solid var(--border-color); background: var(--bg-panel-subtle); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            @if (!string.IsNullOrWhiteSpace(AuthService.CurrentUser.Image))
                            {
                                <img src="@AuthService.CurrentUser.Image" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <span style="font-size: 16px; font-weight: 600; color: var(--text-primary); text-transform: uppercase;">
                                    @((!string.IsNullOrWhiteSpace(AuthService.CurrentUser.Name) ? AuthService.CurrentUser.Name[0].ToString() : "U"))
                                </span>
                            }
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <label class="shadcn-btn shadcn-btn-outline shadcn-btn-size-sm" style="cursor: pointer; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 0;">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="17 8 12 3 7 8"></polyline>
                                    <line x1="12" y1="3" x2="12" y2="15"></line>
                                </svg>
                                <span>@(isUploadingAvatar ? "Uploading..." : "Upload Avatar")</span>
                                <InputFile OnChange="HandleAvatarSelected" accept=".jpg,.jpeg,.png,.svg,.heic,.webp" style="display: none;" disabled="@isUploadingAvatar" />
                            </label>
                            @if (!string.IsNullOrWhiteSpace(AuthService.CurrentUser.Image))
                            {
                                <Button Variant="ghost" Size="sm" OnClick="RemoveAvatar" Style="color: #ef4444;">
                                    Remove
                                </Button>
                            }
                        </div>
                    </div>
                </div>

                <!-- Full Name -->
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Full name</span>
                        <span class="setting-desc">Your display name across chat sessions and agent logs.</span>
                    </div>
                    <div class="setting-control" style="display: flex; align-items: center; gap: 8px;">
                        <input class="setting-input" @bind="authFullNameInput" placeholder="Full name" style="max-width: 220px;" />
                        <Button Variant="outline" Size="sm" OnClick="SaveAccountProfile">Save</Button>
                    </div>
                </div>

                <!-- Nickname -->
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Nickname</span>
                        <span class="setting-desc">Short name used by the AI assistant when addressing you.</span>
                    </div>
                    <div class="setting-control" style="display: flex; align-items: center; gap: 8px;">
                        <input class="setting-input" @bind="authNicknameInput" placeholder="e.g. Alex" style="max-width: 220px;" />
                        <Button Variant="outline" Size="sm" OnClick="SaveAccountProfile">Save</Button>
                    </div>
                </div>

                <!-- Email Address -->
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Email address</span>
                        <span class="setting-desc">Primary email linked to your account and sessions.</span>
                    </div>
                    <div class="setting-control">
                        <span class="setting-desc" style="color: var(--text-primary); font-weight: 500; font-family: var(--font-mono); font-size: 12.5px;">
                            @(AuthService.CurrentUser.Email ?? "No email associated")
                        </span>
                    </div>
                </div>

                <!-- Passkey Security (FIDO2 / WebAuthn) -->
                <div class="setting-item" style="flex-direction: column; align-items: stretch; gap: 8px;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 16px;">
                        <div class="setting-info">
                            <span class="setting-title">Passkey security (FIDO2 / WebAuthn)</span>
                            <span class="setting-desc">Sign in securely using Touch ID, Face ID, Windows Hello, or hardware security keys.</span>
                        </div>
                        <div class="setting-control">
                            <Button Variant="outline" Size="sm" OnClick="SetupPasskey" Disabled="@isSettingUpPasskey">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
                                    <path d="M21 2l-2 2m-1.5 1.5L16 7l-1.5-1.5L13 7l-1.5-1.5L10 7l-2-2"></path>
                                    <circle cx="7.5" cy="15.5" r="5.5"></circle>
                                    <path d="M11.5 11.5L21 2"></path>
                                </svg>
                                @(isSettingUpPasskey ? "Setting up..." : (userPasskeys.Count > 0 ? "Add another passkey" : "Register passkey"))
                            </Button>
                        </div>
                    </div>

                    @if (userPasskeys.Count > 0)
                    {
                        <div class="passkey-list">
                            @foreach (var pk in userPasskeys)
                            {
                                <div class="passkey-item-row">
                                    <div class="passkey-item-info">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21 2l-2 2m-1.5 1.5L16 7l-1.5-1.5L13 7l-1.5-1.5L10 7l-2-2"></path>
                                            <circle cx="7.5" cy="15.5" r="5.5"></circle>
                                            <path d="M11.5 11.5L21 2"></path>
                                        </svg>
                                        <div>
                                            <span class="passkey-item-name">@pk.Name</span>
                                            <span class="passkey-item-date" style="margin-left: 8px;">Added @pk.CreatedAt.ToString("MMM d, yyyy")</span>
                                        </div>
                                    </div>
                                    <Button Variant="ghost" Size="sm" OnClick="() => HandleDeletePasskey(pk.Id)">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="18" y1="6" x2="6" y2="18"></line>
                                            <line x1="6" y1="6" x2="18" y2="18"></line>
                                        </svg>
                                    </Button>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Password Reset -->
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Change password</span>
                        <span class="setting-desc">Update your account password. Must be at least 6 characters.</span>
                    </div>
                    <div class="setting-control">
                        <Button Variant="outline" Size="sm" OnClick="() => showPasswordModal = true">
                            Change Password
                        </Button>
                    </div>
                </div>

                <!-- Sign Out -->
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Sign out</span>
                        <span class="setting-desc">End your active session and return to the login screen safely.</span>
                    </div>
                    <div class="setting-control">
                        <Button Variant="destructive" Size="sm" OnClick="HandleSettingsLogout">
                            Sign Out
                        </Button>
                    </div>
                </div>
            </div>
        }
        else if (activeCategory == "Audio" || activeCategory == "Account/Audio")
        {
            <!-- Clean List-Style Voice & Audio Settings -->
            <div class="settings-group">
                <!-- Microphone Input Device -->
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Microphone</span>
                        <span class="setting-desc">Primary sound input device.</span>
                    </div>
                    <div class="setting-control" style="min-width: 220px;">
                        <select class="setting-select" value="@selectedAudioInputDeviceId" @onchange="OnAudioInputDeviceChanged">
                            <option value="">Default Microphone</option>
                            @foreach (var dev in audioDevices.Where(d => d.Kind == "audioinput"))
                            {
                                <option value="@dev.DeviceId">@dev.Label</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Input Volume -->
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Input volume</span>
                        <span class="setting-desc">Microphone capture gain level (@inputVolume%).</span>
                    </div>
                    <div class="setting-control" style="min-width: 180px;">
                        <input type="range" min="0" max="100" class="minimal-range-slider" value="@inputVolume" @oninput="OnInputVolumeChanged" />
                    </div>
                </div>

                <!-- Test Microphone -->
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Test microphone</span>
                        <span class="setting-desc">Live audio capture meter.</span>
                        <div id="discordMicMeter" class="minimal-meter-wrapper" style="margin-top: 6px; max-width: 240px;">
                            <div class="minimal-meter-track">
                                <div class="mic-meter-fill"></div>
                                @if (!autoSensitivity)
                                {
                                    <div class="minimal-meter-notch" style="left: @(sensitivityThreshold)%"></div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="setting-control">
                        <button type="button" class="btn-minimal-action @(isMicTesting ? "active" : "")" @onclick="ToggleMicTestAsync">
                            @if (isMicTesting)
                            {
                                <span class="recording-dot"></span>
                                <span>Stop test</span>
                            }
                            else
                            {
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                                    <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                                    <line x1="12" y1="19" x2="12" y2="23"></line>
                                    <line x1="8" y1="23" x2="16" y2="23"></line>
                                </svg>
                                <span>Test mic</span>
                            }
                        </button>
                    </div>
                </div>

                <!-- Mic Loopback -->
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Microphone loopback</span>
                        <span class="setting-desc">Monitor your own voice live through output speakers.</span>
                    </div>
                    <div class="setting-control">
                        <label class="setting-toggle">
                            <input type="checkbox" class="setting-checkbox" checked="@micLoopbackEnabled" @onchange="OnMicLoopbackToggled" />
                            <span class="setting-desc">@(micLoopbackEnabled ? "Active" : "Off")</span>
                        </label>
                    </div>
                </div>

                <!-- Speaker Output Device -->
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Speaker & output</span>
                        <span class="setting-desc">Audio output destination.</span>
                    </div>
                    <div class="setting-control" style="min-width: 220px;">
                        <select class="setting-select" value="@selectedAudioOutputDeviceId" @onchange="OnAudioOutputDeviceChanged">
                            <option value="">Default Speaker</option>
                            @foreach (var dev in audioDevices.Where(d => d.Kind == "audiooutput"))
                            {
                                <option value="@dev.DeviceId">@dev.Label</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Output Volume -->
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Output volume</span>
                        <span class="setting-desc">Playback loudness level (@outputVolume%).</span>
                    </div>
                    <div class="setting-control" style="min-width: 180px;">
                        <input type="range" min="0" max="100" class="minimal-range-slider" value="@outputVolume" @oninput="OnOutputVolumeChanged" />
                    </div>
                </div>

                <!-- Test Speaker Output -->
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Test speaker output</span>
                        <span class="setting-desc">Play a harmonic test chime through output device.</span>
                    </div>
                    <div class="setting-control">
                        <button type="button" class="btn-minimal-action @(isSpeakerTesting ? "active" : "")"
                                @onclick="TestSpeakerOutputAsync"
                                disabled="@isSpeakerTesting">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                                <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                            </svg>
                            <span>@(isSpeakerTesting ? "Playing..." : "Test speaker")</span>
                        </button>
                    </div>
                </div>

                <!-- Automatic Input Sensitivity -->
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Automatic input sensitivity</span>
                        <span class="setting-desc">Continuously adapt microphone sensitivity to room noise.</span>
                    </div>
                    <div class="setting-control">
                        <label class="setting-toggle">
                            <input type="checkbox" class="setting-checkbox" checked="@autoSensitivity" @onchange="OnAutoSensitivityToggled" />
                            <span class="setting-desc">@(autoSensitivity ? "Auto" : "Manual")</span>
                        </label>
                    </div>
                </div>

                <!-- Manual Sensitivity Threshold (when manual) -->
                @if (!autoSensitivity)
                {
                    <div class="setting-item">
                        <div class="setting-info">
                            <span class="setting-title">Sensitivity threshold</span>
                            <span class="setting-desc">Cutoff gate for ambient background noise (@(sensitivityThreshold)%).</span>
                        </div>
                        <div class="setting-control" style="min-width: 180px;">
                            <input type="range" min="5" max="90" class="minimal-range-slider" value="@sensitivityThreshold" @oninput="OnSensitivityThresholdChanged" />
                        </div>
                    </div>
                }

                <!-- Echo Cancellation -->
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Echo cancellation</span>
                        <span class="setting-desc">Filter feedback from speakers back into your microphone.</span>
                    </div>
                    <div class="setting-control">
                        <label class="setting-toggle">
                            <input type="checkbox" class="setting-checkbox" checked="@echoCancellation" @onchange='e => OnVoiceProcessingChanged("echoCancellation", (bool)(e.Value ?? true))' />
                            <span class="setting-desc">@(echoCancellation ? "Active" : "Disabled")</span>
                        </label>
                    </div>
                </div>

                <!-- Noise Suppression -->
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Noise suppression</span>
                        <span class="setting-desc">Remove background room noise, typing, and fans.</span>
                    </div>
                    <div class="setting-control">
                        <label class="setting-toggle">
                            <input type="checkbox" class="setting-checkbox" checked="@noiseSuppression" @onchange='e => OnVoiceProcessingChanged("noiseSuppression", (bool)(e.Value ?? true))' />
                            <span class="setting-desc">@(noiseSuppression ? "Active" : "Disabled")</span>
                        </label>
                    </div>
                </div>

                <!-- Automatic Gain Control -->
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">Automatic gain control</span>
                        <span class="setting-desc">Normalize speech capture between soft and loud volumes.</span>
                    </div>
                    <div class="setting-control">
                        <label class="setting-toggle">
                            <input type="checkbox" class="setting-checkbox" checked="@autoGainControl" @onchange='e => OnVoiceProcessingChanged("autoGainControl", (bool)(e.Value ?? true))' />
                            <span class="setting-desc">@(autoGainControl ? "Active" : "Disabled")</span>
                        </label>
                    </div>
                </div>
            </div>
        }
        else if (activeCategory == "Git" || activeCategory == "Account/Git")
        {
            <!-- Git & Version Control View -->
            <div class="settings-group">
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 16px;">
                    <div>
                        <h2 style="font-size: 15px; font-weight: 600; margin: 0 0 4px 0; color: var(--text-primary);">Git & Version Control Accounts</h2>
                        <p style="font-size: 12.5px; color: var(--text-muted); margin: 0;">
                            Connect GitHub, GitLab (Cloud & Self-Hosted), Forgejo / Gitea (Codeberg & Self-Hosted), and Bitbucket for repository inspection and automated code operations.
                        </p>
                    </div>
                    <button type="button" class="btn-git-connect" @onclick="OpenAddGitAccountModal">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        <span>Connect account</span>
                    </button>
                </div>

                @if (GitService.Accounts.Count == 0)
                {
                    <div class="git-empty-state">
                        <span class="git-empty-text">
                            No Git accounts connected yet. Connect a personal access token for GitHub, GitLab, Codeberg/Forgejo, or Bitbucket to enable branching, diffs, and pull requests.
                        </span>
                        <button type="button" class="btn-git-connect-outline" @onclick="OpenAddGitAccountModal">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            <span>Connect Git account</span>
                        </button>
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        @foreach (var acc in GitService.Accounts)
                        {
                            <div class="setting-item" style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: var(--bg-panel-subtle); border: 1px solid var(--border-color); border-radius: var(--radius-md);">
                                <div style="display: flex; align-items: center; gap: 14px;">
                                    @if (!string.IsNullOrWhiteSpace(acc.AvatarUrl))
                                    {
                                        <img src="@acc.AvatarUrl" alt="@acc.Username" style="width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--border-color); object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div style="width: 34px; height: 34px; border-radius: var(--radius-sm); background: var(--bg-hover); display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 600; color: var(--text-primary); border: 1px solid var(--border-color);">
                                            @switch (acc.ProviderType)
                                            {
                                                case GitProviderType.GitHub:
                                                    <span>GH</span>
                                                    break;
                                                case GitProviderType.GitLab:
                                                    <span>GL</span>
                                                    break;
                                                case GitProviderType.Forgejo:
                                                    <span>FJ</span>
                                                    break;
                                                case GitProviderType.Bitbucket:
                                                    <span>BB</span>
                                                    break;
                                                default:
                                                    <span>GIT</span>
                                                    break;
                                            }
                                        </div>
                                    }
                                    <div style="display: flex; flex-direction: column; gap: 3px;">
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <span style="font-size: 13.5px; font-weight: 600; color: var(--text-primary);">@acc.DisplayName</span>
                                            <Badge Variant="secondary">@acc.ProviderType.ToString()</Badge>
                                            @if (acc.IsDefault)
                                            {
                                                <Badge Variant="default">Default</Badge>
                                            }
                                        </div>
                                        <div style="display: flex; align-items: center; gap: 8px; font-size: 11.5px; color: var(--text-muted);">
                                            <span>@acc.InstanceUrl</span>
                                            @if (!string.IsNullOrWhiteSpace(acc.Username))
                                            {
                                                <span>·</span>
                                                <span style="color: var(--text-secondary); font-weight: 500;">@@@acc.Username</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(acc.Scopes))
                                            {
                                                <span>·</span>
                                                <span style="opacity: 0.8;" title="Granted scopes: @acc.Scopes">@acc.Scopes</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <Button Variant="outline" Size="sm" OnClick="() => TestGitConnection(acc)" Disabled="@isTestingGitConnection">
                                        @(testingAccountId == acc.Id ? "Verifying..." : "Verify")
                                    </Button>
                                    <Button Variant="outline" Size="sm" OnClick="() => ExploreRepositories(acc)">
                                        Repositories
                                    </Button>
                                    <Button Variant="ghost" Size="sm" OnClick="() => EditGitAccount(acc)">
                                        Edit
                                    </Button>
                                    <Button Variant="ghost" Size="sm" OnClick="() => DeleteGitAccount(acc)">
                                        Delete
                                    </Button>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (selectedGitAccount != null && gitRepositories != null)
                {
                    <div style="margin-top: 24px; padding: 16px; background: var(--bg-panel-subtle); border: 1px solid var(--border-color); border-radius: var(--radius-md);">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                            <div>
                                <h3 style="font-size: 14px; font-weight: 600; margin: 0 0 2px 0; color: var(--text-primary);">
                                    Repositories for @selectedGitAccount.DisplayName
                                </h3>
                                <span style="font-size: 11.5px; color: var(--text-muted);">
                                    @gitRepositories.Count repositories found
                                </span>
                            </div>
                            <Button Variant="ghost" Size="sm" OnClick="() => { selectedGitAccount = null; gitRepositories = null; }">
                                Close Explorer
                            </Button>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 6px; max-height: 320px; overflow-y: auto;">
                            @foreach (var repo in gitRepositories)
                            {
                                <div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; background: var(--bg-panel); border: 1px solid var(--border-color); border-radius: var(--radius-sm);">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <span style="font-size: 13px; font-weight: 500; color: var(--text-primary);">@repo.FullName</span>
                                        @if (repo.IsPrivate)
                                        {
                                            <Badge Variant="outline">Private</Badge>
                                        }
                                        <span style="font-size: 11px; color: var(--text-muted);">branch: @repo.DefaultBranch</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(repo.HtmlUrl))
                                    {
                                        <a href="@repo.HtmlUrl" target="_blank" class="link-action" style="font-size: 11.5px;">
                                            Open ↗
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else if (activeCategory == "Logs")
        {
            <!-- Logs View -->
            <div class="settings-group">
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-title">System logs</span>
                        <span class="setting-desc">Activity and error logs stored on this machine.</span>
                    </div>
                    <div class="setting-control">
                        <a class="link-action" href="/api/logs/gram.log" target="_blank">Open latest log ↗</a>
                    </div>
                </div>
            </div>
        }
        else if (activeCategory == "About")
        {
            <!-- About Gram View (Hard-coded for all environments) -->
            <div class="about-container">
                <div class="about-hero-card">
                    <div class="about-logo-wrapper">
                        <img src="icons/2helix.svg" alt="2Helix Logo" class="about-2helix-logo" />
                    </div>
                    <div class="about-hero-info">
                        <div class="about-app-title">Gram</div>
                        <div class="about-version-badge">v1.0.0 · Production Release</div>
                        <p class="about-tagline">
                            Intelligent pair programming and multi-model assistant workspace.
                        </p>
                    </div>
                </div>

                <div class="settings-group">
                    <div class="setting-item">
                        <div class="setting-info">
                            <span class="setting-title">Developed by</span>
                            <span class="setting-desc">Lead Architect & Engineer</span>
                        </div>
                        <div class="setting-control">
                            <span style="font-weight: 600; color: var(--text-primary);">Taufeeq Ali</span>
                        </div>
                    </div>

                    <div class="setting-item">
                        <div class="setting-info">
                            <span class="setting-title">Owned by</span>
                            <span class="setting-desc">Company & Brand Ownership</span>
                        </div>
                        <div class="setting-control">
                            <a href="https://2helix.com" target="_blank" class="link-action" style="display: inline-flex; align-items: center; gap: 7px; font-weight: 600;">
                                <img src="icons/2helix.svg" alt="2Helix" style="width: 16px; height: 16px;" />
                                <span>2Helix</span>
                                <span style="font-size: 11px;">↗</span>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="settings-group">
                    <div class="setting-item">
                        <div class="setting-info">
                            <span class="setting-title">Privacy Policy</span>
                            <span class="setting-desc">Read how your data, private code, and credentials are protected</span>
                        </div>
                        <div class="setting-control">
                            <a href="https://2helix.com/privacy" target="_blank" class="link-action">
                                Privacy Docs ↗
                            </a>
                        </div>
                    </div>

                    <div class="setting-item">
                        <div class="setting-info">
                            <span class="setting-title">Terms of Service</span>
                            <span class="setting-desc">Read software terms, licenses, and usage policies</span>
                        </div>
                        <div class="setting-control">
                            <a href="https://2helix.com/terms" target="_blank" class="link-action">
                                Terms & Conditions ↗
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
        </section>
    </main>
</div>

@if (showGitModal)
{
    <div class="modal-backdrop" @onclick="() => showGitModal = false">
        <div class="modal-dialog" style="max-width: 520px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <span class="modal-title">@(editingGitAccount != null && GitService.Accounts.Any(a => a.Id == editingGitAccount.Id) ? "Edit Git Account" : "Connect Git Account")</span>
                    <p style="font-size: 11.5px; color: var(--text-muted); margin: 2px 0 0 0;">
                        Authorize Gram to explore repositories, create branches, and open pull requests.
                    </p>
                </div>
                <button class="btn-close-modal" @onclick="() => showGitModal = false">✕</button>
            </div>
            <div class="modal-body" style="padding: 18px 20px; display: flex; flex-direction: column; gap: 16px;">
                <!-- Provider Selector Tiles -->
                <div class="sheet-field">
                    <label class="sheet-label">Select Platform</label>
                    <div class="git-provider-tiles">
                        <button type="button" class="git-provider-tile @(gitProviderTypeInput == GitProviderType.GitHub ? "active" : "")" @onclick="() => SelectGitProvider(GitProviderType.GitHub)">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                            </svg>
                            <span>GitHub</span>
                        </button>
                        <button type="button" class="git-provider-tile @(gitProviderTypeInput == GitProviderType.GitLab ? "active" : "")" @onclick="() => SelectGitProvider(GitProviderType.GitLab)">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                <path d="m23.6 9.59-1.16-3.56a.94.94 0 0 0-.36-.46.96.96 0 0 0-.58-.15.98.98 0 0 0-.57.2.92.92 0 0 0-.31.47l-1.95 6H5.33l-1.95-6a.92.92 0 0 0-.31-.47.98.98 0 0 0-.57-.2.96.96 0 0 0-.58.15.94.94 0 0 0-.36.46L.4 9.59a1.53 1.53 0 0 0 .54 1.66l10.45 7.6a.98.98 0 0 0 1.22 0l10.45-7.6a1.53 1.53 0 0 0 .54-1.66Z"/>
                            </svg>
                            <span>GitLab</span>
                        </button>
                        <button type="button" class="git-provider-tile @(gitProviderTypeInput == GitProviderType.Forgejo ? "active" : "")" @onclick="() => SelectGitProvider(GitProviderType.Forgejo)">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 14.93V17a1 1 0 0 1-2 0v-.07A5 5 0 0 1 7.07 13H7a1 1 0 0 1 0-2h.07A5 5 0 0 1 11 7.07V7a1 1 0 0 1 2 0v.07A5 5 0 0 1 16.93 11H17a1 1 0 0 1 0 2h-.07A5 5 0 0 1 13 16.93z"/>
                            </svg>
                            <span>Codeberg</span>
                        </button>
                        <button type="button" class="git-provider-tile @(gitProviderTypeInput == GitProviderType.Bitbucket ? "active" : "")" @onclick="() => SelectGitProvider(GitProviderType.Bitbucket)">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M2.65 3C2.3 3 2 3.3 2 3.65c0 .08.02.17.05.25l3.22 16.5c.06.31.33.54.65.54h12.16c.32 0 .59-.23.65-.54l3.22-16.5c.03-.08.05-.17.05-.25 0-.35-.3-.65-.65-.65H2.65zm9.95 12.35H8.7l-1.07-5.5h6.04l-1.07 5.5z"/>
                            </svg>
                            <span>Bitbucket</span>
                        </button>
                    </div>
                </div>

                <!-- Personal Access Token & Quick Link -->
                <div class="sheet-field">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
                        <label class="sheet-label" style="margin: 0;">Personal Access Token</label>
                        <a href="@GetTokenCreationUrl(gitProviderTypeInput, gitInstanceUrlInput)" target="_blank" class="git-token-hint">
                            <span>Create token on @gitProviderTypeInput</span>
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                <polyline points="15 3 21 3 21 9"></polyline>
                                <line x1="10" y1="14" x2="21" y2="3"></line>
                            </svg>
                        </a>
                    </div>
                    <div style="display: flex; gap: 6px;">
                        <input type="@(showGitToken ? "text" : "password")" class="sheet-input" @bind="gitTokenInput" placeholder="@GetTokenPlaceholder(gitProviderTypeInput)" />
                        <Button Variant="outline" Size="sm" OnClick="() => showGitToken = !showGitToken">
                            @(showGitToken ? "Hide" : "Show")
                        </Button>
                    </div>
                    <span style="font-size: 11.5px; color: var(--text-muted); line-height: 1.4;">
                        @GetTokenHelpText(gitProviderTypeInput)
                    </span>
                </div>

                <!-- Verified Profile Banner (if verified or test succeeded) -->
                @if (verifiedProfile != null && verifiedProfile.Success)
                {
                    <div class="git-verified-card">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            @if (!string.IsNullOrWhiteSpace(verifiedProfile.AvatarUrl))
                            {
                                <img src="@verifiedProfile.AvatarUrl" alt="@verifiedProfile.Username" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover;" />
                            }
                            else
                            {
                                <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--bg-active); display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 600;">
                                    @verifiedProfile.Username[..Math.Min(2, verifiedProfile.Username.Length)].ToUpperInvariant()
                                </div>
                            }
                            <div style="display: flex; flex-direction: column;">
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span style="font-size: 13px; font-weight: 600; color: var(--text-primary);">@verifiedProfile.DisplayName</span>
                                    <span style="font-size: 11.5px; color: var(--text-muted);">@@@verifiedProfile.Username</span>
                                </div>
                                <span style="font-size: 11px; color: #10b981; font-weight: 500;">
                                    ✓ Authenticated · @(verifiedProfile.RepositoryCount > 0 ? $"{verifiedProfile.RepositoryCount} repositories accessible" : "Ready for code operations")
                                </span>
                            </div>
                        </div>
                    </div>
                }
                else if (verifiedProfile != null && !verifiedProfile.Success)
                {
                    <div style="padding: 8px 12px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: var(--radius-sm); font-size: 12px; color: #f87171;">
                        @verifiedProfile.ErrorMessage
                    </div>
                }

                <!-- Account Label & Customization -->
                <div class="sheet-field">
                    <label class="sheet-label">Account Label</label>
                    <input type="text" class="sheet-input" @bind="gitDisplayNameInput" placeholder="e.g. Personal GitHub, Work GitLab" />
                </div>

                <!-- Self-Hosted / Advanced Options -->
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <span style="font-size: 12px; font-weight: 500; color: var(--text-secondary);">Advanced & Host Settings</span>
                        <button type="button" class="btn-clean-toggle" @onclick="() => showGitAdvanced = !showGitAdvanced">
                            @(showGitAdvanced ? "Hide" : "Configure Host URL")
                        </button>
                    </div>

                    @if (showGitAdvanced)
                    {
                        <div style="display: flex; flex-direction: column; gap: 10px; padding: 12px; background: var(--bg-hover); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                            <div class="sheet-field">
                                <label class="sheet-label">Instance / Host URL</label>
                                <input type="text" class="sheet-input" @bind="gitInstanceUrlInput" placeholder="https://github.com" />
                                <span style="font-size: 11px; color: var(--text-muted);">
                                    For GitHub Enterprise, self-hosted GitLab, or private Gitea/Forgejo servers.
                                </span>
                            </div>
                            <div class="sheet-field">
                                <label class="sheet-label">Username (Optional / Bitbucket)</label>
                                <input type="text" class="sheet-input" @bind="gitUsernameInput" placeholder="Your username on this platform" />
                            </div>
                        </div>
                    }
                </div>

                <div style="display: flex; align-items: center; gap: 8px;">
                    <input type="checkbox" id="chkGitDefault" @bind="gitIsDefaultInput" />
                    <label for="chkGitDefault" style="font-size: 12.5px; color: var(--text-primary); cursor: pointer;">Set as default Git account</label>
                </div>
            </div>
            <div class="modal-footer" style="display: flex; justify-content: space-between; padding: 12px 18px; border-top: 1px solid var(--border-color);">
                <Button Variant="outline" Size="sm" OnClick="() => TestDraftGitConnection()" Disabled="@isTestingGitConnection">
                    @(isTestingGitConnection ? "Verifying..." : "Test Connection")
                </Button>
                <div style="display: flex; gap: 8px;">
                    <Button Variant="ghost" Size="sm" OnClick="() => showGitModal = false">Cancel</Button>
                    <button type="button" class="btn-git-connect" @onclick="VerifyAndSaveGitAccountAsync" disabled="@isTestingGitConnection">
                        @if (isTestingGitConnection)
                        {
                            <span>Verifying...</span>
                        }
                        else
                        {
                            <span>Verify & Save</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showDiscoveryModal)
{
    <div class="modal-backdrop" @onclick="CloseDiscoveryModal">
        <div class="modal-dialog discovery-modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <span class="modal-title">Discover Models</span>
                    <span style="font-size: 11.5px; color: var(--text-muted);">
                        @FilteredDiscoveredModels.Count @(FilteredDiscoveredModels.Count == 1 ? "model" : "models")
                    </span>
                </div>
                <button class="btn-close-modal" @onclick="CloseDiscoveryModal" title="Close dialog">✕</button>
            </div>

            <div class="modal-search-bar">
                <div class="modal-search-input-wrapper">
                    <svg class="modal-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input class="modal-search-input"
                           @bind="discoverySearch"
                           @bind:event="oninput"
                           placeholder="Search models by name or Openrouter Model ID..." />
                    @if (!string.IsNullOrWhiteSpace(discoverySearch))
                    {
                        <button class="modal-search-clear-btn" @onclick="ClearDiscoverySearch" title="Clear search">✕</button>
                    }
                </div>

                <div class="filter-chips">
                    @foreach (var chip in filterChips)
                    {
                        <button class="filter-chip @(activeFilterChip == chip ? "active" : "")"
                                @onclick="() => activeFilterChip = chip">
                            @if (chip != "All")
                            {
                                <ModelIcon Vendor="@chip" Size="12" />
                            }
                            <span>@chip</span>
                        </button>
                    }
                </div>
            </div>

            <div class="modal-body discovery-modal-body">
                @if (isLoadingDiscovery)
                {
                    <div class="discovery-loading-state">
                        <div class="loading-spinner"></div>
                        <span>Fetching available models from OpenRouter...</span>
                    </div>
                }
                else if (FilteredDiscoveredModels.Count == 0)
                {
                    <div class="harness-empty-state" style="padding: 36px 0;">
                        <span style="font-size: 26px; margin-bottom: 6px;">🔍</span>
                        <h3 style="margin: 0 0 6px 0; font-size: 14px; color: var(--text-primary);">No models found</h3>
                        <p style="margin: 0 0 14px 0; font-size: 12px; color: var(--text-muted);">
                            No models match your current search query or active filter.
                        </p>
                        @if (!string.IsNullOrWhiteSpace(discoverySearch) || activeFilterChip != "All")
                        {
                            <button class="btn-secondary" style="margin-top: 0;" @onclick="ResetDiscoveryFilters">
                                Reset Filters
                            </button>
                        }
                    </div>
                }
                else
                {
                    @foreach (var model in FilteredDiscoveredModels)
                    {
                        var vendor = GetModelVendor(model.Id);
                        var isAlreadyAdded = ModelService.Models.Any(m => m.Id.Equals(model.Id, StringComparison.OrdinalIgnoreCase));
                        <div class="discovery-row @(model.IsSelected ? "selected" : "")"
                             @onclick="() => model.IsSelected = !model.IsSelected">
                            <div class="discovery-left">
                                <div class="custom-checkbox @(model.IsSelected ? "checked" : "")">
                                    @if (model.IsSelected)
                                    {
                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    }
                                </div>

                                <ModelIcon ModelId="@model.Id" Vendor="@vendor" Size="18" />

                                <div class="model-info-block">
                                    <div class="model-title-row">
                                        <span class="model-name">@model.Name</span>
                                        <span class="model-vendor-pill vendor-@(vendor.ToLowerInvariant())">@vendor</span>
                                        @if (isAlreadyAdded)
                                        {
                                            <span class="model-added-pill">Added</span>
                                        }
                                        <span class="model-id-badge">@model.Id</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(model.Description))
                                    {
                                        <span class="discovery-desc">@model.Description</span>
                                    }
                                </div>
                            </div>

                            <div class="discovery-right">
                                @if (model.ContextLength.HasValue)
                                {
                                    <span class="model-ctx-badge">
                                        @(model.ContextLength.Value >= 1000000 
                                            ? $"{model.ContextLength.Value / 1000000}M" 
                                            : model.ContextLength.Value >= 1000 
                                                ? $"{model.ContextLength.Value / 1000}k" 
                                                : $"{model.ContextLength.Value}")
                                    </span>
                                }
                                <button class="star-btn @(model.IsFavorite ? "active" : "")"
                                        @onclick="() => model.IsFavorite = !model.IsFavorite"
                                        @onclick:stopPropagation="true"
                                        title="@(model.IsFavorite ? "Remove favorite" : "Mark favorite")">
                                    @(model.IsFavorite ? "★" : "☆")
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="modal-footer">
                <div class="modal-footer-stats">
                    <span class="selection-pill @(discoveredModels.Any(m => m.IsSelected) ? "has-selected" : "")">
                        @(discoveredModels.Count(m => m.IsSelected)) selected
                    </span>
                    <button class="btn-subtle" style="margin-left: 8px; font-size: 11.5px; padding: 3px 8px;" @onclick="ToggleSelectAllFiltered">
                        @(FilteredDiscoveredModels.All(m => m.IsSelected) ? "Deselect All Visible" : "Select All Visible")
                    </button>
                </div>

                <div class="modal-footer-actions">
                    <button class="btn-secondary" style="margin-top: 0;" @onclick="CloseDiscoveryModal">
                        Cancel
                    </button>
                    <button class="btn-primary-action"
                            disabled="@(discoveredModels.Count(m => m.IsSelected) == 0)"
                            @onclick="AddSelectedModels">
                        Add @(discoveredModels.Count(m => m.IsSelected) > 0 ? $"{discoveredModels.Count(m => m.IsSelected)} Models" : "Models")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showProviderModal && selectedProvider != null)
{
    <div class="modal-backdrop" @onclick="CloseProviderModal">
        <div class="modal-dialog provider-modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span class="modal-title">@selectedProvider.Name Settings</span>
                    <span class="provider-status @(currentProviderHealth.IsHealthy ? "connected" : (string.IsNullOrWhiteSpace(providerKeyInput) && selectedProvider.Id != "ollama" ? "disconnected" : "connected"))" style="font-size: 10.5px;">
                        @(currentProviderHealth.IsHealthy ? "Healthy" : (string.IsNullOrWhiteSpace(providerKeyInput) && selectedProvider.Id != "ollama" ? "No Key" : "Configured"))
                    </span>
                </div>
                <button class="btn-close-modal" @onclick="CloseProviderModal">✕</button>
            </div>

            <div class="modal-body" style="gap: 16px; padding: 18px 22px;">
                <!-- Endpoint / Base URL -->
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <label class="setting-title" style="font-size: 13px;">API Endpoint / Base URL</label>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <input class="setting-input" style="flex: 1; width: 100%;"
                               @bind="providerBaseUrlInput"
                               placeholder="@(selectedProvider.Id == "ollama" ? "http://localhost:11434" : "https://api...")" />
                        <button class="btn-secondary" style="margin-top: 0; white-space: nowrap;" @onclick="ResetProviderBaseUrl">
                            Default
                        </button>
                    </div>
                    <span class="setting-desc">Custom reverse proxy, gateway, or local server endpoint.</span>
                </div>

                <!-- API Key (if not local Ollama) -->
                @if (selectedProvider.Id != "ollama")
                {
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <div style="display: flex; align-items: center; justify-content: space-between;">
                            <label class="setting-title" style="font-size: 13px;">User API Key (BYOK)</label>
                            @if (!string.IsNullOrWhiteSpace(providerCopyFeedback))
                            {
                                <span style="font-size: 11px; color: var(--success); font-weight: 500;">@providerCopyFeedback</span>
                            }
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <input class="setting-input" style="flex: 1; width: 100%; font-family: var(--font-mono); font-size: 12px;"
                                   type="@(showProviderKey ? "text" : "password")"
                                   @bind="providerKeyInput"
                                   placeholder="@(ModelService.HasSystemKey(selectedProvider.Id) ? "(System Included) Paste custom key to override..." : $"Paste {selectedProvider.Name} API key...")" />
                            <button class="btn-secondary" style="margin-top: 0;" @onclick="() => showProviderKey = !showProviderKey">
                                @(showProviderKey ? "Hide" : "Show")
                            </button>
                            <button class="btn-secondary" style="margin-top: 0;" @onclick="CopyProviderKey" disabled="@string.IsNullOrWhiteSpace(providerKeyInput)">
                                Copy
                            </button>
                        </div>
                        @if (ModelService.IsSystemManaged(selectedProvider.Id) && string.IsNullOrWhiteSpace(providerKeyInput))
                        {
                            <span class="setting-desc" style="color: #60a5fa;">✨ System managed key is active. Providing your own key will override system defaults.</span>
                        }
                        else
                        {
                            <span class="setting-desc">Stored encrypted in your local secure_keys.dat store.</span>
                        }
                    </div>
                }

                <!-- Health Check Diagnostic -->
                <div style="display: flex; flex-direction: column; gap: 8px; background: var(--bg-panel-subtle); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 12px 14px;">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <span class="setting-title" style="font-size: 13px;">Live Health & Connection Test</span>
                        <button class="btn-secondary" style="margin-top: 0;" @onclick="TestCurrentProviderHealth" disabled="@isCheckingProviderHealth">
                            @(isCheckingProviderHealth ? "Pinging..." : "Test Health")
                        </button>
                    </div>

                    <div style="display: flex; align-items: center; gap: 8px; font-size: 12px;">
                        <span class="swatch-dot" style="background-color: @(currentProviderHealth.IsHealthy ? "var(--success)" : "var(--danger)");"></span>
                        <span style="color: var(--text-primary); font-weight: 500;">
                            @(isCheckingProviderHealth ? "Testing provider connection..." : (currentProviderHealth.LastChecked.HasValue ? currentProviderHealth.Message : "Ready for connection test"))
                        </span>
                        @if (currentProviderHealth.LastChecked.HasValue && !isCheckingProviderHealth)
                        {
                            <span style="font-size: 11px; color: var(--text-muted); margin-left: auto;">
                                @currentProviderHealth.LastChecked.Value.ToLocalTime().ToString("h:mm:ss tt")
                            </span>
                        }
                    </div>
                </div>
            </div>

            <div class="modal-footer" style="padding: 12px 20px;">
                <button class="btn-subtle" @onclick="CloseProviderModal">
                    Cancel
                </button>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <button class="btn-primary-action" @onclick="SaveProviderSettings">
                        Save & Close
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showPasswordModal)
{
    <div class="modal-backdrop" @onclick="() => showPasswordModal = false">
        <div class="modal-dialog-confirm" @onclick:stopPropagation="true" style="max-width: 380px;">
            <span class="confirm-title">Change Password</span>
            <span class="confirm-message">Enter your current password and your new password below.</span>
            
            <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 14px; text-align: left;">
                <div>
                    <label style="font-size: 11.5px; color: var(--text-secondary); margin-bottom: 4px; display: block;">Current Password</label>
                    <input type="password" class="setting-input" @bind="currentPasswordInput" placeholder="Current password" />
                </div>
                <div>
                    <label style="font-size: 11.5px; color: var(--text-secondary); margin-bottom: 4px; display: block;">New Password</label>
                    <input type="password" class="setting-input" @bind="newPasswordInput" placeholder="At least 6 characters" />
                </div>
            </div>

            <div class="confirm-actions" style="margin-top: 18px;">
                <button class="btn-subtle" @onclick="() => showPasswordModal = false">Cancel</button>
                <button class="btn-primary-action" @onclick="HandlePasswordReset" disabled="@isResettingPassword">
                    @(isResettingPassword ? "Updating..." : "Update Password")
                </button>
            </div>
        </div>
    </div>
}

@if (showUnsavedModal)
{
    <div class="modal-backdrop" @onclick="CancelLeave">
        <div class="modal-dialog-confirm" @onclick:stopPropagation="true">
            <span class="confirm-title">Unsaved changes</span>
            <span class="confirm-message">
                You have unsaved changes in your settings. Leaving now will discard your modifications.
            </span>
            <div class="confirm-actions">
                <button class="btn-subtle" @onclick="CancelLeave">
                    Keep Editing
                </button>
                <button class="btn-danger-subtle" @onclick="DiscardAndLeave">
                    Discard & Leave
                </button>
                <button class="btn-primary-action" @onclick="SaveAndLeave">
                    Save & Leave
                </button>
            </div>
        </div>
    </div>
}

@if (showAddMcpModal)
{
    <div class="modal-backdrop" @onclick="() => showAddMcpModal = false">
        <div class="modal-dialog" style="max-width: 480px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <span class="modal-title">Register MCP Server</span>
                <button class="btn-close-modal" @onclick="() => showAddMcpModal = false">✕</button>
            </div>
            <div class="modal-body" style="padding: 16px 20px; display: flex; flex-direction: column; gap: 14px;">
                <div class="sheet-field">
                    <label class="sheet-label">Server Name</label>
                    <input type="text" class="sheet-input" @bind="newMcpName" placeholder="e.g. Postgres DB MCP" />
                </div>
                <div class="sheet-field">
                    <label class="sheet-label">Executable Command</label>
                    <input type="text" class="sheet-input" @bind="newMcpCommand" placeholder="npx, docker, uvx, or binary path" />
                </div>
                <div class="sheet-field">
                    <label class="sheet-label">Arguments</label>
                    <input type="text" class="sheet-input" @bind="newMcpArgs" placeholder="-y @@modelcontextprotocol/server-postgres ..." />
                </div>
            </div>
