    private async Task TestDraftGitConnection()
    {
        if (string.IsNullOrWhiteSpace(gitTokenInput))
        {
            SonnerService.Warning("Token required", "Please enter a personal access token to verify.");
            return;
        }

        isTestingGitConnection = true;
        StateHasChanged();
        try
        {
            var temp = new GitAccount
            {
                ProviderType = gitProviderTypeInput,
                InstanceUrl = gitInstanceUrlInput,
                Username = gitUsernameInput,
                Token = gitTokenInput
            };
            var profile = await GitService.ValidateAndFetchProfileAsync(temp);
            verifiedProfile = profile;
            if (profile.Success)
            {
                if (!string.IsNullOrWhiteSpace(profile.Username) && string.IsNullOrWhiteSpace(gitUsernameInput))
                {
                    gitUsernameInput = profile.Username;
                }
                if (!string.IsNullOrWhiteSpace(profile.AvatarUrl))
                {
                    gitAvatarUrlInput = profile.AvatarUrl;
                }
                if (!string.IsNullOrWhiteSpace(profile.Scopes))
                {
                    gitScopesInput = profile.Scopes;
                }
                SonnerService.Success("Authentication successful", $"Connected as @{profile.Username}");
            }
            else
            {
                SonnerService.Error("Authentication failed", profile.ErrorMessage ?? "Could not authenticate with provided token/URL");
            }
        }
        catch (Exception ex)
        {
            verifiedProfile = new GitUserProfile { Success = false, ErrorMessage = ex.Message };
            SonnerService.Error("Verification error", ex.Message);
        }
        finally
        {
            isTestingGitConnection = false;
            StateHasChanged();
        }
    }

    private async Task VerifyAndSaveGitAccountAsync()
    {
        if (string.IsNullOrWhiteSpace(gitTokenInput))
        {
            SonnerService.Warning("Token required", "Please enter a personal access token.");
            return;
        }

        isTestingGitConnection = true;
        StateHasChanged();
        try
        {
            var account = editingGitAccount ?? new GitAccount();
            account.ProviderType = gitProviderTypeInput;
            account.InstanceUrl = string.IsNullOrWhiteSpace(gitInstanceUrlInput) ? "https://github.com" : gitInstanceUrlInput.Trim();
            account.Username = gitUsernameInput.Trim();
            account.Token = gitTokenInput.Trim();

            // Run verification and profile discovery
            var profile = await GitService.ValidateAndFetchProfileAsync(account);
            if (profile.Success)
            {
                if (!string.IsNullOrWhiteSpace(profile.Username))
                {
                    account.Username = profile.Username;
                }
                if (!string.IsNullOrWhiteSpace(profile.AvatarUrl))
                {
                    account.AvatarUrl = profile.AvatarUrl;
                }
                if (!string.IsNullOrWhiteSpace(profile.Scopes))
                {
                    account.Scopes = profile.Scopes;
                }

                if (string.IsNullOrWhiteSpace(gitDisplayNameInput) || gitDisplayNameInput.StartsWith("My ") || gitDisplayNameInput.EndsWith("Account"))
                {
                    account.DisplayName = $"{gitProviderTypeInput} (@{account.Username})";
                }
                else
                {
                    account.DisplayName = gitDisplayNameInput.Trim();
                }

                account.IsDefault = gitIsDefaultInput;
                await GitService.SaveAccountAsync(account);
                showGitModal = false;
                SonnerService.Success("Account connected", $"Authenticated with {gitProviderTypeInput} as @{account.Username}");
            }
            else
            {
                verifiedProfile = profile;
                SonnerService.Error("Authentication failed", profile.ErrorMessage ?? "Could not authenticate with provided token.");
            }
        }
        catch (Exception ex)
        {
            verifiedProfile = new GitUserProfile { Success = false, ErrorMessage = ex.Message };
            SonnerService.Error("Connection error", ex.Message);
        }
        finally
        {
            isTestingGitConnection = false;
            StateHasChanged();
        }
    }

