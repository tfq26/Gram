        if (modelId.StartsWith("openai/", StringComparison.OrdinalIgnoreCase)) return "OpenAI";
        if (modelId.StartsWith("deepseek/", StringComparison.OrdinalIgnoreCase)) return "DeepSeek";
        if (modelId.StartsWith("google/", StringComparison.OrdinalIgnoreCase) || modelId.StartsWith("gemini-", StringComparison.OrdinalIgnoreCase)) return "Google";
        if (modelId.StartsWith("cloudflare/", StringComparison.OrdinalIgnoreCase) || modelId.StartsWith("@cf/", StringComparison.OrdinalIgnoreCase)) return "Cloudflare";
        if (modelId.StartsWith("meta-llama/", StringComparison.OrdinalIgnoreCase) || modelId.StartsWith("meta/", StringComparison.OrdinalIgnoreCase)) return "Meta";
        if (modelId.StartsWith("x-ai/", StringComparison.OrdinalIgnoreCase) || modelId.StartsWith("xai/", StringComparison.OrdinalIgnoreCase)) return "xAI";
        if (modelId.StartsWith("ollama/", StringComparison.OrdinalIgnoreCase)) return "Ollama";
        if (modelId.StartsWith("qwen/", StringComparison.OrdinalIgnoreCase) || modelId.StartsWith("alibaba/", StringComparison.OrdinalIgnoreCase)) return "Qwen";
        if (modelId.StartsWith("mistralai/", StringComparison.OrdinalIgnoreCase)) return "Mistral";
        if (modelId.StartsWith("cohere/", StringComparison.OrdinalIgnoreCase)) return "Cohere";
        var slashIndex = modelId.IndexOf('/');
        return slashIndex > 0 ? modelId[..slashIndex] : "OpenRouter";
    }

