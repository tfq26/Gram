    private static string GetTokenHelpText(GitProviderType type)
    {
        return type switch
        {
            GitProviderType.GitHub => "Required scopes: 'repo' (read/write repository data) and 'read:user' (profile verification). Fine-grained or classic tokens are supported.",
            GitProviderType.GitLab => "Required scopes: 'api', 'read_repository', 'write_repository', and 'read_user'.",
            GitProviderType.Forgejo => "Required scopes: 'repo' and 'user' on your Codeberg or Gitea/Forgejo instance.",
            GitProviderType.Bitbucket => "Create an App Password with 'Repositories: Read & Write' and 'Pull requests: Read & Write'.",
            _ => "Personal access token with read/write repository privileges."
        };
    }

