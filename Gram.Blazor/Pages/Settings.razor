    private async Task SetupPasskey()
    {
        isSettingUpPasskey = true;
        StateHasChanged();
        try
        {
            var user = AuthService.CurrentUser;
            var regResult = await JSRuntime.InvokeAsync<PasskeyRegisterJsResult>("gramPasskey.register", user.Id, user.Email, user.Name);
            if (!regResult.Success || string.IsNullOrWhiteSpace(regResult.CredentialId))
            {
                if (!string.IsNullOrWhiteSpace(regResult.Error) && !regResult.Error.Contains("cancelled", StringComparison.OrdinalIgnoreCase))
                {
                    SonnerService.Error("Passkey error", regResult.Error);
                }
                return;
            }

            var result = await AuthService.RegisterPasskeyAsync(regResult.CredentialId, regResult.PublicKey ?? regResult.CredentialId, regResult.Name ?? "Passkey");
            if (result.Success)
            {
                SonnerService.Success("Passkey registered", $"{regResult.Name ?? "Passkey"} has been linked to your account.");
                await LoadPasskeysAsync();
            }
            else
            {
                SonnerService.Error("Passkey error", result.ErrorMessage ?? "Could not save passkey.");
            }
        }
        catch (Exception ex)
        {
            SonnerService.Error("Passkey error", ex.Message);
        }
        finally
        {
            isSettingUpPasskey = false;
            StateHasChanged();
        }
    }

