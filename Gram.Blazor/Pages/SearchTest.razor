@page "/search-test"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@rendermode InteractiveServer
@using System.Diagnostics
@using Gram.Blazor.Shared
@inject WebContentService WebContentService
@inject SearchGroundingHarness SearchGroundingHarness
@inject AgentOrchestrator AgentOrchestrator
@inject SearchDiagnosticsLogService SearchDiagnosticsLog
@inject ILogger<SearchTest> Logger

<PageTitle>Search Test · Gram</PageTitle>

<div class="voice-test-page search-test-page">
    <div class="voice-test-card search-test-card">
        <div class="voice-test-header">
            <div>
                <span class="voice-test-eyebrow">DIAGNOSTIC TOOL</span>
                <h1>Web search grounding test</h1>
                <p>Runs the same web search service used by Gram chat. Results bypass the cache so source coverage, snippets, and timings reflect a fresh request.</p>
            </div>
            <a class="voice-test-back" href="/">Back to chat</a>
        </div>

        <section class="search-test-provider-panel">
            <div class="voice-test-section-label">Search providers</div>
            <div class="search-test-provider-list">
                @if (WebContentService.ProviderStatuses.Count == 0)
                {
                    <span class="search-test-provider-pill fallback">Built-in fallbacks active</span>
                }
                else
                {
                    @foreach (var provider in WebContentService.ProviderStatuses)
                    {
                        <span class="search-test-provider-pill @(provider.IsConfigured ? "configured" : "missing")">
                            @provider.Name: @(provider.IsConfigured ? "Configured" : "API key missing")
                        </span>
                    }
                    <span class="search-test-provider-pill fallback">Wikipedia · Google News · DuckDuckGo fallback</span>
                }
            </div>
        </section>

        <section class="search-test-input-panel">
            <label class="voice-test-section-label" for="searchTestQuery">Custom prompt</label>
            <textarea id="searchTestQuery"
                      class="search-test-query"
                      rows="3"
                      @bind="customQuery"
                      placeholder="Ask a current question, such as: What is the plot of Avengers: Doomsday?"></textarea>
            <div class="voice-test-controls search-test-controls">
                <button type="button" class="voice-test-button" @onclick="RunCustomPromptAsync" disabled="@isRunning">Run custom prompt</button>
                <button type="button" class="voice-test-secondary-button" @onclick="RunStandardPromptsAsync" disabled="@isRunning">Run 5 grounded answers</button>
                <button type="button" class="voice-test-secondary-button" @onclick="ClearResults" disabled="@(isRunning || runs.Count == 0)">Clear</button>
                <span class="voice-test-status @(isRunning ? "listening" : "")">@status</span>
            </div>
        </section>

        @if (runs.Count > 0)
        {
            <section class="search-test-summary">
                <div class="voice-test-section-label">Run summary</div>
                <div class="search-test-log-path">Diagnostics are saved to <code>@SearchDiagnosticsLog.LogPath</code></div>
                <div class="voice-test-grid search-test-metrics">
                    <div><span>Prompts run</span><strong>@runs.Count</strong></div>
                    <div><span>Grounding ready</span><strong>@runs.Count(run => run.GroundingReady) / @runs.Count</strong></div>
                    <div><span>Citation checks</span><strong>@runs.Count(run => run.Validation?.Passed == true) / @runs.Count(run => run.Validation != null)</strong></div>
                    <div><span>Claim coverage</span><strong>@FormatCoverage(runs)</strong></div>
                    <div><span>Total results</span><strong>@runs.Sum(run => run.Results.Count)</strong></div>
                    <div><span>Invalid citations</span><strong>@runs.Sum(run => run.Validation?.InvalidCitationCount ?? 0)</strong></div>
                    <div><span>Average latency</span><strong>@AverageLatencyMs ms</strong></div>
                </div>
            </section>
        }

        <div class="search-test-runs" aria-live="polite">
            @foreach (var run in runs)
            {
                <section class="search-test-run">
                    <div class="search-test-run-header">
                        <div>
                            <span class="search-test-status-pill @(run.GroundingReady ? "pass" : "fail")">
                                @(run.GroundingReady ? "Grounding ready" : "Insufficient grounding")
                            </span>
                            <h2>@run.Query</h2>
                            <div class="search-test-timestamp">@run.StartedAt.ToLocalTime().ToString("MMM d, yyyy h:mm:ss tt")</div>
                        </div>
                        <strong class="search-test-latency">@run.ElapsedMilliseconds ms</strong>
                    </div>

                    <div class="voice-test-grid search-test-metrics">
                        <div><span>Results</span><strong>@run.Results.Count</strong></div>
                        <div><span>Results with snippets</span><strong>@run.SnippetCount</strong></div>
                        <div><span>Relevant results</span><strong>@run.RelevantResultCount</strong></div>
                        <div><span>Source types</span><strong>@run.SourceCount</strong></div>
                        <div><span>Search time</span><strong>@FormatSeconds(run.ElapsedMilliseconds)</strong></div>
                        <div><span>Model time</span><strong>@FormatSeconds(run.ModelMilliseconds)</strong></div>
                        <div><span>Est. context tokens</span><strong>@run.EstimatedContextTokens</strong></div>
                        <div><span>Parallel cost</span><strong>@FormatCost(run.ParallelCostUsd)</strong></div>
                        <div><span>Primary sources</span><strong>@run.PrimarySourceCount</strong></div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(run.Answer))
                    {
                        <div class="search-test-answer">
                            <div class="voice-test-section-label">Model answer · @run.ModelId</div>
                            <p>@run.Answer</p>
                            <span class="search-test-answer-quality @(run.AnswerUsesSources ? "pass" : "fail")">
                                @(run.AnswerUsesSources ? "Answer references grounding" : "Answer did not visibly reference grounding")
                            </span>
                            @if (run.Validation != null)
                            {
                                <div class="search-test-validation @(run.Validation.Passed ? "pass" : "fail")">
                                    @(run.Validation.Passed ? "Citation validation passed" : "Citation validation failed") · @run.Validation.CitedMaterialClaimCount/@run.Validation.MaterialClaimCount material claims cited · @run.Validation.ValidCitationCount valid source link(s)
                                    @foreach (var issue in run.Validation.Issues)
                                    {
                                        <div>@issue</div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(run.Error))
                    {
                        <div class="voice-test-error"><strong>Search error:</strong> @run.Error</div>
                    }
                    @if (run.MissingCoverage.Count > 0)
                    {
                        <div class="voice-test-error"><strong>Missing evidence coverage:</strong> @string.Join(", ", run.MissingCoverage)</div>
                    }
                    else if (run.Results.Count == 0)
                    {
                        <div class="search-test-empty">No search results were returned. Check the server log for upstream HTTP status codes and timing.</div>
                    }
                    else
                    {
                        <div class="search-test-source-summary">
                            @foreach (var source in run.SourceBreakdown)
                            {
                                <span>@source.Key: @source.Value</span>
                            }
                        </div>

                        <div class="search-test-result-list">
                            @foreach (var result in run.Results)
                            {
                                <article class="search-test-result-card">
                                    <div class="search-test-result-meta">
                                        <span>@(result.Source ?? "Unknown")</span>
                                        <span>@GetHost(result.Url)</span>
                                    </div>
                                    <a href="@result.Url" target="_blank" rel="noopener noreferrer">@result.Title</a>
                                    <p>@(string.IsNullOrWhiteSpace(result.Snippet) ? "No snippet was returned by this source." : result.Snippet)</p>
                                </article>
                            }
                        </div>
                    }
                </section>
            }
        </div>
    </div>
</div>

@code {
    private static readonly string[] StandardPrompts =
    [
        "What is the plot of Avengers: Doomsday?",
        "What is the latest major NASA mission update?",
        "What was the latest Federal Reserve interest-rate decision?",
        "What major artificial intelligence model was announced most recently?",
        "What are the latest Formula 1 championship standings?"
    ];

    private readonly List<SearchDiagnosticRun> runs = [];
    private string customQuery = StandardPrompts[0];
    private string status = "Ready to test";
    private bool isRunning;
    private const string EvaluationModelId = "gram-q-plus";

    private long AverageLatencyMs => runs.Count == 0 ? 0 : (long)runs.Average(run => run.ElapsedMilliseconds);

    private async Task RunCustomPromptAsync()
    {
        if (string.IsNullOrWhiteSpace(customQuery) || isRunning) return;
        await RunPromptsAsync([customQuery.Trim()]);
    }

    private async Task RunStandardPromptsAsync()
    {
        if (isRunning) return;
        await RunPromptsAsync(StandardPrompts);
    }

    private async Task RunPromptsAsync(IEnumerable<string> prompts)
    {
        isRunning = true;
        var batchId = Guid.NewGuid().ToString("N")[..12];
        try
        {
            foreach (var prompt in prompts)
            {
                status = $"Searching: {prompt}";
                await InvokeAsync(StateHasChanged);

                var startedAt = DateTimeOffset.UtcNow;
                var stopwatch = Stopwatch.StartNew();
                Logger.LogInformation("Search diagnostic started for prompt: {Prompt}", prompt);

                try
                {
                    var grounding = await SearchGroundingHarness.RunAsync(prompt, 5, bypassCache: true);
                    stopwatch.Stop();
                    var run = grounding.Error is null
                        ? SearchDiagnosticRun.Create(prompt, startedAt, stopwatch.ElapsedMilliseconds, grounding.Results, grounding.Context, EvaluationModelId, grounding.Usage) with { MissingCoverage = grounding.MissingCoverage }
                        : SearchDiagnosticRun.Failed(prompt, startedAt, stopwatch.ElapsedMilliseconds, grounding.Error);
                    if (grounding.Error is null && grounding.IsGrounded)
                    {
                        var answer = new System.Text.StringBuilder();
                        var modelTimer = Stopwatch.StartNew();
                        using var evaluationCts = new CancellationTokenSource(TimeSpan.FromSeconds(45));
                        await foreach (var step in AgentOrchestrator.RunAgentLoopAsync(
                            EvaluationModelId,
                            [new Message("user", prompt)],
                            Environment.CurrentDirectory,
                            GramSystemPrompt.DefaultBasePrompt,
                            maxIterations: 3,
                            forcedWebSearchQuery: prompt,
                            prefetchedWebContextOverride: grounding.Context,
                            disableTools: true,
                            cancellationToken: evaluationCts.Token))
                        {
                            if (!string.IsNullOrWhiteSpace(step.ContentDelta)) answer.Append(step.ContentDelta);
                            if (!string.IsNullOrWhiteSpace(step.ErrorMessage)) run = run with { Error = step.ErrorMessage };
                        }
                        modelTimer.Stop();
                        var answerText = answer.ToString().Trim();
                        var validation = GroundedAnswerValidator.Validate(answerText, grounding.Results);
                        run = run with { Answer = answerText, AnswerUsesSources = UsesGrounding(answerText, grounding.Results), Validation = validation, ModelMilliseconds = modelTimer.ElapsedMilliseconds };
                    }
                    runs.Insert(0, run);
                    await SearchDiagnosticsLog.AppendAsync(new SearchDiagnosticLogEntry
                    {
                        RunId = $"{batchId}-{Guid.NewGuid().ToString("N")[..8]}",
                        Query = prompt,
                        ModelId = run.ModelId,
                        SearchMilliseconds = run.ElapsedMilliseconds,
                        ModelMilliseconds = run.ModelMilliseconds,
                        TotalMilliseconds = run.ElapsedMilliseconds + run.ModelMilliseconds,
                        ResultCount = run.Results.Count,
                        ResultsWithSnippets = run.SnippetCount,
                        RelevantResultCount = run.RelevantResultCount,
                        SourceTypeCount = run.SourceCount,
                        FetchedPageCount = grounding.FetchedPages,
                        EstimatedContextTokens = run.EstimatedContextTokens,
                        ProviderEstimatedCostUsd = run.ParallelCostUsd,
                        ProviderCostIsEstimate = run.ParallelCostUsd.HasValue,
                        ProviderUnits = grounding.Usage?.ProviderUnits,
                        TopicCategory = grounding.Plan?.TopicCategory ?? "general",
                        SearchQueryCount = grounding.Plan?.Queries.Count ?? 0,
                        PrimaryDomains = grounding.Plan?.PreferredDomains,
                        MissingCoverage = grounding.MissingCoverage,
                        Provider = grounding.Usage?.Provider ?? "fallback",
                        GroundingReady = run.GroundingReady,
                        AnswerUsesSources = run.AnswerUsesSources,
                        CitationValidationPassed = run.Validation?.Passed,
                        MaterialClaimCount = run.Validation?.MaterialClaimCount ?? 0,
                        CitedMaterialClaimCount = run.Validation?.CitedMaterialClaimCount ?? 0,
                        InvalidCitationCount = run.Validation?.InvalidCitationCount ?? 0,
                        CitationCoverage = run.Validation?.CitationCoverage ?? 0,
                        PrimarySourceCount = run.PrimarySourceCount,
                        GroundingContextCharacters = grounding.Context.Length,
                        Error = run.Error,
                        Answer = run.Answer,
                        GroundingContext = grounding.Context,
                        Sources = run.Results.Select(result => new SearchDiagnosticSourceLog(
                            result.Title,
                            result.Url,
                            result.Snippet,
                            result.Source ?? "Unknown",
                            run.RelevantResultCount > 0 && ($"{result.Title} {result.Snippet}").Contains(prompt.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "", StringComparison.OrdinalIgnoreCase))).ToList()
                    });
                    Logger.LogInformation(
                        "Search diagnostic completed for prompt: {Prompt}; GroundingReady={GroundingReady}; Results={ResultCount}; Snippets={SnippetCount}; Relevant={RelevantCount}; Sources={SourceCount}; FetchedPages={FetchedPages}; ElapsedMs={ElapsedMs}",
                        prompt,
                        run.GroundingReady,
                        run.Results.Count,
                        run.SnippetCount,
                        run.RelevantResultCount,
                        run.SourceCount,
                        grounding.FetchedPages,
                        run.ElapsedMilliseconds);
                }
                catch (Exception ex)
                {
                    stopwatch.Stop();
                    runs.Insert(0, SearchDiagnosticRun.Failed(prompt, startedAt, stopwatch.ElapsedMilliseconds, ex.Message));
                    Logger.LogError(ex, "Search diagnostic failed for prompt: {Prompt}", prompt);
                }

                await InvokeAsync(StateHasChanged);
            }

            status = "Search diagnostics complete";
        }
        finally
        {
            isRunning = false;
        }
    }

    private void ClearResults()
    {
        runs.Clear();
        status = "Ready to test";
    }

    private static string GetHost(string url)
    {
        return Uri.TryCreate(url, UriKind.Absolute, out var uri) ? uri.Host : url;
    }

    private static string FormatSeconds(long milliseconds) => milliseconds <= 0 ? "—" : $"{milliseconds / 1000d:0.00}s";
    private static string FormatCost(decimal? cost) => cost.HasValue ? $"${cost.Value:0.0000} est." : "Not reported";
    private static string FormatCoverage(IEnumerable<SearchDiagnosticRun> values)
    {
        var validated = values.Where(run => run.Validation != null).Select(run => run.Validation!).ToList();
        return validated.Count == 0 ? "—" : $"{validated.Average(item => item.CitationCoverage) * 100:0}%";
    }

    private sealed record SearchDiagnosticRun(
        string Query,
        DateTimeOffset StartedAt,
        long ElapsedMilliseconds,
        IReadOnlyList<WebSearchResult> Results,
        int SnippetCount,
        int RelevantResultCount,
        IReadOnlyDictionary<string, int> SourceBreakdown,
        string? Error,
        string Answer = "",
        string ModelId = "",
        bool AnswerUsesSources = false,
        SearchUsageTelemetry? Usage = null,
        long ModelMilliseconds = 0,
        GroundedAnswerValidation? Validation = null)
        {
        public IReadOnlyList<string> MissingCoverage { get; init; } = [];
        public int SourceCount => SourceBreakdown.Count;
        public bool GroundingReady => Error is null && Results.Count > 0 && SnippetCount > 0 && RelevantResultCount > 0 && MissingCoverage.Count == 0;
        public int EstimatedContextTokens => Usage is null ? 0 : Usage.EstimatedInputTokens + Usage.EstimatedOutputTokens;
        public decimal? ParallelCostUsd => Usage?.Provider.Equals("Parallel", StringComparison.OrdinalIgnoreCase) == true ? Usage.EstimatedCostUsd : null;
        public int PrimarySourceCount => Results.Count(result => SourceQualityScorer.Score(result, SearchPlanBuilder.ForQuestion(Query)) >= 80);

        public static SearchDiagnosticRun Create(string query, DateTimeOffset startedAt, long elapsedMilliseconds, IReadOnlyList<WebSearchResult> results, string context, string modelId, SearchUsageTelemetry? usage)
        {
            var queryTerms = GetSignificantTerms(query);
            var relevantCount = results.Count(result =>
            {
                var searchableText = $"{result.Title} {result.Snippet}";
                return queryTerms.Count == 0 || queryTerms.Any(term => searchableText.Contains(term, StringComparison.OrdinalIgnoreCase));
            });
            var sourceBreakdown = results
                .GroupBy(result => result.Source ?? "Unknown", StringComparer.OrdinalIgnoreCase)
                .OrderByDescending(group => group.Count())
                .ToDictionary(group => group.Key, group => group.Count(), StringComparer.OrdinalIgnoreCase);

            return new SearchDiagnosticRun(
                query,
                startedAt,
                elapsedMilliseconds,
                results,
                results.Count(result => !string.IsNullOrWhiteSpace(result.Snippet)),
                relevantCount,
                sourceBreakdown,
                null, "", modelId, false, Usage: usage);
        }

        public static SearchDiagnosticRun Failed(string query, DateTimeOffset startedAt, long elapsedMilliseconds, string error)
        {
            return new SearchDiagnosticRun(query, startedAt, elapsedMilliseconds, [], 0, 0, new Dictionary<string, int>(), error);
        }

        private static HashSet<string> GetSignificantTerms(string query)
        {
            string[] ignoredWords = ["what", "when", "where", "which", "who", "why", "how", "was", "were", "are", "is", "the", "and", "for", "from", "with", "most", "major", "latest", "recently"];
            return query
                .Split([' ', ':', '?', ',', '.', '-'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(term => term.Length >= 4 && !ignoredWords.Contains(term, StringComparer.OrdinalIgnoreCase))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
        }
    }

    private static bool UsesGrounding(string answer, IReadOnlyList<WebSearchResult> results)
    {
        if (string.IsNullOrWhiteSpace(answer)) return false;
        return results.Any(result =>
            answer.Contains(result.Title, StringComparison.OrdinalIgnoreCase)
            || answer.Contains(result.Url, StringComparison.OrdinalIgnoreCase)
            || (Uri.TryCreate(result.Url, UriKind.Absolute, out var uri) && answer.Contains(uri.Host, StringComparison.OrdinalIgnoreCase)));
    }
}
