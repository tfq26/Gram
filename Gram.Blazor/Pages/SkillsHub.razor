@page "/skills"
@page "/connections/skills"
@rendermode InteractiveServer
@namespace Gram.Blazor.Pages
@using Gram.Blazor.Shared
@using Gram.Blazor.Components.ShadCn
@inject ToolboxManagerService ToolboxService
@inject ISonnerService SonnerService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Agent Skills · Gram</PageTitle>

<div class="settings-container" style="min-height: 100vh; background: var(--bg-app, #09090b); color: var(--text-primary, #ededed); padding: 32px 40px; max-width: 1080px; margin: 0 auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
    
    <!-- Header Section -->
    <div style="display: flex; align-items: flex-start; justify-content: space-between; border-bottom: 1px solid var(--border-color, #27272a); padding-bottom: 20px; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
        <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                <a href="/" class="btn-secondary" style="font-size: 11.5px; padding: 4px 10px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                    <span>←</span>
                    <span>Chat</span>
                </a>
                <span style="font-size: 11.5px; color: var(--text-muted, #a1a1aa);">/</span>
                <span style="font-size: 11.5px; color: var(--text-muted, #a1a1aa);">Connections</span>
                <span style="font-size: 11.5px; color: var(--text-muted, #a1a1aa);">/</span>
                <span style="font-size: 11.5px; color: var(--text-primary, #ededed); font-weight: 500;">Agent Skills</span>
            </div>
            <h1 style="font-size: 20px; font-weight: 600; margin: 0; color: var(--text-primary, #ededed); letter-spacing: -0.01em;">
                Agent Skills & Guidelines
            </h1>
            <p style="font-size: 13px; color: var(--text-muted, #a1a1aa); margin: 4px 0 0 0;">
                Domain knowledge rules, architectural guidelines, and toolchain instructions injected into agent prompts.
            </p>
        </div>

        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
            <a href="/toolbox" class="btn-secondary" style="font-size: 12px; padding: 6px 12px; text-decoration: none;">
                Toolbox & CDE →
            </a>
            <a href="/mcp" class="btn-secondary" style="font-size: 12px; padding: 6px 12px; text-decoration: none;">
                MCP Bridges →
            </a>
            <button type="button" class="btn-primary" style="font-size: 12px; padding: 6px 14px;" @onclick="OpenCreateSkillModal">
                + New Skill
            </button>
        </div>
    </div>

    <!-- Status Group -->
    <div class="settings-group" style="margin-bottom: 24px;">
        <div class="setting-item" style="display: flex; align-items: center; justify-content: space-between; padding: 14px 16px;">
            <div class="setting-info">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span class="setting-title" style="font-size: 13.5px; font-weight: 500; color: var(--text-primary, #ededed);">Prompt Injection Mode</span>
                    <span class="provider-badge connected" style="font-size: 11px;">Dynamic Grounding</span>
                </div>
                <span class="setting-desc" style="font-size: 12px; color: var(--text-muted, #a1a1aa); margin-top: 2px;">
                    Enabled skills and coding standards are automatically assembled into context prompts for autonomous tasks.
                </span>
            </div>
            <div class="setting-control" style="font-size: 12px; color: var(--text-muted, #a1a1aa);">
                <span>@ToolboxService.Skills.Count(s => s.IsActive) active / @ToolboxService.Skills.Count total skills</span>
            </div>
        </div>
    </div>

    <!-- Skills Group -->
    <div class="settings-group">
        <div style="padding: 14px 16px; border-bottom: 1px solid var(--border-color, #27272a); display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
            <div>
                <span style="font-size: 13px; font-weight: 600; color: var(--text-primary, #ededed); text-transform: uppercase; letter-spacing: 0.03em;">Configured Domain Skills</span>
                <span style="font-size: 12px; color: var(--text-muted, #a1a1aa); display: block; margin-top: 2px;">Modular instructions tailored to your technical stack and conventions.</span>
            </div>
            <input class="setting-input"
                   @bind="searchQuery"
                   @bind:event="oninput"
                   placeholder="Filter skills..."
                   style="max-width: 240px; font-size: 12px; padding: 5px 10px;" />
        </div>

        @{
            var filteredSkills = ToolboxService.Skills.Where(s =>
                string.IsNullOrWhiteSpace(searchQuery) ||
                s.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                s.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                s.SystemPrompt.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();
        }

        @if (filteredSkills.Count == 0)
        {
            <div style="padding: 36px 20px; text-align: center;">
                <span style="font-size: 13.5px; color: var(--text-muted, #a1a1aa); display: block; margin-bottom: 12px;">No agent skills matching your query.</span>
                <button type="button" class="btn-secondary" style="font-size: 12px;" @onclick="OpenCreateSkillModal">
                    + Create Skill
                </button>
            </div>
        }
        else
        {
            @foreach (var skill in filteredSkills)
            {
                var isExpanded = expandedSkillIds.Contains(skill.Id);
                var tokenEstimate = Math.Max(1, skill.SystemPrompt.Length / 4);

                <div class="setting-item" style="display: flex; align-items: flex-start; justify-content: space-between; padding: 16px; gap: 16px; border-bottom: 1px solid var(--border-color, #27272a);">
                    <div class="setting-info" style="flex: 1; min-width: 0;">
                        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                            <span class="setting-title" style="font-size: 13.5px; font-weight: 500; color: var(--text-primary, #ededed);">@skill.Name</span>
                            @if (skill.IsActive)
                            {
                                <span class="provider-badge connected" style="font-size: 10px;">Active</span>
                            }
                            else
                            {
                                <span class="provider-badge disconnected" style="font-size: 10px;">Disabled</span>
                            }
                            <span style="font-size: 10.5px; color: var(--text-muted, #a1a1aa); font-family: monospace;">
                                ~@tokenEstimate tokens
                            </span>
                        </div>

                        <span class="setting-desc" style="font-size: 12.5px; color: var(--text-secondary, #a1a1aa); margin-top: 4px; line-height: 1.45; display: block;">
                            @skill.Description
                        </span>

                        <!-- Collapsible Guidelines Toggle -->
                        <div style="margin-top: 8px;">
                            <button type="button" class="btn-subtle" style="font-size: 11px; padding: 2px 6px; display: inline-flex; align-items: center; gap: 4px;" @onclick="() => ToggleGuidelinePreview(skill.Id)">
                                <span>@(isExpanded ? "Hide Guidelines ▴" : "View Guidelines ▾")</span>
                            </button>

                            @if (isExpanded)
                            {
                                <div style="margin-top: 8px; background: var(--bg-app, #09090b); border: 1px solid var(--border-color, #27272a); border-radius: 6px; padding: 12px;">
                                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                                        <span style="font-size: 10px; font-weight: 600; color: var(--text-muted, #a1a1aa); text-transform: uppercase; letter-spacing: 0.04em;">System Prompt Guidelines</span>
                                        <span style="font-size: 10px; color: var(--text-muted, #a1a1aa);">@skill.SystemPrompt.Length characters</span>
                                    </div>
                                    <pre style="font-size: 11.5px; font-family: monospace; color: var(--text-secondary, #d4d4d8); margin: 0; white-space: pre-wrap; word-break: break-word; max-height: 160px; overflow-y: auto; line-height: 1.5;">@skill.SystemPrompt</pre>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="setting-control" style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
                        <button type="button" class="btn-secondary" style="font-size: 11.5px; padding: 4px 10px; margin: 0;" @onclick="() => OpenEditSkillModal(skill)">
                            Edit
                        </button>
                        <button type="button" class="btn-subtle" style="font-size: 11.5px; padding: 4px 8px; margin: 0; color: @(skill.IsActive ? "var(--text-muted, #a1a1aa)" : "var(--accent, #3b82f6)");" @onclick="() => ToolboxService.ToggleSkill(skill.Id)">
                            @(skill.IsActive ? "Disable" : "Enable")
                        </button>
                        <button type="button" class="btn-subtle" style="font-size: 11.5px; padding: 4px 8px; margin: 0; color: var(--text-danger, #ef4444);" @onclick="() => DeleteSkill(skill.Id)">
                            Delete
                        </button>
                    </div>
                </div>
            }
        }
    </div>

</div>

<!-- Add / Edit Skill Modal -->
@if (showSkillModal)
{
    <div class="modal-backdrop" @onclick="() => showSkillModal = false">
        <div class="modal-dialog" style="max-width: 540px; border-radius: var(--radius-lg, 12px);" @onclick:stopPropagation="true">
            <div class="modal-header" style="padding: 16px 20px; border-bottom: 1px solid var(--border-color, #27272a);">
                <span class="modal-title" style="font-size: 15px; font-weight: 600;">
                    @(editingSkillId == null ? "Create Agent Skill" : "Edit Agent Skill")
                </span>
                <button class="btn-close-modal" @onclick="() => showSkillModal = false">✕</button>
            </div>
            <div class="modal-body" style="padding: 16px 20px; display: flex; flex-direction: column; gap: 14px;">
                <div class="sheet-field">
                    <label class="sheet-label" style="font-size: 12px; font-weight: 500; color: var(--text-primary, #ededed); margin-bottom: 4px; display: block;">Skill Name</label>
                    <input class="sheet-input" @bind="modalSkillName" placeholder="e.g. Blazor & .NET 9 Specialist" />
                </div>
                <div class="sheet-field">
                    <label class="sheet-label" style="font-size: 12px; font-weight: 500; color: var(--text-primary, #ededed); margin-bottom: 4px; display: block;">Description</label>
                    <input class="sheet-input" @bind="modalSkillDesc" placeholder="Brief summary of when the model activates this skill..." />
                </div>
                <div class="sheet-field">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
                        <label class="sheet-label" style="font-size: 12px; font-weight: 500; color: var(--text-primary, #ededed); margin: 0;">System Prompt Guidelines</label>
                        <span style="font-size: 11px; color: var(--text-muted, #a1a1aa);">Injected into context</span>
                    </div>
                    <textarea class="sheet-input" style="min-height: 140px; font-family: monospace; font-size: 12px; line-height: 1.5; resize: vertical;" @bind="modalSkillPrompt" placeholder="You are an expert in... When generating code, follow these principles:..."></textarea>
                </div>
            </div>
            <div class="modal-footer" style="padding: 12px 20px; border-top: 1px solid var(--border-color, #27272a); display: flex; justify-content: flex-end; gap: 8px;">
                <button type="button" class="btn-secondary" @onclick="() => showSkillModal = false">Cancel</button>
                <button type="button" class="btn-primary" @onclick="SaveSkill">
                    @(editingSkillId == null ? "Create Skill" : "Save Changes")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string searchQuery = "";
    private HashSet<string> expandedSkillIds = new();

    private bool showSkillModal = false;
    private string? editingSkillId = null;
    private string modalSkillName = "";
    private string modalSkillDesc = "";
    private string modalSkillPrompt = "";

    protected override void OnInitialized()
    {
        ToolboxService.OnChange += HandleUpdated;
    }

    private void HandleUpdated() => _ = InvokeAsync(StateHasChanged);

    private void ToggleGuidelinePreview(string skillId)
    {
        if (expandedSkillIds.Contains(skillId))
            expandedSkillIds.Remove(skillId);
        else
            expandedSkillIds.Add(skillId);
    }

    private void OpenCreateSkillModal()
    {
        editingSkillId = null;
        modalSkillName = "";
        modalSkillDesc = "";
        modalSkillPrompt = "";
        showSkillModal = true;
    }

    private void OpenEditSkillModal(AgentSkillDefinition skill)
    {
        editingSkillId = skill.Id;
        modalSkillName = skill.Name;
        modalSkillDesc = skill.Description;
        modalSkillPrompt = skill.SystemPrompt;
        showSkillModal = true;
    }

    private void SaveSkill()
    {
        if (string.IsNullOrWhiteSpace(modalSkillName))
        {
            SonnerService.Error("Incomplete", "Please enter a skill name.");
            return;
        }

        if (editingSkillId != null)
        {
            var existing = ToolboxService.Skills.FirstOrDefault(s => s.Id == editingSkillId);
            if (existing != null)
            {
                existing.Name = modalSkillName.Trim();
                existing.Description = modalSkillDesc.Trim();
                existing.SystemPrompt = modalSkillPrompt.Trim();
                ToolboxService.UpdateSkill(existing);
                SonnerService.Success("Skill Updated", $"Saved changes to '{existing.Name}'.");
            }
        }
        else
        {
            ToolboxService.AddSkill(new AgentSkillDefinition
            {
                Name = modalSkillName.Trim(),
                Description = modalSkillDesc.Trim(),
                SystemPrompt = modalSkillPrompt.Trim(),
                Icon = "💡",
                IsActive = true
            });
            SonnerService.Success("Skill Created", $"'{modalSkillName}' added to agent knowledge.");
        }

        showSkillModal = false;
        editingSkillId = null;
        modalSkillName = "";
        modalSkillDesc = "";
        modalSkillPrompt = "";
    }

    private void DeleteSkill(string id)
    {
        ToolboxService.RemoveSkill(id);
        SonnerService.Info("Deleted", "Agent skill removed.");
    }

    public void Dispose()
    {
        ToolboxService.OnChange -= HandleUpdated;
    }
}
