@page "/toolbox"
@page "/connections/toolbox"
@rendermode InteractiveServer
@namespace Gram.Blazor.Pages
@using Gram.Blazor.Shared
@using Gram.Blazor.Components.ShadCn
@inject ToolboxManagerService ToolboxService
@inject WorkspaceTabService TabService
@inject ISonnerService SonnerService
@implements IDisposable

<PageTitle>Toolbox & CDE · Gram</PageTitle>

<div class="settings-container" style="min-height: 100vh; background: var(--bg-app, #09090b); color: var(--text-primary, #ededed); padding: 32px 40px; max-width: 1080px; margin: 0 auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
    
    <!-- Header Section -->
    <div style="display: flex; align-items: flex-start; justify-content: space-between; border-bottom: 1px solid var(--border-color, #27272a); padding-bottom: 20px; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
        <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                <a href="/" class="btn-secondary" style="font-size: 11.5px; padding: 4px 10px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                    <span>←</span>
                    <span>Chat</span>
                </a>
                <span style="font-size: 11.5px; color: var(--text-muted, #a1a1aa);">/</span>
                <span style="font-size: 11.5px; color: var(--text-muted, #a1a1aa);">Connections</span>
                <span style="font-size: 11.5px; color: var(--text-muted, #a1a1aa);">/</span>
                <span style="font-size: 11.5px; color: var(--text-primary, #ededed); font-weight: 500;">Toolbox & CDE</span>
            </div>
            <h1 style="font-size: 20px; font-weight: 600; margin: 0; color: var(--text-primary, #ededed); letter-spacing: -0.01em;">
                Toolbox & CDE Runtime
            </h1>
            <p style="font-size: 13px; color: var(--text-muted, #a1a1aa); margin: 4px 0 0 0;">
                Core developer tools, container execution sandboxes, and language syntax parsers.
            </p>
        </div>

        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
            <a href="/mcp" class="btn-secondary" style="font-size: 12px; padding: 6px 12px; text-decoration: none;">
                MCP Bridges →
            </a>
            <a href="/skills" class="btn-secondary" style="font-size: 12px; padding: 6px 12px; text-decoration: none;">
                Agent Skills →
            </a>
            <button type="button" class="btn-secondary" style="font-size: 12px; padding: 6px 12px;" @onclick="TestToolboxHealth">
                Diagnostics
            </button>
        </div>
    </div>

    <!-- Engine Status Group -->
    <div class="settings-group" style="margin-bottom: 24px;">
        <div class="setting-item" style="display: flex; align-items: center; justify-content: space-between; padding: 14px 16px;">
            <div class="setting-info">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span class="setting-title" style="font-size: 13.5px; font-weight: 500; color: var(--text-primary, #ededed);">Local Engine Status</span>
                    <span class="provider-badge connected" style="font-size: 11px;">@ToolboxService.ToolboxStatus</span>
                    <span style="font-size: 11px; color: var(--text-muted, #a1a1aa); font-family: monospace;">v@(ToolboxService.ToolboxVersion)</span>
                </div>
                <span class="setting-desc" style="font-size: 12px; color: var(--text-muted, #a1a1aa); margin-top: 2px;">
                    Powers isolated process spawning, terminal streaming, and syntax tree inspections.
                </span>
            </div>
            <div class="setting-control" style="font-size: 12px; color: var(--text-muted, #a1a1aa);">
                <span>@ToolboxService.InstalledTools.Count(t => t.IsEnabled) active / @ToolboxService.InstalledTools.Count total</span>
            </div>
        </div>
    </div>

    <!-- Core Tools Group -->
    <div class="settings-group">
        <div style="padding: 14px 16px; border-bottom: 1px solid var(--border-color, #27272a); display: flex; align-items: center; justify-content: space-between;">
            <div>
                <span style="font-size: 13px; font-weight: 600; color: var(--text-primary, #ededed); text-transform: uppercase; letter-spacing: 0.03em;">Installed Developer Tools</span>
                <span style="font-size: 12px; color: var(--text-muted, #a1a1aa); display: block; margin-top: 2px;">Available to autonomous agent workflows and terminal sessions.</span>
            </div>
        </div>

        @foreach (var group in ToolboxService.InstalledTools.GroupBy(t => t.Category))
        {
            <div style="padding: 9px 16px; background: var(--bg-panel-subtle, rgba(255, 255, 255, 0.02)); border-bottom: 1px solid var(--border-color, #27272a); border-top: 1px solid var(--border-color, #27272a); display: flex; align-items: center; justify-content: space-between;">
                <span style="font-size: 11px; font-weight: 600; color: var(--text-muted, #a1a1aa); text-transform: uppercase; letter-spacing: 0.05em;">
                    @(group.Key switch
                    {
                        "Sandbox" => "Sandboxes & Container Runtimes",
                        "Code" => "Code Intelligence & Syntax Parsers",
                        "Browser" => "Browser & Visual QA",
                        "MCP" => "MCP Connectors",
                        "Skills" => "Agent Skills",
                        _ => $"{group.Key} Tools"
                    })
                </span>
                <span style="font-size: 11px; color: var(--text-muted, #a1a1aa);">
                    @group.Count() @(group.Count() == 1 ? "tool" : "tools")
                </span>
            </div>

            @foreach (var tool in group)
            {
                <div class="setting-item" style="display: flex; align-items: flex-start; justify-content: space-between; padding: 16px; gap: 16px; border-bottom: 1px solid var(--border-color, #27272a);">
                    <div class="setting-info" style="flex: 1; min-width: 0;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span class="setting-title" style="font-size: 13.5px; font-weight: 500; color: var(--text-primary, #ededed);">@tool.Name</span>
                            @if (tool.IsEnabled)
                            {
                                <span class="provider-badge connected" style="font-size: 10px;">@tool.Status</span>
                            }
                            else
                            {
                                <span class="provider-badge disconnected" style="font-size: 10px;">Disabled</span>
                            }
                        </div>
                        <span class="setting-desc" style="font-size: 12.5px; color: var(--text-secondary, #a1a1aa); margin-top: 4px; line-height: 1.45; display: block;">
                            @tool.Description
                        </span>
                    </div>

                    <div class="setting-control" style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
                        <button type="button" class="btn-secondary" style="font-size: 11.5px; padding: 4px 10px; margin: 0;" @onclick="() => OpenToolInTab(tool)">
                            Configure
                        </button>
                        <button type="button" class="btn-subtle" style="font-size: 11.5px; padding: 4px 8px; margin: 0; color: @(tool.IsEnabled ? "var(--text-muted, #a1a1aa)" : "var(--accent, #3b82f6)");" @onclick="() => ToolboxService.ToggleTool(tool.Id)">
                            @(tool.IsEnabled ? "Disable" : "Enable")
                        </button>
                    </div>
                </div>
            }
        }
    </div>

</div>

@code {
    protected override void OnInitialized()
    {
        ToolboxService.OnChange += StateHasChanged;
    }

    private void OpenToolInTab(ToolboxToolInfo tool)
    {
        TabService.OpenToolConfigTab(tool.Id, tool.Name, tool.Icon);
        SonnerService.Success("Tab opened", $"Opened configuration tab for {tool.Name}");
    }

    private void TestToolboxHealth()
    {
        SonnerService.Success("Toolbox Engine Active", $"Gram Sandbox & Tool engine is running normally (v{ToolboxService.ToolboxVersion})");
    }

    public void Dispose()
    {
        ToolboxService.OnChange -= StateHasChanged;
    }
}
