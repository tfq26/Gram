@inherits LayoutComponentBase
@inject NavigationManager NavManager
@inject Gram.Blazor.Shared.ThemeService ThemeService
@inject Gram.Blazor.Shared.ChatStateService ChatStateService
@inject Gram.Blazor.Shared.SettingsService SettingsService
@inject Gram.Blazor.Shared.IAuthService AuthService
@inject Gram.Blazor.Shared.ISonnerService SonnerService
@implements IDisposable

<div class="app-shell" data-theme="@ThemeService.ActiveThemeName.ToLowerInvariant().Replace(" ", "-")" style="@ThemeService.GetInlineCssVariables()">
@if (!IsLoginPage())
    {
        <header class="topbar">
            <div class="topbar-left">
                <a class="brand" href="/" style="display: inline-flex; align-items: center; gap: 7px;">
                    <img src="icons/gram-logo.svg" alt="Gram" style="width: 17px; height: 17px; display: block;" />
                    <span>Gram</span>
                </a>
                <nav class="topbar-nav">
                    <a class="nav-link @(IsActive("/") ? "active" : "")" href="/">Chat</a>
                    <a class="nav-link @(IsActive("/settings") ? "active" : "")" href="/settings">Settings</a>
                </nav>

                <TopbarTabs />
            </div>

            @if (IsActive("/settings"))
            {
                <div class="topbar-center">
                    <nav class="breadcrumbs">
                        @for (int i = 0; i < SettingsService.BreadcrumbParts.Count; i++)
                        {
                            var index = i;
                            var part = SettingsService.BreadcrumbParts[index];
                            @if (index > 0)
                            {
                                <span class="breadcrumb-separator">/</span>
                            }
                            <span class="@(index == SettingsService.BreadcrumbParts.Count - 1 ? "breadcrumb-current" : "breadcrumb-part")">@part</span>
                        }
                    </nav>
                </div>
            }
            else
            {
                <div class="topbar-center"></div>
            }

            <div class="topbar-right">
                <a class="nav-link btn-toolbox-pin @(IsActive("/toolbox") ? "active" : "")" href="/toolbox" title="Toolbox & Extensions">
                    Toolbox
                </a>
            </div>
        </header>
    }
    <main class="page-frame @(IsLoginPage() ? "login-frame" : "")">
        @if (!IsLoginPage() && !AuthService.CurrentUser.IsAuthenticated)
        {
            <div style="display: flex; justify-content: center; align-items: center; height: 100%; color: var(--text-muted); font-size: 14px;">
                <span>Redirecting to sign in...</span>
            </div>
        }
        else
        {
            @Body
        }
    </main>
    <Sonner />
    <AuthModal @bind-IsOpen="showAuthModal" />
</div>

@code {
    private bool showAuthModal = false;

    protected override void OnInitialized()
    {
        ThemeService.OnChange += OnThemeChanged;
        ChatStateService.OnChange += OnChatStateChanged;
        SettingsService.OnBreadcrumbChanged += OnBreadcrumbChanged;
        AuthService.OnAuthStateChanged += OnAuthChanged;
        NavManager.LocationChanged += OnLocationChanged;

        CheckAuthentication();
    }

    protected override void OnParametersSet()
    {
        CheckAuthentication();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        CheckAuthentication();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnChatStateChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnBreadcrumbChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnAuthChanged()
    {
        CheckAuthentication();
        _ = InvokeAsync(StateHasChanged);
    }

    private void CheckAuthentication()
    {
        if (!IsLoginPage() && !AuthService.CurrentUser.IsAuthenticated)
        {
            var relativePath = NavManager.ToBaseRelativePath(NavManager.Uri);
            var returnUrl = string.IsNullOrWhiteSpace(relativePath) ? "/" : "/" + relativePath;
            if (returnUrl.Contains("login", StringComparison.OrdinalIgnoreCase) || returnUrl.Contains("signin", StringComparison.OrdinalIgnoreCase))
            {
                returnUrl = "/";
            }
            NavManager.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}");
        }
    }

    private bool IsActive(string path)
    {
        var uri = NavManager.ToBaseRelativePath(NavManager.Uri);
        if (string.IsNullOrEmpty(uri) && path == "/") return true;
        return "/" + uri.TrimEnd('/') == path.TrimEnd('/');
    }

    private bool IsLoginPage()
    {
        var uri = NavManager.ToBaseRelativePath(NavManager.Uri).ToLowerInvariant();
        return uri.StartsWith("login") || uri.StartsWith("signin");
    }

    public void Dispose()
    {
        ThemeService.OnChange -= OnThemeChanged;
        ChatStateService.OnChange -= OnChatStateChanged;
        SettingsService.OnBreadcrumbChanged -= OnBreadcrumbChanged;
        AuthService.OnAuthStateChanged -= OnAuthChanged;
        NavManager.LocationChanged -= OnLocationChanged;
    }
}


