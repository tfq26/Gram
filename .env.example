# ==============================================================================
# GRAM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Web Server Port
GRAM_PORT=7337

# ------------------------------------------------------------------------------
# AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Options:
#   - None         : Default for self-hosting (instant local admin access, zero login)
#   - BetterAuth   : Cloud deployments with Better Auth
#   - ProxyHeader  : Authentik / Authelia / Traefik reverse proxy headers
#   - Oidc         : Self-hosted Authentik / Keycloak / Zitadel OpenID Connect
AUTH_PROVIDER=None

# --- Better Auth (Cloud Mode) ---
# BETTER_AUTH_URL=https://auth.yourdomain.com
# BETTER_AUTH_SECRET=your-better-auth-secret

# --- Generic OIDC (Authentik / Keycloak Mode) ---
# OIDC_AUTHORITY=https://authentik.yourdomain.com/application/o/gram/
# OIDC_CLIENT_ID=gram-client-id
# OIDC_CLIENT_SECRET=gram-client-secret

# --- Forward-Auth Headers (Traefik / Nginx / Authelia) ---
# PROXY_USER_HEADER=X-authentik-username
# PROXY_EMAIL_HEADER=X-authentik-email
# PROXY_NAME_HEADER=X-authentik-name

# ------------------------------------------------------------------------------
# AI PROVIDERS CONFIGURATION
# ------------------------------------------------------------------------------
# Local Ollama endpoint (host.docker.internal reaches the host OS from inside Docker)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenRouter API Key (Optional)
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
