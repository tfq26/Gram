{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gram",
  "version": "2.0.0",
  "identifier": "com.gram.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "bun run build:studio",
    "frontendDist": "../dist/studio"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gram",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "backgroundColor": "#0a0a0c",
        "url": "http://127.0.0.1:7337"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
